#!/usr/bin/env bash
# commit-msg hook: reject commit messages containing AI agent signatures.
# Activated via: git config core.hooksPath scripts/hooks  (auto-set by Makefile)

MSG_FILE="$1"

if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Patterns that identify AI agent-generated commit messages.
# Each pattern is a case-insensitive extended regex.
PATTERNS=(
  # Cursor / Cursor Agent
  'Generated-by:.*[Cc]ursor'
  'Made-with:.*[Cc]ursor'
  '\[cursor\]'
  'cursor-agent'

  # GitHub Copilot
  'Generated-by:.*[Cc]opilot'
  'Made-with:.*[Cc]opilot'
  '\[copilot\]'
  'Co-authored-by:.*copilot'
  'Co-authored-by:.*github-copilot'

  # Claude Code / Anthropic
  'Generated-by:.*[Cc]laude'
  'Made-with:.*[Cc]laude'
  '\[claude\]'
  'Co-authored-by:.*claude'

  # Codex / OpenAI
  'Generated-by:.*[Cc]odex'
  'Made-with:.*[Cc]odex'
  'Generated-by:.*[Oo]pen[Aa][Ii]'

  # Generic AI markers (trailer format only)
  'Generated-by:.*[Aa][Ii]'
  '^AI-generated$'
  'auto-generated by.*agent'

  # Aider
  'aider:'
  '\[aider\]'
)

violations=()
for pattern in "${PATTERNS[@]}"; do
  if grep -qEi "$pattern" "$MSG_FILE"; then
    match=$(grep -nEi "$pattern" "$MSG_FILE" | head -1)
    violations+=("  $match")
  fi
done

if [ ${#violations[@]} -gt 0 ]; then
  echo "[commit-msg] ERROR: AI agent signature detected in commit message."
  echo ""
  for v in "${violations[@]}"; do
    echo "$v"
  done
  echo ""
  echo "[commit-msg] Remove the AI-generated trailer/tag before committing."
  echo "[commit-msg] If this is a false positive, use --no-verify to bypass."
  exit 1
fi

exit 0
