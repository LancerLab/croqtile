#include "choreo_cuda.h"

// extern "C" void kernel(int * lhs, int * rhs, int * out, int m, int k, int n) {
__cok__ { /// kernel program
__device__ void ukernel_sgemm_32x32x32(float* lhs, float* rhs, float* out) {
  int tid_x = threadIdx.x;
  int tid_y = threadIdx.y;
  for (int i = 0; i < 32; i++) {
      out[tid_y*32 + tid_x] += lhs[tid_y * 32 + i] * rhs[i * 32 + tid_x];
  }
  return;
}

__device__ int tile_addr_(int x_offset, int y_offset, int x_stride, int y_stride) {
  int idx = x_offset * x_stride + y_offset * y_stride;
  return idx;
}

__device__ int tile_addr_ex_(int x_tile, int y_tile, int x_offset, int y_offset, int x_tile_size, int y_tile_size, int x_stride, int y_stride) {
  int idx = x_tile * x_tile_size * x_stride + y_tile * y_tile_size * y_stride + x_offset * x_stride + y_offset * y_stride;
  return idx;
}

__device__ void fill_zero_elementwise(float* data) {
  int tid_x = threadIdx.x;
  int tid_y = threadIdx.y;
  data[tid_y*32 + tid_x] = 0.0;
}
} /// end of kernel decl

// __co__ f32 [4096, 4096] sgemm(f32 [4096, 4096] lhs, f32 [4096, 4096] rhs, f32 [4096, 4096] output) { /// device program
__co__ void gpu_matmul(f32 [4096, 4096] lhs, f32 [4096, 4096] rhs, f32 [4096, 4096] output) { /// device program
  parallel p by 128 {  // p is bid_x
    parallel q by 128 { // q is bid_y
      with index = {m_tile_times_p, n_tile_times_q, k_tile} in [1, 1, 128] {  // decl your tiled spans
        shared f32[lhs.span(0)/#p, rhs.span(1)/#q] l2_out; // alternative: f32[lhs.span(0)/#p, lhs.span(1)/#x, rhs.span(2)/#y]
        call fill_zero_elementwise(l2_out);
        foreach k_tile {
          lhs_load = dma.copy lhs.chunkat(p, k_tile) => shared; // tiling_factor: {6, 17, 4}, new_size {lhs(0)/6, lhs(1)/17, lhs(2)/4}
          rhs_load = dma.copy rhs.chunkat(k_tile, q) => shared; // no explicit decl the target buffer, but can refer by <FutureType>.data
          call ukernel_sgemm_32x32x32(lhs_load.data, rhs_load.data, l2_out); // |span| calculate the total size of span.
          out_store = dma.copy l2_out => output.chunkat(p, q); // can use defined vars
        }
      }
    } // can use python styling
  }
}

// target code
// dim3 gridDim(128, 128); // 128 = CEIL_DIV(M, 32) = ((M + 32 - 1)/32)
// dim3 blockDim(32, 32);
// int bx = blockIdx.x; // p
// int by = blockIdx.y; // q
