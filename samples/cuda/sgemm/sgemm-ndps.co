#include "choreo_cuda.h"
// NON-DESTINATION-PASSING-STYLE sgemm implementation

// extern "C" void kernel(int * lhs, int * rhs, int * out, int m, int k, int n) {
__cok__ { /// kernel program
extern "C" void sgemm_kernel(int * lhs, int * rhs, int * out) {
  return;
}
} /// end of kernel decl

// __co__ f32 [4096, 4096] sgemm(f32 [4096, 4096] lhs, f32 [4096, 4096] rhs, f32 [4096, 4096] output) { /// device program
__co__ void sgemm(f32 [4096, 4096] lhs, f32 [4096, 4096] rhs, f32 [4096, 4096] output) { /// device program
  parallel p by 128 {  // p is sip_index
    parallel q by 128 {
    // use p and q for m_tile and n_tile
      with index = {m_tile, n_tile, k_tile} in [1, 1, 1] {  // decl your tiled spans
        shared f32[32, 32] l2_out; // alternative: f32[lhs.span(0)/#p, lhs.span(1)/#x, rhs.span(2)/#y]
        foreach k_tile {
          lhs_load = dma.copy lhs.chunkat(p, k_tile) => shared; // tiling_factor: {6, 17, 4}, new_size {lhs(0)/6, lhs(1)/17, lhs(2)/4}
          rhs_load = dma.copy rhs.chunkat(k_tile, q) => shared; // no explicit decl the target buffer, but can refer by <FutureType>.data
          call sgemm_kernel(lhs_load.data, rhs_load.data, l2_out); // |span| calculate the total size of span.
          out_store = dma.copy l2_out => output.chunkat(p, q); // can use defined vars
        }
      }
    } // can use python styling
  }
}

int main() { /// host program
  unsigned long m, n, k;
  m = 4096;
  n = 4096;
  k = 4096;

  float* a = (float *)malloc(sizeof(float) * m * k);
  float* b = (float *)malloc(sizeof(float) * k * n);
  // float* c = (float *)malloc(sizeof(float) * m * n);
  auto lhs_data = choreo::make_spanview<2>((float*)a, {m, k});
  auto rhs_data = choreo::make_spanview<2>((float*)b, {k, n});
  // auto out_data = choreo::make_spanview<2>((float*)c, {m, n});

  // auto res = sgemm(lhs_data, rhs_data, out_data);
  auto res = sgemm(lhs_data, rhs_data);

  return 0;
}
