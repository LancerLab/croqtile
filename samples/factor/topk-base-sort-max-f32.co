
#include "choreo.h"
#include <chrono>

__cok__ { /// kernel program

#define TAR32(low, high) (low & 0xffff | (high & 0xffff) << 16)
#define ADDR2VEC(addr) (addr >> 6)
#define EXT32(hi, lo) ((hi) << 16 | ((lo) & 0xffff))

#define BLOCK_U8 256
#define CVT_U16(m) ((m << 16) | m)
#define CVT_U8(m) ((m << 24) | (m << 16) | (m << 8) | m)

#define BLOCK_SIZE 64
#define BLOCK_SIZE_2 128
#define BLOCK_SIZE_4 256

#define VR_SIZE 16
#define VR_SIZE_F16 32
#define VR_SIZE_U8 64
#define MAX_NUM_VACC 1024
#define MAX_NUM_QACC 512

enum DataTypes : int {
  INT8 = 2,
  INT16 = 3,
  INT32 = 4,
  UINT8 = 6,
  UINT16 = 7,
  UINT32 = 8,
  FLOAT16 = 10,
  FLOAT32 = 11,
  BFLOAT16 = 16,
};

static void __attribute__((always_inline)) setVabBase(int vab_base) {
  __dtu_c_movsr2vab_lv_s(vab_base);
  __dtu_c_movsr2vab_l_d(vab_base);
  __dtu_c_movsr2vab_m_s1(vab_base);
  __dtu_c_movsr2vab_m_s2(vab_base);
  __dtu_c_movsr2vab_m_d(vab_base);
}

static int __attribute__((always_inline)) CeilDiv(int x, int y) {
  return (x + y - 1) / y;
}

extern "C" void topk_split_stage2_fp32(int input_addr, int order_vector_addr,
                                 int output_addr, int output_index_addr,
                                 int input_ori_sizes, int col_ori_sizes,
                                 int vr_base, int smr_base, int global_size,
                                 int split_base) {
#if __GCU_ARCH__ < 300
  int ci_vec_num = 1;

  int input_base = TAR32(ADDR2VEC(input_addr), ADDR2VEC(input_addr));
  int input_off = TAR32(ci_vec_num, ci_vec_num);

  int order_vector_base =
      TAR32(ADDR2VEC(order_vector_addr), ADDR2VEC(order_vector_addr));
  int order_vector_off = TAR32(ci_vec_num, ci_vec_num);

  int output_base =
      TAR32(ADDR2VEC(output_addr), ADDR2VEC(output_addr));
  int output_off = TAR32(ci_vec_num, ci_vec_num);

  int output_read_base =
      TAR32(ADDR2VEC(output_addr), ADDR2VEC(output_addr));
  int output_read_off = TAR32(ci_vec_num, ci_vec_num);

  int output_index_base =
      TAR32(ADDR2VEC(output_index_addr), ADDR2VEC(output_index_addr));
  int output_index_off = TAR32(ci_vec_num, ci_vec_num);

  int output_index_read_base =
      TAR32(ADDR2VEC(output_index_addr), ADDR2VEC(output_index_addr));
  int output_index_read_off = TAR32(ci_vec_num, ci_vec_num);

  // Clear VAB status
  setVabBase(0x0);

  va16f32 vacc0, vacc1, vacc2, vacc3, vacc4, vacc5, vacc6, vacc7;
  smr_t smr0;
  v64i8 vr_input[8];
  v64i8 vr_order_vector[8];
  v64i8 vr_index[8];
  v64i8 vr_index0;
  int input_blocks = (input_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE;
  int col_sizes = (col_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE * BLOCK_SIZE;

  int col_global_sizes = (col_sizes + MAX_NUM_VACC * VR_SIZE - 1) /
                         (MAX_NUM_VACC * VR_SIZE) * (MAX_NUM_VACC * VR_SIZE);
  int col_global_blocks = col_global_sizes / (MAX_NUM_VACC * VR_SIZE);

  int col_local_sizes = col_ori_sizes < MAX_NUM_VACC * VR_SIZE
                            ? col_ori_sizes
                            : MAX_NUM_VACC * VR_SIZE;
  int col_local_blocks = col_local_sizes / BLOCK_SIZE;
  // set vmm_raw
  __dtu_c_movsr2vmm_raw(0x1);
  __dtu_c_movsr2naccovr(0x1);

  tar_t output_tar_base = __dtu_c_movsr2targ(output_base);
  tar_t output_tar_off = __dtu_c_movsr2tari(output_off, output_tar_base);

  tar_t output_read_tar_base = __dtu_c_movsr2targ(output_read_base);
  tar_t output_read_tar_off =
      __dtu_c_movsr2tari(output_read_off, output_read_tar_base);

  tar_t output_index_tar_base = __dtu_c_movsr2targ(output_index_base);
  tar_t output_index_tar_off = __dtu_c_movsr2tari(output_index_off,
                                                  output_index_tar_base);

  tar_t output_index_read_tar_base = __dtu_c_movsr2targ(output_index_read_base);
  tar_t output_index_read_tar_off =
      __dtu_c_movsr2tari(output_index_read_off, output_index_read_tar_base);

  for (int i=15; i >= 0; i--) {
    vr_index0 = __dtu_v_movr2vr_lsb(vr_index0, i);
    if (i != 0) {
      vr_index0 = __dtu_v_movsfti_l_b(vr_index0, 4);
    }
  }

  int smr_col = smr_base;
#pragma clang loop unroll(disable)
  for (int col_global_index = 0; col_global_index < col_global_blocks;
       col_global_index++) {
#pragma clang loop unroll(disable)
    for (int col_local_index = 0; col_local_index < col_local_blocks;
         col_local_index++) {
      tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
      tar_t order_vector_tar_off =
          __dtu_c_movsr2tari(order_vector_off, order_vector_tar_base);

      tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
      tar_t input_tar_off = __dtu_c_movsr2tari(input_off, input_tar_base);

      if (vr_base == 0) {
        vacc0 = __dtu_l_vclr_va();
        vacc1 = __dtu_l_vclr_va();
        vacc2 = __dtu_l_vclr_va();
        vacc3 = __dtu_l_vclr_va();
        vacc4 = __dtu_l_vclr_va();
        vacc5 = __dtu_l_vclr_va();
        vacc6 = __dtu_l_vclr_va();
        vacc7 = __dtu_l_vclr_va();
      } else {
        vacc0 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc1 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc2 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc3 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc4 = __dtu_l_tvlda(output_index_read_tar_base,
                              output_index_read_tar_off);
        vacc5 = __dtu_l_tvlda(output_index_read_tar_base,
                              output_index_read_tar_off);
        vacc6 = __dtu_l_tvlda(output_index_read_tar_base,
                              output_index_read_tar_off);
        vacc7 = __dtu_l_tvlda(output_index_read_tar_base,
                              output_index_read_tar_off);
      }

      int vr_pos = split_base;
#pragma clang loop unroll(disable)
      for (int input_index = 0; input_index < input_blocks; input_index++) {
        vr_order_vector[0] =
            __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
        vr_order_vector[1] =
            __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
        vr_order_vector[2] =
            __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
        vr_order_vector[3] =
            __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
        vr_input[0] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
        vr_input[1] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
        vr_input[2] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
        vr_input[3] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
        for (int i = 0; i < BLOCK_SIZE / VR_SIZE; i++) {
          v64i8 vr_pos_ = __dtu_v_movr2vr_dup(vr_pos);
          vr_index[i] = __dtu_v_vadd_a_u32(vr_index0, vr_pos_);
          vr_pos += 16;

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col, 0);
          vacc0 = __dtu_m_vmm_mode3_f_vs0(vacc0, vr_input[i], smr0);
          vacc4 = __dtu_m_vmm_mode3_f_vs0(vacc4, vr_index[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 16, 0);
          vacc1 = __dtu_m_vmm_mode3_f_vs0(vacc1, vr_input[i], smr0);
          vacc5 = __dtu_m_vmm_mode3_f_vs0(vacc5, vr_index[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 32, 0);
          vacc2 = __dtu_m_vmm_mode3_f_vs0(vacc2, vr_input[i], smr0);
          vacc6 = __dtu_m_vmm_mode3_f_vs0(vacc6, vr_index[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 48, 0);
          vacc3 = __dtu_m_vmm_mode3_f_vs0(vacc3, vr_input[i], smr0);
          vacc7 = __dtu_m_vmm_mode3_f_vs0(vacc7, vr_index[i], smr0);
        }
      }

      // store sorted vector to output memory
      __dtu_v_tvsta_w(vacc0, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc1, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc2, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc3, output_tar_base, output_tar_off);

      __dtu_v_tvsta_w(vacc4, output_index_tar_base,
                      output_index_tar_off);
      __dtu_v_tvsta_w(vacc5, output_index_tar_base,
                      output_index_tar_off);
      __dtu_v_tvsta_w(vacc6, output_index_tar_base,
                      output_index_tar_off);
      __dtu_v_tvsta_w(vacc7, output_index_tar_base,
                      output_index_tar_off);
      smr_col += 64;
    }
  }
#else
 constexpr int QACC_LENGTH = VR_SIZE * 4;
  int num_loops = CeilDiv(input_ori_sizes, QACC_LENGTH * 2);  // 2 VPTs
  int BPE = 4;

  int da_step = TAR32(1, 1);
  int da_jump = TAR32(3, 3);
  int qa_step = TAR32(2, 2);
  int input_base = TAR32(input_addr >> 7, (input_addr >> 7) + 2);
  tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
  tar_t input_tar_step = __dtu_c_movsr2tari(da_step, input_tar_base);
  tar_t input_tar_jump = __dtu_c_movsr2tari(da_jump, input_tar_base);

  int order_vector_base =
      TAR32(order_vector_addr >> 8, (order_vector_addr >> 8) + 1);
  tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
  tar_t order_vector_tar_step =
      __dtu_c_movsr2tari(qa_step, order_vector_tar_base);

  char* output_val_addr = reinterpret_cast<char*>(output_addr);
  char* output_idx_addr = reinterpret_cast<char*>(output_index_addr);
  va16u32x4 qacc_bpe = __dtu_l_movr2qa_u32(BPE);
  va16u32x4 qacc_col_start = __dtu_l_movr2qa_u32(smr_base);
  va16u32x4 qacc_col_end = __dtu_l_movr2qa_u32(smr_base + col_ori_sizes);

  int input_pos = split_base;
#pragma clang loop unroll(enable)
  // main loop, fill elements to current block according to order_vector
  for (int input_index = 0; input_index < num_loops; input_index++) {
    va16u32x4 order_vector =
        __dtu_l_tvldqa_u32_qa(order_vector_tar_base, order_vector_tar_step);
    vbool64_t mask_ge = __dtu_m_mop_msle_u32_qa(qacc_col_start, order_vector);
    vbool64_t mask_lt = __dtu_m_mop_mslt_u32_qa(order_vector, qacc_col_end);
    vbool64_t mask = __dtu_m_mop_mand_m64(mask_ge, mask_lt);

    order_vector = __dtu_m_mop_sub_u32_qa(order_vector, qacc_col_start);
    order_vector = __dtu_m_mop_mul_u32_qa(order_vector, qacc_bpe);
    va16u32x2 order_vector_lo = __dtu_extractqa2da_u32(order_vector, 0);
    va16u32x2 order_vector_hi = __dtu_extractqa2da_u32(order_vector, 1);

    va16f32x2 input_lo = __dtu_l_tvldqa_f32_da(input_tar_base, input_tar_step);
    va16f32x2 input_hi = __dtu_l_tvldqa_f32_da(input_tar_base, input_tar_jump);

    __dtu_m_vstxda_dual_f32_vs0_vm(input_lo, output_val_addr,
                                   order_vector_lo, mask);
    __dtu_m_vstxda_dual_f32_vs1_vm(input_hi, output_val_addr,
                                   order_vector_hi, mask);

    va16u32x4 index = __dtu_m_mid_m0_u32(input_pos);
    va16u32x2 index_lo = __dtu_extractqa2da_u32(index, 0);
    va16u32x2 index_hi = __dtu_extractqa2da_u32(index, 1);

    __dtu_m_vstxda_dual_u32_vs0_vm(index_lo, output_idx_addr,
                                   order_vector_lo, mask);
    __dtu_m_vstxda_dual_u32_vs1_vm(index_hi, output_idx_addr,
                                   order_vector_hi, mask);

    input_pos += QACC_LENGTH * 2;
  }
#endif
}

extern "C" void sort_stage1_fp32(int input_addr, int sort_addr,
                                 int order_vector_addr,
                                 int smr_off_buf_addr,
                                 int input_ori_sizes,
                                 int sort_ori_sizes, int vr_base,
                                 int smr_base) {
  // Clear VAB status
  setVabBase(0x0);

  // input
  int ci_vec_num = 1;
  int input_base = TAR32(ADDR2VEC(input_addr), ADDR2VEC(input_addr));
  int input_off = TAR32(1, 1);

  int order_vector_read_base =
      TAR32(ADDR2VEC(order_vector_addr), ADDR2VEC(order_vector_addr) + 4);
  int order_vector_read_off1 = TAR32(1, 1);
  int order_vector_read_off5 = TAR32(5, 5);

  int order_vector_write_base =
      TAR32(ADDR2VEC(order_vector_addr), ADDR2VEC(order_vector_addr) + 4);
  int order_vector_write_off1 = TAR32(1, 1);
  int order_vector_write_off5 = TAR32(5, 5);

  int sort_base = TAR32(ADDR2VEC(sort_addr), ADDR2VEC(sort_addr) + 4);
  int sort_off1 = TAR32(1, 1);
  int sort_off5 = TAR32(5, 5);

  int smr_off_buf = TAR32(ADDR2VEC(smr_off_buf_addr),
                                   ADDR2VEC(smr_off_buf_addr) + 1);
  int smr_off_buf_off = TAR32(0, 0);

  va16f32 vacc0, vacc1, vacc2, vacc3, vacc4, vacc5, vacc6, vacc7;
  va16f32x4 qacc0, qacc1, qacc2, qacc3, qacc4, qacc5, qacc6, qacc7,
            qacc8, qacc9, qacc10, qacc11, qacc12, qacc13, qacc14, qacc15;
  smr_t smr0;
  v64i8 vr_input[8];
  v64i8 vr_sort_vector[4];
  v64i8 vr_s[8];

  __dtu_c_movsr2naccovr(0x4);

  int input_blocks = (input_ori_sizes + BLOCK_SIZE_2 - 1) / BLOCK_SIZE_2;
  int sort_sizes = (sort_ori_sizes + BLOCK_SIZE_2 - 1) / BLOCK_SIZE_2
                   * BLOCK_SIZE_2;

  int sort_global_blocks = (sort_sizes + MAX_NUM_VACC * VR_SIZE - 1) /
                           (MAX_NUM_VACC * VR_SIZE);
  int sort_global_sizes = sort_global_blocks * (MAX_NUM_VACC * VR_SIZE);

  int sort_local_sizes =
      sort_sizes < MAX_NUM_VACC * VR_SIZE ? sort_sizes : MAX_NUM_VACC * VR_SIZE;
  int sort_local_blocks = sort_local_sizes / BLOCK_SIZE_2;

  tar_t sort_tar_base = __dtu_c_movsr2targ(sort_base);
  tar_t sort_tar_off1 = __dtu_c_movsr2tari(sort_off1, sort_tar_base);
  tar_t sort_tar_off5 = __dtu_c_movsr2tari(sort_off5, sort_tar_base);

  tar_t order_vector_read_tar_base = __dtu_c_movsr2targ(order_vector_read_base);
  tar_t order_vector_read_tar_off1 =
      __dtu_c_movsr2tari(order_vector_read_off1, order_vector_read_tar_base);
  tar_t order_vector_read_tar_off5 =
      __dtu_c_movsr2tari(order_vector_read_off5, order_vector_read_tar_base);

  tar_t order_vector_write_tar_base =
      __dtu_c_movsr2targ(order_vector_write_base);
  tar_t order_vector_write_tar_off1 =
      __dtu_c_movsr2tari(order_vector_write_off1, order_vector_write_tar_base);
  tar_t order_vector_write_tar_off5 =
      __dtu_c_movsr2tari(order_vector_write_off5, order_vector_write_tar_base);

  tar_t smr_off_buf_tar_base =
      __dtu_c_movsr2targ(smr_off_buf);
  tar_t smr_off_buf_tar_off =
      __dtu_c_movsr2tari(smr_off_buf_off, smr_off_buf_tar_base);

  v64i8 vr_zero;
  vr_zero = __dtu_v_vclr_vr();
  //init smr_off_buf: 0 && 64
  __dtu_c_tvst_itar(vr_zero, smr_off_buf_tar_base, smr_off_buf_tar_off);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x40), 0);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x40), 4);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x40), 8);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x40), 12);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x50), 0);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x50), 4);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x50), 8);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x50), 12);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x60), 0);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x60), 4);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x60), 8);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x60), 12);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x70), 0);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x70), 4);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x70), 8);
  __dtu_st_w(0x40, reinterpret_cast<char*>(smr_off_buf_addr + 0x70), 12);

  v64i8 vr_smr_off;
  vr_smr_off = __dtu_s_tvld_itar(smr_off_buf_tar_base, smr_off_buf_tar_off);

  v64i8 vr_smr_base, vr_smr_128;
  vr_smr_128 = __dtu_v_vclr_vr();
  vr_smr_128 = __dtu_v_movr2vr_lsb(vr_smr_128, 128);
  vr_smr_128 = __dtu_v_movsfti_l_b(vr_smr_128, 4);

  vr_smr_base = __dtu_v_vclr_vr();
  vr_smr_base = __dtu_v_movr2vr_lsb(vr_smr_base, smr_base);
  vr_smr_base = __dtu_v_movsfti_l_b(vr_smr_base, 4);
  vr_smr_base = __dtu_v_vadd_a_u32(vr_smr_base, vr_smr_off);

  // each local blocl deal with 16K data
#pragma clang loop unroll(disable)
  for (int sort_global_index = 0; sort_global_index < sort_global_blocks;
       sort_global_index++) {
#pragma clang loop unroll(disable)
    for (int sort_local_index = 0; sort_local_index < sort_local_blocks;
         sort_local_index++) {
      // reset input tar:  input data from l1 memory
      tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
      tar_t input_tar_off = __dtu_c_movsr2tari(input_off, input_tar_base);

      // load sort vctor, each block deal with 64 data
      // smr size:v4x16, because: vcmpac use VMM.32b.v4.v4x16.v1m4
      vr_sort_vector[0] = __dtu_s_tvld_itar(sort_tar_base, sort_tar_off1);
      smr0 = __dtu_m_ldsmr_mode8_f_row(smr0, vr_sort_vector[0], 0);
      vr_sort_vector[1] = __dtu_s_tvld_itar(sort_tar_base, sort_tar_off1);
      smr0 = __dtu_m_ldsmr_mode8_f_row(smr0, vr_sort_vector[1], 4);
      vr_sort_vector[2] = __dtu_s_tvld_itar(sort_tar_base, sort_tar_off1);
      smr0 = __dtu_m_ldsmr_mode8_f_row(smr0, vr_sort_vector[2], 8);
      vr_sort_vector[3] = __dtu_s_tvld_itar(sort_tar_base, sort_tar_off5);
      smr0 = __dtu_m_ldsmr_mode8_f_row(smr0, vr_sort_vector[3], 12);

      qacc0 = __dtu_l_vclr_qa();
      qacc1 = __dtu_l_vclr_qa();
      qacc2 = __dtu_l_vclr_qa();
      qacc3 = __dtu_l_vclr_qa();
      qacc4 = __dtu_l_vclr_qa();
      qacc5 = __dtu_l_vclr_qa();
      qacc6 = __dtu_l_vclr_qa();
      qacc7 = __dtu_l_vclr_qa();
      qacc8 = __dtu_l_vclr_qa();

      int vr_local_base = vr_base;
      for (int i=0; i < 8; i++) {
        vr_s[i] = vr_smr_base;
      }

#pragma clang loop unroll(disable)
      for (int input_index = 0; input_index < input_blocks; input_index++) {
        vr_s[0] = __dtu_v_movr2vr_lsb(vr_s[0], vr_local_base);
