        v64i8 vr_res[4];
        vr_res[0] = __dtu_s_tvld_itar(order_vector_read_tar_base,
                                 order_vector_read_tar_off1);
        vr_0[0] = __dtu_v_vadd_a_u32(vr_0[0], vr_res[0]);
        vr_res[1] = __dtu_s_tvld_itar(order_vector_read_tar_base,
                                  order_vector_read_tar_off1);
        vr_0[1] = __dtu_v_vadd_a_u32(vr_0[1], vr_res[1]);
        vr_res[2] = __dtu_s_tvld_itar(order_vector_read_tar_base,
                                  order_vector_read_tar_off1);
        vr_0[2] = __dtu_v_vadd_a_u32(vr_0[2], vr_res[2]);
        vr_res[3] = __dtu_s_tvld_itar(order_vector_read_tar_base,
                                  order_vector_read_tar_off5);
        vr_0[3] = __dtu_v_vadd_a_u32(vr_0[3], vr_res[3]);
      }

        __dtu_c_tvst_itar(vr_0[0], order_vector_write_tar_base,
                    order_vector_write_tar_off1);
        __dtu_c_tvst_itar(vr_0[1], order_vector_write_tar_base,
                    order_vector_write_tar_off1);
        __dtu_c_tvst_itar(vr_0[2], order_vector_write_tar_base,
                    order_vector_write_tar_off1);
        __dtu_c_tvst_itar(vr_0[3], order_vector_write_tar_base,
                    order_vector_write_tar_off5);

      vr_smr_base = __dtu_v_vadd_a_u32(vr_smr_base, vr_smr_128);
    }
  }
}

extern "C" void topk_merge_stage2_fp32(int input_addr,
                                 int order_vector_addr,
                                 int output_addr,
                                 int input_ori_sizes, int col_ori_sizes,
                                 int vr_base, int smr_base, int global_size) {
#if __GCU_ARCH__ < 300
  int ci_vec_num = 1;

  int input_base = TAR32(ADDR2VEC(input_addr), ADDR2VEC(input_addr));
  int input_off = TAR32(ci_vec_num, ci_vec_num);

  int order_vector_base =
      TAR32(ADDR2VEC(order_vector_addr), ADDR2VEC(order_vector_addr));
  int order_vector_off = TAR32(ci_vec_num, ci_vec_num);

  int output_base =
      TAR32(ADDR2VEC(output_addr), ADDR2VEC(output_addr));
  int output_off = TAR32(ci_vec_num, ci_vec_num);

  // Clear VAB status
  setVabBase(0x0);

  va16f32 vacc0, vacc1, vacc2, vacc3, vacc4, vacc5, vacc6, vacc7,
          vacc8, vacc9, vacc10, vacc11, vacc12, vacc13, vacc14, vacc15;
  smr_t smr0;
  v64i8 vr_input[4];
  v64i8 vr_order_vector[4];
  v64i8 vr_index[4];
  v64i8 vr_index0, vr_index1;
  v64i8 vr_index_output[4];
  v64i8 vr_output[4];
  int input_blocks = (input_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE;
  int col_sizes = (col_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE * BLOCK_SIZE;

  int col_global_sizes = (col_sizes + MAX_NUM_VACC * VR_SIZE - 1) /
                         (MAX_NUM_VACC * VR_SIZE) * (MAX_NUM_VACC * VR_SIZE);
  int col_global_blocks = col_global_sizes / (MAX_NUM_VACC * VR_SIZE);

  int col_local_sizes = col_ori_sizes < MAX_NUM_VACC * VR_SIZE
                            ? col_ori_sizes
                            : MAX_NUM_VACC * VR_SIZE;
  int col_local_blocks = col_local_sizes / BLOCK_SIZE;
  // set vmm_raw
  __dtu_c_movsr2vmm_raw(0x1);
  __dtu_c_movsr2naccovr(0x1);

  tar_t output_tar_base = __dtu_c_movsr2targ(output_base);
  tar_t output_tar_off = __dtu_c_movsr2tari(output_off, output_tar_base);

  tar_t output_read_tar_base = __dtu_c_movsr2targ(output_base);
  tar_t output_read_tar_off =
      __dtu_c_movsr2tari(output_off, output_read_tar_base);

  int smr_col = smr_base;

  for (int index = 15; index >= 0; index--) {
    auto value = index >= 8 ? 16 : 2 * index;
    vr_index0 = __dtu_v_movr2vr_lsb(vr_index0, value);  // set lowest 32bit
    // left shift 4 byte, no shift for last time
    if (index != 0) {
      vr_index0 = __dtu_v_movsfti_l_b(vr_index0, 4);
    }
  }

  // get value to be sorted
#pragma clang loop unroll(disable)
  for (int col_global_index = 0; col_global_index < col_global_blocks;
       col_global_index++) {
#pragma clang loop unroll(disable)
    for (int col_local_index = 0; col_local_index < col_local_blocks;
         col_local_index++) {
      tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
      tar_t order_vector_tar_off =
          __dtu_c_movsr2tari(order_vector_off, order_vector_tar_base);

      tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
      tar_t input_tar_off = __dtu_c_movsr2tari(input_off, input_tar_base);

      if (vr_base == 0) {
        vacc0 = __dtu_l_vclr_va();
        vacc1 = __dtu_l_vclr_va();
        vacc2 = __dtu_l_vclr_va();
        vacc3 = __dtu_l_vclr_va();
      } else {
        vacc0 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc1 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc2 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc3 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
      }

#pragma clang loop unroll(disable)
      for (int input_index = 0; input_index < input_blocks; input_index++) {
          vr_order_vector[0] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[1] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[2] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[3] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_input[0] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[1] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[2] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[3] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);

        for (int i = 0; i < BLOCK_SIZE / VR_SIZE; i++) {
          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                              smr_col, 0);
          vacc0 = __dtu_m_vmm_mode3_f_vs0(vacc0, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                              smr_col + 16, 0);
          vacc1 = __dtu_m_vmm_mode3_f_vs0(vacc1, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 32, 0);
          vacc2 = __dtu_m_vmm_mode3_f_vs0(vacc2, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 48, 0);
          vacc3 = __dtu_m_vmm_mode3_f_vs0(vacc3, vr_input[i], smr0);
        }
      }

      __dtu_v_tvsta_w(vacc0, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc1, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc2, output_tar_base, output_tar_off);
      __dtu_v_tvsta_w(vacc3, output_tar_base, output_tar_off);

      smr_col += 64;
    }
  }
#else
  constexpr int QACC_LENGTH = VR_SIZE * 4;
  int num_loops = CeilDiv(input_ori_sizes, QACC_LENGTH * 2);  // 2 VPTs

  int BPE = 4;
  int da_step = TAR32(1, 1);
  int da_jump = TAR32(3, 3);
  int qa_step = TAR32(2, 2);
  int input_base = TAR32(input_addr >> 7, (input_addr >> 7) + 2);
  tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
  tar_t input_tar_step = __dtu_c_movsr2tari(da_step, input_tar_base);
  tar_t input_tar_jump = __dtu_c_movsr2tari(da_jump, input_tar_base);

  int order_vector_base =
      TAR32(order_vector_addr >> 8, (order_vector_addr >> 8) + 1);

  tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
  tar_t order_vector_tar_step =
      __dtu_c_movsr2tari(qa_step, order_vector_tar_base);

  char* base_addr = reinterpret_cast<char*>(output_addr);
  va16u32x4 qacc_bpe = __dtu_l_movr2qa_u32(BPE);
  va16u32x4 qacc_col_start = __dtu_l_movr2qa_u32(smr_base);
  va16u32x4 qacc_col_end = __dtu_l_movr2qa_u32(smr_base + col_ori_sizes);

#pragma clang loop unroll(enable)
  // main loop, fill elements to current block according to order_vector
  for (int input_index = 0; input_index < num_loops; input_index++) {
    va16u32x4 order_vector =
        __dtu_l_tvldqa_u32_qa(order_vector_tar_base, order_vector_tar_step);
    vbool64_t mask_ge = __dtu_m_mop_msle_u32_qa(qacc_col_start, order_vector);
    vbool64_t mask_lt = __dtu_m_mop_mslt_u32_qa(order_vector, qacc_col_end);
    vbool64_t mask = __dtu_m_mop_mand_m64(mask_ge, mask_lt);

    order_vector = __dtu_m_mop_sub_u32_qa(order_vector, qacc_col_start);
    order_vector = __dtu_m_mop_mul_u32_qa(order_vector, qacc_bpe);
    va16u32x2 order_vector_lo = __dtu_extractqa2da_u32(order_vector, 0);
    va16u32x2 order_vector_hi = __dtu_extractqa2da_u32(order_vector, 1);

    va16u32x2 input_lo = __dtu_l_tvldqa_u32_da(input_tar_base, input_tar_step);
    va16u32x2 input_hi = __dtu_l_tvldqa_u32_da(input_tar_base, input_tar_jump);

    __dtu_m_vstxda_dual_u32_vs0_vm(input_lo, base_addr, order_vector_lo, mask);
    __dtu_m_vstxda_dual_u32_vs1_vm(input_hi, base_addr, order_vector_hi, mask);
  }
#endif
}

extern "C" void topk_merge_stage2_index(int input_addr,
                                 int order_vector_addr,
                                 int output_addr,
                                 int input_ori_sizes, int col_ori_sizes,
                                 int vr_base, int smr_base, int global_size,
                                 int bpe) {
#if __GCU_ARCH__ < 300
  int ci_vec_num = 1;

  int input_base = TAR32(ADDR2VEC(input_addr), ADDR2VEC(input_addr));
  int input_off = TAR32(ci_vec_num, ci_vec_num);

  int order_vector_base =
      TAR32(ADDR2VEC(order_vector_addr), ADDR2VEC(order_vector_addr));
  int order_vector_off = TAR32(ci_vec_num, ci_vec_num);

  int output_base =
      TAR32(ADDR2VEC(output_addr), ADDR2VEC(output_addr));
  int output_off = TAR32(ci_vec_num, ci_vec_num);

  // Clear VAB status
  setVabBase(0x0);

  va16f32 vacc0, vacc1, vacc2, vacc3, vacc4, vacc5, vacc6, vacc7,
          vacc8, vacc9, vacc10, vacc11, vacc12, vacc13, vacc14, vacc15;
  smr_t smr0;
  v64i8 vr_input[4];
  v64i8 vr_order_vector[4];
  v64i8 vr_index[4];
  v64i8 vr_index0, vr_index1;
  v64i8 vr_index_output[4];
  v64i8 vr_output[4];
  int input_blocks = (input_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE;
  int col_sizes = (col_ori_sizes + BLOCK_SIZE - 1) / BLOCK_SIZE * BLOCK_SIZE;

  int col_global_sizes = (col_sizes + MAX_NUM_VACC * VR_SIZE - 1) /
                         (MAX_NUM_VACC * VR_SIZE) * (MAX_NUM_VACC * VR_SIZE);
  int col_global_blocks = col_global_sizes / (MAX_NUM_VACC * VR_SIZE);

  int col_local_sizes = col_ori_sizes < MAX_NUM_VACC * VR_SIZE
                            ? col_ori_sizes
                            : MAX_NUM_VACC * VR_SIZE;
  int col_local_blocks = col_local_sizes / BLOCK_SIZE;
  // set vmm_raw
  __dtu_c_movsr2vmm_raw(0x1);
  __dtu_c_movsr2naccovr(0x1);

  tar_t output_tar_base = __dtu_c_movsr2targ(output_base);
  tar_t output_tar_off = __dtu_c_movsr2tari(output_off, output_tar_base);

  tar_t output_read_tar_base = __dtu_c_movsr2targ(output_base);
  tar_t output_read_tar_off =
      __dtu_c_movsr2tari(output_off, output_read_tar_base);

  int smr_col = smr_base;

  for (int index = 15; index >= 0; index--) {
    auto value = index >= 8 ? 16 : 2 * index;
    vr_index0 = __dtu_v_movr2vr_lsb(vr_index0, value);  // set lowest 32bit
    // left shift 4 byte, no shift for last time
    if (index != 0) {
      vr_index0 = __dtu_v_movsfti_l_b(vr_index0, 4);
    }
  }

  // get value to be sorted
#pragma clang loop unroll(disable)
  for (int col_global_index = 0; col_global_index < col_global_blocks;
       col_global_index++) {
#pragma clang loop unroll(disable)
    for (int col_local_index = 0; col_local_index < col_local_blocks;
         col_local_index++) {
      tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
      tar_t order_vector_tar_off =
          __dtu_c_movsr2tari(order_vector_off, order_vector_tar_base);

      tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
      tar_t input_tar_off = __dtu_c_movsr2tari(input_off, input_tar_base);

      if (vr_base == 0) {
        vacc0 = __dtu_l_vclr_va();
        vacc1 = __dtu_l_vclr_va();
        vacc2 = __dtu_l_vclr_va();
        vacc3 = __dtu_l_vclr_va();
      } else {
        vacc0 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc1 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc2 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
        vacc3 = __dtu_l_tvlda(output_read_tar_base, output_read_tar_off);
      }

#pragma clang loop unroll(disable)
      for (int input_index = 0; input_index < input_blocks; input_index++) {
          vr_order_vector[0] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[1] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[2] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_order_vector[3] =
              __dtu_s_tvld_itar(order_vector_tar_base, order_vector_tar_off);
          vr_input[0] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[1] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[2] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);
          vr_input[3] = __dtu_v_tvld_itar(input_tar_base, input_tar_off);

        for (int i = 0; i < BLOCK_SIZE / VR_SIZE; i++) {
          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                              smr_col, 0);
          vacc0 = __dtu_m_vmm_mode3_f_vs0(vacc0, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                              smr_col + 16, 0);
          vacc1 = __dtu_m_vmm_mode3_f_vs0(vacc1, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 32, 0);
          vacc2 = __dtu_m_vmm_mode3_f_vs0(vacc2, vr_input[i], smr0);

          smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_order_vector[i],
                                               smr_col + 48, 0);
          vacc3 = __dtu_m_vmm_mode3_f_vs0(vacc3, vr_input[i], smr0);
        }
      }

      // store sorted vector to output memory
      if (bpe == 4) {
        __dtu_v_tvsta_w(vacc0, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc1, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc2, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc3, output_tar_base, output_tar_off);
      } else {
        vr_index_output[0] = __dtu_l_movva2vr_w(vacc0);
        vr_index_output[1] = __dtu_l_movva2vr_w(vacc1);
        vr_index_output[2] = __dtu_l_movva2vr_w(vacc2);
        vr_index_output[3] = __dtu_l_movva2vr_w(vacc3);

        vacc4  = __dtu_l_vclr_va();
        vacc5  = __dtu_l_vclr_va();
        vacc6 = __dtu_l_vclr_va();
        vacc7 = __dtu_l_vclr_va();
        vacc8 = __dtu_l_vclr_va();
        vacc9 = __dtu_l_vclr_va();
        vacc10 = __dtu_l_vclr_va();
        vacc11 = __dtu_l_vclr_va();

        smr0 = __dtu_m_ldsmr_mode3_f_row_o2m(smr0, vr_index0, 0, 0);

        vacc4 = __dtu_m_vmm_mode3_f_vs0(vacc4, vr_index_output[0], smr0);
        vr_index_output[0] = __dtu_v_movsfti_r_qw(vr_index_output[0], 2);
        vacc5 = __dtu_m_vmm_mode3_f_vs0(vacc5, vr_index_output[0], smr0);
        vacc6 = __dtu_m_vmm_mode3_f_vs0(vacc6, vr_index_output[1], smr0);
        vr_index_output[1] = __dtu_v_movsfti_r_qw(vr_index_output[1], 2);
        vacc7 = __dtu_m_vmm_mode3_f_vs0(vacc7, vr_index_output[1], smr0);
        vacc8 = __dtu_m_vmm_mode3_f_vs0(vacc8, vr_index_output[2], smr0);
        vr_index_output[2] = __dtu_v_movsfti_r_qw(vr_index_output[2], 2);
        vacc9 = __dtu_m_vmm_mode3_f_vs0(vacc9, vr_index_output[2], smr0);
        vacc10 = __dtu_m_vmm_mode3_f_vs0(vacc10, vr_index_output[3], smr0);
        vr_index_output[3] = __dtu_v_movsfti_r_qw(vr_index_output[3], 2);
        vacc11 = __dtu_m_vmm_mode3_f_vs0(vacc11, vr_index_output[3], smr0);


        __dtu_v_tvsta_w(vacc4, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc5, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc6, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc7, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc8, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc9, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc10, output_tar_base, output_tar_off);
        __dtu_v_tvsta_w(vacc11, output_tar_base, output_tar_off);
      }

      smr_col += 64;
    }
  }
#else
  constexpr int QACC_LENGTH = VR_SIZE * 4;
  int num_loops = CeilDiv(input_ori_sizes, QACC_LENGTH * 2);  // 2 VPTs
  int BPE = 4;
  int da_step = TAR32(1, 1);
  int da_jump = TAR32(3, 3);
  int qa_step = TAR32(2, 2);
  int input_base = TAR32(input_addr >> 7, (input_addr >> 7) + 2);
  tar_t input_tar_base = __dtu_c_movsr2targ(input_base);
  tar_t input_tar_step = __dtu_c_movsr2tari(da_step, input_tar_base);
  tar_t input_tar_jump = __dtu_c_movsr2tari(da_jump, input_tar_base);

  int order_vector_base =
      TAR32(order_vector_addr >> 8, (order_vector_addr >> 8) + 1);

  tar_t order_vector_tar_base = __dtu_c_movsr2targ(order_vector_base);
  tar_t order_vector_tar_step =
      __dtu_c_movsr2tari(qa_step, order_vector_tar_base);

  char* base_addr = reinterpret_cast<char*>(output_addr);
  va16u32x4 qacc_bpe = __dtu_l_movr2qa_u32(BPE);
  va16u32x4 qacc_col_start = __dtu_l_movr2qa_u32(smr_base);
  va16u32x4 qacc_col_end = __dtu_l_movr2qa_u32(smr_base + col_ori_sizes);

#pragma clang loop unroll(enable)
  // main loop, fill elements to current block according to order_vector
  for (int input_index = 0; input_index < num_loops; input_index++) {
    va16u32x4 order_vector =
        __dtu_l_tvldqa_u32_qa(order_vector_tar_base, order_vector_tar_step);
    vbool64_t mask_ge = __dtu_m_mop_msle_u32_qa(qacc_col_start, order_vector);
    vbool64_t mask_lt = __dtu_m_mop_mslt_u32_qa(order_vector, qacc_col_end);
    vbool64_t mask = __dtu_m_mop_mand_m64(mask_ge, mask_lt);

    order_vector = __dtu_m_mop_sub_u32_qa(order_vector, qacc_col_start);
    order_vector = __dtu_m_mop_mul_u32_qa(order_vector, qacc_bpe);
    va16u32x2 order_vector_lo = __dtu_extractqa2da_u32(order_vector, 0);
    va16u32x2 order_vector_hi = __dtu_extractqa2da_u32(order_vector, 1);

    va16u32x2 input_lo = __dtu_l_tvldqa_u32_da(input_tar_base, input_tar_step);
    va16u32x2 input_hi = __dtu_l_tvldqa_u32_da(input_tar_base, input_tar_jump);

    __dtu_m_vstxda_dual_u32_vs0_vm(input_lo, base_addr, order_vector_lo, mask);
    __dtu_m_vstxda_dual_u32_vs1_vm(input_hi, base_addr, order_vector_hi, mask);
  }
#endif
}

} /// end of kernel decl


__co__ void topk(
    f32 [A, B, C] input,
    s32 k,
    s32 axis,
    f32 alpha,
    f32 beta,
    s32 output_value,
    s32 output_index
) { /// device program
  // f32[input.span(0), input.span(1)] output; // use same shape as input

  return;
}


int main() { /// host program
  choreo::f32 a[512][1024]; // unified abstraction in choreo type system, no need for C++ vectors/uint8_t, no factor Data/Mem types, we handles the bridge choreo::f32 b[512][512] = {0};

  auto input_data = choreo::make_spanview<2, choreo::f32>((float*)a, {512, 1024});
  input_data.fill_random(-1.0, 1.0);

  auto start = std::chrono::high_resolution_clock::now();

  topk(input_data);

  auto end = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);

  std::cout << res.shape()[0] << std::endl;
  std::cout << res.shape()[1] << std::endl;

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j) {
        std::cout << "i: " << i << ", j: " << j << "\n";
        std::cout << "res: " << res[i][j] << "\n";
        float ref = input_data[i][j] > 0? input_data[i][j] : 0;

        std::cout << "ref: " << ref << std::endl;
        assert(ref == res[i][j]);
      }
  std::cout << "Test Passed\n" << std::endl;
  std::cout << "Function execution time: " << duration.count() << " microseconds" << std::endl;
}
