#include "choreo.h"

// extern "C" void kernel(int * lhs, int * rhs, int * out, int m, int k, int n) {
__cok__ { /// kernel program
extern "C" void kernel(int * lhs, int * rhs, int * out) {
  int m = 8;
  int k = 1024;
  int n = 128;
  for (int i = 0; i < m; ++i) {
    for (int j = 0; j < n; ++j) {
      for (int z = 0; z < k; ++z) {
        out[i*n + j] += lhs[i*k+z]*rhs[z*n+j];
        // out[i*n + j] = lhs[i*k+z] + rhs[z*n+j];
      }
    }
  }
}
} /// end of kernel decl

__co__ auto matmul(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32 [M, N] output;

  // tiled block sizes
  int m = 8;
  int n = 128;
  int k = 1024;

  parallel p by 1 {
    with tilings = {m_tile, n_tile, k_tile} in [M/m, N/n, K/k] {
      foreach m_tile, n_tile {
        local s32 [m, n] buffer {0};
        foreach k_tile {
          lf = dma.copy lhs.chunkat(m_tile, k_tile) => local;
          rf = dma.copy rhs.chunkat(k_tile, n_tile) => local;

          call kernel(lf.data, rf.data, buffer);

          dma.copy buffer => output.chunkat(m_tile, n_tile);
        }
      }
    }
  }
  return output;
}

int main() { /// host program
  choreo::s32 a[512][1024] = {0};
  choreo::s32 b[1024][1024] = {0};
  std::fill_n(&a[0][0], sizeof(a) / sizeof(a[0][0]), 1);
  std::fill_n(&b[0][0], sizeof(b) / sizeof(b[0][0]), 1);
  auto lhs_data = choreo::make_spanview<2, choreo::s32>((int*)a, {512, 1024});
  auto rhs_data = choreo::make_spanview<2, choreo::s32>((int*)b, {1024, 1024});

  auto start = std::chrono::high_resolution_clock::now();

  auto res = matmul(lhs_data, rhs_data);

  auto end = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);

  std::cout << "result in a shape: [" << res.shape() << "]" << std::endl;

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j) {
        int ref = 0;
        for (size_t k = 0; k < lhs_data.shape()[1]; ++k) {
          ref += a[i][k]*b[k][j];
        }
        if (ref != res[i][j]) {
          std::cout << "i: " << i << ", j: " << j << "\n";
          std::cout << "res: " << res[i][j] << "\n";
          std::cout << "ref: " << ref << std::endl;
          assert(ref == res[i][j]);
        }
      }
  std::cout << "Test Passed\n" << std::endl;
  std::cout << "Function execution time: " << duration.count() << " microseconds" << std::endl;
}
