// cse/decompress_emb_vec.co - Embedding vector decompress function

// Use constant definitions
#include "choreo.h"
#define LEN 1000
#define EMB_VEC_SIZE 64

__cok__ {
__co_device__ void decompress_kernel(float* dst_table, float* src_table, unsigned int* index) {
  for (int i = 0; i < LEN; ++i)
    for (int j = 0; j < EMB_VEC_SIZE; ++j) {
        unsigned int idx_element = index[i];
        dst_table[i * EMB_VEC_SIZE + j] = src_table[idx_element * EMB_VEC_SIZE + j];
    }
}

// Device function with boundary check
__co_device__ void decompress_kernel_with_bounds(float* dst_table, float* src_table, unsigned int* index, int block_size, int tDim) {
  int start_idx = (blockIdx.x * tDim + threadIdx.x) * block_size;
  int end_idx = start_idx + block_size;

  for (int i = start_idx; i < end_idx; ++i) {
    if (i < LEN) {
      unsigned int src_idx = index[i];
      for (int j = 0; j < EMB_VEC_SIZE; ++j) {
        dst_table[(i - start_idx) * EMB_VEC_SIZE + j] = src_table[src_idx * EMB_VEC_SIZE + j];
      }
    }
  }
  __syncthreads();
}

}

__co__ void decompress_emb_vec(f32 [LEN, EMB_VEC_SIZE] src_emb_vec, u32 [LEN] src_index, f32 [LEN, EMB_VEC_SIZE] dst_emb_vec) {
  parallel {p, q} by [1, 1] {
    local f32 [LEN/#p/#q, EMB_VEC_SIZE] local_emb_vec_dst;
    local f32 [LEN/#p/#q, EMB_VEC_SIZE] local_emb_vec_src;
    local u32 [LEN/#p/#q] index;
    dma.copy dst_emb_vec.chunkat(p#q, _) => local_emb_vec_dst;
    dma.copy src_emb_vec.chunkat(p#q, _) => local_emb_vec_src;
    dma.copy src_index.chunkat(p#q) => index;
    call decompress_kernel(local_emb_vec_dst, local_emb_vec_src, index);
    dma.copy local_emb_vec_dst => dst_emb_vec.chunkat(p#q, _);
  }
}

// Optimized version - fully utilize 1 cluster and 10 threads of GCU
__co__ void decompress_emb_vec_optimized(f32 [LEN, EMB_VEC_SIZE] src_emb_vec, u32 [LEN] src_index, f32 [LEN, EMB_VEC_SIZE] dst_emb_vec) {
  parallel p by 2 { // launch 1 cluster
    parallel q by 10 { // launch 10 sips
      // Calculate the block size for each thread
      int block_size = LEN / #p / #q;
      
      // Allocate local storage for each thread
      local f32[block_size, EMB_VEC_SIZE] local_emb_vec_dst;
      local f32[LEN, EMB_VEC_SIZE] local_emb_vec_src;
      local u32[LEN] local_index;
      
      // Copy data from global memory to local
      dma.copy dst_emb_vec.chunkat(p#q, _) => local_emb_vec_dst;
      dma.copy src_emb_vec => local_emb_vec_src;
      dma.copy src_index => local_index;
      
      call decompress_kernel_with_bounds(local_emb_vec_dst, local_emb_vec_src, local_index, block_size, #q);
      
      // Write back the result to global memory
      dma.copy local_emb_vec_dst => dst_emb_vec.chunkat(p#q, _);
    }
  }
}

