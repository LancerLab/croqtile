// cse/fill_default_emb_vec_basic.co - 默认值填充函数（choreo版本）- 未优化版本

// 使用常量定义
#include "choreo.h"
#define LEN 1000
#define EMB_VEC_SIZE 64
#define DEFAULT_VALUE 0.5f
#
__cok__ {

__co_device__ void fill_default(float* table, unsigned int* index) {
  for (int i = 0; i < LEN; ++i)
    for (int j = 0; j < EMB_VEC_SIZE; ++j) {
        unsigned int idx_element = index[i];
        table[idx_element * EMB_VEC_SIZE + j] = DEFAULT_VALUE;
    }
}

// 带边界检查的设备函数
__co_device__ void fill_default_with_bounds(float* output, unsigned int* index, int block_size, int bDim, int tDim) {
  int start_idx = (blockIdx.x * tDim + threadIdx.x) * block_size;
  int end_idx = start_idx + block_size;

  // if (blockIdx.x == 1 && threadIdx.x == 1) printf("blockDim.x, threadDim.x {%d, %d}\n", blockDim.x, threadDim.x);
  // if (blockIdx.x == 1 && threadIdx.x == 1) printf("kenrel {%d, %d}\n", blockIdx.x, threadIdx.x);
  // if (blockIdx.x == 1 && threadIdx.x == 1) printf("valid range = {%d, %d}\n", start_idx, end_idx);
  for (int i = 0; i < LEN; ++i) {
    unsigned int dst_idx = index[i];
    // if (blockIdx.x == 1 && threadIdx.x == 1) printf("i = %d; idx = %d\n", i, dst_idx);
    // if (blockIdx.x == 1 && threadIdx.x == 1) printf("hit or not = %s\n", ((dst_idx >= start_idx && dst_idx < end_idx) ? "true" : "false"));
    // 检查索引是否在当前线程负责范围内
    if (dst_idx >= start_idx && dst_idx < end_idx) {
      // 转换为局部索引
      int local_dst_idx = dst_idx - start_idx;
      // 使用循环展开提高性能
      for (int j = 0; j < EMB_VEC_SIZE; ++j) {
        output[local_dst_idx * EMB_VEC_SIZE + j] = DEFAULT_VALUE;
      }
    }
  }
  __syncthreads();
}

}

// 实现fill_default_emb_vec函数 - 未优化版本
__co__ void fill_default_emb_vec(u32[LEN] missing_index, f32[LEN, EMB_VEC_SIZE] output_emb_vec) {

  parallel p by 1 {
    parallel q by 1 {
      local f32[LEN/#p/#q, EMB_VEC_SIZE] local_emb_vec;
      local u32[LEN] index;
      dma.copy output_emb_vec.chunkat(p#q, _) => local_emb_vec;
      dma.copy missing_index.chunkat(p#q) => index;
    //   foreach {i, j} in [LEN/#p/#q, EMB_VEC_SIZE] {
    //       dst_emb_vec = missing_index.at(i);
    //       local_emb_vec.at(dst_emb_vec, j) = 0.5f;
    //   }
    //   call fill_default(local_emb_vec, index);
      dma.copy local_emb_vec => output_emb_vec.chunkat(p#q, _);
    }
  }
}

