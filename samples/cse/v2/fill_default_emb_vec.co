// cse/v2/fill_default_emb_vec.co - Default value fill function (choreo version, v2, fine-grained at semantics)

#include "choreo.h"
#include <climits>
#define DEFAULT_VALUE 0.5f

// ================== Choreo kernel implementation ==================
// Kernel: fill_default_emb_vec_direct
__co__ void fill_default_emb_vec_direct(u32[DYN_DIM] missing_index, global f32[??, EMB_VEC_SIZE] output_emb_vec) {
  parallel p by 1 {
    parallel q by 1 {
      foreach {idx} in [DYN_DIM / #p / #q] {
        local f32[1, EMB_VEC_SIZE] local_emb_vec;
        local u32[1] index;
        dma.copy missing_index.subspan(1).at(p#q#idx) => index;
        dma.copy output_emb_vec.subspan(1, EMB_VEC_SIZE).at(index.at(0), _) => local_emb_vec;
        foreach {j} in [EMB_VEC_SIZE] {
          local_emb_vec.at(0, j) = DEFAULT_VALUE;
        }
        dma.copy local_emb_vec => output_emb_vec.subspan(1, EMB_VEC_SIZE).at(index.at(0), _);
      }
    }
  }
}

// ================== CPU reference implementation ==================
#include <stdint.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void fill_default_emb_vec_cpu(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    for (size_t idx = 0; idx < (len * emb_vec_size); idx++) {
        size_t src_emb_vec = idx / emb_vec_size;
        size_t dst_emb_vec = missing_index[src_emb_vec];
        size_t dst_float = idx % emb_vec_size;
        output_emb_vec[dst_emb_vec * emb_vec_size + dst_float] = default_emb_vec;
    }
}

void fill_default_emb_vec_cpu_optimized(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    for (size_t i = 0; i < len; i++) {
        size_t dst_emb_vec = missing_index[i];
        float* dst_ptr = output_emb_vec + dst_emb_vec * emb_vec_size;
        size_t j = 0;
        for (; j + 3 < emb_vec_size; j += 4) {
            dst_ptr[j] = default_emb_vec;
            dst_ptr[j + 1] = default_emb_vec;
            dst_ptr[j + 2] = default_emb_vec;
            dst_ptr[j + 3] = default_emb_vec;
        }
        for (; j < emb_vec_size; j++) {
            dst_ptr[j] = default_emb_vec;
        }
    }
}

void fill_default_emb_vec_cpu_advanced(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    if (emb_vec_size >= 8) {
        float* template_vec = (float*)malloc(emb_vec_size * sizeof(float));
        for (size_t j = 0; j < emb_vec_size; j++) {
            template_vec[j] = default_emb_vec;
        }
        for (size_t i = 0; i < len; i++) {
            size_t dst_emb_vec = missing_index[i];
            float* dst_ptr = output_emb_vec + dst_emb_vec * emb_vec_size;
            memcpy(dst_ptr, template_vec, emb_vec_size * sizeof(float));
        }
        free(template_vec);
    } else {
        fill_default_emb_vec_cpu_optimized(output_emb_vec, default_emb_vec, missing_index, len, emb_vec_size);
    }
}

// ================== main test function ==================
int main() {
    // #define LEN 1000
    // #define EMB_VEC_SIZE 64
    const int LEN = 1000;
    const int EMB_VEC_SIZE = 64;
    float output_choreo[LEN][EMB_VEC_SIZE] = {0};
    float output_cpu[LEN][EMB_VEC_SIZE] = {0};
    float output_opt[LEN][EMB_VEC_SIZE] = {0};
    float output_adv[LEN][EMB_VEC_SIZE] = {0};
    unsigned int missing_index[LEN];
    for (int i = 0; i < LEN; ++i) missing_index[i] = rand() % LEN;

    fill_default_emb_vec_cpu(&output_cpu[0][0], DEFAULT_VALUE, missing_index, LEN, EMB_VEC_SIZE);
    fill_default_emb_vec_cpu_optimized(&output_opt[0][0], DEFAULT_VALUE, missing_index, LEN, EMB_VEC_SIZE);
    fill_default_emb_vec_cpu_advanced(&output_adv[0][0], DEFAULT_VALUE, missing_index, LEN, EMB_VEC_SIZE);

    // Allocate device/global buffer for output_choreo
    float * output_choreo__device = nullptr;
    choreo::abend_true(topsMalloc(&output_choreo__device, ((LEN) * (64ULL)) * 4));
    choreo::abend_true(topsMemcpy(output_choreo__device, output_choreo, ((LEN) * (64ULL)) * 4, topsMemcpyHostToDevice));

    auto missing_index_view = choreo::make_spanview<1, choreo::u32>((unsigned int*)missing_index, {LEN});
    auto output_choreo_view = choreo::make_spanview<2, choreo::f32>((float*)output_choreo__device, {choreo::__inf__, EMB_VEC_SIZE});
    
    // Call choreo kernel on device buffer
    fill_default_emb_vec_direct(missing_index_view, output_choreo_view);
    // Copy result back to host
    choreo::abend_true(topsMemcpy(output_choreo, output_choreo__device, ((LEN) * (64ULL)) * 4, topsMemcpyDeviceToHost));

    bool match = true;
    for (int i = 0; i < LEN; ++i) {
        for (int j = 0; j < EMB_VEC_SIZE; ++j) {
            if (fabs(output_choreo[i][j] - output_cpu[i][j]) > 1e-5) {
                printf("error location: {%d, %d} = %.2f vs %.2f\n", i, j, output_choreo[i][j], output_cpu[i][j]);
                match = false;
            }
        }
    }
    printf("fill_default_emb_vec: %s\n", match ? "PASS" : "FAIL");

    int opt_fail = 0, adv_fail = 0;
    for (int i = 0; i < LEN * EMB_VEC_SIZE; ++i) {
        if (fabs(output_cpu[0][i] - output_opt[0][i]) > 1e-5) opt_fail = 1;
        if (fabs(output_cpu[0][i] - output_adv[0][i]) > 1e-5) adv_fail = 1;
    }
    printf("CPU optimized: %s\n", opt_fail ? "FAIL" : "PASS");
    printf("CPU advanced: %s\n", adv_fail ? "FAIL" : "PASS");
    return 0;
}
