// EmbeddingCacheReplaceChoreo kernel for Choreo
#include "choreo.h"
#include "embedding_cache_util.h"

// Add missing function declarations and macros
#define min_(a, b) (((a) > (b)) ? (b) : (a))
#define ceil_(a, b) (((a) + (b) - 1) / (b))

// --------- operator implementation ---------

// EmbeddingCacheReplaceChoreo_kernel: main choreo operator, two-level parallel simulates block/thread division
// Supports block transfer, batch processing, parallel search and replacement, all data transfer uses dma+subspan/at

using namespace flashtensor::embedding_cache_util;

#define PART_SIZE 1024
#define WARP_SIZE 32
#define SET_ASSOCIATIVITY 2
#define TILE_SIZE 8*1024
#define KEY_TYPE s64
__co__ void EmbeddingCacheReplaceChoreo_kernel(
    KEY_TYPE[capacity_in_set, set_associativity, warp_size] & keys, // global key table
    f32[capacity_in_set, set_associativity, warp_size, embedding_vec_size] & vals, // global value table
    u64[capacity_in_set, set_associativity, warp_size] & slot_counter, // global LRU counter
    KEY_TYPE[len] d_keys, // input query key
    f32[len, embedding_vec_size] d_values, // input query value
    u64 global_counter, // global counter
    int dim_grid, int dim_block
) {
  parallel blockIdx by dim_grid {
    parallel threadIdx by dim_block {
      // Local buffer declaration, block processing key/counter
      local KEY_TYPE[PART_SIZE, set_associativity, warp_size] buffer_key;
      local u64[PART_SIZE, set_associativity, warp_size] buffer_counter;
      local KEY_TYPE[TILE_SIZE] buffer_query;
      local u32[TILE_SIZE] buffer_src_set;

      k_total_len0 = cdiv(capacity_in_set, dim_block);
      k_total_start = threadIdx * k_total_len0;
      k_total_end = min_(k_total_start + k_total_len0, capacity_in_set);
      k_total_len = k_total_end - k_total_start;
      
      k_loop_num = cdiv(k_total_len, PART_SIZE);
      k_len0 = PART_SIZE;
      // Outer loop: block copy key/counter to local buffer
      foreach {k_loop_idx} in [k_loop_num] {
        k_start = k_total_start + k_len0 * k_loop_idx;
        k_end = min_(k_start + k_len0, k_total_end);
        k_len = k_end - k_start;

        // Block transfer key/counter to local buffer
        dma.copy.async keys.subspan(k_total_len0, set_associativity, warp_size).at(threadIdx, _, _).subspan(k_len0, set_associativity, warp_size).at(k_loop_idx, _, _).subspan(k_len, set_associativity, warp_size) => buffer_key.subspan(k_len, set_associativity, warp_size);
        dma.copy.async slot_counter.subspan(k_total_len0, set_associativity, warp_size).at(threadIdx, _, _).subspan(k_len0, set_associativity, warp_size).at(k_loop_idx, _, _).subspan(k_len, set_associativity, warp_size) => buffer_counter.subspan(k_len, set_associativity, warp_size);

        m_loop_num = cdiv(len, TILE_SIZE);
        m_len0 = cdiv(len, m_loop_num);
        // Inner loop: batch process input query
        foreach {m_loop_idx} in [m_loop_num] {
          m_start = m_loop_idx * m_len0;
          m_end = min_(m_start + m_len0, len);
          m_len = m_end - m_start;

          // Block transfer query to local buffer
          dma.copy d_keys.subspan(m_len0).at(m_loop_idx).subspan(m_len) => buffer_query.subspan(m_len);

          // Hash bucket, get src_set for each query
          call MurmurHash3_32(buffer_query, buffer_src_set, capacity_in_set, m_len);


          // Traverse all queries in this batch, search/replace/write back
          foreach {query_idx} in [m_len] {
            src_set = buffer_src_set.at(query_idx); // set mapped by query
            if (!(k_start <= src_set && src_set < k_end))
              continue;

            query = buffer_query.at(query_idx); // current query key
            set_offset = src_set - k_start; // offset of set in local buffer
            // Only process the key range handled by the current thread
            mutable src_slab = query % set_associativity; // slab id
            mutable flag_need_replace = 1;
            mutable src_slot = 0;
            // Search for key or empty slot in set
            foreach {cnt} in [set_associativity] {
              src_slot = call index<s64, WARP_SIZE>(buffer_key.subspan(1,1,warp_size).at(set_offset, src_slab, _), query);
              if (src_slot >= 0) {
                flag_need_replace = 0;
                break;
              }
              key_a = buffer_key.at(set_offset, src_slab, warp_size-1);
              // Check empty slot
              if (key_a == 0x7FFFFFFFFFFFFFFF) {
                src_slot = call index<s64, WARP_SIZE>(buffer_key.subspan(1,1,warp_size).at(set_offset, src_slab, _), 0x7FFFFFFFFFFFFFFF);
                break;
              }
              src_slab = (src_slab + 1) % set_associativity;
            }
            // If none, find LRU slot
            if (src_slot == -1) {
              s32 idx = call argmin<u64, SET_ASSOCIATIVITY * WARP_SIZE>(buffer_counter.subspan(1,set_associativity,warp_size).at(set_offset, _, _), warp_size, src_slab);
              src_slab = idx / warp_size;
              src_slot = idx % warp_size;
            }
            // Replace key/value/counter
            if (flag_need_replace == 1) {
              buffer_key.at(set_offset, src_slab, src_slot) = query;
              dma.copy d_values.subspan(1, embedding_vec_size).at(m_loop_idx * m_len0 + query_idx, _).span_as(1, 1, 1, embedding_vec_size)
                => vals.subspan(1, 1, 1, embedding_vec_size).at(src_set, src_slab, src_slot, _);
            }
            buffer_counter.at(set_offset, src_slab, src_slot) = global_counter;
          }
        }
        // Block write back global key/counter

        dma.copy buffer_key.subspan(k_len, set_associativity, warp_size) => keys.subspan(k_total_len0, set_associativity, warp_size).at(threadIdx, _, _).subspan(k_len0, set_associativity, warp_size).at(k_loop_idx, _, _).subspan(k_len, set_associativity, warp_size);
        dma.copy buffer_counter.subspan(k_len, set_associativity, warp_size) => slot_counter.subspan(k_total_len0, set_associativity, warp_size).at(threadIdx, _, _).subspan(k_len0, set_associativity, warp_size).at(k_loop_idx, _, _).subspan(k_len, set_associativity, warp_size);
      }
    }
  }
}

// TODO: choreo need to implement a new version of host wrapper
// to take a send-in topsStream_t
//
// Host side interface, parameters consistent with the original header file
extern "C" void EmbeddingCacheReplaceChoreo(
    int64_t *keys,
    float *vals,
    uint64_t *slot_counter,
    int capacity_in_set,
    int embedding_vec_size,
    uint64_t global_counter,
    int64_t *d_keys,
    float *d_values,
    int len,
    int dim_grid,
    int dim_block,
    int num_bytes_in_SharedMem,
    void* stream
) {
    using namespace choreo;
    // Convert host pointers to choreo views
    auto keys_view = spanned_view<int64_t, 3>(keys, {static_cast<unsigned long>(capacity_in_set), 2, 32});
    auto vals_view = spanned_view<float, 4>(vals, {static_cast<unsigned long>(capacity_in_set), 2, 32, static_cast<unsigned long>(embedding_vec_size)});
    auto slot_counter_view = spanned_view<uint64_t, 3>(slot_counter, {static_cast<unsigned long>(capacity_in_set), 2, 32});
    auto d_keys_view = spanned_view<int64_t, 1>(d_keys, {static_cast<unsigned long>(len)});
    auto d_values_view = spanned_view<float, 2>(d_values, {static_cast<unsigned long>(len), static_cast<unsigned long>(embedding_vec_size)});
    EmbeddingCacheReplaceChoreo_kernel(keys_view, vals_view, slot_counter_view, d_keys_view, d_values_view, global_counter, dim_grid, dim_block);
}
