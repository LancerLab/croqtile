// cse/fill_default_emb_vec_basic.co - 默认值填充函数（choreo版本）- 未优化版本

// 使用常量定义
#include "choreo.h"
#define LEN 1000
#define EMB_VEC_SIZE 64
#define DEFAULT_VALUE 0.5f
#
__cok__ {


}

// 实现fill_default_emb_vec函数 - 未优化版本
__co__ void fill_default_emb_vec(u32[LEN] missing_index, f32[LEN, EMB_VEC_SIZE] output_emb_vec) {

  parallel p by 1 {
    parallel q by 1 {
      local f32[LEN/#p/#q, EMB_VEC_SIZE] local_emb_vec;
      local u32[LEN/#p/#q] index;
      dma.copy output_emb_vec.chunkat(p#q, _) => local_emb_vec;
      dma.copy missing_index.chunkat(p#q) => index;
      foreach {i, j} in [LEN/#p/#q, EMB_VEC_SIZE] {
          unsigned int dst_emb_vec = missing_index.at(i);
          local_emb_vec.at(dst_emb_vec, j) = 0.5f;
      }
      dma.copy local_emb_vec => output_emb_vec.chunkat(p#q, _);
    }
  }
}


// --- CPU参考实现 ---
void fill_default_emb_vec_cpu(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    for (size_t idx = 0; idx < (len * emb_vec_size); idx++) {
        size_t src_emb_vec = idx / emb_vec_size;
        size_t dst_emb_vec = missing_index[src_emb_vec];
        size_t dst_float = idx % emb_vec_size;
        output_emb_vec[dst_emb_vec * emb_vec_size + dst_float] = default_emb_vec;
    }
}

void fill_default_emb_vec_cpu_optimized(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    for (size_t i = 0; i < len; i++) {
        size_t dst_emb_vec = missing_index[i];
        float* dst_ptr = output_emb_vec + dst_emb_vec * emb_vec_size;
        size_t j = 0;
        for (; j + 3 < emb_vec_size; j += 4) {
            dst_ptr[j] = default_emb_vec;
            dst_ptr[j + 1] = default_emb_vec;
            dst_ptr[j + 2] = default_emb_vec;
            dst_ptr[j + 3] = default_emb_vec;
        }
        for (; j < emb_vec_size; j++) {
            dst_ptr[j] = default_emb_vec;
        }
    }
}

void fill_default_emb_vec_cpu_advanced(float* output_emb_vec, const float default_emb_vec,
    const unsigned int* missing_index, const size_t len,
    const size_t emb_vec_size) {
    if (emb_vec_size >= 8) {
        float* template_vec = (float*)malloc(emb_vec_size * sizeof(float));
        for (size_t j = 0; j < emb_vec_size; j++) {
            template_vec[j] = default_emb_vec;
        }
        for (size_t i = 0; i < len; i++) {
            size_t dst_emb_vec = missing_index[i];
            float* dst_ptr = output_emb_vec + dst_emb_vec * emb_vec_size;
            memcpy(dst_ptr, template_vec, emb_vec_size * sizeof(float));
        }
        free(template_vec);
    } else {
        fill_default_emb_vec_cpu_optimized(output_emb_vec, default_emb_vec, missing_index, len, emb_vec_size);
    }
}

// --- main函数：对比choreo和CPU实现 ---
int main() {
    float output_choreo[LEN][EMB_VEC_SIZE] = {0};
    float output_cpu[LEN][EMB_VEC_SIZE] = {0};
    unsigned int missing_index[LEN];
    for (int i = 0; i < LEN; ++i) missing_index[i] = rand() % LEN;

    for (int i = 0; i < LEN; ++i) printf("missing index[%d] = %d\n", i, missing_index[i]);

    // CPU实现
    fill_default_emb_vec_cpu(&output_cpu[0][0], DEFAULT_VALUE, missing_index, LEN, EMB_VEC_SIZE);

    // choreo调用
    auto missing_index_view = choreo::make_spanview<1, choreo::u32>((unsigned int*)missing_index, {LEN});
    auto output_choreo_view = choreo::make_spanview<2, choreo::f32>((float*)output_choreo, {LEN, EMB_VEC_SIZE});
    fill_default_emb_vec(missing_index_view, output_choreo_view);

    // 校验
    bool match = true;
    for (int i = 0; i < LEN; ++i) {
        for (int j = 0; j < EMB_VEC_SIZE; ++j) {
            if (i < 3 && j < 16) printf("{%d, %d} = %.2f; should be", i, j, output_choreo[i][j]);
            if (i < 3 && j < 16) printf("{%d, %d} = %.2f\n", i, j, output_cpu[i][j]);
            if (fabs(output_choreo[i][j] - output_cpu[i][j]) > 1e-5) {
                match = false;
                break;
            }
        }
    }
    if (match) printf("fill_default_emb_vec: PASS\n");
    else printf("fill_default_emb_vec: FAIL\n");
    return 0;
} 
