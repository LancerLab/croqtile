// Rotary Position Embedding (RoPE) TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, hidden] rope_tiling_3(f32[batch, seq, hidden] X) {
    f32[batch, seq, hidden] Y;
    
    // 内存层级大小
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // 向量长度优化参数
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // 定义分块大小以优化缓存使用
    const int SEQ_TILE = 128;      // 序列维度分块
    const int HIDDEN_TILE = 512;   // 隐藏层维度分块
    
    // 对于 L2 缓存，我们可以处理更大的批次
    const int SEQ_TILE_L2 = 512;     // L2 序列维度分块
    const int HIDDEN_TILE_L2 = 2048; // L2 隐藏层维度分块
    
    // RoPE 配置参数
    const int rope_dim = hidden / 2;  // 通常 RoPE 只应用于一半的隐藏维度
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    // 针对 RoPE 变换的分块处理
    void apply_rope_block(
        float* input_ptr, float* output_ptr,
        int seq_start, int seq_end,
        int hidden_start, int hidden_end,
        int seq_len, int hidden_size, int rope_dim) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 当前分块的大小
        int block_seq = seq_end - seq_start;
        int block_hidden = hidden_end - hidden_start;
        
        // 处理序列分块中的每个位置
        for (int s_idx = 0; s_idx < block_seq; s_idx++) {
            int s = seq_start + s_idx;
            int token_offset = s * hidden_size;
            
            // 处理隐藏维度分块
            // 1. 需要旋转的维度（rope_dim 范围内且 hidden_start 到 hidden_end 之间）
            int rope_start = tcle::max(hidden_start, 0);
            int rope_end = tcle::min(hidden_end, rope_dim);
            
            if (rope_start < rope_end) {
                // 确保我们只处理成对的维度（对于 RoPE，我们总是以成对的方式处理维度）
                if (rope_start % 2 != 0) rope_start++;
                if (rope_end % 2 != 0) rope_end--;
                
                for (int d = rope_start; d < rope_end; d += 2) {
                    // 获取当前位置和维度的原始值
                    float x_d = input_ptr[token_offset + d];
                    float x_d_plus_1 = input_ptr[token_offset + d + 1];
                    
                    // 计算旋转角度，根据维度和位置
                    float theta = tcle::pow(10000.0f, -1.0f * d / rope_dim);
                    float freq = s * theta;
                    float cos_freq = tcle::cos(freq);
                    float sin_freq = tcle::sin(freq);
                    
                    // 应用旋转变换
                    output_ptr[token_offset + d] = x_d * cos_freq - x_d_plus_1 * sin_freq;
                    output_ptr[token_offset + d + 1] = x_d * sin_freq + x_d_plus_1 * cos_freq;
                }
            }
            
            // 2. 不需要旋转的维度（rope_dim 之外且 hidden_start 到 hidden_end 之间）
            int copy_start = tcle::max(hidden_start, rope_dim);
            int copy_end = hidden_end;
            
            if (copy_start < copy_end) {
                for (int d = copy_start; d < copy_end; d += vec_len) {
                    int remaining = tcle::min(vec_len, copy_end - d);
                    
                    if (remaining == vec_len) {
                        // 完整向量情况
                        vec_type in_vec = input_leaptr.load_at(token_offset + d);
                        output_leaptr.store_at(in_vec, token_offset + d);
                    } else {
                        // 部分向量情况（边缘情况）
                        for (int i = 0; i < remaining; i++) {
                            output_ptr[token_offset + d + i] = input_ptr[token_offset + d + i];
                        }
                    }
                }
            }
        }
    }
    
    __co_device__ extern "C" void rope_tiled_kernel(
        float* input_ptr, float* output_ptr,
        int seq_len, int hidden_size, int rope_dim,
        int seq_tile, int hidden_tile) {
        
        // 多层分块处理
        for (int seq_start = 0; seq_start < seq_len; seq_start += seq_tile) {
            int seq_end = tcle::min(seq_start + seq_tile, seq_len);
            
            for (int hidden_start = 0; hidden_start < hidden_size; hidden_start += hidden_tile) {
                int hidden_end = tcle::min(hidden_start + hidden_tile, hidden_size);
                
                // 处理当前分块
                apply_rope_block(
                    input_ptr, output_ptr,
                    seq_start, seq_end,
                    hidden_start, hidden_end,
                    seq_len, hidden_size, rope_dim
                );
            }
        }
    }
    } // __cok__
    
    // 主体并行结构与分层分块
    parallel b by batch {
        // 使用共享内存处理适合 L2 的大块
        shared f32[SEQ_TILE_L2, hidden] X_shared;
        shared f32[SEQ_TILE_L2, hidden] Y_shared;
        
        // 处理 L2 序列分块
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_size_l2 = s_end_l2 - s;
            
            // 复制输入分块到共享内存
            dma.copy X.chunkat(b, s:s_end_l2, _) => X_shared.chunkat(0:seq_size_l2, _);
            
            // 初始化输出分块
            foreach {s_idx, h} in [seq_size_l2, hidden] {
                Y_shared.at(s_idx, h) = 0.0f;
            }
            
            // 处理 L1 分块
            for (int s_l1 = 0; s_l1 < seq_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_size_l2);
                int seq_size_l1 = s_end_l1 - s_l1;
                
                // 处理隐藏层维度的 L2 分块
                for (int h_l2 = 0; h_l2 < hidden; h_l2 += HIDDEN_TILE_L2) {
                    int h_end_l2 = min(h_l2 + HIDDEN_TILE_L2, hidden);
                    int hidden_size_l2 = h_end_l2 - h_l2;
                    
                    // 创建 L1 分块
                    local f32[seq_size_l1, hidden_size_l2] X_local;
                    local f32[seq_size_l1, hidden_size_l2] Y_local;
                    
                    // 从共享内存复制到本地内存
                    dma.copy X_shared.chunkat(s_l1:s_end_l1, h_l2:h_end_l2) => X_local;
                    
                    // 初始化输出分块
                    foreach {s_idx, h} in [seq_size_l1, hidden_size_l2] {
                        Y_local.at(s_idx, h) = 0.0f;
                    }
                    
                    // 处理隐藏层维度的 L1 分块
                    for (int h_l1 = 0; h_l1 < hidden_size_l2; h_l1 += HIDDEN_TILE) {
                        int h_end_l1 = min(h_l1 + HIDDEN_TILE, hidden_size_l2);
                        
                        // 调用优化的 RoPE 内核
                        __call_tcle rope_tiled_kernel(
                            X_local.data,
                            Y_local.data,
                            seq_size_l1,
                            hidden_size_l2,
                            rope_dim - h_l2,  // 调整 rope_dim 相对于当前分块
                            SEQ_TILE,
                            HIDDEN_TILE
                        );
                    }
                    
                    // 结果复制回共享内存
                    dma.copy Y_local => Y_shared.chunkat(s_l1:s_end_l1, h_l2:h_end_l2);
                }
            }
            
            // 将处理后的 L2 分块复制到输出
            dma.copy Y_shared.chunkat(0:seq_size_l2, _) => Y.chunkat(b, s:s_end_l2, _);
        }
    }
    
    return Y;
} 