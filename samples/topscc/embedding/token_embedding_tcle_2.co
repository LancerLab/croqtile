// Token Embedding TCLE Version 2
__co__ f32[batch, seq, hidden] token_embedding_tcle_2(i32[batch, seq] token_ids) {
    f32[batch, seq, hidden] embeddings;
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void token_embedding_kernel(
        int* token_ids_ptr, float* embedding_table_ptr, float* output_ptr,
        int batch_size, int seq_len, int hidden_size, int vocab_size) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 处理每个批次和序列位置
        for (int b = 0; b < batch_size; b++) {
            for (int s = 0; s < seq_len; s++) {
                int token_id = token_ids_ptr[b * seq_len + s];
                
                // 确保 token_id 在有效范围内
                if (token_id < 0 || token_id >= vocab_size) {
                    // 使用无效 token 的默认嵌入（全零）
                    for (int h = 0; h < hidden_size; h++) {
                        output_ptr[(b * seq_len + s) * hidden_size + h] = 0.0f;
                    }
                    continue;
                }
                
                // 获取嵌入表中对应 token 的嵌入向量
                float* token_embedding = &embedding_table_ptr[token_id * hidden_size];
                
                // 将嵌入向量复制到输出
                for (int h = 0; h < hidden_size; h += vec_len) {
                    int remaining = tcle::min(vec_len, hidden_size - h);
                    
                    if (remaining == vec_len) {
                        // 完整向量情况
                        vec_type emb_vec = tcle::vload<vec_type>(&token_embedding[h]);
                        output_leaptr.store_at(emb_vec, (b * seq_len + s) * hidden_size + h);
                    } else {
                        // 部分向量情况（边缘情况）
                        for (int i = 0; i < remaining; i++) {
                            output_ptr[(b * seq_len + s) * hidden_size + h + i] = token_embedding[h + i];
                        }
                    }
                }
            }
        }
    }
    } // __cok__
    
    // 假设词汇表大小
    const int vocab_size = 50000;
    
    // 嵌入表
    shared f32[vocab_size, hidden] embedding_table;
    
    // 初始化嵌入表 - 在实际实现中，这将是加载的预训练嵌入
    foreach {v, h} in [vocab_size, hidden] {
        embedding_table.at(v, h) = 0.01f * (v + h); // 示例初始化
    }
    
    // 主体并行结构
    parallel b by batch {
        local i32[seq] token_ids_local;
        local f32[seq, hidden] embeddings_local;
        
        // 复制输入数据到本地内存
        dma.copy token_ids.chunkat(b, _) => token_ids_local;
        
        // 查找嵌入
        __call_tcle token_embedding_kernel(
            token_ids_local.data,
            embedding_table.data,
            embeddings_local.data,
            1, // 只处理一个批次
            seq,
            hidden,
            vocab_size
        );
        
        // 复制结果到输出
        dma.copy embeddings_local => embeddings.chunkat(b, _, _);
    }
    
    return embeddings;
} 