// Token Embedding TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, hidden] token_embedding_tiling_3(i32[batch, seq] token_ids) {
    f32[batch, seq, hidden] embeddings;
    
    // 内存层级大小
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // 向量长度优化参数
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // 定义分块大小以优化缓存使用
    const int SEQ_TILE = 128;      // 序列维度分块
    const int HIDDEN_TILE = 512;   // 隐藏层维度分块
    
    // 对于 L2 缓存，我们可以处理更大的批次
    const int SEQ_TILE_L2 = 512;     // L2 序列维度分块
    const int HIDDEN_TILE_L2 = 2048; // L2 隐藏层维度分块
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    // 针对嵌入查询操作的分块处理
    void lookup_embeddings_block(
        int* token_ids_ptr, float* embedding_table_ptr, float* output_ptr,
        int seq_start, int seq_end,
        int hidden_start, int hidden_end,
        int seq_len, int hidden_size, int vocab_size) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 当前分块的大小
        int block_seq = seq_end - seq_start;
        int block_hidden = hidden_end - hidden_start;
        
        // 处理序列分块中的每个位置
        for (int s_idx = 0; s_idx < block_seq; s_idx++) {
            int s = seq_start + s_idx;
            int token_id = token_ids_ptr[s];
            
            // 确保 token_id 在有效范围内
            if (token_id < 0 || token_id >= vocab_size) {
                // 使用无效 token 的默认嵌入（全零）
                for (int h_idx = 0; h_idx < block_hidden; h_idx++) {
                    output_ptr[s * hidden_size + hidden_start + h_idx] = 0.0f;
                }
                continue;
            }
            
            // 获取嵌入表中对应 token 的嵌入向量
            float* token_embedding = &embedding_table_ptr[token_id * hidden_size + hidden_start];
            
            // 将嵌入向量复制到输出
            for (int h_idx = 0; h_idx < block_hidden; h_idx += vec_len) {
                int remaining = tcle::min(vec_len, block_hidden - h_idx);
                
                if (remaining == vec_len) {
                    // 完整向量情况
                    vec_type emb_vec = tcle::vload<vec_type>(&token_embedding[h_idx]);
                    output_leaptr.store_at(emb_vec, s * hidden_size + hidden_start + h_idx);
                } else {
                    // 部分向量情况（边缘情况）
                    for (int i = 0; i < remaining; i++) {
                        output_ptr[s * hidden_size + hidden_start + h_idx + i] = token_embedding[h_idx + i];
                    }
                }
            }
        }
    }
    
    __co_device__ extern "C" void token_embedding_tiled_kernel(
        int* token_ids_ptr, float* embedding_table_ptr, float* output_ptr,
        int seq_len, int hidden_size, int vocab_size,
        int seq_tile, int hidden_tile) {
        
        // 多层分块处理
        for (int seq_start = 0; seq_start < seq_len; seq_start += seq_tile) {
            int seq_end = tcle::min(seq_start + seq_tile, seq_len);
            
            for (int hidden_start = 0; hidden_start < hidden_size; hidden_start += hidden_tile) {
                int hidden_end = tcle::min(hidden_start + hidden_tile, hidden_size);
                
                // 处理当前分块
                lookup_embeddings_block(
                    token_ids_ptr, embedding_table_ptr, output_ptr,
                    seq_start, seq_end,
                    hidden_start, hidden_end,
                    seq_len, hidden_size, vocab_size
                );
            }
        }
    }
    } // __cok__
    
    // 假设词汇表大小
    const int vocab_size = 50000;
    
    // 嵌入表
    shared f32[vocab_size, hidden] embedding_table;
    
    // 初始化嵌入表 - 在实际实现中，这将是加载的预训练嵌入
    foreach {v, h} in [vocab_size, hidden] {
        embedding_table.at(v, h) = 0.01f * (v + h); // 示例初始化
    }
    
    // 主体并行结构与分层分块
    parallel b by batch {
        // 使用共享内存处理适合 L2 的大块
        shared i32[SEQ_TILE_L2] token_ids_shared;
        shared f32[SEQ_TILE_L2, hidden] embeddings_shared;
        
        // 处理 L2 序列分块
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_size_l2 = s_end_l2 - s;
            
            // 复制输入分块到共享内存
            dma.copy token_ids.chunkat(b, s:s_end_l2) => token_ids_shared.chunkat(0:seq_size_l2);
            
            // 初始化输出分块
            foreach {s_idx, h} in [seq_size_l2, hidden] {
                embeddings_shared.at(s_idx, h) = 0.0f;
            }
            
            // 处理 L1 分块
            for (int s_l1 = 0; s_l1 < seq_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_size_l2);
                int seq_size_l1 = s_end_l1 - s_l1;
                
                // 创建 L1 分块
                local i32[seq_size_l1] token_ids_local;
                local f32[seq_size_l1, hidden] embeddings_local;
                
                // 从共享内存复制到本地内存
                dma.copy token_ids_shared.chunkat(s_l1:s_end_l1) => token_ids_local;
                
                // 初始化输出分块
                foreach {s_idx, h} in [seq_size_l1, hidden] {
                    embeddings_local.at(s_idx, h) = 0.0f;
                }
                
                // 调用优化的嵌入内核
                __call_tcle token_embedding_tiled_kernel(
                    token_ids_local.data,
                    embedding_table.data,
                    embeddings_local.data,
                    seq_size_l1,
                    hidden,
                    vocab_size,
                    SEQ_TILE,
                    HIDDEN_TILE
                );
                
                // 结果复制回共享内存
                dma.copy embeddings_local => embeddings_shared.chunkat(s_l1:s_end_l1, _);
            }
            
            // 将处理后的 L2 分块复制到输出
            dma.copy embeddings_shared.chunkat(0:seq_size_l2, _) => embeddings.chunkat(b, s:s_end_l2, _);
        }
    }
    
    return embeddings;
} 