// Token Embedding Basic Version 1
__co__ f32[batch, seq, dim] token_embedding_basic_1(s32[batch, seq] idx) {
    f32[batch, seq, dim] emb;
    parallel b by batch {
        local f32[seq, dim] tmp;
        // 1. tmp = embedding lookup (省略实现)
        dma.copy tmp => emb.chunkat(b, _, _);
    }
    return emb;
} 