// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>
#include <cmath>

__cok__ {
// Basic Tanh kernel implementation
__co_device__ void tanh_kernel_basic(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    float x = input[i];
    // Tanh: (exp(x) - exp(-x)) / (exp(x) + exp(-x))
    output[i] = tanhf(x);
  }
}

// Optimized Tanh kernel using TCLE API
__co_device__ void tanh_kernel_optimized(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    float x = input[i];
    output[i] = tanhf(x);
  }
}

// Fast Tanh approximation using polynomial
__co_device__ void tanh_kernel_fast(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    float x = input[i];
    // Fast tanh approximation: x / (1 + |x|) for small x
    float abs_x = x > 0 ? x : -x;
    if (abs_x < 3.0f) {
      output[i] = x / (1.0f + abs_x);
    } else {
      output[i] = x > 0 ? 1.0f : -1.0f;
    }
  }
}
}

// Basic Tanh implementation
__co__ f32[batch, seq, hidden] tanh_basic(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call basic kernel
      call tanh_kernel_basic(x_load.data, y_local, x_load.span(0), x_load.span(1), x_load.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// Optimized Tanh implementation using TCLE API
__co__ f32[batch, seq, hidden] tanh_optimized(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call optimized kernel with TCLE API
      call tanh_kernel_optimized(x_load.data, y_local, x_load.span(0), x_load.span(1), x_load.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// Fast Tanh implementation with approximation
__co__ f32[batch, seq, hidden] tanh_fast(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call fast kernel with approximation
      call tanh_kernel_fast(x_load.data, y_local, x_load.span(0), x_load.span(1), x_load.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// C++ reference implementation for correctness verification
void tanh_reference(float* input, float* output, int size) {
  for (int i = 0; i < size; ++i) {
    float x = input[i];
    output[i] = tanhf(x);
  }
}

int main() {
  const int BATCH = 16;
  const int SEQ = 32;
  const int HIDDEN = 64;
  
  // Initialize input data
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  auto input_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  input_data.fill_random(-3.0, 3.0); // Tanh works well in this range

  // Reference implementation
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  tanh_reference((float*)a, ref_output, BATCH * SEQ * HIDDEN);

  // Test basic implementation
  auto start1 = std::chrono::high_resolution_clock::now();
  auto res_basic = tanh_basic(input_data);
  auto end1 = std::chrono::high_resolution_clock::now();
  auto duration_basic = std::chrono::duration_cast<std::chrono::microseconds>(end1 - start1);

  // Test optimized implementation
  auto start2 = std::chrono::high_resolution_clock::now();
  auto res_optimized = tanh_optimized(input_data);
  auto end2 = std::chrono::high_resolution_clock::now();
  auto duration_optimized = std::chrono::duration_cast<std::chrono::microseconds>(end2 - start2);

  // Test fast implementation
  auto start3 = std::chrono::high_resolution_clock::now();
  auto res_fast = tanh_fast(input_data);
  auto end3 = std::chrono::high_resolution_clock::now();
  auto duration_fast = std::chrono::duration_cast<std::chrono::microseconds>(end3 - start3);

  // Verification
  bool all_correct = true;
  for (size_t i = 0; i < BATCH; ++i) {
    for (size_t j = 0; j < SEQ; ++j) {
      for (size_t k = 0; k < HIDDEN; ++k) {
        float ref = ref_output[i * SEQ * HIDDEN + j * HIDDEN + k];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float fast_val = res_fast[i][j][k];
        
        // Check basic and optimized against reference
        if (std::abs(basic_val - ref) > 1e-6 || 
            std::abs(optimized_val - ref) > 1e-6) {
          std::cout << "Verification failed at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Basic: " << basic_val << std::endl;
          std::cout << "Optimized: " << optimized_val << std::endl;
          all_correct = false;
          break;
        }
        
        // Fast version is an approximation, so we use a looser tolerance
        if (std::abs(fast_val - ref) > 0.1) {
          std::cout << "Fast approximation error at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Fast: " << fast_val << std::endl;
        }
      }
      if (!all_correct) break;
    }
    if (!all_correct) break;
  }

  if (all_correct) {
    std::cout << "Tanh Test Passed" << std::endl;
  } else {
    std::cout << "Tanh Test Failed" << std::endl;
  }

  std::cout << "Function <tanh_basic> execution time: " << duration_basic.count() << " microseconds" << std::endl;
  std::cout << "Function <tanh_optimized> execution time: " << duration_optimized.count() << " microseconds" << std::endl;
  std::cout << "Function <tanh_fast> execution time: " << duration_fast.count() << " microseconds" << std::endl;
}

// CHECK: Tanh Test Passed 