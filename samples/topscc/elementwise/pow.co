// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>
#include <cmath>

__cok__ {
// Basic Power kernel implementation
__co_device__ void pow_kernel_basic(float* base, float* exponent, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = powf(base[i], exponent[i]);
  }
}

// Optimized Power kernel using TCLE API
__co_device__ void pow_kernel_optimized(float* base, float* exponent, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = powf(base[i], exponent[i]);
  }
}

// Advanced Power with fused operations and special case handling
__co_device__ void pow_kernel_advanced(float* base, float* exponent, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    float b = base[i];
    float e = exponent[i];
    
    // Handle special cases for better performance
    if (e == 0.0f) {
      output[i] = 1.0f;
    } else if (e == 1.0f) {
      output[i] = b;
    } else if (e == 2.0f) {
      output[i] = b * b;
    } else if (e == 0.5f) {
      output[i] = sqrtf(b);
    } else if (e == -1.0f) {
      output[i] = b != 0.0f ? 1.0f / b : 0.0f;
    } else {
      output[i] = powf(b, e);
    }
  }
}
}

// Basic Power implementation
__co__ f32[batch, seq, hidden] pow_basic(f32[batch, seq, hidden] base, f32[batch, seq, hidden] exponent) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] base_local;
      local f32[batch/#p, seq/#q, hidden] exponent_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      base_load = dma.copy base.chunkat(p, q, _) => local;
      exponent_load = dma.copy exponent.chunkat(p, q, _) => local;
    
      // Call basic kernel
      call pow_kernel_basic(base_load.data, exponent_load.data, output_local, 
                           base_load.span(0), base_load.span(1), base_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Optimized Power implementation using TCLE API
__co__ f32[batch, seq, hidden] pow_optimized(f32[batch, seq, hidden] base, f32[batch, seq, hidden] exponent) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] base_local;
      local f32[batch/#p, seq/#q, hidden] exponent_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      base_load = dma.copy base.chunkat(p, q, _) => local;
      exponent_load = dma.copy exponent.chunkat(p, q, _) => local;
    
      // Call optimized kernel with TCLE API
      call pow_kernel_optimized(base_load.data, exponent_load.data, output_local,
                               base_load.span(0), base_load.span(1), base_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Advanced Power implementation with fused operations
__co__ f32[batch, seq, hidden] pow_advanced(f32[batch, seq, hidden] base, f32[batch, seq, hidden] exponent) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] base_local;
      local f32[batch/#p, seq/#q, hidden] exponent_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      base_load = dma.copy base.chunkat(p, q, _) => local;
      exponent_load = dma.copy exponent.chunkat(p, q, _) => local;
    
      // Call advanced kernel with fused operations
      call pow_kernel_advanced(base_load.data, exponent_load.data, output_local,
                              base_load.span(0), base_load.span(1), base_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// C++ reference implementation for correctness verification
void pow_reference(float* base, float* exponent, float* output, int size) {
  for (int i = 0; i < size; ++i) {
    output[i] = powf(base[i], exponent[i]);
  }
}

int main() {
  const int BATCH = 16;
  const int SEQ = 32;
  const int HIDDEN = 64;
  
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  choreo::f32 b[BATCH * SEQ * HIDDEN];
  auto base_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  auto exponent_data = choreo::make_spanview<3, choreo::f32>((float*)b, {BATCH, SEQ, HIDDEN});
  
  // Fill with reasonable values for power operation
  base_data.fill_random(0.1, 10.0);  // Positive base values
  exponent_data.fill_random(-2.0, 3.0);  // Reasonable exponent range
  
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  pow_reference((float*)a, (float*)b, ref_output, BATCH * SEQ * HIDDEN);
  
  auto res_basic = pow_basic(base_data, exponent_data);
  auto res_optimized = pow_optimized(base_data, exponent_data);
  auto res_advanced = pow_advanced(base_data, exponent_data);

  // Verify results with improved tolerance
  bool all_correct = true;
  int mismatch_count = 0;
  const float tolerance = 1e-3f;  // Increased tolerance for floating point differences
  
  for (size_t i = 0; i < res_basic.shape()[0]; ++i) {
    for (size_t j = 0; j < res_basic.shape()[1]; ++j) {
      for (size_t k = 0; k < res_basic.shape()[2]; ++k) {
        size_t idx = i * res_basic.shape()[1] * res_basic.shape()[2] + j * res_basic.shape()[2] + k;
        float ref = ref_output[idx];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float advanced_val = res_advanced[i][j][k];
        
        // Check relative error instead of absolute error
        float ref_abs = std::abs(ref);
        float basic_error = ref_abs > 1e-6f ? std::abs(basic_val - ref) / ref_abs : std::abs(basic_val - ref);
        float optimized_error = ref_abs > 1e-6f ? std::abs(optimized_val - ref) / ref_abs : std::abs(optimized_val - ref);
        float advanced_error = ref_abs > 1e-6f ? std::abs(advanced_val - ref) / ref_abs : std::abs(advanced_val - ref);
        
        if (basic_error > tolerance || optimized_error > tolerance || advanced_error > tolerance) {
          if (mismatch_count < 10) {  // Only print first 10 mismatches
            std::cerr << "Mismatch at [" << i << "][" << j << "][" << k << "]: ref=" << ref
                      << ", basic=" << basic_val << " (err=" << basic_error << ")"
                      << ", opt=" << optimized_val << " (err=" << optimized_error << ")"
                      << ", adv=" << advanced_val << " (err=" << advanced_error << ")" << std::endl;
          }
          all_correct = false;
          mismatch_count++;
        }
      }
    }
  }
  
  if (all_correct) {
    std::cout << "Power test PASSED" << std::endl;
  } else {
    std::cout << "Power test FAILED with " << mismatch_count << " mismatches" << std::endl;
  }
  
  return 0;
} 