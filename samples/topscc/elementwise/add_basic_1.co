// Elementwise Add Basic Version 1
__co__ f32[batch, seq, dim] add_basic_1(f32[batch, seq, dim] A, f32[batch, seq, dim] B) {
    f32[batch, seq, dim] C;
    parallel b by batch {
        local f32[seq, dim] tmp;
        // 1. tmp = A.chunkat(b, _, _) + B.chunkat(b, _, _)
        dma.copy tmp => C.chunkat(b, _, _);
    }
    return C;
} 