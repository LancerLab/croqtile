// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>

__cok__ {
// Basic Absolute Value kernel implementation
__co_device__ void abs_kernel_basic(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  printf("[kernel] size=%d, input[0]=%f\n", size, input[0]);
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
  printf("[kernel] output[0]=%f\n", output[0]);
}

// Optimized Absolute Value kernel using TCLE API
__co_device__ void abs_kernel_optimized(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
}

// Advanced Absolute Value with fused operations
__co_device__ void abs_kernel_advanced(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
}
}

// Basic Absolute Value implementation
__co__ f32[batch, seq, hidden] abs_basic(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call basic kernel
      call abs_kernel_basic(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Optimized Absolute Value implementation using TCLE API
__co__ f32[batch, seq, hidden] abs_optimized(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call optimized kernel
      call abs_kernel_optimized(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Advanced Absolute Value implementation with fused operations
__co__ f32[batch, seq, hidden] abs_advanced(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call advanced kernel
      call abs_kernel_advanced(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// C++ reference implementation for correctness verification
void abs_reference(float* input, float* output, int size) {
  printf("[ref] size=%d, input[0]=%f\n", size, input[0]);
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
  printf("[ref] output[0]=%f\n", output[0]);
}

int main() {
  const int BATCH = 16;
  const int SEQ = 32;
  const int HIDDEN = 64;
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  auto input_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  input_data.fill_random(-10.0, 10.0);
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  abs_reference((float*)a, ref_output, BATCH * SEQ * HIDDEN);
  auto start1 = std::chrono::high_resolution_clock::now();
  auto res_basic = abs_basic(input_data);
  auto end1 = std::chrono::high_resolution_clock::now();
  auto duration_basic = std::chrono::duration_cast<std::chrono::microseconds>(end1 - start1);
  auto start2 = std::chrono::high_resolution_clock::now();
  auto res_optimized = abs_optimized(input_data);
  auto end2 = std::chrono::high_resolution_clock::now();
  auto duration_optimized = std::chrono::duration_cast<std::chrono::microseconds>(end2 - start2);
  auto start3 = std::chrono::high_resolution_clock::now();
  auto res_advanced = abs_advanced(input_data);
  auto end3 = std::chrono::high_resolution_clock::now();
  auto duration_advanced = std::chrono::duration_cast<std::chrono::microseconds>(end3 - start3);
  bool all_correct = true;
  for (size_t i = 0; i < BATCH; ++i) {
    for (size_t j = 0; j < SEQ; ++j) {
      for (size_t k = 0; k < HIDDEN; ++k) {
        float ref = ref_output[i * SEQ * HIDDEN + j * HIDDEN + k];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float advanced_val = res_advanced[i][j][k];
        if (std::abs(basic_val - ref) > 1e-5 || std::abs(optimized_val - ref) > 1e-5 || std::abs(advanced_val - ref) > 1e-5) {
          std::cout << "Verification failed at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Basic: " << basic_val << std::endl;
          std::cout << "Optimized: " << optimized_val << std::endl;
          std::cout << "Advanced: " << advanced_val << std::endl;
          std::cout << "Input[" << i << "][" << j << "][" << k << "] = " << a[i * SEQ * HIDDEN + j * HIDDEN + k] << std::endl;
          std::cout << "Expected: " << fabsf(a[i * SEQ * HIDDEN + j * HIDDEN + k]) << std::endl;
          all_correct = false;
          break;
        }
      }
      if (!all_correct) break;
    }
    if (!all_correct) break;
  }
  if (all_correct) {
    std::cout << "Absolute Value Test Passed" << std::endl;
  } else {
    std::cout << "Absolute Value Test Failed" << std::endl;
  }
  std::cout << "Function <abs_basic> execution time: " << duration_basic.count() << " microseconds" << std::endl;
  std::cout << "Function <abs_optimized> execution time: " << duration_optimized.count() << " microseconds" << std::endl;
  std::cout << "Function <abs_advanced> execution time: " << duration_advanced.count() << " microseconds" << std::endl;
}
// CHECK: Absolute Value Test Passed
