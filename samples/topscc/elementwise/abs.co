// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>

__cok__ {
// Version 1: Basic Absolute Value kernel (parallel by 1)
__co_device__ void abs_kernel_basic(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  printf("[kernel] size=%d, input[0]=%f\n", size, input[0]);
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
  printf("[kernel] output[0]=%f\n", output[0]);
}

// Version 2: Optimized Absolute Value kernel using TCLE API
__co_device__ void abs_kernel_optimized(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
}

// Version 4: TCLE-based Absolute Value kernel using __vector float (4xfloat, 128bit)
__co_device__ void abs_kernel_tcle(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;

  // Use TCLE leaptr for vectorized memory access (float4 = 4*4=16 bytes)
  auto input_ptr = tcle::leaptr<__vector float, 1>(input, sizeof(__vector float));
  auto dst_ptr = tcle::leaptr<__vector float, 1>(output, sizeof(__vector float));

  int vector_size = 4; // __vector float
  int vector_count = size / vector_size;

  for (int i = 0; i < vector_count; ++i) {
    __vector float input_vec = input_ptr.load<0>();
    
    // Process vector elements individually for abs operation
    __vector float result_vec;
    for (int j = 0; j < vector_size; ++j) {
      float val = ((float*)&input_vec)[j];
      ((float*)&result_vec)[j] = fabsf(val);
    }
    
    dst_ptr.store<0>(result_vec);
  }

  // Handle remaining elements
  int offset = vector_count * vector_size;
  for (int i = 0; i < size % vector_size; ++i) {
    output[offset + i] = fabsf(input[offset + i]);
  }
}

// Advanced Absolute Value with fused operations
__co_device__ void abs_kernel_advanced(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
}
}

// Version 1: Basic Absolute Value implementation (parallel by 1, simple approach)
__co__ f32[batch, seq, hidden] abs_basic(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 1 {
    parallel q by 1 {
      // Use simple DMA copy and kernel call approach
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call basic kernel
      call abs_kernel_basic(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Version 2: Optimized Absolute Value implementation using TCLE API
__co__ f32[batch, seq, hidden] abs_optimized(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call optimized kernel
      call abs_kernel_optimized(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Version 3: Direct computation without call (using choreo-compute-logic)
__co__ f32[batch, seq, hidden] abs_direct(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      
      // Call basic kernel for direct computation
      call abs_kernel_basic(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Version 4: TCLE-based implementation with vectorized operations
__co__ f32[batch, seq, hidden] abs_tcle(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      
      // Call TCLE-based kernel
      call abs_kernel_tcle(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// Advanced Absolute Value implementation with fused operations
__co__ f32[batch, seq, hidden] abs_advanced(f32[batch, seq, hidden] input) {
  f32[batch, seq, hidden] output;
  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] input_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
      input_load = dma.copy input.chunkat(p, q, _) => local;
      // Call advanced kernel
      call abs_kernel_advanced(input_load.data, output_local, input_load.span(0), input_load.span(1), input_load.span(2));
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }
  return output;
}

// C++ reference implementation for correctness verification
void abs_reference(float* input, float* output, int size) {
  printf("[ref] size=%d, input[0]=%f\n", size, input[0]);
  for (int i = 0; i < size; ++i) {
    output[i] = fabsf(input[i]);
  }
  printf("[ref] output[0]=%f\n", output[0]);
}

int main() {
  const int BATCH = 16;
  const int SEQ = 32;
  const int HIDDEN = 64;
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  auto input_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  input_data.fill_random(-10.0, 10.0);
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  abs_reference((float*)a, ref_output, BATCH * SEQ * HIDDEN);
  
  // Test Version 1: Basic implementation
  auto start1 = std::chrono::high_resolution_clock::now();
  auto res_basic = abs_basic(input_data);
  auto end1 = std::chrono::high_resolution_clock::now();
  auto duration_basic = std::chrono::duration_cast<std::chrono::microseconds>(end1 - start1);
  
  // Test Version 2: Optimized implementation
  auto start2 = std::chrono::high_resolution_clock::now();
  auto res_optimized = abs_optimized(input_data);
  auto end2 = std::chrono::high_resolution_clock::now();
  auto duration_optimized = std::chrono::duration_cast<std::chrono::microseconds>(end2 - start2);
  
  // Test Version 3: Direct computation implementation
  auto start3 = std::chrono::high_resolution_clock::now();
  auto res_direct = abs_direct(input_data);
  auto end3 = std::chrono::high_resolution_clock::now();
  auto duration_direct = std::chrono::duration_cast<std::chrono::microseconds>(end3 - start3);
  
  // Test Version 4: TCLE implementation
  auto start4 = std::chrono::high_resolution_clock::now();
  auto res_tcle = abs_tcle(input_data);
  auto end4 = std::chrono::high_resolution_clock::now();
  auto duration_tcle = std::chrono::duration_cast<std::chrono::microseconds>(end4 - start4);
  
  // Test advanced implementation
  auto start5 = std::chrono::high_resolution_clock::now();
  auto res_advanced = abs_advanced(input_data);
  auto end5 = std::chrono::high_resolution_clock::now();
  auto duration_advanced = std::chrono::duration_cast<std::chrono::microseconds>(end5 - start5);
  
  bool all_correct = true;
  for (size_t i = 0; i < BATCH; ++i) {
    for (size_t j = 0; j < SEQ; ++j) {
      for (size_t k = 0; k < HIDDEN; ++k) {
        float ref = ref_output[i * SEQ * HIDDEN + j * HIDDEN + k];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float direct_val = res_direct[i][j][k];
        float tcle_val = res_tcle[i][j][k];
        float advanced_val = res_advanced[i][j][k];
        if (std::abs(basic_val - ref) > 1e-5 || std::abs(optimized_val - ref) > 1e-5 || 
            std::abs(direct_val - ref) > 1e-5 || std::abs(tcle_val - ref) > 1e-5 || 
            std::abs(advanced_val - ref) > 1e-5) {
          std::cout << "Verification failed at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Basic: " << basic_val << std::endl;
          std::cout << "Optimized: " << optimized_val << std::endl;
          std::cout << "Direct: " << direct_val << std::endl;
          std::cout << "TCLE: " << tcle_val << std::endl;
          std::cout << "Advanced: " << advanced_val << std::endl;
          std::cout << "Input[" << i << "][" << j << "][" << k << "] = " << a[i * SEQ * HIDDEN + j * HIDDEN + k] << std::endl;
          std::cout << "Expected: " << fabsf(a[i * SEQ * HIDDEN + j * HIDDEN + k]) << std::endl;
          all_correct = false;
          break;
        }
      }
      if (!all_correct) break;
    }
    if (!all_correct) break;
  }
  if (all_correct) {
    std::cout << "Absolute Value Test Passed" << std::endl;
  } else {
    std::cout << "Absolute Value Test Failed" << std::endl;
  }
  std::cout << "Version 1 (Basic) execution time: " << duration_basic.count() << " microseconds" << std::endl;
  std::cout << "Version 2 (Optimized) execution time: " << duration_optimized.count() << " microseconds" << std::endl;
  std::cout << "Version 3 (Direct) execution time: " << duration_direct.count() << " microseconds" << std::endl;
  std::cout << "Version 4 (TCLE) execution time: " << duration_tcle.count() << " microseconds" << std::endl;
  std::cout << "Advanced execution time: " << duration_advanced.count() << " microseconds" << std::endl;
}
// CHECK: Absolute Value Test Passed
