// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>
#include <cmath>

__cok__ {
// Basic ReLU kernel implementation
__co_device__ void relu_kernel_basic(float* input, float* output, int m, int n, int k) {
  int size = m * n * k;
  printf("Kernel - Input[0]: %f, Input[1]: %f, Input[2]: %f\n", input[0], input[1], input[2]);
  for (int i = 0; i < size; ++i) {
    output[i] = input[i] > 0.0f ? input[i] : 0.0f;
  }
  printf("Kernel - Output[0]: %f, Output[1]: %f, Output[2]: %f\n", output[0], output[1], output[2]);
}

// Optimized ReLU kernel using TCLE API
__co_device__ void relu_kernel_optimized(float* input, float* output, int m, int n, int k) {
  using vtype = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
  int size = m * n * k;
  int vlength = tcle::altivector_step<vtype>();
  int loop_num = (size + vlength - 1) / vlength;
  printf("Optimized - Size: %d, VLength: %d, LoopNum: %d\n", size, vlength, loop_num);
  tcle::leaptr<vtype> input_ptr = tcle::simple_leaptr<vtype>(input);
  tcle::leaptr<vtype> output_ptr = tcle::simple_leaptr<vtype>(output);
  for (int i = 0; i < loop_num; ++i) {
    vtype input_vec = input_ptr.load();
    for (int j = 0; j < vlength && i * vlength + j < size; ++j) {
      float val = ((float*)&input_vec)[j];
      ((float*)&input_vec)[j] = val > 0.0f ? val : 0.0f;
    }
    output_ptr.store(input_vec);
  }
  printf("Optimized - Output[0]: %f, Output[1]: %f\n", output[0], output[1]);
}

// Advanced ReLU kernel with double buffering
__co_device__ void relu_kernel_advanced(float* input, float* output, int m, int n, int k) {
  using vtype = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
  
  int size = m * n * k;
  int vlength = tcle::altivector_step<vtype>();
  int loop_num = (size + vlength - 1) / vlength;
  
  tcle::leaptr<vtype> input_ptr = tcle::simple_leaptr<vtype>(input);
  tcle::leaptr<vtype> output_ptr = tcle::simple_leaptr<vtype>(output);
  
  // Double buffering for better memory throughput
  vtype buffer[2];
  int buffer_idx = 0;
  
  for (int i = 0; i < loop_num; ++i) {
    // Load next batch while processing current
    vtype input_vec = input_ptr.load();
    buffer[buffer_idx] = input_vec;
    
    // Process previous batch
    if (i > 0) {
      vtype prev_input = buffer[1 - buffer_idx];
      for (int j = 0; j < vlength && (i-1) * vlength + j < size; ++j) {
        float val = ((float*)&prev_input)[j];
        ((float*)&prev_input)[j] = val > 0.0f ? val : 0.0f;
      }
      output_ptr.store(prev_input);
    }
    
    buffer_idx = 1 - buffer_idx;
  }
  
  // Process last batch
  if (loop_num > 0) {
    vtype last_input = buffer[1 - buffer_idx];
    for (int j = 0; j < vlength && (loop_num-1) * vlength + j < size; ++j) {
      float val = ((float*)&last_input)[j];
      ((float*)&last_input)[j] = val > 0.0f ? val : 0.0f;
    }
    output_ptr.store(last_input);
  }
}
}

// Basic ReLU implementation - worst performance
__co__ f32[batch, seq, hidden] relu_basic(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 12 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call basic kernel
      call relu_kernel_basic(x_load.data, y_local, x_local.span(0), x_local.span(1), x_local.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// Optimized ReLU implementation using TCLE API
__co__ f32[batch, seq, hidden] relu_optimized(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 12 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call optimized kernel with TCLE API
      call relu_kernel_optimized(x_load.data, y_local, x_local.span(0), x_local.span(1), x_local.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// Advanced ReLU implementation with double buffering
__co__ f32[batch, seq, hidden] relu_advanced(f32[batch, seq, hidden] X) {
  f32[batch, seq, hidden] Y;

  parallel p by 2 {
    parallel q by 12 {
      local f32[batch/#p, seq/#q, hidden] x_local;
      local f32[batch/#p, seq/#q, hidden] y_local;
    
      x_load = dma.copy X.chunkat(p, q, _) => local;
    
      // Call advanced kernel with double buffering
      call relu_kernel_advanced(x_load.data, y_local, x_local.span(0), x_local.span(1), x_local.span(2));
    
      dma.copy y_local => Y.chunkat(p, q, _);
    }
  }

  return Y;
}

// C++ reference implementation for correctness verification
void relu_reference(float* input, float* output, int size) {
  for (int i = 0; i < size; ++i) {
    output[i] = input[i] > 0.0f ? input[i] : 0.0f;
  }
}

int main() {
  const int BATCH = 16;
  const int SEQ = 36;
  const int HIDDEN = 64;
  
  // Initialize input data
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  auto input_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  input_data.fill_random(-1.0, 1.0);

  // Reference implementation
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  relu_reference((float*)a, ref_output, BATCH * SEQ * HIDDEN);

  // Test basic implementation
  auto start1 = std::chrono::high_resolution_clock::now();
  auto res_basic = relu_basic(input_data);
  auto end1 = std::chrono::high_resolution_clock::now();
  auto duration_basic = std::chrono::duration_cast<std::chrono::microseconds>(end1 - start1);

  // Test optimized implementation
  auto start2 = std::chrono::high_resolution_clock::now();
  auto res_optimized = relu_optimized(input_data);
  auto end2 = std::chrono::high_resolution_clock::now();
  auto duration_optimized = std::chrono::duration_cast<std::chrono::microseconds>(end2 - start2);

  // Test advanced implementation
  auto start3 = std::chrono::high_resolution_clock::now();
  auto res_advanced = relu_advanced(input_data);
  auto end3 = std::chrono::high_resolution_clock::now();
  auto duration_advanced = std::chrono::duration_cast<std::chrono::microseconds>(end3 - start3);

  // Verification with debug info
  bool all_correct = true;
  std::cout << "Debug - First few reference values:" << std::endl;
  for (size_t i = 0; i < 3; ++i) {
    std::cout << "ref[" << i << "]: " << ref_output[i] << std::endl;
  }
  
  std::cout << "Debug - First few basic values:" << std::endl;
  for (size_t i = 0; i < 3; ++i) {
    std::cout << "basic[" << i << "]: " << res_basic[0][0][i] << std::endl;
  }
  
  std::cout << "Debug - First few optimized values:" << std::endl;
  for (size_t i = 0; i < 3; ++i) {
    std::cout << "optimized[" << i << "]: " << res_optimized[0][0][i] << std::endl;
  }
  
  for (size_t i = 0; i < BATCH; ++i) {
    for (size_t j = 0; j < SEQ; ++j) {
      for (size_t k = 0; k < HIDDEN; ++k) {
        float ref = ref_output[i * SEQ * HIDDEN + j * HIDDEN + k];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float advanced_val = res_advanced[i][j][k];
        
        if (std::abs(basic_val - ref) > 1e-6 || 
            std::abs(optimized_val - ref) > 1e-6 || 
            std::abs(advanced_val - ref) > 1e-6) {
          std::cout << "Verification failed at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Basic: " << basic_val << std::endl;
          std::cout << "Optimized: " << optimized_val << std::endl;
          std::cout << "Advanced: " << advanced_val << std::endl;
          all_correct = false;
          break;
        }
      }
      if (!all_correct) break;
    }
    if (!all_correct) break;
  }

  if (all_correct) {
    std::cout << "ReLU Test Passed" << std::endl;
  } else {
    std::cout << "ReLU Test Failed" << std::endl;
  }

  std::cout << "Function <relu_basic> execution time: " << duration_basic.count() << " microseconds" << std::endl;
  std::cout << "Function <relu_optimized> execution time: " << duration_optimized.count() << " microseconds" << std::endl;
  std::cout << "Function <relu_advanced> execution time: " << duration_advanced.count() << " microseconds" << std::endl;
}

// CHECK: ReLU Test Passed 