// Elementwise Add TCLE Version 2
__co__ f32[batch, seq, dim] add_tcle_2(f32[batch, seq, dim] A, f32[batch, seq, dim] B) {
    f32[batch, seq, dim] C;
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void add_kernel(float* a_ptr, float* b_ptr, float* c_ptr, int size) {
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto a_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)a_ptr);
        auto b_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)b_ptr);
        auto c_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)c_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 按向量大小的块处理数据
        for (int i = 0; i < size; i += vec_len) {
            // 处理末尾可能的部分向量
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // 完整向量情况 - 加载，加法，存储
                vec_type a_vec = a_leaptr.load_at(i);
                vec_type b_vec = b_leaptr.load_at(i);
                
                // 向量化加法
                vec_type c_vec = tcle::vadd<vec_type>(a_vec, b_vec);
                
                // 存储结果
                c_leaptr.store_at(c_vec, i);
            } else {
                // 部分向量情况（边缘情况）
                for (int j = 0; j < remaining; j++) {
                    c_ptr[i + j] = a_ptr[i + j] + b_ptr[i + j];
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构
    parallel b by batch {
        local f32[seq, dim] A_local;
        local f32[seq, dim] B_local;
        local f32[seq, dim] C_local;
        
        // 复制输入数据到本地内存
        dma.copy A.chunkat(b, _, _) => A_local;
        dma.copy B.chunkat(b, _, _) => B_local;
        
        // 计算元素级加法
        int total_elements = seq * dim;
        __call_tcle add_kernel(A_local.data, B_local.data, C_local.data, total_elements);
        
        // 复制结果到输出
        dma.copy C_local => C.chunkat(b, _, _);
    }
    
    return C;
} 