// Elementwise Multiply TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, dim] mul_tiling_3(f32[batch, seq, dim] A, f32[batch, seq, dim] B) {
    f32[batch, seq, dim] C;
    
    // 内存层级大小
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // 假设 f32 (4 bytes)，L1 中最大元素数 = 1.5MB / 4 = 375K 元素
    // 对于乘法我们需要：A_tile + B_tile + C_tile 在 L1 中，所以每个大约 ~125K 元素
    
    // 向量长度优化参数
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // 定义分块大小以优化缓存使用
    // 对于元素级操作如乘法，我们可以使用较大的分块
    const int SEQ_TILE = 256;  // 序列维度分块大小
    const int DIM_TILE = 512;  // 特征维度分块大小（VL 的倍数）
    
    // 对于 L2 缓存，我们可以处理更大的批次
    const int SEQ_TILE_L2 = 1024; // L2 序列维度分块
    const int DIM_TILE_L2 = 2048; // L2 特征维度分块
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void mul_kernel(
        float* a_ptr, float* b_ptr, float* c_ptr, int size) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto a_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)a_ptr);
        auto b_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)b_ptr);
        auto c_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)c_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 按向量大小的块处理数据
        for (int i = 0; i < size; i += vec_len) {
            // 处理末尾可能的部分向量
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // 完整向量情况 - 加载，乘法，存储
                vec_type a_vec = a_leaptr.load_at(i);
                vec_type b_vec = b_leaptr.load_at(i);
                
                // 向量化乘法
                vec_type c_vec = tcle::vmul<vec_type>(a_vec, b_vec);
                
                // 存储结果
                c_leaptr.store_at(c_vec, i);
            } else {
                // 部分向量情况（边缘情况）
                for (int j = 0; j < remaining; j++) {
                    c_ptr[i + j] = a_ptr[i + j] * b_ptr[i + j];
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构与分层分块
    parallel b by batch {
        // 使用共享内存处理适合 L2 的大块
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] A_shared;
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] B_shared;
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] C_shared;
        
        // 处理 L2 分块
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            
            for (int d = 0; d < dim; d += DIM_TILE_L2) {
                int d_end_l2 = min(d + DIM_TILE_L2, dim);
                
                // 计算实际分块大小
                int seq_tile_size_l2 = s_end_l2 - s;
                int dim_tile_size_l2 = d_end_l2 - d;
                
                // 复制输入分块到共享内存
                dma.copy A.chunkat(b, s:s_end_l2, d:d_end_l2) => A_shared.chunkat(0:seq_tile_size_l2, 0:dim_tile_size_l2);
                dma.copy B.chunkat(b, s:s_end_l2, d:d_end_l2) => B_shared.chunkat(0:seq_tile_size_l2, 0:dim_tile_size_l2);
                
                // 处理 L1 分块
                for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                    int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                    
                    for (int d_l1 = 0; d_l1 < dim_tile_size_l2; d_l1 += DIM_TILE) {
                        int d_end_l1 = min(d_l1 + DIM_TILE, dim_tile_size_l2);
                        
                        // 计算实际 L1 分块大小
                        int seq_tile_size_l1 = s_end_l1 - s_l1;
                        int dim_tile_size_l1 = d_end_l1 - d_l1;
                        
                        // 创建 L1 分块
                        local f32[seq_tile_size_l1, dim_tile_size_l1] A_local;
                        local f32[seq_tile_size_l1, dim_tile_size_l1] B_local;
                        local f32[seq_tile_size_l1, dim_tile_size_l1] C_local;
                        
                        // 从共享内存复制到本地内存
                        dma.copy A_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1) => A_local;
                        dma.copy B_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1) => B_local;
                        
                        // 计算分块中的总元素数
                        int total_elements = seq_tile_size_l1 * dim_tile_size_l1;
                        
                        // 调用优化的 TCLE 内核计算乘法
                        __call_tcle mul_kernel(
                            A_local.data, 
                            B_local.data, 
                            C_local.data,
                            total_elements
                        );
                        
                        // 结果复制回共享内存
                        dma.copy C_local => C_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1);
                    }
                }
                
                // 将处理后的 L2 分块复制到输出
                dma.copy C_shared.chunkat(0:seq_tile_size_l2, 0:dim_tile_size_l2) => C.chunkat(b, s:s_end_l2, d:d_end_l2);
            }
        }
    }
    
    return C;
} 