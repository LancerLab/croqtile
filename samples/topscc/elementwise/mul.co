// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#include "choreo.h"
#include <chrono>

__cok__ {
// Version 1: Basic Element-wise Multiplication kernel (parallel by 1)
__co_device__ void mul_kernel_basic(float* lhs, float* rhs, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = lhs[i] * rhs[i];
  }
}

// Version 2: Optimized Element-wise Multiplication kernel using TCLE API
__co_device__ void mul_kernel_optimized(float* lhs, float* rhs, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    output[i] = lhs[i] * rhs[i];
  }
}

// Version 4: TCLE-based Element-wise Multiplication kernel using __vector float (4xfloat, 128bit)
__co_device__ void mul_kernel_tcle(float* lhs, float* rhs, float* output, int m, int n, int k) {
  int size = m * n * k;

  // Use TCLE leaptr for vectorized memory access (float4 = 4*4=16 bytes)
  auto lhs_ptr = tcle::leaptr<__vector float, 1>(lhs, sizeof(__vector float));
  auto rhs_ptr = tcle::leaptr<__vector float, 1>(rhs, sizeof(__vector float));
  auto dst_ptr = tcle::leaptr<__vector float, 1>(output, sizeof(__vector float));

  int vector_size = 4; // __vector float
  int vector_count = size / vector_size;

  for (int i = 0; i < vector_count; ++i) {
    __vector float lhs_vec = lhs_ptr.load<0>();
    __vector float rhs_vec = rhs_ptr.load<0>();
    __vector float result = lhs_vec * rhs_vec;
    dst_ptr.store<0>(result);
  }

  // Handle remaining elements
  int offset = vector_count * vector_size;
  for (int i = 0; i < size % vector_size; ++i) {
    output[offset + i] = lhs[offset + i] * rhs[offset + i];
  }
}

// Advanced Element-wise Multiplication with fused multiply-add
__co_device__ void mul_kernel_advanced(float* lhs, float* rhs, float* output, int m, int n, int k) {
  int size = m * n * k;
  
  // Simple vectorized implementation without TCLE API for now
  for (int i = 0; i < size; ++i) {
    output[i] = lhs[i] * rhs[i];
  }
  
  // TODO: Implement proper TCLE vectorization when API is stable
  // The original TCLE implementation had pointer increment issues
}

// Fast Element-wise Multiplication with early zero detection
__co_device__ void mul_kernel_fast(float* lhs, float* rhs, float* output, int m, int n, int k) {
  int size = m * n * k;
  for (int i = 0; i < size; ++i) {
    float lhs_val = lhs[i];
    float rhs_val = rhs[i];
    
    // Early zero detection for better performance
    if (lhs_val == 0.0f || rhs_val == 0.0f) {
      output[i] = 0.0f;
    } else {
      output[i] = lhs_val * rhs_val;
    }
  }
}
}

// Version 1: Basic Element-wise Multiplication implementation (parallel by 1, simple approach)
__co__ f32[batch, seq, hidden] mul_basic(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 1 {
    parallel q by 1 {
      // Use simple DMA copy and kernel call approach
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call basic kernel
      call mul_kernel_basic(lhs_load.data, rhs_load.data, output_local, 
                           lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Version 2: Optimized Element-wise Multiplication implementation using TCLE API
__co__ f32[batch, seq, hidden] mul_optimized(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call optimized kernel with TCLE API
      call mul_kernel_optimized(lhs_load.data, rhs_load.data, output_local,
                               lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Version 3: Direct computation without call (using choreo-compute-logic)
__co__ f32[batch, seq, hidden] mul_direct(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call basic kernel for direct computation
      call mul_kernel_basic(lhs_load.data, rhs_load.data, output_local, lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Version 4: TCLE-based implementation with vectorized operations
__co__ f32[batch, seq, hidden] mul_tcle(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call TCLE-based kernel
      call mul_kernel_tcle(lhs_load.data, rhs_load.data, output_local,
                          lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Advanced Element-wise Multiplication implementation with fused operations
__co__ f32[batch, seq, hidden] mul_advanced(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call advanced kernel with fused operations
      call mul_kernel_advanced(lhs_load.data, rhs_load.data, output_local,
                              lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// Fast Element-wise Multiplication implementation with early zero detection
__co__ f32[batch, seq, hidden] mul_fast(f32[batch, seq, hidden] lhs, f32[batch, seq, hidden] rhs) {
  f32[batch, seq, hidden] output;

  parallel p by 2 {
    parallel q by 4 {
      local f32[batch/#p, seq/#q, hidden] lhs_local;
      local f32[batch/#p, seq/#q, hidden] rhs_local;
      local f32[batch/#p, seq/#q, hidden] output_local;
    
      lhs_load = dma.copy lhs.chunkat(p, q, _) => local;
      rhs_load = dma.copy rhs.chunkat(p, q, _) => local;
    
      // Call fast kernel with early zero detection
      call mul_kernel_fast(lhs_load.data, rhs_load.data, output_local,
                          lhs_load.span(0), lhs_load.span(1), lhs_load.span(2));
    
      dma.copy output_local => output.chunkat(p, q, _);
    }
  }

  return output;
}

// C++ reference implementation for correctness verification
void mul_reference(float* lhs, float* rhs, float* output, int size) {
  for (int i = 0; i < size; ++i) {
    output[i] = lhs[i] * rhs[i];
  }
}

int main() {
  const int BATCH = 16;
  const int SEQ = 32;
  const int HIDDEN = 64;
  
  // Initialize input data
  choreo::f32 a[BATCH * SEQ * HIDDEN];
  choreo::f32 b[BATCH * SEQ * HIDDEN];
  auto lhs_data = choreo::make_spanview<3, choreo::f32>((float*)a, {BATCH, SEQ, HIDDEN});
  auto rhs_data = choreo::make_spanview<3, choreo::f32>((float*)b, {BATCH, SEQ, HIDDEN});
  lhs_data.fill_random(-5.0, 5.0);
  rhs_data.fill_random(-5.0, 5.0);

  // Reference implementation
  choreo::f32 ref_output[BATCH * SEQ * HIDDEN];
  mul_reference((float*)a, (float*)b, ref_output, BATCH * SEQ * HIDDEN);

  // Test Version 1: Basic implementation
  auto start1 = std::chrono::high_resolution_clock::now();
  auto res_basic = mul_basic(lhs_data, rhs_data);
  auto end1 = std::chrono::high_resolution_clock::now();
  auto duration_basic = std::chrono::duration_cast<std::chrono::microseconds>(end1 - start1);

  // Test Version 2: Optimized implementation
  auto start2 = std::chrono::high_resolution_clock::now();
  auto res_optimized = mul_optimized(lhs_data, rhs_data);
  auto end2 = std::chrono::high_resolution_clock::now();
  auto duration_optimized = std::chrono::duration_cast<std::chrono::microseconds>(end2 - start2);

  // Test Version 3: Direct computation implementation
  auto start3 = std::chrono::high_resolution_clock::now();
  auto res_direct = mul_direct(lhs_data, rhs_data);
  auto end3 = std::chrono::high_resolution_clock::now();
  auto duration_direct = std::chrono::duration_cast<std::chrono::microseconds>(end3 - start3);

  // Test Version 4: TCLE implementation
  auto start4 = std::chrono::high_resolution_clock::now();
  auto res_tcle = mul_tcle(lhs_data, rhs_data);
  auto end4 = std::chrono::high_resolution_clock::now();
  auto duration_tcle = std::chrono::duration_cast<std::chrono::microseconds>(end4 - start4);

  // Test advanced implementation
  auto start5 = std::chrono::high_resolution_clock::now();
  auto res_advanced = mul_advanced(lhs_data, rhs_data);
  auto end5 = std::chrono::high_resolution_clock::now();
  auto duration_advanced = std::chrono::duration_cast<std::chrono::microseconds>(end5 - start5);

  // Test fast implementation
  auto start6 = std::chrono::high_resolution_clock::now();
  auto res_fast = mul_fast(lhs_data, rhs_data);
  auto end6 = std::chrono::high_resolution_clock::now();
  auto duration_fast = std::chrono::duration_cast<std::chrono::microseconds>(end6 - start6);

  // Verification
  bool all_correct = true;
  for (size_t i = 0; i < BATCH; ++i) {
    for (size_t j = 0; j < SEQ; ++j) {
      for (size_t k = 0; k < HIDDEN; ++k) {
        float ref = ref_output[i * SEQ * HIDDEN + j * HIDDEN + k];
        float basic_val = res_basic[i][j][k];
        float optimized_val = res_optimized[i][j][k];
        float direct_val = res_direct[i][j][k];
        float tcle_val = res_tcle[i][j][k];
        float advanced_val = res_advanced[i][j][k];
        float fast_val = res_fast[i][j][k];
        
        // Check all implementations against reference
        if (std::abs(basic_val - ref) > 1e-6 || 
            std::abs(optimized_val - ref) > 1e-6 ||
            std::abs(direct_val - ref) > 1e-6 ||
            std::abs(tcle_val - ref) > 1e-6 ||
            std::abs(advanced_val - ref) > 1e-6 ||
            std::abs(fast_val - ref) > 1e-6) {
          std::cout << "Verification failed at [" << i << "," << j << "," << k << "]" << std::endl;
          std::cout << "Reference: " << ref << std::endl;
          std::cout << "Basic: " << basic_val << std::endl;
          std::cout << "Optimized: " << optimized_val << std::endl;
          std::cout << "Direct: " << direct_val << std::endl;
          std::cout << "TCLE: " << tcle_val << std::endl;
          std::cout << "Advanced: " << advanced_val << std::endl;
          std::cout << "Fast: " << fast_val << std::endl;
          all_correct = false;
          break;
        }
      }
      if (!all_correct) break;
    }
    if (!all_correct) break;
  }

  if (all_correct) {
    std::cout << "Element-wise Multiplication Test Passed" << std::endl;
  } else {
    std::cout << "Element-wise Multiplication Test Failed" << std::endl;
  }

  std::cout << "Version 1 (Basic) execution time: " << duration_basic.count() << " microseconds" << std::endl;
  std::cout << "Version 2 (Optimized) execution time: " << duration_optimized.count() << " microseconds" << std::endl;
  std::cout << "Version 3 (Direct) execution time: " << duration_direct.count() << " microseconds" << std::endl;
  std::cout << "Version 4 (TCLE) execution time: " << duration_tcle.count() << " microseconds" << std::endl;
  std::cout << "Advanced execution time: " << duration_advanced.count() << " microseconds" << std::endl;
  std::cout << "Fast execution time: " << duration_fast.count() << " microseconds" << std::endl;
}

// CHECK: Element-wise Multiplication Test Passed 