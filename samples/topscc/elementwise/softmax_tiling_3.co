// Softmax TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, dim] softmax_tiling_3(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // Memory hierarchy sizes
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // Assuming f32 (4 bytes), max elements in L1 = 1.5MB / 4 = 375K elements
    // For Softmax we need: input + output + temporary storage in L1
    
    // Vector length for optimization
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // Define tile sizes for optimal cache usage
    // For Softmax, we need to compute across the entire dim dimension
    // So we'll tile primarily in the seq dimension
    const int SEQ_TILE = 128; // Sequence dimension tile
    
    // For L2 cache, we can process larger batches
    const int SEQ_TILE_L2 = 512; // L2 sequence dimension tile
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void softmax_kernel(
        float* input_ptr, float* output_ptr, 
        int seq_len, int dim_size) {
        
        // Use TCLE vector types for optimal performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Create leaptrs for vectorized memory access
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // Vector length for this platform
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Allocate temp storage for the largest possible exponential values
        // Each sequence needs dim_size elements of temporary storage
        float* exp_values = (float*)tcle::malloc(dim_size * sizeof(float));
        
        // Process each sequence in the tile
        for (int s = 0; s < seq_len; s++) {
            int seq_offset = s * dim_size;
            
            // Step 1: Find maximum value for numerical stability
            float max_val = -INFINITY;
            for (int d = 0; d < dim_size; d++) {
                max_val = tcle::max(max_val, input_ptr[seq_offset + d]);
            }
            
            // Step 2: Compute shifted exponentials
            float sum_exp = 0.0f;
            for (int d = 0; d < dim_size; d++) {
                // Subtract max for numerical stability
                float shifted_val = input_ptr[seq_offset + d] - max_val;
                float exp_val = tcle::exp(shifted_val);
                exp_values[d] = exp_val;
                sum_exp += exp_val;
            }
            
            // Step 3: Normalize the exponentials to get softmax
            vec_type sum_exp_vec = tcle::vbroadcast<vec_type>(sum_exp);
            
            // Process dim in vector-sized chunks
            for (int d = 0; d < dim_size; d += vec_len) {
                // Handle potential partial vectors at the end
                int remaining = tcle::min(vec_len, dim_size - d);
                
                if (remaining == vec_len) {
                    // Full vector case - load exponentials and normalize
                    vec_type exp_vec = tcle::vload<vec_type>(&exp_values[d]);
                    
                    // Normalize by dividing by sum
                    vec_type softmax_vec = tcle::vdiv<vec_type>(exp_vec, sum_exp_vec);
                    
                    // Store result
                    output_leaptr.store_at(softmax_vec, seq_offset + d);
                } else {
                    // Partial vector case (edge case)
                    for (int j = 0; j < remaining; j++) {
                        output_ptr[seq_offset + d + j] = exp_values[d + j] / sum_exp;
                    }
                }
            }
        }
        
        // Free temporary storage
        tcle::free(exp_values);
    }
    } // __cok__
    
    // Main parallel structure with hierarchical tiling
    parallel b by batch {
        // Use shared memory for larger blocks that fit in L2
        shared f32[SEQ_TILE_L2, dim] X_shared;
        shared f32[SEQ_TILE_L2, dim] Y_shared;
        
        // Process L2 tiles
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_tile_size_l2 = s_end_l2 - s;
            
            // Copy input tile to shared memory
            dma.copy X.chunkat(b, s:s_end_l2, _) => X_shared.chunkat(0:seq_tile_size_l2, _);
            
            // Process L1 tiles within this L2 tile
            for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                int seq_tile_size_l1 = s_end_l1 - s_l1;
                
                // Create L1 tiles for processing
                local f32[seq_tile_size_l1, dim] X_local;
                local f32[seq_tile_size_l1, dim] Y_local;
                
                // Copy from shared to local memory
                dma.copy X_shared.chunkat(s_l1:s_end_l1, _) => X_local;
                
                // Call the optimized kernel for Softmax
                __call_tcle softmax_kernel(
                    X_local.data,
                    Y_local.data,
                    seq_tile_size_l1,
                    dim
                );
                
                // Copy results back to shared memory
                dma.copy Y_local => Y_shared.chunkat(s_l1:s_end_l1, _);
            }
            
            // Copy the processed L2 tile to output
            dma.copy Y_shared.chunkat(0:seq_tile_size_l2, _) => Y.chunkat(b, s:s_end_l2, _);
        }
    }
    
    return Y;
} 