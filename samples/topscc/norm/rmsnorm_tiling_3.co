// RMSNorm TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, dim] rmsnorm_tiling_3(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // 内存层级大小
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // 假设 f32 (4 bytes)，L1 中最大元素数 = 1.5MB / 4 = 375K 元素
    // 对于 RMSNorm 我们需要：输入 + 输出 + 临时变量在 L1 中
    
    // 向量长度优化参数
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // 定义分块大小以优化缓存使用
    // 对于 RMSNorm，我们需要对整个 dim 维度进行归一化
    // 所以我们主要在 seq 维度上进行分块
    const int SEQ_TILE = 128; // 序列维度分块（一次处理这么多序列）
    
    // 对于 L2 缓存，我们可以处理更大的批次
    const int SEQ_TILE_L2 = 512; // L2 序列维度分块
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void rmsnorm_kernel(
        float* input_ptr, float* output_ptr, 
        int seq_len, int dim_size, float epsilon) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 处理每个序列
        for (int s = 0; s < seq_len; s++) {
            int seq_offset = s * dim_size;
            
            // 计算均方根
            float sum_squared = 0.0f;
            for (int d = 0; d < dim_size; d++) {
                float val = input_ptr[seq_offset + d];
                sum_squared += val * val;
            }
            
            // 均方根
            float rms = tcle::sqrt(sum_squared / dim_size + epsilon);
            
            // 向量化归一化
            vec_type rms_vec = tcle::vbroadcast<vec_type>(rms);
            
            // 以向量大小为单位处理维度
            for (int d = 0; d < dim_size; d += vec_len) {
                // 处理末尾可能的部分向量
                int remaining = tcle::min(vec_len, dim_size - d);
                
                if (remaining == vec_len) {
                    // 完整向量情况
                    vec_type input_vec = input_leaptr.load_at(seq_offset + d);
                    
                    // 归一化: x / rms
                    vec_type normalized = tcle::vdiv<vec_type>(input_vec, rms_vec);
                    
                    // 存储结果
                    output_leaptr.store_at(normalized, seq_offset + d);
                } else {
                    // 部分向量情况（边缘情况）
                    for (int j = 0; j < remaining; j++) {
                        float val = input_ptr[seq_offset + d + j];
                        output_ptr[seq_offset + d + j] = val / rms;
                    }
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构与分层分块
    parallel b by batch {
        // 使用共享内存处理适合 L2 的大块
        shared f32[SEQ_TILE_L2, dim] X_shared;
        shared f32[SEQ_TILE_L2, dim] Y_shared;
        
        // 处理 L2 分块
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_tile_size_l2 = s_end_l2 - s;
            
            // 复制输入分块到共享内存
            dma.copy X.chunkat(b, s:s_end_l2, _) => X_shared.chunkat(0:seq_tile_size_l2, _);
            
            // 处理 L1 分块
            for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                int seq_tile_size_l1 = s_end_l1 - s_l1;
                
                // 创建 L1 分块
                local f32[seq_tile_size_l1, dim] X_local;
                local f32[seq_tile_size_l1, dim] Y_local;
                
                // 从共享内存复制到本地内存
                dma.copy X_shared.chunkat(s_l1:s_end_l1, _) => X_local;
                
                // 调用优化的内核计算 RMSNorm
                __call_tcle rmsnorm_kernel(
                    X_local.data,
                    Y_local.data,
                    seq_tile_size_l1,
                    dim,
                    1e-5f // epsilon
                );
                
                // 结果复制回共享内存
                dma.copy Y_local => Y_shared.chunkat(s_l1:s_end_l1, _);
            }
            
            // 将处理后的 L2 分块复制到输出
            dma.copy Y_shared.chunkat(0:seq_tile_size_l2, _) => Y.chunkat(b, s:s_end_l2, _);
        }
    }
    
    return Y;
} 