// LayerNorm Double Buffer Version 4 - Optimized with tiling and double buffering
__co__ f32[batch, seq, dim] layernorm_doublebuffer_4(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // Memory hierarchy sizes
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // Vector length for optimization
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // Define tile sizes for optimal cache usage
    // For LayerNorm, we need to normalize across the entire dim dimension
    // So we'll tile primarily in the seq dimension
    const int SEQ_TILE = 128; // Sequence dimension tile (process this many sequences at once)
    
    // For L2 cache, we can process larger batches
    const int SEQ_TILE_L2 = 512; // L2 sequence dimension tile
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void layernorm_kernel(
        float* input_ptr, float* output_ptr, 
        int seq_len, int dim_size, float epsilon) {
        
        // Use TCLE vector types for optimal performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Create leaptrs for vectorized memory access
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // Vector length for this platform
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Process each sequence in the tile
        for (int s = 0; s < seq_len; s++) {
            // Calculate mean
            float mean = 0.0f;
            for (int d = 0; d < dim_size; d++) {
                mean += input_ptr[s * dim_size + d];
            }
            mean /= dim_size;
            
            // Calculate variance
            float var = 0.0f;
            for (int d = 0; d < dim_size; d++) {
                float diff = input_ptr[s * dim_size + d] - mean;
                var += diff * diff;
            }
            var /= dim_size;
            
            // Calculate standard deviation
            float stddev = tcle::sqrt(var + epsilon);
            
            // Vectorized normalization
            vec_type mean_vec = tcle::vbroadcast<vec_type>(mean);
            vec_type stddev_vec = tcle::vbroadcast<vec_type>(stddev);
            
            // Process dim in vector-sized chunks
            for (int d = 0; d < dim_size; d += vec_len) {
                // Handle potential partial vectors at the end
                int remaining = tcle::min(vec_len, dim_size - d);
                
                if (remaining == vec_len) {
                    // Full vector case
                    vec_type input_vec = input_leaptr.load_at(s * dim_size + d);
                    
                    // Normalize: (x - mean) / stddev
                    vec_type centered = tcle::vsub<vec_type>(input_vec, mean_vec);
                    vec_type normalized = tcle::vdiv<vec_type>(centered, stddev_vec);
                    
                    // Store result
                    output_leaptr.store_at(normalized, s * dim_size + d);
                } else {
                    // Partial vector case (edge case)
                    for (int j = 0; j < remaining; j++) {
                        float val = input_ptr[s * dim_size + d + j];
                        output_ptr[s * dim_size + d + j] = (val - mean) / stddev;
                    }
                }
            }
        }
    }
    } // __cok__
    
    // Main parallel structure with hierarchical tiling and double buffering
    parallel b by batch {
        // Double buffers for L2 shared memory
        shared f32[2][SEQ_TILE_L2, dim] X_shared;
        shared f32[2][SEQ_TILE_L2, dim] Y_shared;
        
        // Buffer indices for L2
        int l2_buf_idx = 0;
        
        // Process L2 tiles with double buffering
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_tile_size_l2 = s_end_l2 - s;
            
            // Load first L2 tile into current buffer
            dma.copy X.chunkat(b, s:s_end_l2, _) => X_shared[l2_buf_idx].chunkat(0:seq_tile_size_l2, _);
            
            // Preload next L2 tile if not at the end
            if (s + SEQ_TILE_L2 < seq) {
                int next_s = s + SEQ_TILE_L2;
                int next_s_end_l2 = min(next_s + SEQ_TILE_L2, seq);
                int next_seq_tile_size_l2 = next_s_end_l2 - next_s;
                
                // Preload next tile to the other buffer
                dma.copy X.chunkat(b, next_s:next_s_end_l2, _) => X_shared[1-l2_buf_idx].chunkat(0:next_seq_tile_size_l2, _);
            }
            
            // Double buffers for L1 local memory
            local f32[2][SEQ_TILE, dim] X_local;
            local f32[2][SEQ_TILE, dim] Y_local;
            
            // Buffer indices for L1
            int l1_buf_idx = 0;
            
            // Process L1 tiles within this L2 tile with double buffering
            for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                int seq_tile_size_l1 = s_end_l1 - s_l1;
                
                // Load first L1 tile into current buffer
                dma.copy X_shared[l2_buf_idx].chunkat(s_l1:s_end_l1, _) => X_local[l1_buf_idx];
                
                // Preload next L1 tile if not at the end of the L2 tile
                if (s_l1 + SEQ_TILE < seq_tile_size_l2) {
                    int next_s_l1 = s_l1 + SEQ_TILE;
                    int next_s_end_l1 = min(next_s_l1 + SEQ_TILE, seq_tile_size_l2);
                    int next_seq_tile_size_l1 = next_s_end_l1 - next_s_l1;
                    
                    // Preload next tile to the other buffer
                    dma.copy X_shared[l2_buf_idx].chunkat(next_s_l1:next_s_end_l1, _) => X_local[1-l1_buf_idx];
                }
                
                // Call the optimized kernel for LayerNorm
                __call_tcle layernorm_kernel(
                    X_local[l1_buf_idx].data,
                    Y_local[l1_buf_idx].data,
                    seq_tile_size_l1,
                    dim,
                    1e-5f // epsilon
                );
                
                // Copy results back to shared memory
                dma.copy Y_local[l1_buf_idx] => Y_shared[l2_buf_idx].chunkat(s_l1:s_end_l1, _);
                
                // Swap L1 buffers for the next iteration
                l1_buf_idx = 1 - l1_buf_idx;
            }
            
            // Copy the processed L2 tile to output
            dma.copy Y_shared[l2_buf_idx].chunkat(0:seq_tile_size_l2, _) => Y.chunkat(b, s:s_end_l2, _);
            
            // Swap L2 buffers for the next iteration
            l2_buf_idx = 1 - l2_buf_idx;
        }
    }
    
    return Y;
} 