// GELU Activation TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, dim] gelu_tiling_3(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // 内存层级大小
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // 假设 f32 (4 bytes)，L1 中最大元素数 = 1.5MB / 4 = 375K 元素
    // 对于 GELU 我们需要：输入 + 输出在 L1 中，所以每个大约 ~187K 元素
    
    // 向量长度优化参数
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // 定义分块大小以优化缓存使用
    // 对于元素级操作如 GELU，我们可以使用较大的分块
    const int SEQ_TILE = 256;  // 序列维度分块大小
    const int DIM_TILE = 512;  // 特征维度分块大小（VL 的倍数）
    
    // 对于 L2 缓存，我们可以处理更大的批次
    const int SEQ_TILE_L2 = 1024; // L2 序列维度分块
    const int DIM_TILE_L2 = 2048; // L2 特征维度分块
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void gelu_kernel(
        float* input_ptr, float* output_ptr, int size) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // GELU 常量
        const float sqrt_2_over_pi = 0.7978845608028654f;  // sqrt(2/pi)
        const float coeff_a = 0.044715f;
        vec_type v_sqrt_2_over_pi = (vec_type)(sqrt_2_over_pi);
        vec_type v_coeff_a = (vec_type)(coeff_a);
        vec_type v_half = (vec_type)(0.5f);
        vec_type v_one = (vec_type)(1.0f);
        
        // 按向量大小的块处理数据
        for (int i = 0; i < size; i += vec_len) {
            // 处理末尾可能的部分向量
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // 完整向量情况 - 加载，处理，存储
                vec_type input_vec = input_leaptr.load_at(i);
                
                // 向量化 GELU: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
                // 计算 x^3 项
                vec_type x_squared = tcle::vmul<vec_type>(input_vec, input_vec);
                vec_type x_cubed = tcle::vmul<vec_type>(x_squared, input_vec);
                
                // 计算 0.044715 * x^3
                vec_type coeff_x_cubed = tcle::vmul<vec_type>(v_coeff_a, x_cubed);
                
                // 计算 x + 0.044715 * x^3
                vec_type inner_term = tcle::vadd<vec_type>(input_vec, coeff_x_cubed);
                
                // 计算 sqrt(2/pi) * (x + 0.044715 * x^3)
                vec_type scaled_term = tcle::vmul<vec_type>(v_sqrt_2_over_pi, inner_term);
                
                // 计算 tanh(sqrt(2/pi) * (x + 0.044715 * x^3))
                vec_type tanh_term = tcle::vtanh<vec_type>(scaled_term);
                
                // 计算 1 + tanh(...)
                vec_type one_plus_tanh = tcle::vadd<vec_type>(v_one, tanh_term);
                
                // 计算 0.5 * x * (1 + tanh(...))
                vec_type half_x = tcle::vmul<vec_type>(v_half, input_vec);
                vec_type output_vec = tcle::vmul<vec_type>(half_x, one_plus_tanh);
                
                // 存储结果
                output_leaptr.store_at(output_vec, i);
            } else {
                // 部分向量情况（边缘情况）
                for (int j = 0; j < remaining; j++) {
                    float x = input_ptr[i + j];
                    float x3 = x * x * x;
                    float inner = x + coeff_a * x3;
                    float tanh_term = tcle::tanh(sqrt_2_over_pi * inner);
                    output_ptr[i + j] = 0.5f * x * (1.0f + tanh_term);
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构与分层分块
    parallel b by batch {
        // 使用共享内存处理适合 L2 的大块
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] X_shared;
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] Y_shared;
        
        // 处理 L2 分块
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            
            for (int d = 0; d < dim; d += DIM_TILE_L2) {
                int d_end_l2 = min(d + DIM_TILE_L2, dim);
                
                // 计算实际分块大小
                int seq_tile_size_l2 = s_end_l2 - s;
                int dim_tile_size_l2 = d_end_l2 - d;
                
                // 复制输入分块到共享内存
                dma.copy X.chunkat(b, s:s_end_l2, d:d_end_l2) => X_shared.chunkat(0:seq_tile_size_l2, 0:dim_tile_size_l2);
                
                // 处理 L1 分块
                for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                    int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                    
                    for (int d_l1 = 0; d_l1 < dim_tile_size_l2; d_l1 += DIM_TILE) {
                        int d_end_l1 = min(d_l1 + DIM_TILE, dim_tile_size_l2);
                        
                        // 计算实际 L1 分块大小
                        int seq_tile_size_l1 = s_end_l1 - s_l1;
                        int dim_tile_size_l1 = d_end_l1 - d_l1;
                        
                        // 创建 L1 分块
                        local f32[seq_tile_size_l1, dim_tile_size_l1] X_local;
                        local f32[seq_tile_size_l1, dim_tile_size_l1] Y_local;
                        
                        // 从共享内存复制到本地内存
                        dma.copy X_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1) => X_local;
                        
                        // 计算分块中的总元素数
                        int total_elements = seq_tile_size_l1 * dim_tile_size_l1;
                        
                        // 调用优化的 TCLE 内核计算 GELU
                        __call_tcle gelu_kernel(
                            X_local.data, 
                            Y_local.data, 
                            total_elements
                        );
                        
                        // 结果复制回共享内存
                        dma.copy Y_local => Y_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1);
                    }
                }
                
                // 将处理后的 L2 分块复制到输出
                dma.copy Y_shared.chunkat(0:seq_tile_size_l2, 0:dim_tile_size_l2) => Y.chunkat(b, s:s_end_l2, d:d_end_l2);
            }
        }
    }
    
    return Y;
} 