// SiLU Activation TCLE Version 2
__co__ f32[batch, seq, dim] silu_tcle_2(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void silu_kernel(float* input_ptr, float* output_ptr, int size) {
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 按向量大小的块处理数据
        for (int i = 0; i < size; i += vec_len) {
            // 处理末尾可能的部分向量
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // 完整向量情况 - 加载，处理，存储
                vec_type input_vec = input_leaptr.load_at(i);
                
                // 向量化 SiLU: x * sigmoid(x)
                vec_type neg_input_vec = tcle::vneg<vec_type>(input_vec);
                vec_type exp_neg_input = tcle::vexp<vec_type>(neg_input_vec);
                vec_type ones = (vec_type)(1.0f);
                vec_type denom = tcle::vadd<vec_type>(ones, exp_neg_input);
                vec_type sigmoid_vec = tcle::vdiv<vec_type>(ones, denom);
                vec_type output_vec = tcle::vmul<vec_type>(input_vec, sigmoid_vec);
                
                // 存储结果
                output_leaptr.store_at(output_vec, i);
            } else {
                // 部分向量情况（边缘情况）
                for (int j = 0; j < remaining; j++) {
                    float val = input_ptr[i + j];
                    float sigmoid_val = 1.0f / (1.0f + tcle::exp(-val));
                    output_ptr[i + j] = val * sigmoid_val;
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构
    parallel b by batch {
        local f32[seq, dim] X_local;
        local f32[seq, dim] Y_local;
        
        // 复制输入数据到本地内存
        dma.copy X.chunkat(b, _, _) => X_local;
        
        // 计算 SiLU
        int total_elements = seq * dim;
        __call_tcle silu_kernel(X_local.data, Y_local.data, total_elements);
        
        // 复制结果到输出
        dma.copy Y_local => Y.chunkat(b, _, _);
    }
    
    return Y;
} 