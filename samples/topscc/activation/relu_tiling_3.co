// ReLU Activation TCLE Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, dim] relu_tcle_3(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // Memory hierarchy sizes
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // Assuming f32 (4 bytes), max elements in L1 = 1.5MB / 4 = 375K elements
    // For ReLU we need: input + output in L1, so ~187K elements each
    
    // Vector length for TCLE optimization
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // Define tile sizes to optimize cache usage
    // For element-wise ops like ReLU, we can use large tiles
    const int SEQ_TILE = 256;  // Sequence dimension tile size
    const int DIM_TILE = 512;  // Feature dimension tile size (multiple of VL)
    
    // Use larger tiles for L2 cache
    const int SEQ_TILE_L2 = 1024; // L2 sequence dimension tile
    const int DIM_TILE_L2 = 2048; // L2 feature dimension tile
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void relu_kernel(
        float* input_ptr, float* output_ptr, int size) {
        
        // Use TCLE vector types for optimal performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Create leaptrs for vectorized memory access
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // Vector length for this platform
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Process data in vector-sized chunks
        for (int i = 0; i < size; i += vec_len) {
            // Handle potential partial vectors at the end
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // Full vector case - load, process, store
                vec_type input_vec = input_leaptr.load_at(i);
                
                // Vectorized ReLU: max(0, x)
                vec_type zeros = (vec_type)(0.0f);
                vec_type output_vec = tcle::vmax<vec_type>(zeros, input_vec);
                
                // Store result
                output_leaptr.store_at(output_vec, i);
            } else {
                // Partial vector case (edge case)
                for (int j = 0; j < remaining; j++) {
                    float val = input_ptr[i + j];
                    output_ptr[i + j] = (val > 0.0f) ? val : 0.0f;
                }
            }
        }
    }
    } // __cok__
    
    // Main parallel structure with hierarchical tiling
    parallel b by batch {
        // Use shared memory for larger blocks that fit in L2
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] X_shared;
        shared f32[SEQ_TILE_L2, DIM_TILE_L2] Y_shared;
        
        // Process L2 tiles
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            
            for (int d = 0; d < dim; d += DIM_TILE_L2) {
                int d_end_l2 = min(d + DIM_TILE_L2, dim);
                
                // Copy input tile to shared memory
                dma.copy X.chunkat(b, s:s_end_l2, d:d_end_l2) => X_shared.chunkat(0:s_end_l2-s, 0:d_end_l2-d);
                
                // Process L1 tiles within this L2 tile
                for (int s_l1 = 0; s_l1 < s_end_l2 - s; s_l1 += SEQ_TILE) {
                    int s_end_l1 = min(s_l1 + SEQ_TILE, s_end_l2 - s);
                    
                    for (int d_l1 = 0; d_l1 < d_end_l2 - d; d_l1 += DIM_TILE) {
                        int d_end_l1 = min(d_l1 + DIM_TILE, d_end_l2 - d);
                        
                        // Create L1 tiles for processing
                        local f32[s_end_l1 - s_l1, d_end_l1 - d_l1] X_local;
                        local f32[s_end_l1 - s_l1, d_end_l1 - d_l1] Y_local;
                        
                        // Copy from shared to local memory
                        dma.copy X_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1) => X_local;
                        
                        // Calculate total elements in this tile
                        int total_elements = (s_end_l1 - s_l1) * (d_end_l1 - d_l1);
                        
                        // Call the optimized TCLE kernel for ReLU
                        __call_tcle relu_kernel(
                            X_local.data, 
                            Y_local.data, 
                            total_elements
                        );
                        
                        // Copy results back to shared memory
                        dma.copy Y_local => Y_shared.chunkat(s_l1:s_end_l1, d_l1:d_end_l1);
                    }
                }
                
                // Copy the processed L2 tile to output
                dma.copy Y_shared.chunkat(0:s_end_l2-s, 0:d_end_l2-d) => Y.chunkat(b, s:s_end_l2, d:d_end_l2);
            }
        }
    }
    
    return Y;
} 