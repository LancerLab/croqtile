// GELU Activation TCLE Version 2
__co__ f32[batch, seq, dim] gelu_tcle_2(f32[batch, seq, dim] X) {
    f32[batch, seq, dim] Y;
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void gelu_kernel(float* input_ptr, float* output_ptr, int size) {
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // GELU 常量
        const float sqrt_2_over_pi = 0.7978845608028654f;  // sqrt(2/pi)
        const float coeff_a = 0.044715f;
        vec_type v_sqrt_2_over_pi = (vec_type)(sqrt_2_over_pi);
        vec_type v_coeff_a = (vec_type)(coeff_a);
        vec_type v_half = (vec_type)(0.5f);
        vec_type v_one = (vec_type)(1.0f);
        
        // 按向量大小的块处理数据
        for (int i = 0; i < size; i += vec_len) {
            // 处理末尾可能的部分向量
            int remaining = tcle::min(vec_len, size - i);
            
            if (remaining == vec_len) {
                // 完整向量情况 - 加载，处理，存储
                vec_type input_vec = input_leaptr.load_at(i);
                
                // 向量化 GELU: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
                // 计算 x^3 项
                vec_type x_squared = tcle::vmul<vec_type>(input_vec, input_vec);
                vec_type x_cubed = tcle::vmul<vec_type>(x_squared, input_vec);
                
                // 计算 0.044715 * x^3
                vec_type coeff_x_cubed = tcle::vmul<vec_type>(v_coeff_a, x_cubed);
                
                // 计算 x + 0.044715 * x^3
                vec_type inner_term = tcle::vadd<vec_type>(input_vec, coeff_x_cubed);
                
                // 计算 sqrt(2/pi) * (x + 0.044715 * x^3)
                vec_type scaled_term = tcle::vmul<vec_type>(v_sqrt_2_over_pi, inner_term);
                
                // 计算 tanh(sqrt(2/pi) * (x + 0.044715 * x^3))
                vec_type tanh_term = tcle::vtanh<vec_type>(scaled_term);
                
                // 计算 1 + tanh(...)
                vec_type one_plus_tanh = tcle::vadd<vec_type>(v_one, tanh_term);
                
                // 计算 0.5 * x * (1 + tanh(...))
                vec_type half_x = tcle::vmul<vec_type>(v_half, input_vec);
                vec_type output_vec = tcle::vmul<vec_type>(half_x, one_plus_tanh);
                
                // 存储结果
                output_leaptr.store_at(output_vec, i);
            } else {
                // 部分向量情况（边缘情况）
                for (int j = 0; j < remaining; j++) {
                    float x = input_ptr[i + j];
                    float x3 = x * x * x;
                    float inner = x + coeff_a * x3;
                    float tanh_term = tcle::tanh(sqrt_2_over_pi * inner);
                    output_ptr[i + j] = 0.5f * x * (1.0f + tanh_term);
                }
            }
        }
    }
    } // __cok__
    
    // 主体并行结构
    parallel b by batch {
        local f32[seq, dim] X_local;
        local f32[seq, dim] Y_local;
        
        // 复制输入数据到本地内存
        dma.copy X.chunkat(b, _, _) => X_local;
        
        // 计算 GELU
        int total_elements = seq * dim;
        __call_tcle gelu_kernel(X_local.data, Y_local.data, total_elements);
        
        // 复制结果到输出
        dma.copy Y_local => Y.chunkat(b, _, _);
    }
    
    return Y;
} 