#include "choreo.h"
#include <chrono>

__cok__ { /// kernel program

extern "C" void relu_kernel(float* input, float* out) {
  constexpr int m = 256;
  constexpr int n = 256;
  for (int i = 0; i < m; ++i) {
    for (int j = 0; j < n; ++j) {
      out[i*n+j] = input[i*n+j] > 0.0f ? input[i*n+j] : 0.0f;
    }
  }
}

} /// end of kernel decl


