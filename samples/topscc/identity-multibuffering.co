__co__ f32 [10240] identity(f32 [10240] input) { /// device program
  f32[10240] output; // use same shape as input

  parallel p by 1 {  // p is sip_index
    shared f32[1024] l2_out;
    with index={l_tile} in [output.span(0)/l2_out.span(0)] {
      input_load_A = dma.copy.async input.chunkat(l_tile) => shared;
      input_load_B = dma.any;

      // handle multi-buffer loop body; iter iv from 1 to N; handle iv-1's buffer
      foreach l_tile(1:) {
        input_load_B = dma.copy.async input.chunkat(l_tile) => shared;
        wait input_load_A;
        parallel q by 1 {
          with index2={l_tile_s} in [16] {
            foreach l_tile_s {
              input_load_s = dma.copy.async input_load_A.data.chunkat(l_tile_s) => local;
              wait input_load_s;
              out_store_s = dma.copy.async input_load_s.data => l2_out.chunkat(l_tile_s);
              wait out_store_s;
            }
          }
        }
        out_store = dma.copy.async l2_out => output.chunkat(l_tile); // can use defined vars
        wait out_store;
        swap(input_load_A, input_load_B);
      }

      // handle tail
      // input_load_tail = select(#l_tile % 2, input_load_B, input_load_A);
      // wait input_load_A;
      // parallel q by 1 {
      //   with index2={l_tile_s} in [16] {
      //     foreach l_tile_s {
      //       input_load_s = dma.copy.async input_load_tail.data.chunkat(l_tile_s) => local;
      //       wait input_load_s;
      //       out_store_s = dma.copy.async input_load_s.data => l2_out.chunkat(l_tile_s);
      //       wait out_store_s;
      //     }
      //   }
      // }
    }
  } // can use python styling
  return output;
}


int main() { /// host program
  choreo::f32 a[1024*10]; // unified abstraction in choreo type system, no need for C++ vectors/uint8_t, no factor Data/Mem types, we handles the bridge choreo::f32 b[512][512] = {0};

  auto input_data = choreo::make_spanview<1, choreo::f32>((float*)a, {1024*10});
  input_data.fill_random(-1.0, 1.0);

  auto start = std::chrono::high_resolution_clock::now();

  auto res
    = identity(input_data);

  auto end = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);

  std::cout << res.shape()[0] << std::endl;

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i) {
      std::cout << "i: " << i << "\n";
      std::cout << "res: " << res[i] << "\n";
      float ref = input_data[i];

      std::cout << "ref: " << ref << std::endl;
      assert(ref == res[i]);
  }
  std::cout << "Test Passed\n" << std::endl;
  std::cout << "Function execution time: " << duration.count() << " microseconds" << std::endl;
}
