// Multi-Head Linear Attention (MLA) Example for Topscc
// This sample demonstrates a basic implementation of MLA (linear attention) without advanced optimizations.
// All comments are in English for clarity.

#include "choreo.h"
#include <cmath>
#include <iostream>
#include <vector>

// Device kernel: matrix multiplication (C = A x B)
__co_device__ extern "C" void matmul_kernel(float* A, float* B, float* C, int M, int K, int N) {
    for (int m = 0; m < M; ++m) {
        for (int n = 0; n < N; ++n) {
            float sum = 0.0f;
            for (int k = 0; k < K; ++k) {
                sum += A[m * K + k] * B[k * N + n];
            }
            C[m * N + n] = sum;
        }
    }
}

// Device kernel: elementwise ReLU activation
__co_device__ extern "C" void relu_kernel(float* input, float* output, int M, int N) {
    for (int m = 0; m < M; ++m) {
        for (int n = 0; n < N; ++n) {
            float val = input[m * N + n];
            output[m * N + n] = val > 0.0f ? val : 0.0f;
        }
    }
}

// Device kernel: row-wise sum (for normalization)
__co_device__ extern "C" void row_sum_kernel(float* input, float* output, int M, int N) {
    for (int m = 0; m < M; ++m) {
        float sum = 0.0f;
        for (int n = 0; n < N; ++n) {
            sum += input[m * N + n];
        }
        output[m] = sum;
    }
}

// Device kernel: row-wise normalization (output = input / norm)
__co_device__ extern "C" void row_norm_kernel(float* input, float* norm, float* output, int M, int N) {
    for (int m = 0; m < M; ++m) {
        float n = norm[m];
        for (int k = 0; k < N; ++k) {
            output[m * N + k] = n > 1e-6f ? input[m * N + k] / n : 0.0f;
        }
    }
}

// Tileflow function: Multi-Head Linear Attention (single head, basic version)
// Q: [B, S, D], K: [B, S, D], V: [B, S, D] (B=batch, S=seq_len, D=dim)
// Output: [B, S, D]
__co__ f32[B, S, D] multi_head_linear_attention(f32[B, S, D] Q, f32[B, S, D] K, f32[B, S, D] V) {
    f32[B, S, D] output;
    parallel b by B { // batch parallel
        // Allocate local buffers for intermediate results
        local f32[S, D] Q_relu;
        local f32[S, D] K_relu;
        local f32[D, D] KV; // K'V: [D, D]
        local f32[S, D] Q_KV; // Q' x (K'V): [S, D]
        local f32[S] norm; // normalization factor
        local f32[S, D] out_norm; // normalized output

        // 1. ReLU activation: Q' = ReLU(Q), K' = ReLU(K)
        local_q = dma.copy Q.chunkat(b, _, _) => local;
        local_k = dma.copy K.chunkat(b, _, _) => local;
        call relu_kernel(local_q.data, Q_relu, S, D);
        call relu_kernel(local_k.data, K_relu, S, D);

        // 2. Compute K'V: [D, D] = [S, D]^T x [S, D]
        // Transpose K_relu to [D, S], then matmul with V [S, D]
        local_v = dma.copy V.chunkat(b, _, _) => local;
        // For simplicity, we use matmul_kernel with K_relu^T as A, V as B
        // So, A: [D, S], B: [S, D] => C: [D, D]
        call matmul_kernel(K_relu, local_v.data, KV, D, S, D); // K_relu^T x V

        // 3. Compute Q' x (K'V): [S, D] = [S, D] x [D, D]
        call matmul_kernel(Q_relu, KV, Q_KV, S, D, D);

        // 4. Row-wise sum of Q_relu for normalization
        call row_sum_kernel(Q_relu, norm, S, D);

        // 5. Row-wise normalization
        call row_norm_kernel(Q_KV, norm, out_norm, S, D);

        // 6. Write result to output
        dma.copy out_norm => output.chunkat(b, _, _);
    }
    return output;
}

// ------------------- Host Test Code -------------------
// Simple CPU reference implementation for validation
void cpu_mla_ref(const float* Q, const float* K, const float* V, float* O, int B, int S, int D) {
    for (int b = 0; b < B; ++b) {
        // 1. ReLU activation
        std::vector<float> Q_relu(S * D, 0.0f);
        std::vector<float> K_relu(S * D, 0.0f);
        for (int i = 0; i < S * D; ++i) {
            Q_relu[i] = Q[b * S * D + i] > 0.0f ? Q[b * S * D + i] : 0.0f;
            K_relu[i] = K[b * S * D + i] > 0.0f ? K[b * S * D + i] : 0.0f;
        }
        // 2. Compute K'V: [D, D] = [S, D]^T x [S, D]
        std::vector<float> KV(D * D, 0.0f);
        for (int d1 = 0; d1 < D; ++d1) {
            for (int d2 = 0; d2 < D; ++d2) {
                float sum = 0.0f;
                for (int s = 0; s < S; ++s) {
                    sum += K_relu[s * D + d1] * V[b * S * D + s * D + d2];
                }
                KV[d1 * D + d2] = sum;
            }
        }
        // 3. Q' x (K'V): [S, D] = [S, D] x [D, D]
        std::vector<float> Q_KV(S * D, 0.0f);
        for (int s = 0; s < S; ++s) {
            for (int d2 = 0; d2 < D; ++d2) {
                float sum = 0.0f;
                for (int d1 = 0; d1 < D; ++d1) {
                    sum += Q_relu[s * D + d1] * KV[d1 * D + d2];
                }
                Q_KV[s * D + d2] = sum;
            }
        }
        // 4. Row-wise sum of Q_relu for normalization
        std::vector<float> norm(S, 0.0f);
        for (int s = 0; s < S; ++s) {
            float sum = 0.0f;
            for (int d = 0; d < D; ++d) {
                sum += Q_relu[s * D + d];
            }
            norm[s] = sum > 1e-6f ? sum : 1.0f;
        }
        // 5. Row-wise normalization
        for (int s = 0; s < S; ++s) {
            for (int d = 0; d < D; ++d) {
                O[b * S * D + s * D + d] = Q_KV[s * D + d] / norm[s];
            }
        }
    }
}

int main() {
    constexpr int B = 2;   // batch size
    constexpr int S = 4;   // sequence length
    constexpr int D = 8;   // embedding dim

    // Allocate and initialize Q, K, V using Choreo fill_random API
    auto Q = choreo::make_spandata<float>(B, S, D);
    auto K = choreo::make_spandata<float>(B, S, D);
    auto V = choreo::make_spandata<float>(B, S, D);
    Q.fill_random(-1.0f, 1.0f);
    K.fill_random(-1.0f, 1.0f);
    V.fill_random(-1.0f, 1.0f);

    // Call Choreo MLA
    auto result = multi_head_linear_attention(Q.view(), K.view(), V.view());

    // Call CPU reference
    std::vector<float> ref(B * S * D, 0.0f);
    cpu_mla_ref(Q.data(), K.data(), V.data(), ref.data(), B, S, D);

    // Compare results
    int error_count = 0;
    for (int i = 0; i < B * S * D; ++i) {
        float diff = std::abs(result[i] - ref[i]);
        if (diff > 1e-3f) {
            if (error_count < 10) {
                std::cout << "Mismatch at " << i << ": Choreo = " << result[i] << ", Ref = " << ref[i] << ", Diff = " << diff << std::endl;
            }
            ++error_count;
        }
    }
    if (error_count == 0) {
        std::cout << "[PASS] Choreo MLA matches CPU reference." << std::endl;
    } else {
        std::cout << "[FAIL] Mismatches found: " << error_count << std::endl;
    }
    // Optionally print a small part of the result
    std::cout << "Sample output (first batch, first row): ";
    for (int d = 0; d < D; ++d) std::cout << result[d] << " ";
    std::cout << std::endl;
    return 0;
} 