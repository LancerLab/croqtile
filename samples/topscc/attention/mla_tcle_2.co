// Multi-head Linear Attention TCLE Version 2
__co__ f32[batch, seq_q, hidden] mla_tcle_2(
    f32[batch, seq_q, hidden] Q,
    f32[batch, seq_k, hidden] K,
    f32[batch, seq_k, hidden] V) {
    
    f32[batch, seq_q, hidden] out;
    
    // 定义多头注意力参数
    const int num_heads = 16;  // 头数
    const int head_dim = hidden / num_heads;  // 每个头的维度
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void mla_kernel(
        float* q_ptr, float* k_ptr, float* v_ptr, float* out_ptr,
        int seq_q_len, int seq_k_len, int hidden_size, 
        int num_heads, int head_dim) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto q_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)q_ptr);
        auto k_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)k_ptr);
        auto v_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)v_ptr);
        auto out_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)out_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 线性注意力中的临时累加器
        float* kv_sum = (float*)tcle::malloc(num_heads * head_dim * sizeof(float));
        float* k_sum = (float*)tcle::malloc(num_heads * sizeof(float));
        
        // 对每个头进行计算
        for (int h = 0; h < num_heads; h++) {
            int head_offset = h * head_dim;
            
            // 初始化累加器
            for (int d = 0; d < head_dim; d++) {
                kv_sum[h * head_dim + d] = 0.0f;
            }
            k_sum[h] = 0.0f;
            
            // 线性注意力先计算 K、V 的全局累加
            for (int k = 0; k < seq_k_len; k++) {
                // 对每个键值对进行处理
                for (int d = 0; d < head_dim; d++) {
                    float k_val = k_ptr[k * hidden_size + head_offset + d];
                    float v_val = v_ptr[k * hidden_size + head_offset + d];
                    
                    // 累加 k*v
                    kv_sum[h * head_dim + d] += k_val * v_val;
                    
                    // 在第一个维度上累加 k (只需要做一次)
                    if (d == 0) {
                        for (int d2 = 0; d2 < head_dim; d2++) {
                            k_sum[h] += k_ptr[k * hidden_size + head_offset + d2];
                        }
                    }
                }
            }
            
            // 处理每个查询
            for (int q = 0; q < seq_q_len; q++) {
                // 计算线性注意力输出: q·(kv_sum) / (q·k_sum)
                float q_k_sum = 0.0f;
                
                // 计算 q·k_sum 
                for (int d = 0; d < head_dim; d++) {
                    float q_val = q_ptr[q * hidden_size + head_offset + d];
                    q_k_sum += q_val * k_sum[h];
                }
                
                // 防止除零
                q_k_sum = tcle::max(q_k_sum, 1e-6f);
                
                // 计算 q·(kv_sum) / (q·k_sum)
                for (int d = 0; d < head_dim; d += vec_len) {
                    int remaining = tcle::min(vec_len, head_dim - d);
                    
                    if (remaining == vec_len) {
                        // 完整向量宽度
                        vec_type q_vec = q_leaptr.load_at(q * hidden_size + head_offset + d);
                        vec_type kv_vec = tcle::vload<vec_type>(&kv_sum[h * head_dim + d]);
                        
                        // 点积和归一化
                        vec_type tmp = tcle::vmul<vec_type>(q_vec, kv_vec);
                        vec_type q_k_sum_vec = tcle::vbroadcast<vec_type>(q_k_sum);
                        vec_type out_vec = tcle::vdiv<vec_type>(tmp, q_k_sum_vec);
                        
                        // 存储结果
                        out_leaptr.store_at(out_vec, q * hidden_size + head_offset + d);
                    } else {
                        // 部分向量（边缘情况）
                        for (int i = 0; i < remaining; i++) {
                            float q_val = q_ptr[q * hidden_size + head_offset + d + i];
                            float kv_val = kv_sum[h * head_dim + d + i];
                            out_ptr[q * hidden_size + head_offset + d + i] = (q_val * kv_val) / q_k_sum;
                        }
                    }
                }
            }
        }
        
        // 释放临时存储
        tcle::free(kv_sum);
        tcle::free(k_sum);
    }
    } // __cok__
    
    // 主体并行结构
    parallel b by batch {
        local f32[seq_q, hidden] Q_local;
        local f32[seq_k, hidden] K_local;
        local f32[seq_k, hidden] V_local;
        local f32[seq_q, hidden] out_local;
        
        // 复制输入数据到本地内存
        dma.copy Q.chunkat(b, _, _) => Q_local;
        dma.copy K.chunkat(b, _, _) => K_local;
        dma.copy V.chunkat(b, _, _) => V_local;
        
        // 计算线性多头注意力
        __call_tcle mla_kernel(
            Q_local.data,
            K_local.data,
            V_local.data,
            out_local.data,
            seq_q,
            seq_k,
            hidden,
            num_heads,
            head_dim
        );
        
        // 复制结果到输出
        dma.copy out_local => out.chunkat(b, _, _);
    }
    
    return out;
} 