// Gated Linear Unit (GLU) TCLE Version 2
__co__ f32[batch, seq, hidden] glu_tcle_2(f32[batch, seq, hidden] X) {
    f32[batch, seq, hidden] Y;
    
    // 定义 GLU 参数
    const int ff_dim = hidden * 4;  // 扩展维度，通常是隐藏层的 4 倍
    
    // 使用 TCLE 向量化处理
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void glu_kernel(
        float* input_ptr, float* output_ptr,
        float* w1_ptr, float* b1_ptr,
        float* w2_ptr, float* b2_ptr,
        float* w3_ptr, float* b3_ptr,
        int seq_len, int hidden_size, int ff_size) {
        
        // 使用 TCLE 向量类型获得最佳性能
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // 创建向量化内存访问指针
        auto input_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)input_ptr);
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // 获取平台向量长度
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // 临时存储中间结果
        float* gate_values = (float*)tcle::malloc(ff_size * sizeof(float));
        float* act_values = (float*)tcle::malloc(ff_size * sizeof(float));
        
        // 对每个序列位置处理
        for (int s = 0; s < seq_len; s++) {
            int token_offset = s * hidden_size;
            
            // 计算门控值: gate = SiLU(input * W1 + b1)
            for (int f = 0; f < ff_size; f++) {
                float sum = b1_ptr[f];
                for (int h = 0; h < hidden_size; h++) {
                    sum += input_ptr[token_offset + h] * w1_ptr[f * hidden_size + h];
                }
                
                // 应用 SiLU 激活: x * sigmoid(x)
                float x = sum;
                float sigmoid_x = 1.0f / (1.0f + tcle::exp(-x));
                gate_values[f] = x * sigmoid_x;
            }
            
            // 计算线性投影: act = input * W2 + b2
            for (int f = 0; f < ff_size; f++) {
                float sum = b2_ptr[f];
                for (int h = 0; h < hidden_size; h++) {
                    sum += input_ptr[token_offset + h] * w2_ptr[f * hidden_size + h];
                }
                act_values[f] = sum;
            }
            
            // 计算门控投影: output = (gate * act) * W3 + b3
            for (int h = 0; h < hidden_size; h += vec_len) {
                int remaining = tcle::min(vec_len, hidden_size - h);
                
                if (remaining == vec_len) {
                    // 完整向量情况
                    vec_type bias_vec = tcle::vload<vec_type>(&b3_ptr[h]);
                    vec_type result = bias_vec;
                    
                    for (int f = 0; f < ff_size; f++) {
                        float gated_val = gate_values[f] * act_values[f];
                        vec_type gated_vec = tcle::vbroadcast<vec_type>(gated_val);
                        vec_type weight_vec = tcle::vload<vec_type>(&w3_ptr[f * hidden_size + h]);
                        
                        // 累加: result += gated_val * weight_vec
                        result = tcle::vfma<vec_type>(result, gated_vec, weight_vec);
                    }
                    
                    // 存储结果
                    output_leaptr.store_at(result, token_offset + h);
                } else {
                    // 部分向量情况（边缘情况）
                    for (int i = 0; i < remaining; i++) {
                        float sum = b3_ptr[h + i];
                        for (int f = 0; f < ff_size; f++) {
                            float gated_val = gate_values[f] * act_values[f];
                            sum += gated_val * w3_ptr[f * hidden_size + h + i];
                        }
                        output_ptr[token_offset + h + i] = sum;
                    }
                }
            }
        }
        
        // 释放临时存储
        tcle::free(gate_values);
        tcle::free(act_values);
    }
    } // __cok__
    
    // 网络权重和偏置
    shared f32[ff_dim, hidden] W1; // 门控路径
    shared f32[ff_dim] b1;
    shared f32[ff_dim, hidden] W2; // 线性路径
    shared f32[ff_dim] b2;
    shared f32[ff_dim, hidden] W3; // 最终投影
    shared f32[hidden] b3;
    
    // 初始化网络权重 - 在实际实现中，这些将是输入或加载的
    foreach {f, h} in [ff_dim, hidden] {
        W1.at(f, h) = 0.01f * (f + h); // 示例初始化
        W2.at(f, h) = 0.01f * (f + h);
        W3.at(f, h) = 0.01f * (f + h);
        
        if (h == 0) {
            b1.at(f) = 0.0f; // 偏置初始化
            b2.at(f) = 0.0f;
        }
    }
    
    foreach {h} in [hidden] {
        b3.at(h) = 0.0f;
    }
    
    // 主体并行结构
    parallel b by batch {
        local f32[seq, hidden] X_local;
        local f32[seq, hidden] Y_local;
        
        // 复制输入数据到本地内存
        dma.copy X.chunkat(b, _, _) => X_local;
        
        // 计算 GLU
        __call_tcle glu_kernel(
            X_local.data,
            Y_local.data,
            W1.data,
            b1.data,
            W2.data,
            b2.data,
            W3.data,
            b3.data,
            seq,
            hidden,
            ff_dim
        );
        
        // 复制结果到输出
        dma.copy Y_local => Y.chunkat(b, _, _);
    }
    
    return Y;
} 