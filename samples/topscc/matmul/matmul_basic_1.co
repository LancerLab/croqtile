// MatMul Basic Version 1
__co__ f32[batch, m, n] matmul_basic_1(f32[batch, m, k] A, f32[batch, k, n] B) {
    f32[batch, m, n] C;
    parallel b by batch {
        local f32[m, n] tmp;
        // 1. tmp = A.chunkat(b, _, :) @ B.chunkat(b, :, _)
        dma.copy tmp => C.chunkat(b, _, _);
    }
    return C;
} 