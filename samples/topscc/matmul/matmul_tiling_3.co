// MatMul TCLE Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, m, n] matmul_tcle_3(f32[batch, m, k] A, f32[batch, k, n] B) {
    f32[batch, m, n] C;
    
    // Memory hierarchy sizes
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // Calculate tile sizes based on memory constraints
    // For L1 we need to fit: A_tile, B_tile, C_tile
    // Assuming f32 (4 bytes), max elements = 1.5MB / 4 = 375K elements to distribute
    
    // For matrix multiply we need: M*K + K*N + M*N elements
    // Let's use MT, NT, KT as tile dimensions
    // We'll use tiling to ensure L1 cache efficiency
    
    // Vector length for TCLE optimization
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // Define tile sizes for best cache utilization
    // Align tile sizes to vector length
    const int MT = 128;  // Align with vector length
    const int NT = 256;  // Larger for better vectorization
    const int KT = 64;   // Smaller to reduce memory footprint
    
    // Two-level tiling strategy:
    // 1. Outer tiling for L2->L1 transfers
    // 2. Inner tiling for compute optimization
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    __co_device__ extern "C" void matmul_kernel(
        float* A_ptr, float* B_ptr, float* C_ptr,
        int M, int N, int K, int MT, int NT, int KT) {
        
        // Use TCLE vector types for optimal performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Create leaptrs for vectorized memory access
        auto A_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)A_ptr);
        auto B_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)B_ptr);
        auto C_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)C_ptr);
        
        // Vector length for this platform
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Multi-buffering for L1 cache
        // We use ping-pong buffers for A and B tiles to overlap compute and DMA
        
        // For each tile
        for (int m_tile = 0; m_tile < M; m_tile += MT) {
            int m_end = tcle::min(m_tile + MT, M);
            
            for (int n_tile = 0; n_tile < N; n_tile += NT) {
                int n_end = tcle::min(n_tile + NT, N);
                
                // Initialize C tile to zeros
                for (int m = m_tile; m < m_end; m++) {
                    for (int n = n_tile; n < n_end; n += vec_len) {
                        int n_vec = tcle::min(vec_len, n_end - n);
                        
                        if (n_vec == vec_len) {
                            // Full vector width
                            vec_type zeros = (vec_type)(0.0f);
                            C_leaptr.store_at(zeros, (m - m_tile) * N + (n - n_tile));
                        } else {
                            // Partial vector (edge case)
                            for (int v = 0; v < n_vec; v++) {
                                C_ptr[(m - m_tile) * N + (n - n_tile) + v] = 0.0f;
                            }
                        }
                    }
                }
                
                // Compute C tile using k-dimension tiling
                for (int k_tile = 0; k_tile < K; k_tile += KT) {
                    int k_end = tcle::min(k_tile + KT, K);
                    
                    // Load A and B tiles into L1 cache
                    // In actual hardware, this would use DMA or equivalent
                    
                    // Compute within tiles using vectorization
                    for (int m = m_tile; m < m_end; m++) {
                        for (int k = k_tile; k < k_end; k++) {
                            // Broadcast A value
                            float a_val = A_ptr[(m - m_tile) * K + (k - k_tile)];
                            vec_type a_vec = tcle::vbroadcast<vec_type>(a_val);
                            
                            for (int n = n_tile; n < n_end; n += vec_len) {
                                int n_vec = tcle::min(vec_len, n_end - n);
                                
                                if (n_vec == vec_len) {
                                    // Full vector width
                                    vec_type b_vec = B_leaptr.load_at((k - k_tile) * N + (n - n_tile));
                                    vec_type c_vec = C_leaptr.load_at((m - m_tile) * N + (n - n_tile));
                                    
                                    // Vectorized FMA operation
                                    vec_type result = tcle::vfma<vec_type>(c_vec, a_vec, b_vec);
                                    C_leaptr.store_at(result, (m - m_tile) * N + (n - n_tile));
                                } else {
                                    // Partial vector (edge case)
                                    for (int v = 0; v < n_vec; v++) {
                                        float b_val = B_ptr[(k - k_tile) * N + (n - n_tile) + v];
                                        C_ptr[(m - m_tile) * N + (n - n_tile) + v] += a_val * b_val;
                                    }
                                }
                            }
                        }
                    }
                } // end k_tile loop
            } // end n_tile loop
        } // end m_tile loop
    }
    } // __cok__
    
    // Main parallel structure with hierarchical tiling
    parallel b by batch {
        // Use shared memory for larger blocks that still fit in L2
        shared f32[m, k] A_shared;
        shared f32[k, n] B_shared;
        
        // Load full batch slices to shared memory
        dma.copy A.chunkat(b, _, _) => A_shared;
        dma.copy B.chunkat(b, _, _) => B_shared;
        
        // Create L1 tiles for processing
        local f32[MT, NT] C_local;
        
        // Process tiles with optimal blocking
        foreach {i, j} in [m/MT, n/NT] {
            // Define tile boundaries
            int m_start = i * MT;
            int m_end = min(m_start + MT, m);
            int n_start = j * NT;
            int n_end = min(n_start + NT, n);
            
            // Zero initialize the output tile
            foreach {mi, ni} in [m_end - m_start, n_end - n_start] {
                C_local.at(mi, ni) = 0.0f;
            }
            
            // K-dimension tiling for compute and data reuse
            for (int kt = 0; kt < k; kt += KT) {
                int k_end = min(kt + KT, k);
                
                // Load tiles from shared to local memory
                local f32[m_end - m_start, k_end - kt] A_local;
                local f32[k_end - kt, n_end - n_start] B_local;
                
                // Copy tiles from shared memory to local
                dma.copy A_shared.chunkat(m_start:m_end, kt:k_end) => A_local;
                dma.copy B_shared.chunkat(kt:k_end, n_start:n_end) => B_local;
                
                // Call the optimized TCLE kernel for matrix multiplication
                __call_tcle matmul_kernel(
                    A_local.data, B_local.data, C_local.data,
                    m_end - m_start, n_end - n_start, k_end - kt,
                    MT, NT, KT
                );
            }
            
            // Copy the computed tile to the final output
            dma.copy C_local => C.chunkat(b, m_start:m_end, n_start:n_end);
        }
    }
    
    return C;
} 