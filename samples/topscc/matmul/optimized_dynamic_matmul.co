// Optimized dynamic matrix multiplication with double buffering and tiling
// Can be compiled with: choreo -es -t topscc optimized_dynamic_matmul.co

__co__ auto optimized_matmul(f32 [M, K] lhs, f32 [K, N] rhs) {
  // Output tensor with dynamic shape matching input dimensions
  f32 [M, N] output;
  
  // Tile sizes for optimal cache utilization and vectorization
  // These values can be adjusted based on hardware characteristics
  const int TILE_M = 64;  // M dimension tile size
  const int TILE_N = 64;  // N dimension tile size
  const int TILE_K = 32;  // K dimension tile size for reducing memory footprint
  
  // Use parallel compute structure for better utilization of hardware resources
  parallel p by 4 {  // Parallelize across 4 cores/threads
    with {m_tile, k_tile, n_tile} 
      in [ceil_div(M, TILE_M), ceil_div(K, TILE_K), ceil_div(N, TILE_N)] {
      
      // Double buffering for overlapping computation and data transfer
      shared f32 [2][min(TILE_M, M - m_tile * TILE_M)][TILE_K] lhs_sbuf;
      shared f32 [2][TILE_K][min(TILE_N, N - n_tile * TILE_N)] rhs_sbuf;
      
      // Shared buffer for output results
      shared f32 [min(TILE_M, M - m_tile * TILE_M)][min(TILE_N, N - n_tile * TILE_N)] out_sbuf;
      
      // Local computation buffers
      local f32 [min(TILE_M, M - m_tile * TILE_M)][min(TILE_K, K - k_tile * TILE_K)] lhs_lbuf;
      local f32 [min(TILE_K, K - k_tile * TILE_K)][min(TILE_N, N - n_tile * TILE_N)] rhs_lbuf;
      local f32 [min(TILE_M, M - m_tile * TILE_M)][min(TILE_N, N - n_tile * TILE_N)] out_lbuf;
      
      // Initialize output buffer to zero
      foreach {mi, ni} in [min(TILE_M, M - m_tile * TILE_M), min(TILE_N, N - n_tile * TILE_N)] {
        out_lbuf.at(mi, ni) = 0.0f;
      }
      
      // Events for synchronization
      shared event load_done[2], compute_done[2];
      
      // Current buffer index for double buffering
      int buf_idx = 0;
      
      // Process each tile in the K dimension with double buffering
      foreach m_tile, n_tile {
        // Get the actual dimensions for this tile
        int m_size = min(TILE_M, M - m_tile * TILE_M);
        int n_size = min(TILE_N, N - n_tile * TILE_N);
        
        // Preload the first K tile
        if (k_tile == 0) {
          int k_size = min(TILE_K, K);
          dma.copy lhs.chunkat(m_tile * TILE_M, 0).subview(0:m_size, 0:k_size) => lhs_sbuf[0];
          dma.copy rhs.chunkat(0, n_tile * TILE_N).subview(0:k_size, 0:n_size) => rhs_sbuf[0];
          trigger load_done[0];
        }
        
        // Process all K tiles
        foreach k_tile {
          int k_size = min(TILE_K, K - k_tile * TILE_K);
          int next_k_tile = k_tile + 1;
          int next_k_size = (next_k_tile < #k_tile) ? min(TILE_K, K - next_k_tile * TILE_K) : 0;
          
          // Load next tile asynchronously if not at the end
          if (next_k_tile < #k_tile) {
            inthreads.async (p == 0) {
              dma.copy lhs.chunkat(m_tile * TILE_M, next_k_tile * TILE_K).subview(0:m_size, 0:next_k_size) => 
                lhs_sbuf[1 - buf_idx];
              dma.copy rhs.chunkat(next_k_tile * TILE_K, n_tile * TILE_N).subview(0:next_k_size, 0:n_size) => 
                rhs_sbuf[1 - buf_idx];
              trigger load_done[1 - buf_idx];
            }
          }
          
          // Wait for current tile data to be loaded
          wait load_done[buf_idx];
          
          // Copy from shared to local memory for computation
          dma.copy lhs_sbuf[buf_idx] => lhs_lbuf;
          dma.copy rhs_sbuf[buf_idx] => rhs_lbuf;
          
          // Compute matrix multiplication for this tile
          foreach {mi, ni, ki} in [m_size, n_size, k_size] {
            out_lbuf.at(mi, ni) += lhs_lbuf.at(mi, ki) * rhs_lbuf.at(ki, ni);
          }
          
          // Swap buffers for next iteration
          buf_idx = 1 - buf_idx;
        }
        
        // Copy result to output tensor
        dma.copy out_lbuf => output.chunkat(m_tile * TILE_M, n_tile * TILE_N).subview(0:m_size, 0:n_size);
      }
    }
    sync.shared;  // Ensure all parallel operations are completed
  }
  
  return output;
}

// Main function to test the implementation
int main() {
  // Define test dimensions with dynamic shapes
  int M = 128;
  int K = 256;
  int N = 128;
  
  auto lhs = choreo::make_spandata<choreo::f32>(M, K);
  auto rhs = choreo::make_spandata<choreo::f32>(K, N);
  
  // Initialize with random values
  lhs.fill_random(-1.0, 1.0);
  rhs.fill_random(-1.0, 1.0);
  
  // Call our optimized matrix multiplication
  auto start_time = std::chrono::high_resolution_clock::now();
  auto res = optimized_matmul(lhs.view(), rhs.view());
  auto end_time = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end_time - start_time);
  
  // Verify results
  bool correct = true;
  for (size_t i = 0; i < res.shape()[0]; ++i) {
    for (size_t j = 0; j < res.shape()[1]; ++j) {
      float ref = 0.0f;
      
      for (size_t k = 0; k < lhs.shape()[1]; ++k) {
        ref += lhs[i][k] * rhs[k][j];
      }
      
      if (std::abs(ref - res[i][j]) > 1e-4) {
        std::cout << "Error at [" << i << "][" << j << "]: " 
                  << "Expected " << ref << ", got " << res[i][j] << std::endl;
        correct = false;
        break;
      }
    }
    if (!correct) break;
  }
  
  if (correct) {
    std::cout << "Test Passed!" << std::endl;
    std::cout << "Matrix dimensions: " << M << "x" << K << " * " << K << "x" << N << std::endl;
    std::cout << "Execution time: " << duration.count() << " microseconds" << std::endl;
  } else {
    std::cout << "Test Failed!" << std::endl;
  }
  
  return 0;
} 