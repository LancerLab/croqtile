// MoE Routing Gate Basic Version
// This operator computes the routing probabilities for Mixture of Experts
// Inspired by the multi-head-attention-basic.co example

#include "choreo.h"
#include <cmath>
#include <iostream>
#include <vector>

// Device kernel: matrix multiplication (C = A x B)
__co_device__ extern "C" void matmul_kernel(float* A, float* B, float* C, int M, int K, int N) {
    for (int m = 0; m < M; ++m) {
        for (int n = 0; n < N; ++n) {
            float sum = 0.0f;
            for (int k = 0; k < K; ++k) {
                sum += A[m * K + k] * B[k * N + n];
            }
            C[m * N + n] = sum;
        }
    }
}

// Device kernel: row-wise softmax with top-k selection
__co_device__ extern "C" void topk_softmax_kernel(float* input, float* output, int* indices, int M, int N, int k) {
    for (int m = 0; m < M; ++m) {
        // Find top-k indices using a simple sorting approach
        // In a real implementation, this would use a more efficient algorithm
        for (int i = 0; i < k; ++i) {
            float max_val = -INFINITY;
            int max_idx = -1;
            
            for (int n = 0; n < N; ++n) {
                // Check if this index was already selected
                bool already_selected = false;
                for (int j = 0; j < i; ++j) {
                    if (indices[m * k + j] == n) {
                        already_selected = true;
                        break;
                    }
                }
                
                if (!already_selected && input[m * N + n] > max_val) {
                    max_val = input[m * N + n];
                    max_idx = n;
                }
            }
            
            indices[m * k + i] = max_idx;
        }
        
        // Compute softmax only for the top-k values
        float max_val = -INFINITY;
        for (int i = 0; i < k; ++i) {
            int idx = indices[m * k + i];
            if (input[m * N + idx] > max_val) {
                max_val = input[m * N + idx];
            }
        }
        
        float sum = 0.0f;
        for (int i = 0; i < k; ++i) {
            int idx = indices[m * k + i];
            output[m * N + idx] = expf(input[m * N + idx] - max_val);
            sum += output[m * N + idx];
        }
        
        // Normalize only the top-k values, others remain 0
        for (int n = 0; n < N; ++n) {
            output[m * N + n] = 0.0f;  // Initialize all to zero
        }
        
        for (int i = 0; i < k; ++i) {
            int idx = indices[m * k + i];
            output[m * N + idx] /= sum;
        }
    }
}

// Tileflow function: MoE Router (with top-k selection)
// Input: [B, S, D], W_router: [D, E] (B=batch, S=seq_len, D=dim, E=num_experts)
// Output: [B, S, E] (router probabilities), [B, S, k] (top-k expert indices)
__co__ f32[B, S, E], i32[B, S, k] moe_router_basic(f32[B, S, D] input, f32[D, E] W_router, i32 top_k) {
    f32[B, S, E] router_probs;
    i32[B, S, k] expert_indices;
    
    parallel b by B { // batch parallel
        // Allocate local buffers for intermediate results
        local f32[S, D] local_input;
        local f32[S, E] router_logits;  // Routing scores
        local f32[S, E] local_probs;    // Routing probabilities
        local i32[S, k] local_indices;  // Top-k expert indices
        
        // 1. Copy input data to local buffer
        dma.copy input.chunkat(b, _, _) => local_input;
        
        // 2. Compute router logits: input x W_router
        call matmul_kernel(local_input.data, W_router.data, router_logits.data, S, D, E);
        
        // 3. Apply top-k softmax to get router probabilities and indices
        call topk_softmax_kernel(router_logits.data, local_probs.data, local_indices.data, S, E, k);
        
        // 4. Write results to output
        dma.copy local_probs.span_as([1, S, E]) => router_probs.chunkat(b, _, _);
        dma.copy local_indices.span_as([1, S, k]) => expert_indices.chunkat(b, _, _);
    }
    
    return router_probs, expert_indices;
}

// ------------------- Host Test Code -------------------
// Simple CPU reference implementation for validation
void cpu_moe_router_ref(const float* input, const float* W_router, float* probs, int* indices, 
                        int B, int S, int D, int E, int k) {
    for (int b = 0; b < B; ++b) {
        // Compute router logits
        std::vector<float> router_logits(S * E, 0.0f);
        for (int s = 0; s < S; ++s) {
            for (int e = 0; e < E; ++e) {
                float sum = 0.0f;
                for (int d = 0; d < D; ++d) {
                    sum += input[b * S * D + s * D + d] * W_router[d * E + e];
                }
                router_logits[s * E + e] = sum;
            }
        }
        
        // Find top-k and apply softmax
        for (int s = 0; s < S; ++s) {
            // Find top-k indices
            std::vector<int> top_indices;
            std::vector<float> values = std::vector<float>(E);
            for (int e = 0; e < E; ++e) {
                values[e] = router_logits[s * E + e];
                probs[b * S * E + s * E + e] = 0.0f; // Initialize all to zero
            }
            
            for (int i = 0; i < k; ++i) {
                float max_val = -INFINITY;
                int max_idx = -1;
                
                for (int e = 0; e < E; ++e) {
                    if (std::find(top_indices.begin(), top_indices.end(), e) == top_indices.end() && 
                        values[e] > max_val) {
                        max_val = values[e];
                        max_idx = e;
                    }
                }
                
                top_indices.push_back(max_idx);
                indices[b * S * k + s * k + i] = max_idx;
            }
            
            // Compute softmax for top-k
            float max_val = -INFINITY;
            for (int i = 0; i < k; ++i) {
                int e = top_indices[i];
                max_val = std::max(max_val, router_logits[s * E + e]);
            }
            
            float sum = 0.0f;
            for (int i = 0; i < k; ++i) {
                int e = top_indices[i];
                float exp_val = std::exp(router_logits[s * E + e] - max_val);
                probs[b * S * E + s * E + e] = exp_val;
                sum += exp_val;
            }
            
            // Normalize
            for (int i = 0; i < k; ++i) {
                int e = top_indices[i];
                probs[b * S * E + s * E + e] /= sum;
            }
        }
    }
}

int main() {
    constexpr int B = 2;    // batch size
    constexpr int S = 4;    // sequence length
    constexpr int D = 8;    // embedding dimension
    constexpr int E = 8;    // number of experts
    constexpr int k = 2;    // top-k experts to select
    
    // Allocate and initialize input and router weights
    auto input = choreo::make_spandata<float>(B, S, D);
    auto W_router = choreo::make_spandata<float>(D, E);
    input.fill_random(-1.0f, 1.0f);
    W_router.fill_random(-1.0f, 1.0f);
    
    // Call Choreo MoE Router
    auto [router_probs, expert_indices] = moe_router_basic(input.view(), W_router.view(), k);
    
    // Call CPU reference
    std::vector<float> ref_probs(B * S * E, 0.0f);
    std::vector<int> ref_indices(B * S * k, 0);
    cpu_moe_router_ref(input.data(), W_router.data(), ref_probs.data(), ref_indices.data(), B, S, D, E, k);
    
    // Compare results
    int error_count = 0;
    for (int i = 0; i < B * S * E; ++i) {
        float diff = std::abs(router_probs[i] - ref_probs[i]);
        if (diff > 1e-3f) {
            if (error_count < 10) {
                std::cout << "Probability mismatch at " << i << ": Choreo = " << router_probs[i] 
                          << ", Ref = " << ref_probs[i] << ", Diff = " << diff << std::endl;
            }
            ++error_count;
        }
    }
    
    for (int i = 0; i < B * S * k; ++i) {
        if (expert_indices[i] != ref_indices[i]) {
            if (error_count < 10) {
                std::cout << "Index mismatch at " << i << ": Choreo = " << expert_indices[i] 
                          << ", Ref = " << ref_indices[i] << std::endl;
            }
            ++error_count;
        }
    }
    
    if (error_count == 0) {
        std::cout << "[PASS] Choreo MoE Router matches CPU reference." << std::endl;
    } else {
        std::cout << "[FAIL] Mismatches found: " << error_count << std::endl;
    }
    
    // Print a sample of the output
    std::cout << "Sample router probabilities (first batch, first sequence):" << std::endl;
    for (int e = 0; e < E; ++e) {
        std::cout << router_probs[e] << " ";
    }
    std::cout << std::endl;
    
    std::cout << "Sample expert indices (first batch, first sequence):" << std::endl;
    for (int i = 0; i < k; ++i) {
        std::cout << expert_indices[i] << " ";
    }
    std::cout << std::endl;
    
    return 0;
} 