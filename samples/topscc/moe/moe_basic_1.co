// MoE Complete Basic Version 1
__co__ f32[batch, seq, hidden] moe_basic_1(f32[batch, seq, hidden] X) {
    f32[batch, seq, hidden] Y;
    parallel b by batch {
        local f32[seq, hidden] X_local;
        local f32[seq, hidden] Y_local;
        
        // 复制输入数据到本地内存
        dma.copy X.chunkat(b, _, _) => X_local;
        
        // 1. 路由计算
        // router_indices = router(X_local)
        
        // 2. 选择专家并计算
        // Y_local = compute_with_experts(X_local, router_indices)
        
        // 复制结果到输出
        dma.copy Y_local => Y.chunkat(b, _, _);
    }
    return Y;
} 