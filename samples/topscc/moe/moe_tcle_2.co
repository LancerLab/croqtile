// MoE Complete TCLE Version 2
__co__ f32[batch, seq, hidden] moe_tcle_2(f32[batch, seq, hidden] X) {
    f32[batch, seq, hidden] Y;
    
    // Define MoE parameters
    const int num_experts = 8;   // Number of experts
    const int top_k = 2;         // Select top k experts
    const int expert_hidden = hidden * 4; // FFN intermediate layer dimension (usually 4x)
    
    // Use TCLE vectorization
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    // Helper function: perform top-k selection
    void top_k_indices(float* scores, int* indices, int num_experts, int k) {
        // Initialize indices
        for (int i = 0; i < num_experts; i++) {
            indices[i] = i;
        }
        
        // Simple selection sort to find top-k
        for (int i = 0; i < k; i++) {
            int max_idx = i;
            for (int j = i + 1; j < num_experts; j++) {
                if (scores[indices[j]] > scores[indices[max_idx]]) {
                    max_idx = j;
                }
            }
            // Swap
            if (max_idx != i) {
                int temp = indices[i];
                indices[i] = indices[max_idx];
                indices[max_idx] = temp;
            }
        }
    }
    
    // MoE router kernel
    void moe_router_kernel(
        float* input_ptr, float* router_weights, float* router_bias,
        int* expert_indices, float* expert_weights, 
        int seq_len, int hidden_size, int num_experts, int top_k) {
        
        // Temporary storage for expert scores
        float* expert_scores = (float*)tcle::malloc(num_experts * sizeof(float));
        int* indices = (int*)tcle::malloc(num_experts * sizeof(int));
        
        // Process each token in each sequence
        for (int s = 0; s < seq_len; s++) {
            int token_offset = s * hidden_size;
            
            // Initialize expert scores to bias value
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] = router_bias[e];
            }
            
            // Compute routing logits: X * router_weights + router_bias
            for (int h = 0; h < hidden_size; h++) {
                float token_feature = input_ptr[token_offset + h];
                
                // Accumulate scores for each expert
                for (int e = 0; e < num_experts; e++) {
                    expert_scores[e] += token_feature * router_weights[e * hidden_size + h];
                }
            }
            
            // Apply softmax to get routing probabilities
            // Step 1: find max value for numerical stability
            float max_score = expert_scores[0];
            for (int e = 1; e < num_experts; e++) {
                max_score = tcle::max(max_score, expert_scores[e]);
            }
            
            // Step 2: compute exp(score - max) and sum
            float sum_exp = 0.0f;
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] = tcle::exp(expert_scores[e] - max_score);
                sum_exp += expert_scores[e];
            }
            
            // Step 3: normalization
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] /= sum_exp;
            }
            
            // Select top-k experts
            top_k_indices(expert_scores, indices, num_experts, top_k);
            
            // Store top-k expert indices and scores
            for (int k = 0; k < top_k; k++) {
                int idx = indices[k];
                expert_indices[s * top_k + k] = idx;
                expert_weights[s * top_k + k] = expert_scores[idx];
            }
        }
        
        // Free temporary storage
        tcle::free(expert_scores);
        tcle::free(indices);
    }
    
    // Expert network (simplified FFN) kernel
    void expert_ffn_kernel(
        float* input_ptr, float* output_ptr,
        float* expert_w1, float* expert_b1,
        float* expert_w2, float* expert_b2,
        int hidden_size, int ff_size) {
        
        // Use TCLE vector type for best performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Create vectorized memory access pointers
        auto output_leaptr = tcle::simple_leaptr<vec_type>((generic_ptr)output_ptr);
        
        // Get platform vector length
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Temporary storage for intermediate results
        float* intermediate = (float*)tcle::malloc(ff_size * sizeof(float));
        
        // Compute first layer: intermediate = GeLU(input * W1 + b1)
        for (int f = 0; f < ff_size; f++) {
            float sum = expert_b1[f];
            for (int h = 0; h < hidden_size; h++) {
                sum += input_ptr[h] * expert_w1[f * hidden_size + h];
            }
            
            // Apply GeLU activation
            // GeLU(x) ≈ 0.5 * x * (1 + tanh(sqrt(2/π) * (x + 0.044715 * x^3)))
            float x = sum;
            float x3 = x * x * x;
            float inner = 0.79788456f * (x + 0.044715f * x3); // sqrt(2/π) ≈ 0.79788456
            intermediate[f] = 0.5f * x * (1.0f + tcle::tanh(inner));
        }
        
        // Compute second layer: output = intermediate * W2 + b2
        for (int h = 0; h < hidden_size; h += vec_len) {
            int remaining = tcle::min(vec_len, hidden_size - h);
            
            if (remaining == vec_len) {
                // Full vector case
                vec_type bias_vec = tcle::vload<vec_type>(&expert_b2[h]);
                vec_type result = bias_vec;
                
                for (int f = 0; f < ff_size; f++) {
                    float inter_val = intermediate[f];
                    vec_type inter_vec = tcle::vbroadcast<vec_type>(inter_val);
                    vec_type weight_vec = tcle::vload<vec_type>(&expert_w2[f * hidden_size + h]);
                    
                    // Accumulate: result += inter_val * weight_vec
                    result = tcle::vfma<vec_type>(result, inter_vec, weight_vec);
                }
                
                // Store result
                output_leaptr.store_at(result, h);
            } else {
                // Partial vector case (edge case)
                for (int i = 0; i < remaining; i++) {
                    float sum = expert_b2[h + i];
                    for (int f = 0; f < ff_size; f++) {
                        sum += intermediate[f] * expert_w2[f * hidden_size + h + i];
                    }
                    output_ptr[h + i] = sum;
                }
            }
        }
        
        // Free temporary storage
        tcle::free(intermediate);
    }
    
    // MoE complete processing kernel
    __co_device__ extern "C" void moe_kernel(
        float* input_ptr, float* output_ptr,
        float* router_weights, float* router_bias,
        float* expert_w1, float* expert_b1,
        float* expert_w2, float* expert_b2,
        int seq_len, int hidden_size, int ff_size, 
        int num_experts, int top_k) {
        
        // Use TCLE vector type for best performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Get platform vector length
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Temporary storage
        int* expert_indices = (int*)tcle::malloc(seq_len * top_k * sizeof(int));
        float* expert_weights = (float*)tcle::malloc(seq_len * top_k * sizeof(float));
        float* expert_output = (float*)tcle::malloc(hidden_size * sizeof(float));
        float* token_result = (float*)tcle::malloc(hidden_size * sizeof(float));
        
        // Compute routing decisions
        moe_router_kernel(
            input_ptr, router_weights, router_bias,
            expert_indices, expert_weights,
            seq_len, hidden_size, num_experts, top_k
        );
        
        // Process each sequence position
        for (int s = 0; s < seq_len; s++) {
            int token_offset = s * hidden_size;
            
            // Initialize token result to 0
            for (int h = 0; h < hidden_size; h++) {
                token_result[h] = 0.0f;
            }
            
            // Process selected experts
            for (int k = 0; k < top_k; k++) {
                int expert_idx = expert_indices[s * top_k + k];
                float expert_weight = expert_weights[s * top_k + k];
                
                // Get current expert's weight pointers
                float* cur_w1 = &expert_w1[expert_idx * hidden_size * ff_size];
                float* cur_b1 = &expert_b1[expert_idx * ff_size];
                float* cur_w2 = &expert_w2[expert_idx * ff_size * hidden_size];
                float* cur_b2 = &expert_b2[expert_idx * hidden_size];
                
                // Apply expert FFN
                expert_ffn_kernel(
                    &input_ptr[token_offset], expert_output,
                    cur_w1, cur_b1, cur_w2, cur_b2,
                    hidden_size, ff_size
                );
                
                // Weighted accumulation of expert output
                for (int h = 0; h < hidden_size; h += vec_len) {
                    int remaining = tcle::min(vec_len, hidden_size - h);
                    
                    if (remaining == vec_len) {
                        // Full vector case
                        vec_type weight_vec = tcle::vbroadcast<vec_type>(expert_weight);
                        vec_type expert_vec = tcle::vload<vec_type>(&expert_output[h]);
                        vec_type result_vec = tcle::vload<vec_type>(&token_result[h]);
                        
                        // Accumulate: result += weight * expert_output
                        result_vec = tcle::vfma<vec_type>(result_vec, weight_vec, expert_vec);
                        
                        // Store result
                        tcle::vstore<vec_type>(result_vec, &token_result[h]);
                    } else {
                        // Partial vector case (edge case)
                        for (int i = 0; i < remaining; i++) {
                            token_result[h + i] += expert_weight * expert_output[h + i];
                        }
                    }
                }
            }
            
            // Copy final result to output
            for (int h = 0; h < hidden_size; h++) {
                output_ptr[token_offset + h] = token_result[h];
            }
        }
        
        // Free temporary storage
        tcle::free(expert_indices);
        tcle::free(expert_weights);
        tcle::free(expert_output);
        tcle::free(token_result);
    }
    } // __cok__
    
    // Shared weights
    shared f32[num_experts, hidden] router_W;
    shared f32[num_experts] router_b;
    
    shared f32[num_experts, hidden, expert_hidden] expert_W1;
    shared f32[num_experts, expert_hidden] expert_b1;
    shared f32[num_experts, expert_hidden, hidden] expert_W2;
    shared f32[num_experts, hidden] expert_b2;
    
    // Initialize weights - in actual implementation, these would be input or loaded
    foreach {e, h} in [num_experts, hidden] {
        router_W.at(e, h) = 0.01f * (e + h); // Example initialization
        
        if (h == 0) {
            router_b.at(e) = 0.0f; // Bias initialization
        }
        
        foreach {eh} in [expert_hidden] {
            expert_W1.at(e, h, eh) = 0.01f * (e + h + eh);
            
            if (h == 0) {
                expert_b1.at(e, eh) = 0.0f;
            }
        }
        
        expert_b2.at(e, h) = 0.0f;
        
        foreach {eh} in [expert_hidden] {
            expert_W2.at(e, eh, h) = 0.01f * (e + eh + h);
        }
    }
    
    // Main parallel structure
    parallel b by batch {
        local f32[seq, hidden] X_local;
        local f32[seq, hidden] Y_local;
        
        // Copy input data to local memory
        dma.copy X.chunkat(b, _, _) => X_local;
        
        // Calculate MoE
        __call_tcle moe_kernel(
            X_local.data,
            Y_local.data,
            router_W.data,
            router_b.data,
            expert_W1.data,
            expert_b1.data,
            expert_W2.data,
            expert_b2.data,
            seq,
            hidden,
            expert_hidden,
            num_experts,
            top_k
        );
        
        // Copy results to output
        dma.copy Y_local => Y.chunkat(b, _, _);
    }
    
    return Y;
}