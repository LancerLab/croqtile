// MoE Router TILING Version 3 - Optimized with tiling for memory hierarchy
__co__ f32[batch, seq, experts, k_experts] moe_router_tiling_3(f32[batch, seq, hidden] X) {
    f32[batch, seq, experts, k_experts] router_indices;
    
    // Memory hierarchy sizes
    // L1 (LOCAL): ~1.5MB
    // L2 (SHARED): 64MB
    // Global: 40.75GB
    
    // Assuming f32 (4 bytes), max elements in L1 = 1.5MB / 4 = 375K elements
    
    // Vector length for optimization
    const int VL = 128; // TCLE_MAX_VECTOR_LENGTH for GCU300
    
    // Define optimal tile sizes
    const int SEQ_TILE = 64;     // Sequence dimension tile
    const int HIDDEN_TILE = 256; // Hidden dimension tile (multiple of VL)
    
    // For L2 cache, we can process larger batches
    const int SEQ_TILE_L2 = 256; // L2 sequence dimension tile
    
    // Router parameters
    const int top_k = k_experts; // Number of experts to select per token
    
    __cok__ {
    #include "tcle.h"
    using namespace tcle;
    
    // Helper function to perform top-k selection
    void top_k_indices(float* scores, int* indices, int num_experts, int k) {
        // Initialize indices
        for (int i = 0; i < num_experts; i++) {
            indices[i] = i;
        }
        
        // Simple selection sort for top-k (more efficient algorithms can be used)
        for (int i = 0; i < k; i++) {
            int max_idx = i;
            for (int j = i + 1; j < num_experts; j++) {
                if (scores[indices[j]] > scores[indices[max_idx]]) {
                    max_idx = j;
                }
            }
            // Swap
            if (max_idx != i) {
                int temp = indices[i];
                indices[i] = indices[max_idx];
                indices[max_idx] = temp;
            }
        }
    }
    
    __co_device__ extern "C" void moe_router_kernel(
        float* input_ptr, float* router_weights, float* router_bias,
        float* output_indices, float* output_scores,
        int seq_len, int hidden_size, int num_experts, int top_k) {
        
        // Use TCLE vector types for optimal performance
        using vec_type = typename tcle::altivector<float, TCLE_MAX_VECTOR_LENGTH>::VT;
        
        // Vector length for this platform
        const int vec_len = tcle::altivector_step<vec_type>();
        
        // Temporary storage for expert scores
        float* expert_scores = (float*)tcle::malloc(num_experts * sizeof(float));
        int* expert_indices = (int*)tcle::malloc(num_experts * sizeof(int));
        
        // Process each token in the batch
        for (int s = 0; s < seq_len; s++) {
            int token_offset = s * hidden_size;
            
            // Initialize expert scores to bias values
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] = router_bias[e];
            }
            
            // Compute router logits: X * router_weights + router_bias
            for (int h = 0; h < hidden_size; h++) {
                float token_feature = input_ptr[token_offset + h];
                
                // For each expert, accumulate score
                for (int e = 0; e < num_experts; e++) {
                    expert_scores[e] += token_feature * router_weights[e * hidden_size + h];
                }
            }
            
            // Apply softmax to get routing probabilities
            // Step 1: Find max for numerical stability
            float max_score = expert_scores[0];
            for (int e = 1; e < num_experts; e++) {
                max_score = tcle::max(max_score, expert_scores[e]);
            }
            
            // Step 2: Compute exp(score - max) and sum
            float sum_exp = 0.0f;
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] = tcle::exp(expert_scores[e] - max_score);
                sum_exp += expert_scores[e];
            }
            
            // Step 3: Normalize
            for (int e = 0; e < num_experts; e++) {
                expert_scores[e] /= sum_exp;
            }
            
            // Select top-k experts
            top_k_indices(expert_scores, expert_indices, num_experts, top_k);
            
            // Store top-k expert indices and scores
            for (int k = 0; k < top_k; k++) {
                int idx = expert_indices[k];
                output_indices[s * num_experts * top_k + idx * top_k + k] = (float)idx;
                output_scores[s * num_experts * top_k + idx * top_k + k] = expert_scores[idx];
            }
        }
        
        // Free temporary storage
        tcle::free(expert_scores);
        tcle::free(expert_indices);
    }
    } // __cok__
    
    // Router weights and bias
    shared f32[experts, hidden] router_W;
    shared f32[experts] router_b;
    
    // Initialize router weights - in a real implementation, these would be inputs or loaded
    foreach {e, h} in [experts, hidden] {
        router_W.at(e, h) = 0.01f * (e + h); // Example initialization
        if (h == 0) {
            router_b.at(e) = 0.0f; // Bias initialization
        }
    }
    
    // Main parallel structure with hierarchical tiling
    parallel b by batch {
        // Use shared memory for larger blocks that fit in L2
        shared f32[SEQ_TILE_L2, hidden] X_shared;
        shared f32[SEQ_TILE_L2, experts, k_experts] routes_shared;
        shared f32[SEQ_TILE_L2, experts, k_experts] scores_shared;
        
        // Process L2 tiles
        for (int s = 0; s < seq; s += SEQ_TILE_L2) {
            int s_end_l2 = min(s + SEQ_TILE_L2, seq);
            int seq_tile_size_l2 = s_end_l2 - s;
            
            // Copy input tile to shared memory
            dma.copy X.chunkat(b, s:s_end_l2, _) => X_shared.chunkat(0:seq_tile_size_l2, _);
            
            // Process L1 tiles within this L2 tile
            for (int s_l1 = 0; s_l1 < seq_tile_size_l2; s_l1 += SEQ_TILE) {
                int s_end_l1 = min(s_l1 + SEQ_TILE, seq_tile_size_l2);
                int seq_tile_size_l1 = s_end_l1 - s_l1;
                
                // Create L1 tiles for processing
                local f32[seq_tile_size_l1, hidden] X_local;
                local f32[seq_tile_size_l1, experts, k_experts] routes_local;
                local f32[seq_tile_size_l1, experts, k_experts] scores_local;
                
                // Copy from shared to local memory
                dma.copy X_shared.chunkat(s_l1:s_end_l1, _) => X_local;
                
                // Call the optimized kernel for MoE routing
                __call_tcle moe_router_kernel(
                    X_local.data,
                    router_W.data,
                    router_b.data,
                    routes_local.data,
                    scores_local.data,
                    seq_tile_size_l1,
                    hidden,
                    experts,
                    k_experts
                );
                
                // Copy results back to shared memory
                dma.copy routes_local => routes_shared.chunkat(s_l1:s_end_l1, _, _);
                dma.copy scores_local => scores_shared.chunkat(s_l1:s_end_l1, _, _);
            }
            
            // Copy the processed L2 tile (routes) to output
            dma.copy routes_shared.chunkat(0:seq_tile_size_l2, _, _) => router_indices.chunkat(b, s:s_end_l2, _, _);
        }
    }
    
    return router_indices;
} 