{
  "version": "1.0",
  "language": "Choreo",
  "description": "Knowledge base for Choreo syntax and semantics",
  
  "basic_syntax": {
    "comments": {
      "line_comment": "// This is a line comment",
      "block_comment": "/* This is a block comment */"
    },
    
    "statements": {
      "termination": "Statements end with semicolons (;)",
      "blocks": "Code blocks are enclosed in curly braces {}"
    }
  },
  
  "tensor_definitions": {
    "basic_declaration": "tensor name[dim1][dim2]...[dimN] : type;",
    "supported_types": ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float16", "float32", "float64", "bf16"],
    "dimension_specification": {
      "constant": "tensor A[10][20] : float32;",
      "symbolic": "tensor B[N][M] : float32;",
      "computed": "tensor C[2*N][M/2] : float32;"
    },
    "initializers": {
      "zeros": "tensor A[10][10] : float32 = zeros;",
      "ones": "tensor B[5][5] : float32 = ones;",
      "random": "tensor C[3][3] : float32 = random;"
    },
    "attributes": {
      "input": "tensor A[10][10] : float32 = input;",
      "output": "tensor B[10][10] : float32 = output;",
      "temporary": "tensor C[10][10] : float32 = temporary;"
    }
  },
  
  "computation_blocks": {
    "basic_form": "compute { statements... }",
    "parallel_form": "compute parallel(dim1, dim2, ...) { statements... }",
    "reduction_form": "compute reduction(op, dim) { statements... }"
  },
  
  "expressions": {
    "arithmetic": ["+", "-", "*", "/", "%"],
    "logical": ["&&", "||", "!"],
    "comparison": ["==", "!=", "<", ">", "<=", ">="],
    "bitwise": ["&", "|", "^", "~", "<<", ">>"],
    "special_functions": {
      "mathematical": ["sqrt", "exp", "log", "sin", "cos", "tan", "abs"],
      "tensor_specific": ["dim", "transpose", "reshape", "slice", "concat"]
    }
  },
  
  "control_flow": {
    "if_statement": "if (condition) { statements... } else { statements... }",
    "for_loop": "for (variable = start; condition; increment) { statements... }",
    "while_loop": "while (condition) { statements... }"
  },
  
  "tensor_operations": {
    "element_wise": {
      "addition": "C[i][j] = A[i][j] + B[i][j];",
      "multiplication": "C[i][j] = A[i][j] * B[i][j];",
      "functions": "C[i][j] = sqrt(A[i][j]);"
    },
    "reduction": {
      "sum": "sum = 0; for (i = 0; i < N; i++) { sum += A[i]; }",
      "product": "prod = 1; for (i = 0; i < N; i++) { prod *= A[i]; }",
      "min_max": "max = A[0]; for (i = 1; i < N; i++) { if (A[i] > max) max = A[i]; }"
    },
    "matrix_operations": {
      "matrix_multiplication": "for (i = 0; i < M; i++) { for (j = 0; j < N; j++) { for (k = 0; k < K; k++) { C[i][j] += A[i][k] * B[k][j]; } } }",
      "transpose": "for (i = 0; i < N; i++) { for (j = 0; j < M; j++) { B[j][i] = A[i][j]; } }"
    },
    "convolutions": {
      "1d": "for (i = 0; i < N; i++) { for (j = 0; j < K; j++) { if (i+j < N) { result[i] += input[i+j] * kernel[j]; } } }",
      "2d": "for (i = 0; i < H; i++) { for (j = 0; j < W; j++) { for (ki = 0; ki < KH; ki++) { for (kj = 0; kj < KW; kj++) { if (i+ki < H && j+kj < W) { result[i][j] += input[i+ki][j+kj] * kernel[ki][kj]; } } } } }"
    }
  },
  
  "optimization_directives": {
    "memory_layout": "option memory_layout(tensor, layout_type);",
    "parallelization": "option parallel(tensor, dimensions);",
    "tiling": "option tile(tensor, tile_sizes);",
    "fusion": "option fuse(compute_blocks);",
    "target_specific": "option target(hardware_type, optimization_flags);"
  },
  
  "memory_management": {
    "allocation": "Automatic based on tensor definitions",
    "deallocation": "Automatic at end of scope",
    "reuse": "option reuse(tensor_a, tensor_b);"
  },
  
  "common_patterns": {
    "matrix_multiplication": {
      "naive": "for (i = 0; i < M; i++) { for (j = 0; j < N; j++) { for (k = 0; k < K; k++) { C[i][j] += A[i][k] * B[k][j]; } } }",
      "tiled": "for (i = 0; i < M; i+=TILE_M) { for (j = 0; j < N; j+=TILE_N) { for (k = 0; k < K; k+=TILE_K) { for (ii = i; ii < min(i+TILE_M, M); ii++) { for (jj = j; jj < min(j+TILE_N, N); jj++) { for (kk = k; kk < min(k+TILE_K, K); kk++) { C[ii][jj] += A[ii][kk] * B[kk][jj]; } } } } } }"
    },
    "convolution": {
      "direct": "for (n = 0; n < N; n++) { for (c = 0; c < C; c++) { for (h = 0; h < H; h++) { for (w = 0; w < W; w++) { for (kh = 0; kh < KH; kh++) { for (kw = 0; kw < KW; kw++) { if (h+kh < H && w+kw < W) { output[n][c][h][w] += input[n][c][h+kh][w+kw] * kernel[c][kh][kw]; } } } } } } }",
      "im2col": "// Convert image to column format, then use matrix multiplication"
    }
  },
  
  "common_errors": {
    "syntax_errors": [
      "Missing semicolons",
      "Unmatched brackets or parentheses",
      "Invalid tensor dimension expressions"
    ],
    "semantic_errors": [
      "Type mismatches in expressions",
      "Dimension mismatches in operations",
      "Out-of-bounds tensor access",
      "Uninitialized tensor usage"
    ],
    "optimization_errors": [
      "Conflicting optimization directives",
      "Invalid tiling sizes",
      "Incorrect parallelization specifications"
    ]
  },
  
  "compilation_process": {
    "phases": [
      "Parsing",
      "Semantic analysis",
      "Type checking",
      "Optimization",
      "Code generation"
    ],
    "targets": [
      "CUDA",
      "TopSCC",
      "CPU vector code"
    ]
  }
} 