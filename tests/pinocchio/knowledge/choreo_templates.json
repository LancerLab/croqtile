{
  "version": "1.0",
  "description": "Template library for common Choreo computation patterns",
  
  "matrix_operations": {
    "matrix_multiplication": {
      "naive": {
        "description": "Basic triple-nested loop matrix multiplication",
        "template": [
          "// Matrix multiplication C = A * B",
          "// A: M x K, B: K x N, C: M x N",
          "tensor A[M][K] : float32 = input;",
          "tensor B[K][N] : float32 = input;",
          "tensor C[M][N] : float32 = output;",
          "",
          "compute {",
          "    for (int i = 0; i < M; i++) {",
          "        for (int j = 0; j < N; j++) {",
          "            C[i][j] = 0.0f;",
          "            for (int k = 0; k < K; k++) {",
          "                C[i][j] += A[i][k] * B[k][j];",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      },
      "parallelized": {
        "description": "Parallelized matrix multiplication using parallel compute directive",
        "template": [
          "// Matrix multiplication C = A * B with parallelization",
          "// A: M x K, B: K x N, C: M x N",
          "tensor A[M][K] : float32 = input;",
          "tensor B[K][N] : float32 = input;",
          "tensor C[M][N] : float32 = output;",
          "",
          "compute parallel(M, N) {",
          "    int i = M_idx;",
          "    int j = N_idx;",
          "    C[i][j] = 0.0f;",
          "    for (int k = 0; k < K; k++) {",
          "        C[i][j] += A[i][k] * B[k][j];",
          "    }",
          "}"
        ]
      },
      "tiled": {
        "description": "Tiled matrix multiplication for better cache utilization",
        "template": [
          "// Tiled matrix multiplication C = A * B",
          "// A: M x K, B: K x N, C: M x N",
          "tensor A[M][K] : float32 = input;",
          "tensor B[K][N] : float32 = input;",
          "tensor C[M][N] : float32 = output;",
          "tensor A_tile[TILE_SIZE][TILE_SIZE] : float32;",
          "tensor B_tile[TILE_SIZE][TILE_SIZE] : float32;",
          "",
          "option memory_layout(A_tile, shared);",
          "option memory_layout(B_tile, shared);",
          "",
          "compute {",
          "    for (int i = 0; i < M; i += TILE_SIZE) {",
          "        for (int j = 0; j < N; j += TILE_SIZE) {",
          "            for (int k = 0; k < K; k += TILE_SIZE) {",
          "                // Load tiles",
          "                for (int ti = 0; ti < TILE_SIZE; ti++) {",
          "                    for (int tj = 0; tj < TILE_SIZE; tj++) {",
          "                        if (i + ti < M && k + tj < K) {",
          "                            A_tile[ti][tj] = A[i + ti][k + tj];",
          "                        }",
          "                        if (k + ti < K && j + tj < N) {",
          "                            B_tile[ti][tj] = B[k + ti][j + tj];",
          "                        }",
          "                    }",
          "                }",
          "                ",
          "                // Compute on tiles",
          "                for (int ti = 0; ti < TILE_SIZE; ti++) {",
          "                    for (int tj = 0; tj < TILE_SIZE; tj++) {",
          "                        if (i + ti < M && j + tj < N) {",
          "                            for (int tk = 0; tk < TILE_SIZE; tk++) {",
          "                                if (k + tk < K) {",
          "                                    C[i + ti][j + tj] += A_tile[ti][tk] * B_tile[tk][tj];",
          "                                }",
          "                            }",
          "                        }",
          "                    }",
          "                }",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      },
      "optimized": {
        "description": "Fully optimized matrix multiplication with tiling and parallelization",
        "template": [
          "// Optimized matrix multiplication C = A * B",
          "// A: M x K, B: K x N, C: M x N",
          "tensor A[M][K] : float32 = input;",
          "tensor B[K][N] : float32 = input;",
          "tensor C[M][N] : float32 = output;",
          "",
          "option tile(A, [TILE_M, TILE_K]);",
          "option tile(B, [TILE_K, TILE_N]);",
          "option tile(C, [TILE_M, TILE_N]);",
          "",
          "compute parallel(M, N) {",
          "    int i = M_idx;",
          "    int j = N_idx;",
          "    C[i][j] = 0.0f;",
          "    for (int k = 0; k < K; k++) {",
          "        C[i][j] += A[i][k] * B[k][j];",
          "    }",
          "}"
        ]
      }
    },
    "matrix_transpose": {
      "basic": {
        "description": "Basic matrix transpose operation",
        "template": [
          "// Matrix transpose B = A^T",
          "// A: M x N, B: N x M",
          "tensor A[M][N] : float32 = input;",
          "tensor B[N][M] : float32 = output;",
          "",
          "compute {",
          "    for (int i = 0; i < M; i++) {",
          "        for (int j = 0; j < N; j++) {",
          "            B[j][i] = A[i][j];",
          "        }",
          "    }",
          "}"
        ]
      },
      "parallelized": {
        "description": "Parallelized matrix transpose",
        "template": [
          "// Matrix transpose B = A^T with parallelization",
          "// A: M x N, B: N x M",
          "tensor A[M][N] : float32 = input;",
          "tensor B[N][M] : float32 = output;",
          "",
          "compute parallel(M, N) {",
          "    int i = M_idx;",
          "    int j = N_idx;",
          "    B[j][i] = A[i][j];",
          "}"
        ]
      }
    }
  },
  
  "convolution_operations": {
    "conv1d": {
      "basic": {
        "description": "Basic 1D convolution",
        "template": [
          "// 1D Convolution output = input * kernel",
          "// input: N, kernel: K",
          "tensor input[N] : float32 = input;",
          "tensor kernel[K] : float32 = input;",
          "tensor output[N] : float32 = output;",
          "",
          "compute {",
          "    for (int i = 0; i < N; i++) {",
          "        output[i] = 0.0f;",
          "        for (int j = 0; j < K; j++) {",
          "            int idx = i - j + K/2;",
          "            if (idx >= 0 && idx < N) {",
          "                output[i] += input[idx] * kernel[j];",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      },
      "parallelized": {
        "description": "Parallelized 1D convolution",
        "template": [
          "// 1D Convolution output = input * kernel with parallelization",
          "// input: N, kernel: K",
          "tensor input[N] : float32 = input;",
          "tensor kernel[K] : float32 = input;",
          "tensor output[N] : float32 = output;",
          "",
          "compute parallel(N) {",
          "    int i = N_idx;",
          "    output[i] = 0.0f;",
          "    for (int j = 0; j < K; j++) {",
          "        int idx = i - j + K/2;",
          "        if (idx >= 0 && idx < N) {",
          "            output[i] += input[idx] * kernel[j];",
          "        }",
          "    }",
          "}"
        ]
      }
    },
    "conv2d": {
      "basic": {
        "description": "Basic 2D convolution",
        "template": [
          "// 2D Convolution output = input * kernel",
          "// input: H x W, kernel: KH x KW",
          "tensor input[H][W] : float32 = input;",
          "tensor kernel[KH][KW] : float32 = input;",
          "tensor output[H][W] : float32 = output;",
          "",
          "compute {",
          "    for (int h = 0; h < H; h++) {",
          "        for (int w = 0; w < W; w++) {",
          "            output[h][w] = 0.0f;",
          "            for (int kh = 0; kh < KH; kh++) {",
          "                for (int kw = 0; kw < KW; kw++) {",
          "                    int h_idx = h - kh + KH/2;",
          "                    int w_idx = w - kw + KW/2;",
          "                    if (h_idx >= 0 && h_idx < H && w_idx >= 0 && w_idx < W) {",
          "                        output[h][w] += input[h_idx][w_idx] * kernel[kh][kw];",
          "                    }",
          "                }",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      },
      "parallelized": {
        "description": "Parallelized 2D convolution",
        "template": [
          "// 2D Convolution output = input * kernel with parallelization",
          "// input: H x W, kernel: KH x KW",
          "tensor input[H][W] : float32 = input;",
          "tensor kernel[KH][KW] : float32 = input;",
          "tensor output[H][W] : float32 = output;",
          "",
          "compute parallel(H, W) {",
          "    int h = H_idx;",
          "    int w = W_idx;",
          "    output[h][w] = 0.0f;",
          "    for (int kh = 0; kh < KH; kh++) {",
          "        for (int kw = 0; kw < KW; kw++) {",
          "            int h_idx = h - kh + KH/2;",
          "            int w_idx = w - kw + KW/2;",
          "            if (h_idx >= 0 && h_idx < H && w_idx >= 0 && w_idx < W) {",
          "                output[h][w] += input[h_idx][w_idx] * kernel[kh][kw];",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      },
      "tiled": {
        "description": "Tiled 2D convolution for better cache utilization",
        "template": [
          "// Tiled 2D Convolution output = input * kernel",
          "// input: H x W, kernel: KH x KW",
          "tensor input[H][W] : float32 = input;",
          "tensor kernel[KH][KW] : float32 = input;",
          "tensor output[H][W] : float32 = output;",
          "",
          "option tile(input, [TILE_H, TILE_W]);",
          "option tile(output, [TILE_H, TILE_W]);",
          "",
          "compute parallel(H, W) {",
          "    int h = H_idx;",
          "    int w = W_idx;",
          "    output[h][w] = 0.0f;",
          "    for (int kh = 0; kh < KH; kh++) {",
          "        for (int kw = 0; kw < KW; kw++) {",
          "            int h_idx = h - kh + KH/2;",
          "            int w_idx = w - kw + KW/2;",
          "            if (h_idx >= 0 && h_idx < H && w_idx >= 0 && w_idx < W) {",
          "                output[h][w] += input[h_idx][w_idx] * kernel[kh][kw];",
          "            }",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  },
  
  "reduction_operations": {
    "sum_reduction": {
      "basic": {
        "description": "Basic sum reduction",
        "template": [
          "// Sum reduction of a tensor",
          "tensor input[N] : float32 = input;",
          "tensor output[1] : float32 = output;",
          "",
          "compute {",
          "    output[0] = 0.0f;",
          "    for (int i = 0; i < N; i++) {",
          "        output[0] += input[i];",
          "    }",
          "}"
        ]
      },
      "optimized": {
        "description": "Optimized sum reduction using reduction directive",
        "template": [
          "// Sum reduction of a tensor using reduction directive",
          "tensor input[N] : float32 = input;",
          "tensor output[1] : float32 = output;",
          "",
          "compute reduction(sum, 0) {",
          "    output[0] = input[N_idx];",
          "}"
        ]
      }
    },
    "max_reduction": {
      "basic": {
        "description": "Basic max reduction",
        "template": [
          "// Max reduction of a tensor",
          "tensor input[N] : float32 = input;",
          "tensor output[1] : float32 = output;",
          "",
          "compute {",
          "    output[0] = input[0];",
          "    for (int i = 1; i < N; i++) {",
          "        if (input[i] > output[0]) {",
          "            output[0] = input[i];",
          "        }",
          "    }",
          "}"
        ]
      },
      "optimized": {
        "description": "Optimized max reduction using reduction directive",
        "template": [
          "// Max reduction of a tensor using reduction directive",
          "tensor input[N] : float32 = input;",
          "tensor output[1] : float32 = output;",
          "",
          "compute reduction(max, 0) {",
          "    output[0] = input[N_idx];",
          "}"
        ]
      }
    }
  },
  
  "stencil_computations": {
    "jacobi_1d": {
      "description": "1D Jacobi stencil computation",
      "template": [
        "// 1D Jacobi stencil computation",
        "tensor input[N] : float32 = input;",
        "tensor output[N] : float32 = output;",
        "",
        "compute {",
        "    for (int i = 1; i < N-1; i++) {",
        "        output[i] = 0.3333f * (input[i-1] + input[i] + input[i+1]);",
        "    }",
        "    output[0] = input[0];",
        "    output[N-1] = input[N-1];",
        "}"
      ]
    },
    "laplacian_2d": {
      "description": "2D Laplacian stencil computation",
      "template": [
        "// 2D Laplacian stencil computation",
        "tensor input[H][W] : float32 = input;",
        "tensor output[H][W] : float32 = output;",
        "",
        "compute {",
        "    for (int h = 1; h < H-1; h++) {",
        "        for (int w = 1; w < W-1; w++) {",
        "            output[h][w] = input[h][w-1] + input[h-1][w] - 4.0f * input[h][w] + input[h+1][w] + input[h][w+1];",
        "        }",
        "    }",
        "    // Handle boundaries",
        "    for (int h = 0; h < H; h++) {",
        "        output[h][0] = input[h][0];",
        "        output[h][W-1] = input[h][W-1];",
        "    }",
        "    for (int w = 0; w < W; w++) {",
        "        output[0][w] = input[0][w];",
        "        output[H-1][w] = input[H-1][w];",
        "    }",
        "}"
      ]
    }
  },
  
  "scan_operations": {
    "inclusive_scan": {
      "description": "Inclusive scan (prefix sum) operation",
      "template": [
        "// Inclusive scan (prefix sum)",
        "tensor input[N] : float32 = input;",
        "tensor output[N] : float32 = output;",
        "",
        "compute {",
        "    output[0] = input[0];",
        "    for (int i = 1; i < N; i++) {",
        "        output[i] = output[i-1] + input[i];",
        "    }",
        "}"
      ]
    },
    "exclusive_scan": {
      "description": "Exclusive scan operation",
      "template": [
        "// Exclusive scan",
        "tensor input[N] : float32 = input;",
        "tensor output[N] : float32 = output;",
        "",
        "compute {",
        "    output[0] = 0.0f;",
        "    for (int i = 1; i < N; i++) {",
        "        output[i] = output[i-1] + input[i-1];",
        "    }",
        "}"
      ]
    }
  }
}