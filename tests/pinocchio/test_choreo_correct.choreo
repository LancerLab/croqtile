// 这是一个遵循Choreo语法规则的正确示例文件

// 正确的类型名（小写）
global u32 [10] array1;

// 正确的多维数组声明（单个方括号，逗号分隔）
u32 [2, 4] array2;

// 不在函数参数中使用数组，而是使用全局变量
__co__ void process_array() {
  // 使用全局数组array1
  u32 value;
  value = array1.at(0);
}

__co__ void test_func() {
  // 正确的变量声明和赋值（分开）
  u32 var;
  var = 123;
  
  // 正确的数组访问（使用.at()方法）
  array1.at(5) = 10;
  
  // 正确的逻辑表达式（嵌套if代替&&）
  if (var != 0) {
    if (array1.at(2) > 5) {
      // 条件体
    }
  }
  
  // 正确的浮点数（带f后缀）
  f32 value;
  value = 0.5f;
  
  // 避免索引变量算术运算
  u32 idx;
  idx = 3;
  u32 next_idx;
  next_idx = idx;
  next_idx = next_idx + 1;
  array1.at(next_idx) = 20;
  
  // 使用十进制代替十六进制
  u32 mask;
  mask = 255; // 等同于0xFF
}

// 正确的parallel块结构
parallel p by 1 {
  with i in [10] {
    foreach i {
      array1.at(i) = i;
    }
  }
} 