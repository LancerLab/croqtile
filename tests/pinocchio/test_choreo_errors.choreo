// 这是一个包含常见Choreo错误的示例文件

// 错误1: 使用大写类型名
U32 [10] array1;

// 错误2: 多维数组使用多个方括号
u32 [2][4] array2;

// 错误3: 函数中数组参数
__co__ void process_array(u32 [10] input) {
  // 函数体
}

// 错误4: 变量声明时赋值
__co__ void test_func() {
  u32 var = 123;
  
  // 错误5: 使用方括号访问数组
  array1[5] = 10;
  
  // 错误6: 使用复合逻辑表达式
  if (var != 0 && array1[2] > 5) {
    // 条件体
  }
  
  // 错误7: 浮点数没有f后缀
  f32 value;
  value = 0.5;
  
  // 错误8: 索引变量使用算术运算
  u32 idx = 3;
  array1[idx + 1] = 20;
  
  // 错误9: 使用十六进制常量
  u32 mask = 0xFF;
}

// 错误10: 空的parallel块
parallel p by 1 {
  // 空块
}

// 错误11: 缺少with子句的foreach
foreach i {
  // 操作
} 