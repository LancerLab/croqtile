// RUN: TRACE_DESUGAR= choreo -sa desugar %s | FileCheck --match-full-lines %s

__co__ int foo(f32 mdspan[2, 3, 4] d, int e, bool, f32 mdspan<2> a) {
  c : a [(0), (1)];
  b : d [1, (0), (2)];
}

// CHECK: Name dims of `a': f32 <2> ---> f32 [ $0 $1 ]
// CHECK: Desugar ref: (0) ---> a(0)
// CHECK: Desugar ref: (1) ---> a(1)
// CHECK: Desugar ref: (0) ---> d(0)
// CHECK: Desugar ref: (2) ---> d(2)

__co__ auto foobar(f32 mdspan[?, 2, ?, 4] a) { return a; }

// CHECK: Name dims of `a': f32 [ ? 2 ? 4 ] ---> f32 [ $0 2 $1 4 ]
