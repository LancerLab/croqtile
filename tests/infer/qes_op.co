// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo -vn %s | FileCheck --check-prefix=VALNO --match-full-lines %s

#include "choreo.h"

__co__ void qes_op(int u_x, int u_y) {
  bool f = false;
  bool t = true;

  // c for constant
  // u for unknown

  int c_x = 10;
  int c_y = 10;
  int c_z = 200;

  int a = 0;
  int b = 1;

  int c_0 = (c_x > c_z) ? a : b;
  int c_1 = (c_x < c_z) ? a : b;
  int c_2 = (c_x == c_y) ? a : b;
  int c_3 = (c_x != c_z) ? a : b;
  int c_4 = (c_x <= c_z) ? a : b;
  int c_5 = (c_x < c_y) ? a : b;
  int c_6 = (c_x != c_z) ? a : b;
  int c_7 = (c_x > c_z) ? 999 : b;
  int c_8 = (c_x >= c_z) ? 999 : 9;
  int c_9 = (9 <= 999) ? 999 : 9;

  int u_0 = (u_x > u_y) ? a : b;
  int u_1 = (u_x == c_x) ? a : b;
  int u_2 = (u_x != u_y) ? u_x : b;
  int u_3 = (c_x < c_z) ? u_x : b;
  int u_4 = (c_x < c_z) ? u_x : 999;
  int u_5 = (u_x < c_z) ? 99 : 999;
}

