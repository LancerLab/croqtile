// RUN: choreo -dv=norm -sa=norm %s | FileCheck --match-full-lines %s
// RUN: choreo -i %s | FileCheck --check-prefix=INFER --match-full-lines %s

__co__ auto chunkat_dontcare(s32 [4, 8, 16] i) {
  s32 [i.span] o;
  parallel p by 4 {
    l0 = dma.copy i => local;
    // l1 = dma.copy i.chunkat(_, _, _) => local;
    with {t0} in [2] {
      foreach t0 {
        l2 = dma.copy i.chunkat(t0, _, _) => local;
        l3 = dma.copy i.chunkat(_, t0, _) => local;
        l4 = dma.copy i.chunkat(_, t0, t0) => local;
        l5 = dma.copy i.chunkat(_, t0, _) => local;
        dma.copy l5 => o.chunkat(_, t0, _);
      }
    }
  }
}

// CHECK: Place storage of 'o': DEFAULT ---> GLOBAL
// CHECK: Wrap the `with in` at tests/infer/chunkat_dontcare.co:9.1-8.
// CHECK: Generate with-matchers for '__choreo_zero': __choreo_zero__elem__0
// CHECK: replace t0 with t0.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace t0 with t0.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace t0 with t0.
// CHECK: replace t0 with t0.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace t0 with t0.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace __choreo_zero with __choreo_zero.
// CHECK: replace t0 with t0.
// CHECK: replace __choreo_zero with __choreo_zero.

