// VALNO:   Alias "#0,#1,#2(1)" -> #1
// VALNO:   Alias "#0,#1,#2(2)" -> #2
// VALNO:   New VN #4: 'foo::d'
// VALNO:   Alias "foo::d.span" -> #3
// VALNO:   New VN #5: 'foo::e'
// VALNO:   New VN #6: 'foo::anon_0'
// VALNO:   New VN #7: 'foo::a'
// VALNO: } // end scope-1

