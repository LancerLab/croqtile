// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo -vn -dv=valno %s | FileCheck --check-prefix=CHKVALNO --match-full-lines %s

// device program
__co__ void bounded_arith(s32 [180, 27, 12] a) {
  parallel p by 6 {
    with index = {x, y, z} in [10, 9, 2] {
      foreach index {
        dma.copy a.chunkat(x, y(1), p(-2)) => local;
        dma.copy a.chunkat(x # y, y + 1, p(-1)) => local;
        dma.copy a.chunkat(x # y # z, y + 2, p(1)) => local;
//        dma.copy a.chunkat(5 + x * p, 1 - y, p) => local;
      }
    }
  }
}

// CHKVALNO:      Alias "::bounded_arith::paraby_0::paraby_1::within_0::@y" -> [[Y_VAL:#[0-9]+]]
// CHKVALNO:       New VN [[CONST_VAL:#[0-9]+]]: 'const_90'
// CHKVALNO:       <Bounded> ' (x # y) 's ubound: 'const_90'
// CHKVALNO:       Alias "::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::@anon_0" -> [[CONST_VAL]]
// CHKVALNO:       <Bounded> ' (y + 1) 's ubound: 'const_9'
// CHKVALNO:       Alias "::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::@anon_1" -> [[Y_VAL]]
// CHKVALNO:       <Bounded> ' ( (x # y)  # z) 's ubound: 'const_180'
// CHKVALNO:       Alias "::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::@anon_2" -> #{{[0-9]+}}
// CHKVALNO:       <Bounded> ' (y + 2) 's ubound: 'const_9'


// CHECK: Parameter: ::bounded_arith::a, Type: s32 mdspan<3> [180, 27, 12]
// CHECK: Bounded:   ::bounded_arith::paraby_0::paraby_1::p, Type: {int}->[6](pv)
// CHECK: Bounded:   ::bounded_arith::paraby_0::paraby_1::within_0::index, Type: {int,int,int}->[10, 9, 2]
// CHECK: Bounded:   ::bounded_arith::paraby_0::paraby_1::within_0::x, Type: {int}->[10]
// CHECK: Bounded:   ::bounded_arith::paraby_0::paraby_1::within_0::y, Type: {int}->[9]
// CHECK: Future:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::(anon), Type: sync=>local s32 mdspan<3> [18, 3, 2]
// CHECK: Symbol:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::anon_0, Type: {int}->[90]
// CHECK: Symbol:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::anon_1, Type: {int}->[9]
// CHECK: Future:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::(anon), Type: sync=>local s32 mdspan<3> [2, 3, 2]
// CHECK: Symbol:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::anon_2, Type: {int}->[180]
// CHECK: Symbol:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::anon_3, Type: {int}->[9]
// CHECK: Future:    ::bounded_arith::paraby_0::paraby_1::within_0::foreach_0::(anon), Type: sync=>local s32 mdspan<3> [1, 3, 2]
// CHECK: Function:  ::bounded_arith, Type: void (*)(s32 mdspan<3> [180, 27, 12])

__co__ void bounded_decls() {
  parallel p by 6 {
    foreach n_tile in [16] {
      a = n_tile % 2;
      b = (p + 3) / 2;
    }
  }
}

