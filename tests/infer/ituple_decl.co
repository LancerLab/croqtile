// VALNO:  Alias "#0,#1,#2(1)" -> #1
// VALNO:  Alias "#0,#1,#2(2)" -> #2
// VALNO:  Alias "foo::d.span" -> #3
// VALNO:   New VN #5: 'foo::e'
// VALNO:   New VN #6: 'const_5'
// VALNO:   New VN #7: 'const_1'
// VALNO:   New VN #8: 'index_const_2'
// VALNO:   <Simplify> 'dimof:#3:#8 / ref:#1' to 'const_1'
// VALNO:   <Simplify> 'dimof:#3:#8 / ref:#1' to 'const_1'
