// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index" -> #17
// VALNO:     scope-4 {
// VALNO-DAG:      <Simplify> 'const_6 / const_128 to 'const_0'
// VALNO-DAG:      New VN #18: 'const_0'
// VALNO-DAG:      <Simplify> 'const_128 / const_32 to 'const_4'
// VALNO-DAG:      New VN #19: 'const_4'
// VALNO:      New VN #20: '#18,#19'
// VALNO:      Alias "::with_foreach::paraby_0::within_6::foreach_6::lhs_load.span" -> #20
// VALNO:      Alias "#18,#19(0)" -> #18
// VALNO:      Alias "#18,#19(1)" -> #19
// VALNO:     } // end scope-4
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  parallel p by 1 {
    int bb = |lhs.span|;
    with idx0 in 3 {
      with idx1 in bb {
        foreach idx0, idx1 {}
      }
    }
  }
// CHECK: Symbol:    ::with_foreach::paraby_1::bb, Type: int
// CHECK: Bounded:   ::with_foreach::paraby_1::within_7::idx0, Type: {int}->[3]
// CHECK: Bounded:   ::with_foreach::paraby_1::within_7::idx0__elem__0, Type: {int}->[3]
// CHECK: Bounded:   ::with_foreach::paraby_1::within_7::within_8::idx1, Type: {int}->[768]
