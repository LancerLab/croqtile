// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo -v %s | FileCheck --check-prefix=VALNO --match-full-lines %s

#include "choreo.h"

__co__ void with_foreach(s32 [6, 128] lhs, s32 [128] rhs) {
// VALNO:  scope-1 {
// VALNO:   New VN #0: 'const_6'
// VALNO:   New VN #1: 'const_128'
// VALNO:   New VN #2: '#0,#1'
// VALNO:   New VN #3: 'index_const_0'
// VALNO:   Alias "#0,#1(0)" -> #0
// VALNO:   New VN #4: 'index_const_1'
// VALNO:   Alias "#0,#1(1)" -> #1
// VALNO:   Alias "::with_foreach::lhs.span" -> #2
// VALNO:   Alias "::with_foreach::rhs.span" -> #1
  with index={m} in [32] {
    foreach m {}
  }
// CHECK: Bounded:   ::with_foreach::within_0::index, Type: {int}->[32]
// CHECK: Bounded:   ::with_foreach::within_0::m, Type: {int}->[32]
// VALNO:   scope-2 {
// VALNO:    New VN #5: 'const_32'
// VALNO:    Alias "::with_foreach::within_0::@index(0)" -> #5
// VALNO:    Alias "::with_foreach::within_0::@m" -> #5
// VALNO:    Alias "::with_foreach::within_0::@index" -> #5
// VALNO:    scope-3 {
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  // These two methods are exactly the same
  with index={m, n} in [32, 128] {
    foreach m, n {}
  }
  with index={m, n} in [32, 128] {
    foreach index {}
  }
// CHECK: Bounded:   ::with_foreach::within_1::index, Type: {int,int}->[32, 128]
// CHECK: Bounded:   ::with_foreach::within_1::m, Type: {int}->[32]
// CHECK: Bounded:   ::with_foreach::within_1::n, Type: {int}->[128]
// CHECK: Bounded:   ::with_foreach::within_2::index, Type: {int,int}->[32, 128]
// CHECK: Bounded:   ::with_foreach::within_2::m, Type: {int}->[32]
// CHECK: Bounded:   ::with_foreach::within_2::n, Type: {int}->[128]
// VALNO:   scope-2 {
// VALNO:    New VN #6: 'const_32'
// VALNO:    New VN #7: '#6,#1'
// VALNO:    Alias "#6,#1(0)" -> #6
// VALNO:    Alias "#6,#1(1)" -> #1
// VALNO:    Alias "::with_foreach::within_1::@index(0)" -> #6
// VALNO:    Alias "::with_foreach::within_1::@m" -> #6
// VALNO:    Alias "::with_foreach::within_1::@index(1)" -> #1
// VALNO:    Alias "::with_foreach::within_1::@n" -> #1
// VALNO:    Alias "::with_foreach::within_1::@index" -> #7
// VALNO:    scope-3 {
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2
// VALNO:   scope-2 {
// VALNO:    New VN #8: 'const_32'
// VALNO:    New VN #9: '#8,#1'
// VALNO:    Alias "#8,#1(0)" -> #8
// VALNO:    Alias "#8,#1(1)" -> #1
// VALNO:    Alias "::with_foreach::within_2::@index(0)" -> #8
// VALNO:    Alias "::with_foreach::within_2::@m" -> #8
// VALNO:    Alias "::with_foreach::within_2::@index(1)" -> #1
// VALNO:    Alias "::with_foreach::within_2::@n" -> #1
// VALNO:    Alias "::with_foreach::within_2::@index" -> #9
// VALNO:    scope-3 {
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  with index in [32, 128] {
    foreach index {}
  }
// CHECK: Bounded:   ::with_foreach::within_3::index, Type: {int,int}->[32, 128]
// CHECK: Bounded:   ::with_foreach::within_3::index__elem__0, Type: {int}->[32]
// CHECK: Bounded:   ::with_foreach::within_3::index__elem__1, Type: {int}->[128]
// VALNO:   scope-2 {
// VALNO:    New VN #10: 'const_32'
// VALNO:    New VN #11: '#10,#1'
// VALNO:    Alias "#10,#1(0)" -> #10
// VALNO:    Alias "#10,#1(1)" -> #1
// VALNO:    Alias "::with_foreach::within_3::@index(0)" -> #10
// VALNO:    Alias "::with_foreach::within_3::@index__elem__0" -> #10
// VALNO:    Alias "::with_foreach::within_3::@index(1)" -> #1
// VALNO:    Alias "::with_foreach::within_3::@index__elem__1" -> #1
// VALNO:    Alias "::with_foreach::within_3::@index" -> #11
// VALNO:    scope-3 {
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  with index in [32] {
    foreach index {
      rhs_load = dma.copy rhs.chunkat(index) => shared;
    }
  }
// CHECK: Bounded:   ::with_foreach::within_4::index, Type: {int}->[32]
// CHECK: Bounded:   ::with_foreach::within_4::index__elem__0, Type: {int}->[32]
// CHECK: Future:    ::with_foreach::within_4::foreach_4::rhs_load, Type: sync=>shared s32 mdspan<1> [4]
// VALNO:   scope-2 {
// VALNO:    New VN #12: 'const_32'
// VALNO:    Alias "::with_foreach::within_4::@index(0)" -> #12
// VALNO:    Alias "::with_foreach::within_4::@index__elem__0" -> #12
// VALNO:    Alias "::with_foreach::within_4::@index" -> #12
// VALNO:    scope-3 {
// VALNO:     <Simplify> 'const_128 / const_32 to 'const_4'
// VALNO:     New VN #13: 'const_4'
// VALNO:     Alias "::with_foreach::within_4::foreach_4::rhs_load.span" -> #13
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  with {m} in [32] {
    foreach m {}
  }
// CHECK: Bounded:   ::with_foreach::within_5::m, Type: {int}->[32]
// VALNO:   scope-2 {
// VALNO:    New VN #14: 'const_32'
// VALNO:    Alias "::with_foreach::within_5::@m" -> #14
// VALNO:    scope-3 {
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2

  parallel p by 1{
    with index in [128, 32] {
      foreach index {
        lhs_load = dma.copy lhs.chunkat(index) => local;
      }
    }
  }
// CHECK: Bounded:   ::with_foreach::paraby_0::p, Type: {int}->[1]
// CHECK: Bounded:   ::with_foreach::paraby_0::within_6::index, Type: {int,int}->[128, 32]
// CHECK: Bounded:   ::with_foreach::paraby_0::within_6::index__elem__0, Type: {int}->[128]
// CHECK: Bounded:   ::with_foreach::paraby_0::within_6::index__elem__1, Type: {int}->[32]
// CHECK: Future:    ::with_foreach::paraby_0::within_6::foreach_6::lhs_load, Type: sync=>local s32 mdspan<2> [0, 0]
// VALNO:   scope-2 {
// VALNO:    New VN #15: 'const_1'
// VALNO:    Alias "::with_foreach::paraby_0::@p" -> #15
// VALNO:    scope-3 {
// VALNO:     New VN #16: 'const_32'
// VALNO:     New VN #17: '#1,#16'
// VALNO:     Alias "#1,#16(0)" -> #1
// VALNO:     Alias "#1,#16(1)" -> #16
// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index(0)" -> #1
// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index__elem__0" -> #1
// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index(1)" -> #16
// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index__elem__1" -> #16
// VALNO:     Alias "::with_foreach::paraby_0::within_6::@index" -> #17
// VALNO:     scope-4 {
// VALNO:      <Simplify> 'const_6 / const_128 to 'const_0'
// VALNO:      New VN #18: 'const_0'
// VALNO:      <Simplify> 'const_6 / const_32 to 'const_0'
// VALNO:      New VN #19: '#18,#18'
// VALNO:      Alias "::with_foreach::paraby_0::within_6::foreach_6::lhs_load.span" -> #19
// VALNO:     } // end scope-4
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2
// VALNO:  } // end scope-1
}

