// RUN: choreo -t factor %s -i | FileCheck --check-prefix=CHECK-FACT %s
// RUN: choreo -t cuda %s -i | FileCheck --check-prefix=CHECK-CUDA %s

__co__ auto bar(int) {}

__co__ auto correct() { return 1; }

// CHECK-FACT: Parameter: ::bar::anon_0, Type: int
// CHECK-FACT: Function:  ::bar, Type: void (*)(int)
// CHECK-FACT: Symbol:    ::correct::anon_1, Type: global s32 mdspan<1> [1]
// CHECK-FACT: Function:  ::correct, Type: s32 mdspan<1> [1] (*)()

// CHECK-CUDA: Parameter: ::bar::anon_0, Type: int
// CHECK-CUDA: Function:  ::bar, Type: void (*)(int)
// CHECK-CUDA: Function:  ::correct, Type: int (*)()
