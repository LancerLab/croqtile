// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo -vn %s | FileCheck --check-prefix=VALNO --match-full-lines %s

__co__ void bar1() {
  parallel bdim = {x, y} by [2, 6] {
    local f16[4] l;
  }

  parallel gdim = {xx, yy, zz} by [2, 6, 3] {
    parallel bdim = {x, y} by [4, 5] {
      local f16[4] l;
    }
  }

  parallel p by 4 {
    parallel q = {x, y, z} by [4, 3, 2] {
      local f16[4] l;
    }
  }
}

// CHECK: Bounded:   ::bar1::paraby_0::bdim, Type: {int,int}->[2, 6]
// CHECK: Bounded:   ::bar1::paraby_0::x, Type: {int}->[2]
// CHECK: Bounded:   ::bar1::paraby_0::y, Type: {int}->[6]
// CHECK: Symbol:    ::bar1::paraby_0::l, Type: local f16 mdspan<1> [4]
// CHECK: Bounded:   ::bar1::paraby_1::gdim, Type: {int,int,int}->[2, 6, 3]
// CHECK: Bounded:   ::bar1::paraby_1::xx, Type: {int}->[2]
// CHECK: Bounded:   ::bar1::paraby_1::yy, Type: {int}->[6]
// CHECK: Bounded:   ::bar1::paraby_1::zz, Type: {int}->[3]
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::bdim, Type: {int,int}->[4, 5]
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::x, Type: {int}->[4]
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::y, Type: {int}->[5]
// CHECK: Symbol:    ::bar1::paraby_1::paraby_2::l, Type: local f16 mdspan<1> [4]
// CHECK: Bounded:   ::bar1::paraby_3::p, Type: {int}->[4]
// CHECK: Bounded:   ::bar1::paraby_3::p__elem__x, Type: {int}->[4]
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::q, Type: {int,int,int}->[4, 3, 2]
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::x, Type: {int}->[4]
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::y, Type: {int}->[3]
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::z, Type: {int}->[2]
// CHECK: Symbol:    ::bar1::paraby_3::paraby_4::l, Type: local f16 mdspan<1> [4]
// CHECK: Function:  ::bar1, Type: void (*)()

// VALNO:  scope-1 {
// VALNO:   New VN #0: 'const_1'
// VALNO:   Alias "::@__choreo_no_tiling__" -> #0
// VALNO:   scope-2 {
// VALNO:    New VN #1: 'const_2'
// VALNO:    New VN #2: 'const_6'
// VALNO:    New VN #3: '#1,#2'
// VALNO:    Alias "::bar1::paraby_0::@bdim" -> #3
// VALNO:    Alias "::bar1::paraby_0::@x" -> #1
// VALNO:    Alias "::bar1::paraby_0::@y" -> #2
// VALNO:    New VN #4: 'const_4'
// VALNO:    Alias "::bar1::paraby_0::l.span" -> #4
// VALNO:   } // end scope-2
// VALNO:   scope-2 {
// VALNO:    New VN #5: 'const_2'
// VALNO:    New VN #6: 'const_6'
// VALNO:    New VN #7: 'const_3'
// VALNO:    New VN #8: '#5,#6,#7'
// VALNO:    Alias "::bar1::paraby_1::@gdim" -> #8
// VALNO:    Alias "::bar1::paraby_1::@xx" -> #5
// VALNO:    Alias "::bar1::paraby_1::@yy" -> #6
// VALNO:    Alias "::bar1::paraby_1::@zz" -> #7
// VALNO:    scope-3 {
// VALNO:     New VN #9: 'const_4'
// VALNO:     New VN #10: 'const_5'
// VALNO:     New VN #11: '#9,#10'
// VALNO:     Alias "::bar1::paraby_1::paraby_2::@bdim" -> #11
// VALNO:     Alias "::bar1::paraby_1::paraby_2::@x" -> #9
// VALNO:     Alias "::bar1::paraby_1::paraby_2::@y" -> #10
// VALNO:     Alias "::bar1::paraby_1::paraby_2::l.span" -> #9
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2
// VALNO:   scope-2 {
// VALNO:    New VN #12: 'const_4'
// VALNO:    Alias "::bar1::paraby_3::@p" -> #12
// VALNO:    Alias "::bar1::paraby_3::@p__elem__x" -> #12
// VALNO:    scope-3 {
// VALNO:     New VN #13: 'const_3'
// VALNO:     New VN #14: 'const_2'
// VALNO:     New VN #15: '#12,#13,#14'
// VALNO:     Alias "::bar1::paraby_3::paraby_4::@q" -> #15
// VALNO:     Alias "::bar1::paraby_3::paraby_4::@x" -> #12
// VALNO:     Alias "::bar1::paraby_3::paraby_4::@y" -> #13
// VALNO:     Alias "::bar1::paraby_3::paraby_4::@z" -> #14
// VALNO:     Alias "::bar1::paraby_3::paraby_4::l.span" -> #12
// VALNO:    } // end scope-3
// VALNO:   } // end scope-2
// VALNO:  } // end scope-1
