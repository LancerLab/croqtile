// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo -vn %s | FileCheck --check-prefix=VALNO --match-full-lines %s

__co__ void bar1() {
  parallel bdim = {x, y} by [2, 6] {
    local f16[4] l;
  }

  parallel gdim = {xx, yy, zz} by [2, 6, 3] {
    parallel bdim = {x, y} by [4, 5] {
      local f16[4] l;
    }
  }

  parallel p by 4 {
    parallel q = {x, y, z} by [4, 3, 2] {
      local f16[4] l;
    }
  }
}

// CHECK: Bounded:   ::bar1::paraby_0::bdim, Type: {int,int}->[2, 6](pv)
// CHECK: Bounded:   ::bar1::paraby_0::x, Type: {int}->[2](pi:x)
// CHECK: Bounded:   ::bar1::paraby_0::y, Type: {int}->[6](pi:y)
// CHECK: Symbol:    ::bar1::paraby_0::l, Type: local f16 mdspan<1> [4]
// CHECK: Bounded:   ::bar1::paraby_1::gdim, Type: {int,int,int}->[2, 6, 3](pv)
// CHECK: Bounded:   ::bar1::paraby_1::xx, Type: {int}->[2](pi:x)
// CHECK: Bounded:   ::bar1::paraby_1::yy, Type: {int}->[6](pi:y)
// CHECK: Bounded:   ::bar1::paraby_1::zz, Type: {int}->[3](pi:z)
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::bdim, Type: {int,int}->[4, 5](pv)
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::x, Type: {int}->[4](pi:x)
// CHECK: Bounded:   ::bar1::paraby_1::paraby_2::y, Type: {int}->[5](pi:y)
// CHECK: Symbol:    ::bar1::paraby_1::paraby_2::l, Type: local f16 mdspan<1> [4]
// CHECK: Bounded:   ::bar1::paraby_3::p, Type: {int}->[4](pv)
// CHECK: Bounded:   ::bar1::paraby_3::p__elem__x, Type: {int}->[4](pi:x)
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::q, Type: {int,int,int}->[4, 3, 2](pv)
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::x, Type: {int}->[4](pi:x)
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::y, Type: {int}->[3](pi:y)
// CHECK: Bounded:   ::bar1::paraby_3::paraby_4::z, Type: {int}->[2](pi:z)
// CHECK: Symbol:    ::bar1::paraby_3::paraby_4::l, Type: local f16 mdspan<1> [4]
// CHECK: Function:  ::bar1, Type: void (*)()

// VALNO:  scope-1 {
// VALNO:   New VN #0: 'const_1'
// VALNO:   Alias "::@__choreo_no_tiling__" -> #0
// VALNO:   New VN #1: '::__choreo_no_tiling__'
