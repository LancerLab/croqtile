// RUN: choreo -gs -t factor %s -dv=norm,latenorm | FileCheck %s

// device program
__co__ void dma_norm(f16 [180, 27, 12] a) {
  parallel p by 6 {
    local f16 [18, 3, 2] b;
    local f16 [18, 3, 2] c;
    with index = {x, y} in [10, 9] {
      foreach index {
        f = dma.copy.async a.chunkat(x, y, p) => local;
        dma.copy a.chunkat(x, y, p) => select(x % 3, b, c);
        wait f;
      }
      local f16 [18, 3, 2] buffer;
      dma.copy a.chunkat(x, y, p) => buffer;
    }
  }
}

// CHECK: Hoisted:
// CHECK-NEXT: `- Assign: anon_0 = select( (x % 3) , b, c)
// CHECK: Hoisted:
// CHECK-NEXT: `- Var Decl (): f__buf__, type: local f16 mdspan<3> [18, 3, 2]
// CHECK:     auto b = alloc_(L1Type(FloatType(16),{18, 3, 2}));
// CHECK:     auto c = alloc_(L1Type(FloatType(16),{18, 3, 2}));
// CHECK:     auto f__buf__ = alloc_(L1Type(FloatType(16),{18, 3, 2}));
// CHECK:     auto f = alloc_dma_(SDMAType());
// CHECK:     auto __choreo_anon_fut__0 = alloc_dma_(SDMAType());
// CHECK:     auto buffer = alloc_(L1Type(FloatType(16),{18, 3, 2}));
// CHECK:     auto __choreo_anon_fut__1 = alloc_dma_(SDMAType());
// CHECK:         async_load_(f, a, f__buf__, {Value(18)*iv_x,Value(3)*iv_y,Value(2)*thread_id});
// CHECK:         auto anon_0 = select_(((iv_x)%(Value(3))) == Value(0), b, c);
// CHECK:         async_load_(__choreo_anon_fut__0, a, anon_0, {Value(18)*iv_x,Value(3)*iv_y,Value(2)*thread_id});
// CHECK:         wait_dma_(__choreo_anon_fut__0);
// CHECK:     async_load_(__choreo_anon_fut__1, a, buffer, {Value(18)*x,Value(3)*y,Value(2)*thread_id});
// CHECK:     wait_dma_(__choreo_anon_fut__1);
