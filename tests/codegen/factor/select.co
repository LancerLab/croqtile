// RUN: choreo %s | FileCheck --match-full-lines %s

__co__ void bar(f32 [100, 10] b) {
  f32 [b.span] c;
  f32 [b.span] z;
  int g = 5;
  int h = 3;
  with a in [10] {
    d = select(#a % 2, b, c);
    f = select((g + b.span(1)) / 3, b, c, z);
  }
}

// CHECK:     auto d = select_(0== 0, b, c);
// CHECK:     auto f = select_(5== 0, b, select_(5== 1, c, z));
