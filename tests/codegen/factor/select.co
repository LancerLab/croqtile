// RUN: choreo -gs -t factor %s -o - | FileCheck --match-full-lines %s

__co__ void bar(f32 [100, 10] b) {
  f32 [b.span] c;
  f32 [b.span] z;
  int g = 5;
  int h = 3;
  with idx={a} in [10] {
    d = select(#a % 2, b, c);
    f = select((g + b.span(1)) / 3, b, c, z);
  }
}

// CHECK:     auto d = select_(Value(0)== Value(0), b, c);
// CHECK:     auto f = select_(Value(5)== Value(0), b, select_(Value(5)== Value(1), c, z));
