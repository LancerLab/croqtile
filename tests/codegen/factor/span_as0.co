// RUN: choreo %s | FileCheck --match-full-lines %s

__co__ auto span_as0(f32 [32, 18, 9] a) {
  c = a.span_as([ 288, 18 ]);
  d = a.span_as([ 576, 1, 3, 3 ]);

  s32 [1, 2, 3] m;
  n = m.span_as([6]);

  f32 [a.span] b;
  f32 [a.span] o;
  parallel p by 3 {
    with index = {x, y} in[4, 4] {
      foreach index {
        a_local = dma.copy a.span_as([ 16, 9, 36 ]).chunkat(x, p, y) => local;
        b_local = dma.copy b.span_as([ 144, 36 ]).chunkat(p, p) => local;
        o_store = dma.copy.async a_local => o.span_as([ 16, 9, 36 ]).chunkat(x, p, y);
      }
    }
  }
}

// CHECK:  D(host_func_)("__choreo_span_as0", {a_type, StreamType()}, [&](auto args) {
// CHECK:    auto c = bitcast_(DRAMType(FloatType(32), {288, 18}), args[0]);
// CHECK:    auto d = bitcast_(DRAMType(FloatType(32), {576, 1, 3, 3}), args[0]);
// CHECK:    auto m = alloc_(DRAMType(IntType(32),{1, 2, 3}));
// CHECK:    auto n = bitcast_(DRAMType(IntType(32), {6}), m);
// CHECK:    auto b = alloc_(DRAMType(FloatType(32),{32, 18, 9}));
// CHECK:    auto o = alloc_(DRAMType(FloatType(32),{32, 18, 9}));
// CHECK:    Dim3 grid_dim(1);
// CHECK:    Dim3 block_dim(3);
// CHECK:    auto ts = launch_kernel_("__choreo_span_as0_parallel", grid_dim, block_dim, args.back(), {args[0]}, {});
// CHECK:    return std::vector<Value>{};
// CHECK:  }, true); // end of choreo-factor dataflow program

// CHECK:  D(func_)("__choreo_span_as0_parallel", {a_type}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto a_local__buf__ = alloc_(L1Type(FloatType(32),{4, 3, 9}));
// CHECK:    auto a_local = alloc_dma_(SDMAType());
// CHECK:    auto b_local__buf__ = alloc_(L1Type(FloatType(32),{48, 12}));
// CHECK:    auto b_local = alloc_dma_(SDMAType());
// CHECK:    auto o_store = alloc_dma_(SDMAType());
// CHECK:    var_ x(IntType(32));
// CHECK:    x = 0;
// CHECK:    var_ y(IntType(32));
// CHECK:    y = 0;
// CHECK:    for_(x, 4, 1, [&](auto iv_x) {
// CHECK:      for_(y, 4, 1, [&](auto iv_y) {
// CHECK:        auto anon_3 = bitcast_(DRAMType(FloatType(32), {16, 9, 36}), args[0]);
// CHECK:        async_load_(a_local, anon_3, a_local__buf__, {Value(4)*iv_x,Value(3)*thread_id,Value(9)*iv_y});
// CHECK:        wait_dma_(a_local);
// CHECK:        auto anon_4 = bitcast_(DRAMType(FloatType(32), {144, 36}), b);
// CHECK:        async_load_(b_local, anon_4, b_local__buf__, {Value(48)*thread_id,Value(12)*thread_id});
// CHECK:        wait_dma_(b_local);
// CHECK:        auto anon_5 = bitcast_(DRAMType(FloatType(32), {16, 9, 36}), o);
// CHECK:        async_store_(o_store, a_local, anon_5, {Value(4)*iv_x,Value(3)*thread_id,Value(9)*iv_y});
// CHECK:      }); // end of choreo-foreach block on 'y'.
// CHECK:    }); // end of choreo-foreach block on 'x'.
// CHECK:  }); // end of choreo-factor kernel function
