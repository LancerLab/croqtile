// RUN: choreo -t factor -es %s -o - | FileCheck %s

#include "choreo.h"

__co__ f32 [2] func() {
  global f32 [2] out;
  parallel p by 1 {
    parallel q by 1 {
      local f32 [2] buf{-11.0f};
      dma.copy buf => out;
    }
  }
  return out;
}

// CHECK: D(func_)("__choreo_func_parallel", {}, {output_type}, [&](auto args, auto results) {
// CHECK:   auto & out = results[0];
// CHECK:   auto thread_id = thread_id_();
// CHECK:   auto block_id = block_id_();
// CHECK:   auto buf = alloc_(L1Type(FloatType(32),{2}));
// CHECK:   auto __choreo_anon_fut__0 = alloc_dma_(SDMAType());
// CHECK:   auto buf_init = alloc_dma_(SDMAType());
// CHECK:   memset_(buf_init, buf, -11.000000f);
// CHECK:   async_store_(__choreo_anon_fut__0, buf, out, {0});
// CHECK:   wait_dma_(__choreo_anon_fut__0);
// CHECK: }); // end of choreo-factor device function