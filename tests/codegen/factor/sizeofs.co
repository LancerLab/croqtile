// RUN: choreo -gs  %s | FileCheck %s --match-full-lines

__co__ void sizeofspanned(f16 [10, 20, 30] input) {

  f32 [input.span(0), input.span(1)] b;
  parallel p by 1 {
    call sizeofspanned_kernel(|b|);
  }
}

// CHECK: call_("sizeofspanned_kernel", {Value(200)});

__co__ void sizeoffuture(f16 [10, 20, 30] input) {
  parallel p by 5 {
    f = dma.copy input => local;
    call sizeoffuture_kernel(|f|);
  }
}

// CHECK: call_("sizeoffuture_kernel", {Value(6000)});

__co__ void sizeofselect(f16 [10, 24, 30] input) {
  parallel p by 5 {
    f = dma.copy input => local;
    f1 = dma.copy input => local;
    buf = select(1, f.data, f1.data);
    call sizeofselect_kernel(|buf|);
  }
}

// CHECK: call_("sizeofselect_kernel", {Value(7200)});
