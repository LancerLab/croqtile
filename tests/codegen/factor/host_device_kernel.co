// RUN: choreo -gs -t factor %s | FileCheck --match-full-lines %s
// RUN: choreo -gs -t factor %s | FileCheck --check-prefix=CNT %s

#include <queue>
void helper_func(int& cnt) {}

__cok__ {
extern "C" void kernel(int *input, int *output, int n) {
  for (int i = 0; i < n; ++i) output[i] = input[i] + 1;
}
}

#include <unordered_map>
void foo0() {}

__co__ auto bar(s32[128] input) {
  s32[128] output;
  parallel p by 1 {
    input_local = dma.copy input => local;
    output_local = dma.copy output => local;
    call kernel(input_local.data, output_local.data, |input_local|);
    dma.copy output_local => output;
  }
  return output;
}

#include <unordered_set>
void foo1() {}

int main() {
  choreo::s32 input[128];
  auto input_data = choreo::make_spanview<1, choreo::s32>((choreo::s32*)input, {128});
  input_data.fill_random(-10, 10);
  auto res = bar(input_data);
  std::cout << res.shape()[0] << std::endl;
  for (int i = 0; i < res.shape()[0]; ++i)
    assert(res[i] == input[i] + 1);
  return 0;
}

void foo2() {}

