// RUN: choreo -t factor -gs %s | FileCheck %s

__co__ auto chunkat_tile_one2(s32 [N, M, 64] i) {
  s32 [i.span] o;
  parallel p by 1 {
    with {t0, t1} in [N/256, M/128] {
      foreach t0 {
        i_s = dma.copy i.chunkat(t0, t1, _) => shared;
        shared s32 [i_s.span] o_s;
        parallel q by 8 {
          with {t2} in [i_s.span(0)/4] {
            foreach t2 {
              i_l = dma.copy i_s.chunkat(t2, _, _) => local;
              local s32[i_l.span] o_l;
              // call()
              dma.copy o_l => o_s.chunkat(t2, _, _);
            }
          }
        }
        dma.copy o_s => o.chunkat(t0, t1, _);
      }
    }
  }
  return o;
}

// CHECK:  D(func_)("__choreo_chunkat_tile_one2_parallel", {i_type}, {__choreo_factor_out_type}, [&](auto args, auto results) {
// CHECK:    auto & i = args[0];
// CHECK:    auto & o = results[0];
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto __choreo_nd_ref_M = dim_(args[0], 1);
// CHECK:    auto __choreo_nd_ref_N = dim_(args[0], 0);
// CHECK:    {
// CHECK:    auto i_s__buf__ = alloc_(SRAMType(IntType(32),{256, 128, 64})).shared_(SharedType::kBlockShared);
// CHECK:    auto i_s = alloc_dma_(CDMAType());
// CHECK:    auto o_s = alloc_(SRAMType(IntType(32),{256, 128, 64})).shared_(SharedType::kBlockShared);
// CHECK:    auto __choreo_anon_fut__1 = alloc_dma_(CDMAType());
// CHECK:    var_ t0(IntType(32));
// CHECK:    t0 = 0;
// CHECK:    var_ t1(IntType(32));
// CHECK:    t1 = 0;
// CHECK:    for_(t0, (dim_(args[0], 0) / 256), 1, [&](auto iv_t0) {
// CHECK:      async_load_(i_s, i, i_s__buf__, {Value(256)*iv_t0,Value(128)*t1,0});
// CHECK:      wait_dma_(i_s);
// CHECK:      {
// CHECK:      auto i_l__buf__ = alloc_(L1Type(IntType(32),{4, 128, 64}));
// CHECK:      auto i_l = alloc_dma_(SDMAType());
// CHECK:      auto o_l = alloc_(L1Type(IntType(32),{4, 128, 64}));
// CHECK:      auto __choreo_anon_fut__0 = alloc_dma_(SDMAType());
// CHECK:      var_ t2(IntType(32));
// CHECK:      t2 = 0;
// CHECK:      for_(t2, 64, 1, [&](auto iv_t2) {
// CHECK:        async_load_(i_l, i_s__buf__, i_l__buf__, {Value(4)*iv_t2,0,0});
// CHECK:        wait_dma_(i_l);
// CHECK:        async_store_(__choreo_anon_fut__0, o_l, o_s, {Value(4)*iv_t2,0,0});
// CHECK:        wait_dma_(__choreo_anon_fut__0);
// CHECK:      });
// CHECK:      }
// CHECK:      async_store_(__choreo_anon_fut__1, o_s, o, {Value(256)*iv_t0,Value(128)*t1,0});
// CHECK:      wait_dma_(__choreo_anon_fut__1);
// CHECK:    });
// CHECK:    }
// CHECK:  });
