// RUN: choreo %s | FileCheck --match-full-lines %s

__co__ auto chunkat_dontcare(s32 [4, 8, 16] i) {
  s32 [i.span] o;
  parallel p by 4 {
    l0 = dma.copy i => local;
    with {t0} in [2] {
      foreach t0 {
        l2 = dma.copy i.chunkat(t0, _, _) => local;
        l3 = dma.copy i.chunkat(_, t0, _) => local;
        l4 = dma.copy i.chunkat(_, t0, t0) => local;
        l5 = dma.copy i.chunkat(_, t0, _) => local;
        dma.copy l5 => o.chunkat(_, t0, _);
      }
    }
  }
}

__co__ auto chunkat_dontcare2(s32 [N, M, 64] i) {
  s32 [i.span] o;
  parallel p by 1 {
    with {t0, t1} in [N/256, M/128] {
      foreach t0 {
        i_s = dma.copy i.chunkat(t0, t1, _) => shared;
        shared s32 [i_s.span] o_s;
        parallel q by 8 {
          with {t2} in [i_s.span(0)/4] {
            foreach t2 {
              i_l = dma.copy i_s.chunkat(t2, _, _) => local;
              local s32[i_l.span] o_l;
              // call()
              dma.copy o_l => o_s.chunkat(t2, _, _);
            }
          }
        }
        dma.copy o_s => o.chunkat(t0, t1, _);
      }
    }
  }
  return o;
}

