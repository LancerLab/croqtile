// RUN: choreo -gs -t factor %s | FileCheck %s --match-full-lines

// device program
__co__ void bounded(s32 [12, 4, 16] a) {
  parallel p by 6 {
    with index = {x, y} in [2, 4] {
      foreach x, y {
        f = dma.copy a.chunkat(p, x, y) => local;
        local u16[1,1,1] one;
        eight : [2, 1, 4];
        call kernel(f.data, |a.span|, |f.span|, |one.span|, |eight|);
      }
    }
  }
}

// CHECK: call_("kernel", {f__buf__.addr_(),Value(768),Value(16),Value(1),Value(8)});
