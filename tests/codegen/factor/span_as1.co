// RUN: choreo %s | FileCheck --match-full-lines %s

__co__ s32 [N, M, K] ele_add(s32 [N, M, K] lhs, s32 [N, M, K] rhs) {
  s32[lhs.span] output;

  parallel p by 1 {
    with index = {q, x, y, xx} in [N, K, M, N*K] / {4, 8, 1, 16} {
      foreach q {
        foreach x {
          foreach y { 
            lhs_load = dma.copy.async lhs.span_as([N, K, M]).chunkat(q, x, y) => local;
            rhs_load = dma.copy.async rhs.span_as([N, K, M]).chunkat(q, x, y) => local;
            wait lhs_load, rhs_load;

            local s32[lhs_load.span] l1_out;
            
            call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|);

            out_store = dma.copy.async l1_out => output.span_as([N, K, M]).chunkat(q, x, y);
            wait out_store;
          }
        }
      }
      foreach xx, y {
        lhs_load2 = dma.copy lhs.span_as([N*K, M]).chunkat(xx, y) => local;
      }
    }
  }

  return output;
}

