// RUN: choreo %s | FileCheck %s

// device program
__co__ void ubound(s32 [180, 27] a, int ua, int ub) {
  s32 [a.span] b;
  s32 [a.span] c;

  with index = {x, y} in [ua, ub] {
    d = select(#x % 2, a, b);
    e = select(#y % 3, a, b, c);
  }
}

// CHECK: auto d = select_(((::ubound::ua)%(Value(2)))== Value(0), a, b);
// CHECK: auto e = select_(((::ubound::ub)%(Value(3)))== Value(0), a, select_(((::ubound::ub)%(Value(3)))== Value(1), b, c));

