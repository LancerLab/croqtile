// CHECK:  choreo::runtime_check(hp0.shape()[2] == 128, "shape inconsistent on the 1st parameter (dim: 2).");
// CHECK:  choreo::runtime_check(hp1.shape()[0] == 6, "shape inconsistent on the 2nd parameter (dim: 0).");
// CHECK:  choreo::runtime_check(hp1.shape()[2] == 128, "shape inconsistent on the 2nd parameter (dim: 2).");
// CHECK:  CHECK(topsMalloc(&in_mem0, ((6ULL) * (hp0.shape()[1]) * (128ULL)) * 4));
// CHECK:  CHECK(topsMemcpy(in_mem0, reinterpret_cast<void *>(hp0.data()), ((6ULL) * (hp0.shape()[1]) * (128ULL)) * 4, topsMemcpyHostToDevice));
// CHECK:  CHECK(topsMalloc(&in_mem1, ((6ULL) * (hp1.shape()[1]) * (128ULL)) * 4));
// CHECK:  CHECK(topsMemcpy(in_mem1, reinterpret_cast<void *>(hp1.data()), ((6ULL) * (hp1.shape()[1]) * (128ULL)) * 4, topsMemcpyHostToDevice));
// CHECK:  CHECK(topsMalloc(&out_mem, ((6) * (hp0.shape()[1]) * (128)) * 4));
// CHECK:  auto res = choreo::make_spandata<s32, 3>({6, hp0.shape()[1], 128});
// CHECK:  CHECK(topsMemcpy(reinterpret_cast<void *>(res.data()), out_mem,
// CHECK:                  ((6) * (hp0.shape()[1]) * (128)) * 4, topsMemcpyDeviceToHost));

