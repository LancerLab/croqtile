// RUN: choreo -gs  %s | FileCheck --match-full-lines %s

#include "choreo.h"

__cok__ {
extern "C" void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}

}

__co__ auto ele_add(s32 [6, ?, 128] lhs, s32 [6, ?, 128] rhs) {
  s32[lhs.span] output;

  parallel p by 6 {
    with idx0 = {q, x, y} in lhs.span / {#p, 2, 32}, // [6/6, lhs.span(1) / 2, 128/32] = [1, lhs.span(1) / 2, 4 ]
         idx1 = {w, z, b} in rhs.span / {#p, 2, 32}
    where x <-> z {
      foreach idx0 {
        lhs_load = dma.copy.async lhs.chunkat(q, x, y) => local;
        rhs_load = dma.copy.async rhs.chunkat(q, z, y) => local;
        wait lhs_load, rhs_load;

        local s32[lhs_load.span] l1_out;
        call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|);

        out_store = dma.copy.async l1_out => output.chunkat(q,x,y);
        wait out_store;
      }
    }
  } // can use python styling
  return output;
}
// CHECK: auto lhs_type = DRAMType(IntType(32), {6, -1, 128});
// CHECK: auto rhs_type = DRAMType(IntType(32), {6, -1, 128});
// CHECK: auto output_type = DRAMType(IntType(32), {6, -1, 128});
// CHECK:    auto lhs_load__buf__ = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    auto rhs_load__buf__ = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    auto l1_out = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    for_(q, 1, 1, [&](auto iv_q) {
// CHECK:      for_(x, dim_(args[0], 1)/2-0, 1, [&](auto iv_x) {
// CHECK:        auto iv_z = iv_x;
// CHECK:        for_(y, 4, 1, [&](auto iv_y) {
// CHECK:          async_load_(lhs_load, lhs, lhs_load__buf__, {Value(6)*iv_q,Value(2)*iv_x,Value(32)*iv_y});
// CHECK:          async_load_(rhs_load, rhs, rhs_load__buf__, {Value(6)*iv_q,Value(2)*iv_z,Value(32)*iv_y});
// CHECK:          wait_dma_(lhs_load);
// CHECK:          wait_dma_(rhs_load);
// CHECK:          call_("kernel", {lhs_load__buf__.addr_(),rhs_load__buf__.addr_(),l1_out.addr_(),Value(384)});
// CHECK:          async_store_(out_store, l1_out, output, {Value(6)*iv_q,Value(2)*iv_x,Value(32)*iv_y});
// CHECK:          wait_dma_(out_store);
// CHECK:         }); // end of choreo-foreach block on 'y'.
// CHECK:       }); // end of choreo-foreach block on 'x'.
// CHECK:     }); // end of choreo-foreach block on 'q'.

