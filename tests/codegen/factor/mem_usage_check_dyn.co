// RUN: choreo -t factor -gs -arch=gcu300 %s | FileCheck %s

#include "choreo.h"

__cok__ {
extern "C" void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}

}

__co__ auto ele_add(s32 [6, ?, 128] lhs, s32 [6, ?, 128] rhs) {
  s32[lhs.span] output;

  parallel p by 6 {
    with idx0 = {q, x, y} in lhs.span / {#p, 2, 32}, // [6/6, lhs.span(1) / 2, 128/32] = [1, lhs.span(1) / 2, 4 ]
         idx1 = {w, z, b} in rhs.span / {#p, 2, 32}
    where x <-> z {
      foreach idx0 {
        lhs_load = dma.copy.async lhs.chunkat(q, x, y) => local;
        rhs_load = dma.copy.async rhs.chunkat(q, z, y) => local;
        wait lhs_load, rhs_load;

        local s32[lhs_load.span] l1_out;
        call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|);

        out_store = dma.copy.async l1_out => output.chunkat(q,x,y);
        wait out_store;
      }
    }
  } // can use python styling
  return output;
}

// CHECK:  choreo::runtime_check((size_t)0 + ((6ULL)*(hp0.shape()[1])*(128ULL))*4 <= (size_t)4294967296, "total memory usage at global level (compile time and runtime) should not exceed 4294967296 bytes, 
// CHECK:  choreo::runtime_check((size_t)0 + ((6ULL)*(hp0.shape()[1])*(128ULL))*4 + ((6ULL)*(hp1.shape()[1])*(128ULL))*4 <= (size_t)4294967296
// CHECK:  choreo::runtime_check((size_t)0 + ((6ULL)*(hp0.shape()[1])*(128ULL))*4 + ((6ULL)*(hp1.shape()[1])*(128ULL))*4 + ((6ULL)*(hp0.shape()[1])*(128ULL))*4 <= (size_t)4294967296
