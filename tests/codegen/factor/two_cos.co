// RUN: choreo -gs  %s | FileCheck %s

__co__ void a() {
  parallel p by 1 {
  }
}

__co__ auto b(bf16 [3, 4, 5] arg) {
  return arg;
}

void foo() {
  a();

  choreo::bf16 c[60];

  auto input_data = choreo::make_spanview<2, choreo::bf16>((choreo::bf16*)c, {3, 4, 5});
  auto res = b(input_data);
}

// CHECK: #ifndef __CHOREO_H__
// CHECK: #endif // __CHOREO_H__
// CHECK: using namespace factor;
// CHECK: void __choreo_a() {
// CHECK: } // end of __choreo_a
// CHECK: void __choreo_b() {
// CHECK: } // end of __choreo_b
// CHECK: MODULE_REGISTER("lib__choreo_two_cos", __choreo_a);
// CHECK: MODULE_REGISTER("lib__choreo_two_cos", __choreo_b);
// CHECK: void a() {
// CHECK: }
// CHECK: choreo::spanned_data<choreo::bf16, 3> b(const choreo::spanned_view<choreo::bf16, 3> & ) {
// CHECK: }
// CHECK:  CHECK(topsStreamSynchronize(stream));
// CHECK-NOT:  __CHOREO_H__
// CHECK-NOT: using namespace factor;
// CHECK-NOT: __choreo_a
// CHECK-NOT: __choreo_b
// CHECK-NOT: MODULE_REGISTER
// CHECK-NOT: void a()
// CHECK-NOT: choreo::spanned_data<choreo::bf16, 3> b(const choreo::spanned_view<choreo::bf16, 3> & )
