// RUN: choreo -gs  %s | FileCheck %s
__co__ s32 [6, 17, 128] globals_pass(s32 [6, 17, 128] lhs, s32 [6, 17, 128] rhs) { /// device program
  s32 [lhs.span] output;

  s32 [lhs.span] f1;

  parallel p by 6 {
    dma.copy lhs => output;
    dma.copy rhs => f1;
  }

  return output;
}

// CHECK:   auto lhs_type = DRAMType(IntType(32), {6, 17, 128});
// CHECK:   auto rhs_type = DRAMType(IntType(32), {6, 17, 128});
// CHECK:   auto f1_type = DRAMType(IntType(32), {6, 17, 128});
// CHECK:   auto __choreo_factor_out_type = DRAMType(IntType(32), {6, 17, 128});
// CHECK:   D(host_func_)("__choreo_globals_pass", {lhs_type, rhs_type, f1_type, StreamType()}, [&](auto args) {
// CHECK:     auto output = alloc_(__choreo_factor_out_type);
// CHECK:     auto ts = launch_kernel_("__choreo_globals_pass_parallel", grid_dim, block_dim, args.back(), {args[0], args[1], args[2]}, {output});
// CHECK:     return std::vector<Value>{output};
// CHECK:   }, true);
// CHECK:   D(func_)("__choreo_globals_pass_parallel", {lhs_type, rhs_type, f1_type}, {__choreo_factor_out_type}, [&](auto args, auto results) {
// CHECK:     auto & lhs = args[0];
// CHECK:     auto & rhs = args[1];
// CHECK:     auto & f1 = args[2];
// CHECK:     auto & output = results[0];
// CHECK:     auto __choreo_anon_fut__0 = alloc_dma_(CDMAType());
// CHECK:     auto __choreo_anon_fut__1 = alloc_dma_(CDMAType());
// CHECK:     async_load_(__choreo_anon_fut__0, lhs, output, {0, 0, 0});
// CHECK:     wait_dma_(__choreo_anon_fut__0);
// CHECK:     async_load_(__choreo_anon_fut__1, rhs, f1, {0, 0, 0});
// CHECK:     wait_dma_(__choreo_anon_fut__1);
// CHECK:   }); // end of choreo-factor device function
