// RUN: choreo -gs %s | FileCheck --match-full-lines %s

__co__ auto chunkat_tile_one4(s32 [N, M, 64] i, f32[16] oo) {
  s32 [i.span] o;
  s32 [5, 6] _;
  parallel p by 1 {
    with {t0, t1} in [N/256, M/128] {
      foreach t0 {
        i_s = dma.copy i.chunkat(t0, t1, _) => shared;
        shared s32 [i_s.span] o_s;
        parallel q by 8 {
          with {t2} in [i_s.span(0)/4] {
            foreach t2 {
              i_l = dma.copy i_s.chunkat(t2, _, _) => local;
              local s32[i_l.span] o_l;
              // call()
              dma.copy o_l => o_s.chunkat(t2, _, _);
            }
          }
        }
        dma.copy o_s => o.chunkat(t0, t1, _);
      }
      xxx = dma.copy _.chunkat(_, _) => shared;
      xxxx = dma.copy _ => shared;
    }
  }
  return o;
}

