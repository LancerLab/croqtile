// RUN: choreo %s | FileCheck %s

__co__ auto matmul(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32[lhs.span(0), rhs.span(1)] output;

  block_shape = {8, 1024, 128};
  parallel p by 1 {
    with index = {m_tile, k_tile, n_tile} in [M, K, N] / block_shape {
      foreach m_tile, n_tile {
        local s32 [block_shape(0), block_shape(2)] local_out;
        foreach k_tile {
          lhs_load = dma.copy lhs.chunkat(m_tile, k_tile) => local;
          rhs_load = dma.copy rhs.chunkat(k_tile, n_tile) => local;

          call kernel(lhs_load.data, rhs_load.data, local_out, block_shape(0), block_shape(1), block_shape(2));

          dma.copy local_out => output.chunkat(m_tile, n_tile); // can use defined vars
        }
      }
    }
  }
  return output;
}

// CHECK:     for_(m_tile, dim_(args[0], 0)/8-0, 1, [&](auto iv_m_tile) {
// CHECK:       for_(n_tile, dim_(args[1], 1)/128-0, 1, [&](auto iv_n_tile) {
// CHECK:         for_(k_tile, dim_(args[0], 1)/1024-0, 1, [&](auto iv_k_tile) {
// CHECK:           async_load_(lhs_load, args[0], lhs_load__buf__, {Value(8)*iv_m_tile,Value(1024)*iv_k_tile});
// CHECK:           wait_dma_(lhs_load);
// CHECK:           async_load_(rhs_load, args[1], rhs_load__buf__, {Value(1024)*iv_k_tile,Value(128)*iv_n_tile});
// CHECK:           wait_dma_(rhs_load);
// CHECK:           call_("kernel", {lhs_load__buf__.addr_(),rhs_load__buf__.addr_(),local_out.addr_(),Value(8),Value(1024),Value(128)});
// CHECK:           async_store_(__choreo_anon_fut__0, local_out, output, {Value(8)*iv_m_tile,Value(128)*iv_n_tile});
// CHECK:           wait_dma_(__choreo_anon_fut__0);
// CHECK:         }); // end of choreo-foreach block.
// CHECK:       }); // end of choreo-foreach block.
// CHECK:     }); // end of choreo-foreach block.
