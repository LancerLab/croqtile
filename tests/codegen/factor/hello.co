// RUN: choreo -gs -t factor %s -o - |grep -v "\<CHECK\>:" | FileCheck --match-full-lines %s

__cok__ { // kernel program
void hello() { printf("hello choreo\n"); }
}

// choreo tileflow program
__co__ void co_hello() {
  parallel p by 1 { call hello(); }
}

// host program
int main() {
  return co_hello();
}

