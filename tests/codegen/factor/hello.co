// CHECK: #include "choreo.h"
// CHECK: void co_hello() {
// CHECK:    {{.*}}topsStreamCreate{{.*}}
// CHECK:     __choreo_co_hello(stream);
// CHECK:    {{.*}}topsStreamSynchronize{{.*}}
// CHECK:    {{.*}}topsStreamDestroy{{.*}}
