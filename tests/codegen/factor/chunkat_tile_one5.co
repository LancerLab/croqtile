// RUN: choreo -t factor -gs %s | FileCheck %s

__co__ s32 [512, 1024] chunkat_tile_one5(s32 [512, 1024] lhs, s32 [1024, 1024] rhs) { 
  s32[lhs.span(0), rhs.span(1)] output; 

  parallel p by 1 {  
    with index = {m_tile, n_tile} in [512, 1024] {  
      foreach m_tile { 
        foreach n_tile {
          lhs_load = dma.copy.async lhs.chunkat(m_tile, _) => shared; 
          rhs_load = dma.copy.async rhs.chunkat(_, n_tile) => shared; 
          wait lhs_load, rhs_load;
          parallel q by 1 {
            with index = {m_tile_s, n_tile_s} in [1, 1] {
              foreach m_tile_s {
                foreach n_tile_s {
                  lhs_load_s = dma.copy.async lhs_load.data.chunkat(m_tile_s, _) => local;
                  rhs_load_s = dma.copy.async rhs_load.data.chunkat(_, n_tile_s) => local;
                  wait lhs_load_s, rhs_load_s;
                  // call kernel(lhs_load_s.data, rhs_load_s.data, out_load_s.data); 
                }
              }
            }
          }
        }
      }
    }
  } 
  return output;
}

