// RUN: not choreo -fno-show-source-location %s 2>&1 | FileCheck %s

// this check the scopes for the variable declarations
__co__ void foo(f32 [32] d, int) {
  shared f32 [1, 2] a;
  local  f16 [d.span] b;
  global bf16 [a.span + {1, 1}] c;
  int e = 1;
  ituple f = {3, 4, 5};
}
// CHECK: shared variable 'a` must be declared inside single level of parallel-by.
// CHECK-NEXT: local variable 'b` must be declared inside parallel-by.

__co__ void bar(f32 [32] d, int) {
  parallel p by 6 {
    shared f32 [1, 2] a;
    local  f16 [d.span] b;
    global bf16 [a.span + {1, 1}] c;
		int e = 1;
		ituple f = {3, 4, 5};
  }
}
// CHECK-NEXT: global variable 'c` mustn't be declared inside parallel-by.

__co__ void foobar(f32 [32] d, int) {
  parallel p by 6 {
    parallel q by 2 {
      shared f32 [1, 2] a;
      local  f16 [d.span] b;
      global bf16 [a.span + {1, 1}] c;
			int e = 1;
			ituple f = {3, 4, 5};
    }
  }
}
// CHECK: shared variable 'a` must be declared inside single level of parallel-by.
// CHECK: global variable 'c` mustn't be declared inside parallel-by.

__co__ void local_shared(f32 [32, 2] d, int) {
	global bf16 [d.span + {1, 1}] c;
  parallel p by 6 {
		shared f32 [1, 2] a;
		local  f16 [d.span] b;
    parallel q by 2 {
      local  f16 [d.span] b;
			int e = 1;
			ituple f = {3, 4, 5};
    }
  }
}
// CHECK-NEXT: local variable 'b` must be declared inside a level of parallel-by that is identical to other local variables.

__co__ void two_locals(f32 [32, 18] d, int) {
	global bf16 [d.span + {1, 1}] c;
  parallel p by 6 {
		local f16 [d.span] b;
    parallel q by 2 {
      local f16 [d.span] b;
			int e = 1;
			ituple f = {3, 4, 5};
    }
  }
}
// CHECK-NEXT: local variable 'b` must be declared inside a level of parallel-by that is identical to other local variables.

__co__ void two_shared(f32 [32, 7] d, int) {
	global bf16 [d.span + {1, 1}] c;
  parallel p by 6 {
		shared f32 [1, 2] a;
		shared f16 [d.span] b;
    parallel q by 2 {
      local  f16 [d.span] b;
			int e = 1;
			ituple f = {3, 4, 5};
    }
  }
}

__co__ void normal(f32 [32, 12] d, int) {
	global bf16 [d.span + {1, 1}] c;
  parallel p by 6 {
		shared f32 [1, 2] a;
    parallel q by 2 {
      local  f16 [d.span] b;
			int e = 1;
			ituple f = {3, 4, 5};
    }
  }
}

// CHECK-NOT: local variable
// CHECK-NOT: shared variable
// CHECK-NOT: global variable

// CHECK: Totally 7 errors have been detected.
