// RUN: choreo %s | FileCheck --match-full-lines %s

__co__ void foo3() {
  parallel {p, q} by [2, 6] {
    local f16[4] l;
  }
}

// CHECK:  D(host_func_)("__choreo_foo3", {StreamType()}, [&](auto args) {
// CHECK:    Dim3 grid_dim(2);
// CHECK:    Dim3 block_dim(6);
// CHECK:    auto ts = launch_kernel_("__choreo_foo3_parallel", grid_dim, block_dim, args.back(), {}, {});
// CHECK:    return std::vector<Value>{};
// CHECK:  }, true); // end of choreo-factor dataflow program
// CHECK:  D(func_)("__choreo_foo3_parallel", {}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:  }); // end of choreo-factor kernel function