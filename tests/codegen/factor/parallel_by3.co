// RUN: choreo -gs  %s | FileCheck --match-full-lines %s

__co__ void bar0() {
  parallel {p, q} by [2, 6] {
    local f16[4] l;
  }
}

// CHECK:  D(host_func_)("__choreo_bar0", {StreamType()}, [&](auto args) {
// CHECK:    Dim3 grid_dim(1);
// CHECK:    Dim3 block_dim(2, 6);
// CHECK:    auto ts = launch_kernel_("__choreo_bar0_parallel", grid_dim, block_dim, args.back(), {}, {});
// CHECK:    return std::vector<Value>{};
// CHECK:  }, true); // end of choreo-factor host program
// CHECK:  D(func_)("__choreo_bar0_parallel", {}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:  }); // end of choreo-factor device function

__co__ void bar1() {
  parallel bdim = {x, y} by [2, 6] {
    local f16[4] l;
  }

  parallel gdim = {xx, yy, zz} by [2, 6, 3] {
    parallel bdim = {x, y} by [4, 5] {
      local f16[4] l;
    }
  }

  parallel p by 4 {
    parallel q = {x, y, z} by [4, 3, 2] {
      local f16[4] l;
    }
  }
}

// CHECK:  D(host_func_)("__choreo_bar1", {StreamType()}, [&](auto args) {
// CHECK:    Dim3 grid_dim(1);
// CHECK:    Dim3 block_dim(2, 6);
// CHECK:    auto ts = launch_kernel_("__choreo_bar1_parallel", grid_dim, block_dim, args.back(), {}, {});
// CHECK:    Dim3 grid_dim_1(2, 6, 3);
// CHECK:    Dim3 block_dim_1(4, 5);
// CHECK:    auto ts_1 = launch_kernel_("__choreo_bar1_parallel_1", grid_dim_1, block_dim_1, args.back(), {}, {});
// CHECK:    Dim3 grid_dim_2(4);
// CHECK:    Dim3 block_dim_2(4, 3, 2);
// CHECK:    auto ts_2 = launch_kernel_("__choreo_bar1_parallel_2", grid_dim_2, block_dim_2, args.back(), {}, {});
// CHECK:    return std::vector<Value>{};
// CHECK:  }, true); // end of choreo-factor host program

// CHECK:  D(func_)("__choreo_bar1_parallel", {}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:  }); // end of choreo-factor device function
// CHECK:  D(func_)("__choreo_bar1_parallel_1", {}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:  }); // end of choreo-factor device function
// CHECK:  D(func_)("__choreo_bar1_parallel_2", {}, {}, [&](auto args, auto results) {
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:  }); // end of choreo-factor device function

__co__ void bar2() {
  parallel g by 2, b by 12 {
    local f16[4] l;
  }

  parallel gdim = {xx, yy, zz} by [2, 6, 3],
           bdim = {x, y} by [4, 5] {
    local f16[4] l;
  }

  parallel g by 4,
           b = {x, y, z} by [4, 3, 2] {
    local f16[4] l;
  }
}

// CHECK:   D(host_func_)("__choreo_bar2", {StreamType()}, [&](auto args) {
// CHECK:     Dim3 grid_dim(2);
// CHECK:     Dim3 block_dim(12);
// CHECK:     auto ts = launch_kernel_("__choreo_bar2_parallel", grid_dim, block_dim, args.back(), {}, {});
// CHECK:     Dim3 grid_dim_1(2, 6, 3);
// CHECK:     Dim3 block_dim_1(4, 5);
// CHECK:     auto ts_1 = launch_kernel_("__choreo_bar2_parallel_1", grid_dim_1, block_dim_1, args.back(), {}, {});
// CHECK:     Dim3 grid_dim_2(4);
// CHECK:     Dim3 block_dim_2(4, 3, 2);
// CHECK:     auto ts_2 = launch_kernel_("__choreo_bar2_parallel_2", grid_dim_2, block_dim_2, args.back(), {}, {});
// CHECK:     return std::vector<Value>{};
// CHECK:   }, true); // end of choreo-factor host program
// CHECK:   D(func_)("__choreo_bar2_parallel", {}, {}, [&](auto args, auto results) {
// CHECK:     auto thread_id = thread_id_();
// CHECK:     auto block_id = block_id_();
// CHECK:     auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:   }); // end of choreo-factor device function
// CHECK:   D(func_)("__choreo_bar2_parallel_1", {}, {}, [&](auto args, auto results) {
// CHECK:     auto thread_id = thread_id_();
// CHECK:     auto block_id = block_id_();
// CHECK:     auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:   }); // end of choreo-factor device function
// CHECK:   D(func_)("__choreo_bar2_parallel_2", {}, {}, [&](auto args, auto results) {
// CHECK:     auto thread_id = thread_id_();
// CHECK:     auto block_id = block_id_();
// CHECK:     auto l = alloc_(L1Type(FloatType(16),{4}));
// CHECK:   }); // end of choreo-factor device function