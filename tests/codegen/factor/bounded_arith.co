// RUN: choreo -gs -t factor %s | FileCheck %s --match-full-lines

// device program
__co__ void bounded(s32 [180, 27, 12] a) {
  parallel p by 6 {
    with index = {x, y, z} in [10, 9, 2] {
      foreach x, y {
        dma.copy a.chunkat(x # y, y + 1, p) => local;
      }
      foreach index {
        dma.copy a.span_as([180*27*12]).chunkat(x # y # z) => local;
      }
      dma.copy a.chunkat(x, y(1), p(-1)) => local;
    }
  }
}

