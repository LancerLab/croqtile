// RUN: choreo %s | FileCheck %s

#include "choreo.h"

__co__ auto ele_add(s32 [6, ?, 128] lhs, s32 [6, ?, 128] rhs) {
  s32[lhs.span] output;

  parallel p by 6 {
    with idx0 = {q, x, y} in lhs.span / {#p, 2, 32}, // [6/6, lhs.span(1) / 2, 128/32] = [1, lhs.span(1) / 2, 4 ]
         idx1 = {w, z, b} in rhs.span / {#p, 2, 32}
    where x <-> z {
      foreach idx0 {
        lhs_load = dma.copy.async lhs.chunkat(q, x, y) => local;
        rhs_load = dma.copy.async rhs.chunkat(w, z, b) => local;
        wait lhs_load, rhs_load;

        local s32[lhs_load.span] l1_out;
        call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|);

        out_store = dma.copy.async l1_out => output.chunkat(q,x,y);
        wait out_store;
      }
    }
  } // can use python styling
  return output;
}
// CHECK:	auto lhs_type = DRAMType(IntType(32), {6, -1, 128}));
// CHECK:  auto rhs_type = DRAMType(IntType(32), {6, -1, 128}));
// CHECK:  auto output_type = DRAMType(IntType(32), {6, -1, 128});
// CHECK:    auto lhs_load_buffer = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    auto rhs_load_buffer = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    auto l1_out = alloc_(L1Type(IntType(32),{6, 2, 32}));
// CHECK:    for_(0, 1, 1, [&](auto q) {
// CHECK:      for_(0, 1, 1, [&](auto x) {
// CHECK:        for_(0, 1, 1, [&](auto y) {
// CHECK:          async_load_(lhs_load, args[0], lhs_load_buffer, {Value(6)*thread_id, Value(2)*x, Value(32)*y});
// CHECK:          async_load_(rhs_load, args[1], rhs_load_buffer, {Value(6)*thread_id, Value(2)*z, Value(32)*b});
// CHECK:          wait_dma_(lhs_load);
// CHECK:          wait_dma_(rhs_load);
// CHECK:          call_("kernel", {lhs_load_buffer.addr_(),rhs_load_buffer.addr_(),l1_out.addr_(),384});
// CHECK:          async_store_(out_store, l1_out, results[0], {Value(6)*thread_id, Value(2)*x, Value(32)*y});
// CHECK:          wait_dma_(out_store);
// CHECK:         }); // end of choreo-foreach block on 'q'
// CHECK:       }); // end of choreo-foreach block on 'x'
// CHECK:     }); // end of choreo-foreach block on 'y'

// CHECK:  choreo::runtime_check(sp0.shape()[0] == 6, "shape inconstant on 1st parameter (dim: 0).");
// CHECK:  choreo::runtime_check(sp0.shape()[2] == 128, "shape inconstant on 1st parameter (dim: 2).");
// CHECK:  choreo::runtime_check(sp1.shape()[0] == 6, "shape inconstant on 2th parameter (dim: 0).");
// CHECK:  choreo::runtime_check(sp1.shape()[2] == 128, "shape inconstant on 2th parameter (dim: 2).");
// CHECK:  CHECK(topsMalloc(&in_mem0, 6 * sp0.shape()[1] * 128 * 4));
// CHECK:  CHECK(topsMemcpy(in_mem0, reinterpret_cast<void *>(sp0.data), 6 * sp0.shape()[1] * 128 * 4, topsMemcpyHostToDevice));
// CHECK:  CHECK(topsMalloc(&in_mem1, 6 * sp1.shape()[1] * 128 * 4));
// CHECK:  CHECK(topsMemcpy(in_mem1, reinterpret_cast<void *>(sp1.data), 6 * sp1.shape()[1] * 128 * 4, topsMemcpyHostToDevice));
// CHECK:  CHECK(topsMalloc(&out_mem, 6 * sp0.shape()[1] * 128 * 4));
// CHECK:  auto res = choreo::make_spandata<s32, 3>({6, sp0.shape()[1], 128});
// CHECK:  CHECK(topsMemcpy(reinterpret_cast<void *>(res.data()), out_mem,
// CHECK:                  6 * sp0.shape()[1] * 128 * 4, topsMemcpyDeviceToHost));

