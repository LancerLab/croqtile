// RUN: choreo -n -t cuda %s | FileCheck --match-full-lines %s

__co__ auto foobar(f32 [32] a, int, bool b, f16 [?]) { 
  shared f32 [1024, 1024] var_shared;
  s32 [1024, 1024] var_global_implicit;
  global s32 [1024, 1024] var_global_explicit;
  return 1;
}

// CHECK: __shared__ float var_shared[1024 * 1024];
// CHECK: cudaMalloc(&var_global_implicit, 1048576*4);
// CHECK: cudaMalloc(&var_global_explicit, 1048576*4);
