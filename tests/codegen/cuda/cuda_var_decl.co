// RUN: choreo -gs  -n -t cuda %s | FileCheck --match-full-lines %s

__co__ auto foobar(f32 [32] a, int, bool b, f16 [?]) { 
  shared f32 [32, 32] var_shared;
  s32 [32, 32] var_global_implicit;
  global s32 [32, 32] var_global_explicit;
  return 1;
}

