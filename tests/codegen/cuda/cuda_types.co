// RUN: choreo -gs  -n -t cuda %s | FileCheck --match-full-lines %s

__co__ auto foobar(f32 [32] a, int, bool b, f16 [?]) { 
  f32 [1024, 1024] var_f32;
  s32 [1024, 1024] var_s32;
  return 1;
}

// CHECK: float* var_f32;
// CHECK: cudaMalloc(&var_f32, 1048576*4);
// CHECK: int32_t* var_s32;
// CHECK: cudaMalloc(&var_s32, 1048576*4);
