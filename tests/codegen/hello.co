// RUN: choreo %s | FileCheck --match-full-lines %s
#include <iostream>

__cok__ { // kernel program

void hello(int * a, int * b, int * c, int n) {
  std::cout << "hello choreo" << std::endl;
}

}

// choreo program
__co__ void co_hello() {
  parallel p by 1 { call hello(); }
}

// host program
int main() {
  return co_hello();
}

