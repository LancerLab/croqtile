// RUN: choreo -t topscc -arch=gcu400 -es -dp=memreuse %s  | FileCheck  %s
__co__  void foo() {
  parallel p by 6 {
    shared f32 [5, 6] s_A {0}; 
    parallel q by 2 {
      shared f32 [5, 6] s_B {0};  // the data initialization should be inthreads(q == 0 && r == 0) rather than inthreads (r == 0)
      parallel r by 4 {
        local f32 [5, 6] l_C {0}; // similar as above. Do not make all sub-threads to initialize it.
      }
    }
  }
}

__co__ auto foo1(f16 [36, 15, 14, 64] a) {
  parallel p = {px, py} by [2, 3] {
    a_shared = dma.copy a.chunkat(p, _ , _ ) => shared; // implict masking
    parallel q by 7 {
      a_local = dma.copy a.chunkat(p, q, _) => local;
      parallel r by 4 {
        
      }
    }
  }
  return a;
}

__co__ void foo2() {
  parallel p by 1 {
    shared s32 [8] b;
    foreach i in [b.span] {
      b.at(i) = i;
      c = b.at(i);
    }
    parallel q by 2{}
  }
}

// CHECK: __thread_dims__(4, 1, 1)
// CHECK: __global__ void __choreo_device_foo() {
// CHECK:   __shared__ float s_A[30];
// CHECK:   if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0 && subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:     tops_dte_ctx_t s_A__init;
// CHECK:     tops::dte_scope s_s_A__init(s_A__init);
// CHECK:     tops::memset(s_A__init, tops::mdspan(tops::Shared, (float*)s_A, 5, 6), 0);
// CHECK:   } // single instance
// CHECK:   __shared__ float s_B[30];
// CHECK:   if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0 && subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:     tops_dte_ctx_t s_B__init;
// CHECK:     tops::dte_scope s_s_B__init(s_B__init);
// CHECK:     tops::memset(s_B__init, tops::mdspan(tops::Shared, (float*)s_B, 5, 6), 0);
// CHECK:   } // single instance
// CHECK:   __local__ __valigned__ float l_C[30];
// CHECK:   if (subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:     tops_dte_ctx_t l_C__init;
// CHECK:     tops::dte_scope s_l_C__init(l_C__init);
// CHECK:     tops::memset(l_C__init, tops::mdspan(tops::Private, (float*)l_C, 5, 6), 0);
// CHECK:   } // single instance
// CHECK: }


// CHECK: __thread_dims__(4, 1, 1)
// CHECK: __global__ void __choreo_device_foo1(choreo::f16 * a) {
// CHECK:   __shared__ choreo::half a_shared__buf__[80640];
// CHECK:   tops::mdspan __mds0_a(tops::Global, (choreo::half*)a, 36, 15, 14, 64);
// CHECK:   tops::mdspan __mds1_a_shared__buf__(tops::Shared, (choreo::half*)a_shared__buf__, 18, 5, 14, 64);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:   choreo::future a_shared(choreo_topscc_ctx0, "a_shared", 16, 16, a_shared__buf__);
// CHECK:   if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0 && subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:     int __slice_offset0__a_2_a_shared__buf__[] = {(int)(__tops_bid_x() * (18)), 0, 0};
// CHECK:     tops::slice(*a_shared.get_ctx(), __mds1_a_shared__buf__, __mds0_a, __slice_offset0__a_2_a_shared__buf__);
// CHECK:   } // single instance
// CHECK:   __syncthreads();
// CHECK:   __local__ __valigned__ choreo::half a_local__buf__[11520];
// CHECK:   tops::mdspan __mds2_a(tops::Global, (choreo::half*)a, 36, 15, 14, 64);
// CHECK:   tops::mdspan __mds3_a_local__buf__(tops::Private, (choreo::half*)a_local__buf__, 18, 5, 2, 64);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx1;
// CHECK:   choreo::future a_local(choreo_topscc_ctx1, "a_local", 18, 17, a_local__buf__);
// CHECK:   if (subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:     int __slice_offset1__a_2_a_local__buf__[] = {(int)(__tops_bid_x() * (18)), (int)(__tops_tid_x() * (5)), 0};
// CHECK:     tops::slice(*a_local.get_ctx(), __mds3_a_local__buf__, __mds2_a, __slice_offset1__a_2_a_local__buf__);
// CHECK:   } // single instance
// CHECK:   __syncsubthreads();
// CHECK: }

// CHECK: __thread_dims__(1, 1, 1)
// CHECK: __global__ void __choreo_device_foo2() {
// CHECK:   __shared__ int b[8];
// CHECK:   {
// CHECK:     int __iv_i__elem__0 = 0;
// CHECK:     for (__iv_i__elem__0 = 0; __iv_i__elem__0 < 8; ++__iv_i__elem__0) {
// CHECK:       if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0 && subThreadIdx.x == 0 && subThreadIdx.y == 0 && subThreadIdx.z == 0) {
// CHECK:         *((int*)b + (__iv_i__elem__0)) = __iv_i__elem__0;
// CHECK:       } // single instance
// CHECK:       __syncthreads();
// CHECK:       int c = *((int*)b + (__iv_i__elem__0));
// CHECK:     } // i__elem__0
// CHECK:     __iv_i__elem__0 = 0;
// CHECK:   }
// CHECK: }