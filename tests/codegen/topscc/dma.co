// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ auto foo(f32 [32, 4] a) {
  f32 [a.span + {1, 1}] data;
  parallel p by 2 {
    shared f32 [a.span] b;
    local f32 [a.span] c;
    dma.copy a => b;
    f0 = dma.copy.async b => c;
    local f32 [a.span + {1, 1}] d;
    wait f0; 
    f1 = dma.pad.async<{1,1}, {0,0}, {0,0}, 0> c => d;
    dma.transp<1,0> c => local;
    wait f1;
  }
  return data;
}

// CHECK: __global__ void __choreo_device_foo(float * a, float * data) {
// CHECK:   tops::mdspan __mds_a(tops::Global, a, 32, 4);
// CHECK:   tops::mdspan __mds_data(tops::Global, data, 33, 5);
// CHECK:   __shared__ float b[128];
// CHECK:   tops::mdspan __mds_b(tops::Shared, b, 32, 4);
// CHECK:   __local__ float c[128];
// CHECK:   tops::mdspan __mds_c(tops::Private, c, 32, 4);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:   tops::dte_scope s_choreo_topscc_ctx0(choreo_topscc_ctx0);
// CHECK:   tops::memcpy(choreo_topscc_ctx0, __mds_b, __mds_a);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx1;
// CHECK:   tops::dte_scope s_choreo_topscc_ctx1(choreo_topscc_ctx1);
// CHECK:   choreo::future f0("f0", 8, 1);
// CHECK:   tops::event f0__event__ = tops::memcpy_async(choreo_topscc_ctx1, __mds_c, __mds_b);
// CHECK:   f0.set_event(f0__event__);
// CHECK:   f0.set_data(b);
// CHECK:   __local__ float d[165];
// CHECK:   tops::mdspan __mds_d(tops::Private, d, 33, 5);
// CHECK:   tops::wait(f0.event());
// CHECK:   f0.set_waited();
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx2;
// CHECK:   tops::dte_scope s_choreo_topscc_ctx2(choreo_topscc_ctx2);
// CHECK:   choreo::future f1("f1", 11, 1);
// CHECK:   int __pad_high_c[] = {1, 1};
// CHECK:   int __pad_low_c[] = {0, 0};
// CHECK:   int __pad_mid_c[] = {0, 0};
// CHECK:   tops::event f1__event__ = tops::pad_async(choreo_topscc_ctx2, __mds_d, __mds_c, __pad_low_c, __pad_high_c, __pad_mid_c, 0);
// CHECK:   f1.set_event(f1__event__);
// CHECK:   f1.set_data(d);
// CHECK:   __local__ float anon_0[128];
// CHECK:   tops::mdspan __mds_anon_0(tops::Private, anon_0, 4, 32);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx3;
// CHECK:   tops::dte_scope s_choreo_topscc_ctx3(choreo_topscc_ctx3);
// CHECK:   int __transpose_layout_c[] = {1, 0};
// CHECK:   tops::transpose(choreo_topscc_ctx3, __mds_anon_0, __mds_c, __transpose_layout_c);
// CHECK:   tops::wait(f1.event());
// CHECK:   f1.set_waited();
// CHECK: }
