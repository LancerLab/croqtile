// RUN: choreo -t topscc %s -es -o -  2>&1 | FileCheck %s

__co__ void foo(int M, f32 [3, 2, 12] data) {
  parallel p by 2 {
    local f32 [3, 2, 1] buffer;
    dma.copy data.subspan(M, 2, 1).at(p,0,0) => buffer;
  }
}

// CHECK: warning: Dimensions could be inconsistent between DMA 'from[0](::foo::M)' v.s. 'to[0](3))
// CHECK: choreo::runtime_check((static_cast<long long>(M) * 2LL <= 6LL), "DMA to-buffer is too small ((::foo::M * 2) > 6)
