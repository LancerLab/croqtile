// RUN: choreo -t topscc -es -o - %s | FileCheck %s

__co__ void foo(f32 [M, N, K] d_values, int evs) {
  parallel p by 2
    foreach m_loop_idx in [1024] {
      dma.copy d_values.subspan(1, evs, 12).at(m_loop_idx, 7, p).span_as(1, 1, 12, evs) => local;
      local f32 [34, 78] dst;
      foreach {k, l} in [7, 2]
        dma.copy d_values.subspan(1, evs, 24).at(m_loop_idx, 5, p).span_as(1, 2, 12, evs).chunkat(_, _, k, l) => dst.span_as(1, 2, 34, 39).subspan(1, 2, 12/#k, evs/#l).at(_, _, k, l);
    }
}

// CHECK:       tops::mdspan __mds0_d_values(tops::Global, (float*)d_values + (__tops_tid_x() * 12 + (evs * 84 + evs * (__iv_m_loop_idx__elem__0 * 12))), 1, 1, 12, evs);
// CHECK:       tops::mdspan __mds1_anon_0(tops::Private, (float*)anon_0, 1, 1, 12, evs);
// CHECK:       int __slice_offset0__d_values_2_anon_0[] = {0, 0, 0, 0};
// CHECK:       tops::slice(*__choreo_anon_fut__0.get_ctx(), __mds1_anon_0, __mds0_d_values, __slice_offset0__d_values_2_anon_0);

// CHECK:             tops::mdspan __mds2_d_values(tops::Global, (float*)d_values + (__tops_tid_x() * 24 + (evs * 120 + evs * (__iv_m_loop_idx__elem__0 * 24))), 1, 2, 12, evs);
// CHECK:             tops::mdspan __mds3_dst(tops::Private, (float*)dst + 0, 1, 2, 34, 39);
// CHECK:             int __slice_offset0__d_values_2_dst[] = {0, 0, (int)(__iv_k * 1), (int)(__iv_l * (evs / 2))};
// CHECK:             int __deslice_offset0__dst_2_d_values[] = {0, 0, (int)(__iv_k * 1), (int)(__iv_l * (evs / 2))};
// CHECK:             tops::slice_deslice(*__choreo_anon_fut__1.get_ctx(), __mds3_dst, __mds2_d_values, __slice_offset0__d_values_2_dst, __slice_shape1__d_values_2_dst, __deslice_offset0__dst_2_d_values);
