// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ auto foo(int a, f32 [1, 2] b) { parallel p by 1 {}}

__co__ auto bar(bf16 [1] a, s8[2] b, u16[3] c, f16 [2] d, s32 [1] e, s16 [3] f, u8 [7] g, u32 [1, 2] i, bool) {
  parallel p by 1 {} // ensure device code be generated
  return a;
}

// CHECK: __global__ void __choreo_device_foo(int a, float * b)
// CHECK: __global__ void __choreo_device_bar(__bf16 * a, char * b, unsigned short * c, __fp16 * d, int * e, short * f, unsigned char * g, unsigned int * i, bool anon_0)
// CHECK: void foo(int hp0, const choreo::spanned_view<choreo::f32, 2> & hp1)
// CHECK: choreo::spanned_data<choreo::bf16, 1> bar(const choreo::spanned_view<choreo::bf16, 1> & hp0, const choreo::spanned_view<choreo::s8, 1> & hp1, const choreo::spanned_view<choreo::u16, 1> & hp2, const choreo::spanned_view<choreo::f16, 1> & hp3, const choreo::spanned_view<choreo::s32, 1> & hp4, const choreo::spanned_view<choreo::s16, 1> & hp5, const choreo::spanned_view<choreo::u8, 1> & hp6, const choreo::spanned_view<choreo::u32, 2> & hp7, bool hp8)
