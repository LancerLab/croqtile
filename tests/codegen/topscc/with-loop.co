// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ auto foo(f32 [32, 4, 27] a) {
  parallel p by 2 {
    with index = {x, y} in [4, 9] {
      foreach index {
        dma.copy a.chunkat(p, index) => local;
      }
    }
  }
  return a;
}

__co__ auto bar(f16 [128, 4, 14, 69] a) {
  parallel p by 7 {
    parallel q by 3 {
      with index in [2, 4] {
        foreach index {
          dma.copy a.chunkat(index, p, q) => local;
        }
      }
    }
  }
  return a;
}

