// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ auto foo(int a, f32 [1, 2] b) {
  f16 [b.span] g_data;
  parallel p by 2 {
    shared u8 [g_data.span] s_data;
    parallel q by 3 {
      local s16 [s_data.span] l_data;
    }
  }
  return g_data;
}

// CHECK: __global__ void __choreo_device_foo(int a, float * b, __fp16 * g_data) {
// CHECK:   __shared__ unsigned char s_data[2];
// CHECK:   __local__ short l_data[2];
// CHECK: }

// CHECK: choreo::spanned_data<choreo::f16, 2> foo(int hp0, const choreo::spanned_view<choreo::f32, 2> & hp1) {
// CHECK:   float * b__device = nullptr;
// CHECK:   topsMalloc(&b__device, 8);
// CHECK:   topsMemcpy(b__device, hp1.data(), 8, topsMemcpyHostToDevice);
// CHECK:   auto g_data = choreo::make_spandata<__fp16, 2>({1, 2});
// CHECK:   __fp16 * g_data__device = nullptr;
// CHECK:   topsMalloc(&g_data__device, 4);
// CHECK:   dim3 __foo_gdims(2, 1, 1);
// CHECK:   dim3 __foo_bdims(3, 1, 1);
// CHECK:   __choreo_device_foo<<<__foo_gdims, __foo_bdims>>>(hp0, b__device, g_data__device);
// CHECK:   topsMemcpy(g_data.data(), g_data__device, 4, topsMemcpyDeviceToHost);
// CHECK:   return g_data;
// CHECK: }
