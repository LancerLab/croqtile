// REQUIRES: TARGET-GCUALL
// RUN: choreo -es -t topscc %s  | FileCheck --match-full-lines %s


__cok__ {
__co_device__ extern "C" void kernel(int* i, char* ii) {
  i[0] += 1;
}
}

__co__ auto foo(s64[N,8] input, s32[N,8] input2) {
  
  global s32 [N, 4, 2] t;
  parallel by 1 {
    foreach idx in [N] {
      i1 = dma.copy input2.chunkat(idx, _) => local;
      dma.transp<0, 2, 1> i1.span_as([1, 2, 4]) => t.chunkat(idx, _, _);
    }
  }

  return input;
}


int main() {
  auto input = choreo::make_spandata<choreo::s64>(4, 8);
  input.fill(99);
  auto input2 = choreo::make_spandata<choreo::s32>(4, 8);
  input2.fill(199);

  auto res = foo(input.view(), input2.view());

  for (int i = 0; i < res.shape()[0]; ++i) {
    for (int j = 0; j < res.shape()[1]; ++j) {
      std::cout << res[i][j] << " ";
    }
    std::cout << std::endl;
  }
}


// CHECK:    for (__iv_idx__elem__0 = 0; __iv_idx__elem__0 < N; ++__iv_idx__elem__0) {
// CHECK:      int* i1__buf__ = (int*)(anon_2 + 0);
// CHECK:      tops::mdspan __mds0_input2(tops::Global, (int*)input2 + (__iv_idx__elem__0 * 8) + 0, 1, 8);
// CHECK:      tops::mdspan __mds1_i1__buf__(tops::Private, (int*)i1__buf__, 1, 8);
// CHECK:      tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:      choreo::future i1(choreo_topscc_ctx0, "i1", 16, 12, i1__buf__);
// CHECK:      tops::memcpy(*i1.get_ctx(), __mds1_i1__buf__, __mds0_input2);
// CHECK:      auto * anon_1 = i1.data();
// CHECK:      tops::mdspan __mds2_anon_1(tops::Private, (int*)anon_1, 1, 2, 4);
// CHECK:      tops::mdspan __mds3_t(tops::Global, (int*)t, N, 4, 2);
// CHECK:      tops_dte_ctx_t choreo_topscc_ctx1;
// CHECK:      choreo::future __choreo_anon_fut__0(choreo_topscc_ctx1, "", 17, 7);
// CHECK:      int __transpose_layout0__anon_1[] = {0, 2, 1};
// CHECK:      int __deslice_offset0__t_2_anon_1[] = {(int)(__iv_idx__elem__0 * 1), 0, 0};
// CHECK:      tops::transpose_deslice(*__choreo_anon_fut__0.get_ctx(), __mds3_t, __mds2_anon_1, __transpose_layout0__anon_1, __deslice_offset0__t_2_anon_1);
// CHECK:    } // idx__elem__0
