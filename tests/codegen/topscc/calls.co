// RUN: choreo -t topscc -es %s -o - | FileCheck %s

__co__ auto foo(f32 [32, 4] a, s8 [1] b, int c) {
  int d = 996;
  parallel p by 2 {
    local f32 [a.span] l_a;
    local s8 [b.span] l_b;
    call kernel0();
    call kernel1(l_a, l_b, c, d);
    call kernel2<b.span(0)+3, d + 1>(l_b, a.span(0) + c);
  }
}

// CHECK: __global__ void __choreo_device_foo(float * a, char * b, int c) {
// CHECK:   float* l_a = (float*)(anon_0 + 0);
// CHECK:   char* l_b = (char*)(anon_0 + 512);
// CHECK:   kernel0();
// CHECK:   kernel1((__private__ float*)l_a, (__private__ char*)l_b, c, 996);
// CHECK:   kernel2<4, 997>((__private__ char*)l_b, (c + 32));
// CHECK: }
