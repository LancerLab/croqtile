// RUN: choreo -t topscc -es %s -o - | FileCheck %s

__co__ auto foo(f32 [32, 4] a, s8 [1] b, int c) {
  parallel p by 1 {
    d = dma.any;
    with tiling in [8, 2] {
      d = dma.copy a.chunkat(tiling) => local;
    }
  }
}

// CHECK:   choreo::future d("d", 5, 1);
// CHECK:   tops::event d__event__;
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:   tops::dte_scope s_choreo_topscc_ctx0(choreo_topscc_ctx0);
// CHECK:   {
// CHECK:     tops::slice(choreo_topscc_ctx0, __mds1_d__buf__, __mds0_a, __slice_offset0__a_2_d__buf__);
// CHECK:   }
