// RUN: choreo -t topscc -es -dp=memreuse %s -o - | FileCheck %s

__co__ auto bar() {
  parallel by 2 {
    call foo();
  }
}

// CHECK: __global__ void __choreo_device_bar()

// CHECK: void bar() {
// CHECK:   dim3 __bar_gdims0(1, 1, 1);
// CHECK:   dim3 __bar_bdims0(2, 1, 1);
// CHECK:   __choreo_device_bar<<<__bar_gdims0, __bar_bdims0>>>();
// CHECK:   choreo::abend_true(topsDeviceSynchronize());
// CHECK: }

__co__ auto bar1(f16 [36, 15, 14, 64] a) {
  parallel p = {px, py} by [2, 3] {
    parallel q by 7 {
      with index in [2] {
        foreach index {
          a_local = dma.copy a.chunkat(p, q, index) => local;
        }
      }
    }
  }
  return a;
}

// CHECK: __global__ void __choreo_device_bar1(choreo::f16 * a) {
// CHECK:   {
// CHECK:     int __iv_index__elem__0 = 0;
// CHECK:     for (__iv_index__elem__0 = 0; __iv_index__elem__0 < 2; ++__iv_index__elem__0) {
// CHECK:       __local__ __valigned__ choreo::half a_local__buf__[5760];
// CHECK:       tops::mdspan __mds0_a(tops::Global, (choreo::half*)a, 36, 15, 14, 64);
// CHECK:       tops::mdspan __mds1_a_local__buf__(tops::Private, (choreo::half*)a_local__buf__, 18, 5, 2, 32);
// CHECK:       tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:       choreo::future a_local(choreo_topscc_ctx0, "a_local", {{[0-9]+}}, {{[0-9]+}}, a_local__buf__);
// CHECK:       int __slice_offset0__a_2_a_local__buf__[] = {(int)(__tops_bid_x() * (18)), (int)(__tops_tid_x() * (5)), (int)(__iv_index__elem__0 * (2))};
// CHECK:       tops::slice(*a_local.get_ctx(), __mds1_a_local__buf__, __mds0_a, __slice_offset0__a_2_a_local__buf__);
// CHECK:     } // index__elem__0
// CHECK:     __iv_index__elem__0 = 0;
// CHECK:   }
// CHECK: }

// CHECK:  dim3 __bar1_gdims0(2, 3, 1);
// CHECK:  dim3 __bar1_bdims0(7, 1, 1);

__co__ auto bar2(f16 [4, 36, 14, 64] a) {
  parallel {px, py} by [2, 9] {
    parallel q by 7 {
      with index in [2] {
        foreach index {
          a_local = dma.copy a.chunkat(px, py, q, index) => local;
        }
      }
    }
  }
  return a;
}

// CHECK: __global__ void __choreo_device_bar2(choreo::f16 * a) {
// CHECK:   {
// CHECK:     int __iv_index__elem__0 = 0;
// CHECK:     for (__iv_index__elem__0 = 0; __iv_index__elem__0 < 2; ++__iv_index__elem__0) {
// CHECK:       __local__ __valigned__ choreo::half a_local__buf__[512];
// CHECK:       tops::mdspan __mds2_a(tops::Global, (choreo::half*)a, 4, 36, 14, 64);
// CHECK:       tops::mdspan __mds3_a_local__buf__(tops::Private, (choreo::half*)a_local__buf__, 2, 4, 2, 32);
// CHECK:       tops_dte_ctx_t choreo_topscc_ctx1;
// CHECK:       choreo::future a_local(choreo_topscc_ctx1, "a_local", {{[0-9]+}}, {{[0-9]+}}, a_local__buf__);
// CHECK:       int __slice_offset1__a_2_a_local__buf__[] = {(int)(__tops_bid_x() * (2)), (int)(__tops_bid_y() * (4)), (int)(__tops_tid_x() * (2)), (int)(__iv_index__elem__0 * (32))};
// CHECK:       tops::slice(*a_local.get_ctx(), __mds3_a_local__buf__, __mds2_a, __slice_offset1__a_2_a_local__buf__);
// CHECK:     } // index__elem__0
// CHECK:     __iv_index__elem__0 = 0;
// CHECK:   }
// CHECK: }

// CHECK:   dim3 __bar2_gdims0(2, 9, 1);
// CHECK:   dim3 __bar2_bdims0(7, 1, 1);

__co__ auto async(bf16 [7, 64] a) {
  parallel.async p by 2 { }
  return a;
}

// CHECK: choreo::spanned_data<choreo::bf16, 2> async(const choreo::spanned_view<choreo::bf16, 2> & a) {
// CHECK:   __choreo_device_async<<<__async_gdims0, __async_bdims0>>>(a__device);
// CHECK-NOT:   choreo::abend_true(topsDeviceSynchronize());
// CHECK: }


__co__ void dynamic_expr_paraby(int n) {
  p_count = (n >= 4) ? 4 : n;
  parallel p by p_count { }
}

// CHECK: void dynamic_expr_paraby(int n) {
// CHECK:   choreo::runtime_check((((n >= 4) ? 4 : n) > 0)
// CHECK:   dim3 __dynamic_expr_paraby_gdims0(1, 1, 1);
// CHECK:   dim3 __dynamic_expr_paraby_bdims0(((n >= 4) ? 4 : n), 1, 1);
// CHECK:   __choreo_device_dynamic_expr_paraby<<<__dynamic_expr_paraby_gdims0, __dynamic_expr_paraby_bdims0>>>(n);
// CHECK: }
