// RUN: choreo -es -t topscc -bn %s | FileCheck %s
__co__ void func(int a) {
  parallel q by 1 {
    if (q == 0) {
      call abc();
    } else if (a == 0) {
      if (q == 1) {
        if (a > 0) {
          call def();
        } else if (a == 1) {
          call ghi();
        }
      } else {
        call ghi();
      }
    }
  }
}

// CHECK: __global__ void __choreo_device_func(int a) {
// CHECK:   {
// CHECK:   if ((__tops_tid_x() == 0)) {
// CHECK:     abc();
// CHECK:   }
// CHECK:   if ((!(__tops_tid_x() == 0)) && (a == 0)) {
// CHECK:     if ((__tops_tid_x() == 1)) {
// CHECK:       if ((a > 0)) {
// CHECK:         def();
// CHECK:       }
// CHECK:       if ((!(a > 0)) && (a == 1)) {
// CHECK:         ghi();
// CHECK:       }
// CHECK:     }
// CHECK:     if ((!(__tops_tid_x() == 1))) {
// CHECK:       ghi();
// CHECK:     }
// CHECK:   }
// CHECK:   }
// CHECK: }