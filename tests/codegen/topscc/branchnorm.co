// RUN: choreo -es -t topscc -bn %s | FileCheck %s
__co__ void func(int a) {
  parallel by 1 {
    foreach {q} in [1000] : vectorize(q, 128) {
      if (q == 0) {
        call abc();
      } else if (a > 0) {
        if (q == 1) {
          if (a > 2) {
            call def();
          } else if (a == 0) {
            call ghi();
          }
        } else {
          call klm();
        }
      }
    }
  }
}


