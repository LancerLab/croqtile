// REQUIRES: TARGET-GCUALL
// RUN: choreo -es -adf %s -o - 2>&1 | FileCheck %s
__cok__ {
  __device__ void type_test0(char, unsigned char, short, unsigned short,
                             int, unsigned int, long long, unsigned long long);
  __device__ void type_test1(char*, unsigned char*, short*, unsigned short*,
    int*, unsigned int*, long long*, unsigned long long*);
    
  // type promotion
  __device__ void type_test2(int, int*);
  __device__ void type_test3(void*, void*, void*, void*);

  __device__ int getInt();

}

__co__ void func() {
  parallel by 1 {
    local s8 [10] arr0;
    local u8 [10] arr1;
    local s16 [10] arr2;
    local u16 [10] arr3;
    local s32 [10] arr4;
    local u32 [10] arr5;
    local s64 [10] arr6;
    local u64 [10] arr7;
    s8 v0;
    u8 v1;
    s16 v2;
    u16 v3;
    s32 v4;
    u32 v5;
    s64 v6;
    u64 v7;

    call type_test0(v0, v1, v2, v3, v4, v5, v6, v7);
    call type_test1(arr0, arr1, arr2, arr3, arr4, arr5, arr6, arr7);
    call type_test2(v0, arr0); // s8 => s32, s8* => s32*
    call type_test3(arr0, arr1, arr2, arr3); // s8* => void*, u8* => void*, s16* => void*, u16* => void*
    mutable int a = call getInt();
    mutable float b = call getInt(); // cast int to float
    mutable c = call getInt(); // legal if option '-adf' on, illegal if not
  }
}

// CHECK: type_test0(v0, v1, v2, v3, v4, v5, v6, v7);
// CHECK: type_test1((__private__ char*)arr0, (__private__ unsigned char*)arr1, (__private__ short*)arr2, (__private__ unsigned short*)arr3, (__private__ int*)arr4, (__private__ unsigned int*)arr5, (__private__ long long*)arr6, (__private__ unsigned long long*)arr7);
// CHECK: type_test2(v0, (__private__ char*)arr0);
// CHECK: type_test3((__private__ char*)arr0, (__private__ unsigned char*)arr1, (__private__ short*)arr2, (__private__ unsigned short*)arr3);
// CHECK: int a = getInt();
// CHECK: float b = static_cast<float>(getInt());
// CHECK: int c = getInt();