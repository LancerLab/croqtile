// RUN: choreo -es -adf %s -o - 2>&1 | FileCheck %s
__cok__ {
  __device__ void type_test0(char, unsigned char, short, unsigned short,
                             int, unsigned int, long long, unsigned long long);
  __device__ void type_test1(char*, unsigned char*, short*, unsigned short*,
    int*, unsigned int*, long long*, unsigned long long*);
    
  // type promotion
  __device__ void type_test2(int, int*);
  __device__ void type_test3(void*, void*, void*, void*);
  __device__ void type_test4(int);
  
  // unhandled type
  __device__ void type_test5(const std::vector<int> &);

  template <typename T>
  __device__ void type_test6(T*); // template function params type inference is still not supported
  
}

__co__ void func() {
  parallel by 1 {
    local s8 [10] arr0;
    local u8 [10] arr1;
    local s16 [10] arr2;
    local u16 [10] arr3;
    local s32 [10] arr4;
    local u32 [10] arr5;
    local s64 [10] arr6;
    local u64 [10] arr7;
    s8 v0;
    u8 v1;
    s16 v2;
    u16 v3;
    s32 v4;
    u32 v5;
    s64 v6;
    u64 v7;
    f32 v8;

    call type_test0(v0, v1, v2, v3, v4, v5, v6, v7);
    call type_test1(arr0, arr1, arr2, arr3, arr4, arr5, arr6, arr7);
    call type_test2(v0, arr0);
    call type_test3(arr0, arr1, arr2, arr3);
    call type_test4(v8); // warning: float to int, no matched function
    call type_test5(arr4); // warning: no matched function
    call type_test6(arr0); // warning: no matched function
  }
}

