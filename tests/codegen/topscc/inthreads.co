__co__  void foo(f32 [1, 2, 4] a) {
  parallel p by 6 {
    f = dma.copy a => shared;
    inthreads (p < 3) dma.copy a => local;
    inthreads (p > 0) with q in [2] { 
      inthreads (p == 0) foreach q {
      // The iterations only work on parallel thread 0
      }
    }
    inthreads (p == 1) { int b = 3; }
  }
}

