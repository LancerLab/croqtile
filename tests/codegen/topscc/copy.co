// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ auto foo(f32 [32, 4] a) {
  f32 [a.span] data;
  dma.copy a => data;
  parallel p by 2 {
    dma.copy data.chunkat(p, p) => local;
  }
  return data;
}

// CHECK: __global__ void __choreo_device_foo(float * a, float * data) {
// CHECK:   tops_dte_ctx_t ctx0;
// CHECK:   tops::dte_scope s(ctx0);
// CHECK:   tops::mdspan __mds_a(tops::Global, a, 32, 4);
// CHECK:   tops::mdspan __mds_data(tops::Global, data, 32, 4);
// CHECK:   tops::memcpy(ctx0, __mds_data, __mds_a);
// CHECK:   __local__ float anon_0[128];
// CHECK:   tops_dte_ctx_t ctx1;
// CHECK:   tops::dte_scope s(ctx1);
// CHECK:   tops::mdspan __mds_data(tops::Global, data, 32, 4);
// CHECK:   tops::mdspan __mds_anon_0(tops::Private, anon_0, 16, 2);
// CHECK:   tops::slice(ctx1, __mds_anon_0, __mds_data, __tops_tid_x(), __tops_tid_x());
// CHECK: }

// CHECK: choreo::spanned_data<choreo::f32, 2> foo(const choreo::spanned_view<choreo::f32, 2> & hp0) {
// CHECK:   float * a__device = (float*)topsMalloc(512);
// CHECK:   topsMemcpy(hp0.data(), a__device, 512, topsMemcpyHostToDevice);
// CHECK:   auto data = choreo::make_spandata<float, 2>({32, 4});
// CHECK:   float * data__device = (float*)topsMalloc(512);
// CHECK:   dim3 __foo_gdims(1, 1, 1);
// CHECK:   dim3 __foo_bdims(2, 1, 1);
// CHECK:   __choreo_device_foo<<<__foo_gdims, __foo_bdims>>>(a__device, data__device);
// CHECK:   topsMemcpy(data__device, data.data(), 128, topsMemcpyDeviceToHost);
// CHECK:   return data;
// CHECK: }
