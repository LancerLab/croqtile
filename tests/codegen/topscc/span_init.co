// RUN: choreo -es -t topscc %s -o - | FileCheck %s

__co__ auto foo(s8[4,8] i, float x, int y) {
  // s8[4,8] o{11};
  // f16[4,8] o{11.5f};
  bf16[4,8] o{11};

  parallel by 1 {
    shared s8 [4, 8] smem0{y + 5};
    shared f16 [4, 8] smem1{x + 1.3f};
    shared bf16 [4, 8] smem2{x * 2.0f};
    // dma.copy smem0 => o;
    // dma.copy smem1 => o;
    // dma.copy smem2 => o;

    foreach z in [1] {
      local bf16 [4, 8] l0{smem2.at(z, z)};
      dma.copy l0 => o;
    }
  }
  return o;
}

// CHECK:    tops::memset(smem0__init, tops::mdspan(tops::Shared, (char*)smem0, 4, 8), static_cast<char>((y + 5)));
// CHECK:    tops::memset(smem1__init, tops::mdspan(tops::Shared, (choreo::half*)smem1, 4, 8), f32_to_f16(x + 1.300000f));
// CHECK:    tops::memset(smem2__init, tops::mdspan(tops::Shared, (choreo::bfloat16*)smem2, 4, 8), choreo::bf16(x * 2.000000f));
// CHECK:        tops::memset(l0__init, tops::mdspan(tops::Private, (choreo::bfloat16*)l0, 4, 8), *((choreo::bfloat16*)smem2 + (__iv_z__elem__0 * 8) + __iv_z__elem__0));

// CHECK:  std::fill(o.data(), o.data()+o.element_count(), choreo::bf16(static_cast<float>(11)));


int main() {
  auto input = choreo::make_spandata<choreo::s8>(4, 8);
  input.fill(99);
  
  auto res = foo(input.view(), 79.0f, 79);

  for (int i = 0; i < res.shape()[0]; ++i) {
    for (int j = 0; j < res.shape()[1]; ++j) {
      std::cout << res[i][j] << " ";
    }
    std::cout << std::endl;
  }
}
