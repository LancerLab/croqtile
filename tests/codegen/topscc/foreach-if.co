// RUN: choreo -t topscc %s -es -o - | FileCheck %s

__co__ void foo(int N) {
  parallel p by 6 {
    with index = {x, y, z} in [N % #p, 2, 1]
      foreach index if (p < N %p) {}
  }
}

__co__ void bar(int N) {
  parallel p by 6 {
    with index = {x, y, z} in [N/#p, 2, 1], re in [N%#p] {
      foreach index {}
      foreach re, y, z if (p == 0) {}
    }
  }
}

