// REQUIRES: TARGET-GCUALL
// RUN: choreo -es --use-hetero-tileflow %s | FileCheck --match-full-lines %s

#include "choreo.h"

__cok__ { /// kernel program
} /// end of kernel decl

__co__ int identity(int loc) { /// device program
  print(loc);
  return loc;
}

int main() { /// host program
  choreo::int loc = 7;
  auto res
    = identity(input_data, loc);
  std::cout << res.data();
}
// CHECK: int identity(int loc) {
// CHECK:   std::cout << loc << "\n";
// CHECK:   return loc;
// CHECK: }
