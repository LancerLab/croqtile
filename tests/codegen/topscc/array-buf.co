// RUN: choreo -es -dp=memreuse -t topscc %s -o - | FileCheck --match-full-lines %s

__co__  void foo(f32 [24] a) {
  parallel p by 3 {
    shared f32 [a.span/3] sa[3];
    dma.copy a.chunk(3).at(p - 3) => sa[p];
    dma.copy sa[p] => local;
  }
}
// CHECK:   __shared__ float sa[3][8];
// CHECK:   auto anon_0 = (__tops_tid_x() - 3);
// CHECK:   tops::mdspan __mds0_a(tops::Global, (float*)a, 24);
// CHECK:   tops::mdspan __mds1_sa(tops::Shared, (float*)sa[__tops_tid_x()], 8);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK:   choreo::future __choreo_anon_fut__0(choreo_topscc_ctx0, "", 6, 5, sa[__tops_tid_x()]);
// CHECK:   int __slice_offset0__a_2_sa[] = {(int)(__tops_tid_x() * (8))};
// CHECK:   tops::slice(*__choreo_anon_fut__0.get_ctx(), __mds1_sa, __mds0_a, __slice_offset0__a_2_sa);
// CHECK:   __local__ __valigned__ float anon_1[8];
// CHECK:   tops::mdspan __mds2_sa(tops::Shared, (float*)sa[__tops_tid_x()], 8);
// CHECK:   tops::mdspan __mds3_anon_1(tops::Private, (float*)anon_1, 8);
// CHECK:   tops_dte_ctx_t choreo_topscc_ctx1;
// CHECK:   choreo::future __choreo_anon_fut__1(choreo_topscc_ctx1, "", 7, 5, anon_1);
// CHECK:   tops::memcpy(*__choreo_anon_fut__1.get_ctx(), __mds3_anon_1, __mds2_sa);
