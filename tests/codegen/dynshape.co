// RUN: choreo -t topscc -es %s -o - | FileCheck %s
__co__ void foo(f32 [M, K] lhs, f32 [N, K] rhs) {
   parallel x by 1;
}

// CHECK: __global__ void __choreo_device_foo(float * lhs, float * rhs, unsigned K, unsigned M, unsigned N)

// CHECK: void foo(const choreo::spanned_view<choreo::f32, 2> & lhs, const choreo::spanned_view<choreo::f32, 2> & rhs) {
// CHECK:   auto K = lhs.shape()[1];
// CHECK:   auto M = lhs.shape()[0];
// CHECK:   auto N = rhs.shape()[0];
// CHECK:   float * lhs__device = nullptr;
// CHECK:   choreo::abend_true(topsMalloc(&lhs__device, ((M) * (K)) * 4));
// CHECK:   choreo::abend_true(topsMemcpy(lhs__device, lhs.data(), ((M) * (K)) * 4, topsMemcpyHostToDevice));
// CHECK:   float * rhs__device = nullptr;
// CHECK:   choreo::abend_true(topsMalloc(&rhs__device, ((N) * (K)) * 4));
// CHECK:   choreo::abend_true(topsMemcpy(rhs__device, rhs.data(), ((N) * (K)) * 4, topsMemcpyHostToDevice));
// CHECK:   dim3 __foo_gdims0(1, 1, 1);
// CHECK:   dim3 __foo_bdims0(1, 1, 1);
// CHECK:   __choreo_device_foo<<<__foo_gdims0, __foo_bdims0>>>(lhs__device, rhs__device, K, M, N);
// CHECK: }
