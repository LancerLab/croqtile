// RUN: choreo %s | FileCheck --match-full-lines %s

#include "choreo.h"

// kernel program
void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}

// device program
__co__ s32 mdspan<3> ele_add(s32 [144, 100, 100] a, s32 [144, 100, 100] b) {
  // assert a.span == b.span
  s32[a.span] global_buffer;

  parallel p by 6 {  // p is sip_index
    // kernel function begin
    with index = {x, y} in [10, 10] {  // totally 100 chunks
     foreach x {
      foreach y { 
        f1 = dma.copy.async a.chunkat(p, x, y) => local; // new_size {a(0)/6, a(1)/10, a(2)/10}
        f2 = dma.copy.async b.chunkat(p, x, y) => local;
        wait f1, f2;

        // use f1.span as the span of local buffer
        local s32[f1.span] local_buffer;

        // calculate the total size of span.
        call kernel(f1.data, f2.data, local_buffer, |f1.span|);

        f3 = dma.copy.async local_buffer => global_buffer.chunkat(p, x, y);
        wait f3;
      }
     }
    }
    // end kernel function
  }

  return global_buffer;
}

// host program
int bar(int a[], int b[]) {
  return ele_add(choreo::make_spanned<3>(a, {144, 100, 100}),
                 choreo::make_spanned<3>(b, {144, 100, 100}));
}

