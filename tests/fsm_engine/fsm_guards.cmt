# RUN: bash %s 2>&1 | FileCheck %s

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../.."
ST="$ROOT/.codex/skills/fsm-engine/scripts/state-transition.sh"
PRE="$ROOT/.codex/skills/fsm-engine/scripts/pre-step-check.sh"
POST="$ROOT/.codex/skills/fsm-engine/scripts/post-step-check.sh"
DIR="$(mktemp -d)"

trap "rm -rf $DIR" EXIT

echo "=== TEST: Guard flag enforcement ==="

bash "$ST" INIT "$DIR" max_iteration=5
mkdir -p "$DIR"/{iters,logs,ncu}
printf "h\n" > "$DIR/results.tsv"
touch "$DIR/idea-log.jsonl"
touch "$DIR/iters/iter000_baseline.co"
bash "$ST" BASELINE "$DIR"
bash "$ST" SET "$DIR" baseline_tflops=100 current_best_tflops=100 current_best_iter=0
echo "x" > "$DIR/logs/iter000_compile.log"
echo "x" > "$DIR/logs/iter000_timing.log"
bash "$ST" PROFILE "$DIR"

# Test 1: IDEATE pre-check should BLOCK when ncu not run
echo "--- Test 1: IDEATE blocked without ncu ---"
bash "$ST" IDEATE "$DIR"
if bash "$PRE" IDEATE "$DIR" 2>&1; then
    echo "GUARD_NCU: FAILED (should have blocked)"
else
    echo "GUARD_NCU: BLOCKED correctly"
fi

# Fix: set ncu flags
bash "$ST" SET "$DIR" ncu_ran_this_iter=true bottleneck_identified=true last_bottleneck=dram_throughput
bash "$PRE" IDEATE "$DIR" >/dev/null
echo "GUARD_NCU_AFTER_FIX: OK"

# Test 2: IMPLEMENT pre-check should BLOCK without idea
echo "--- Test 2: IMPLEMENT blocked without idea ---"
bash "$ST" IMPLEMENT "$DIR"
if bash "$PRE" IMPLEMENT "$DIR" 2>&1; then
    echo "GUARD_IDEA: FAILED"
else
    echo "GUARD_IDEA: BLOCKED correctly"
fi

# Fix: set idea flags
bash "$ST" SET "$DIR" idea_is_novel=true idea_logged=true
bash "$PRE" IMPLEMENT "$DIR" >/dev/null
echo "GUARD_IDEA_AFTER_FIX: OK"

# Test 3: MEASURE pre-check should BLOCK without compile
echo "--- Test 3: MEASURE blocked without compile ---"
bash "$ST" MEASURE "$DIR"
if bash "$PRE" MEASURE "$DIR" 2>&1; then
    echo "GUARD_COMPILE: FAILED"
else
    echo "GUARD_COMPILE: BLOCKED correctly"
fi

# Test 4: DECIDE pre-check should BLOCK without timing
echo "--- Test 4: DECIDE blocked without timing ---"
bash "$ST" SET "$DIR" compile_succeeded=true correctness_verified=true
touch "$DIR/iters/iter001_guard_test.co"
echo "ok" > "$DIR/logs/iter001_compile.log"
bash "$ST" DECIDE "$DIR"
if bash "$PRE" DECIDE "$DIR" 2>&1; then
    echo "GUARD_TIMING: FAILED"
else
    echo "GUARD_TIMING: BLOCKED correctly"
fi

# Test 5: STORE pre-check should BLOCK without decision
echo "--- Test 5: STORE blocked without decision ---"
bash "$ST" SET "$DIR" timing_captured=true this_iter_tflops=200
echo "200" > "$DIR/logs/iter001_timing.log"
bash "$ST" STORE "$DIR"
if bash "$PRE" STORE "$DIR" 2>&1; then
    echo "GUARD_DECISION: FAILED"
else
    echo "GUARD_DECISION: BLOCKED correctly"
fi

echo "=== GUARDS PASSED ==="

# CHECK: GUARD_NCU: BLOCKED correctly
# CHECK: GUARD_NCU_AFTER_FIX: OK
# CHECK: GUARD_IDEA: BLOCKED correctly
# CHECK: GUARD_IDEA_AFTER_FIX: OK
# CHECK: GUARD_COMPILE: BLOCKED correctly
# CHECK: GUARD_TIMING: BLOCKED correctly
# CHECK: GUARD_DECISION: BLOCKED correctly
# CHECK: === GUARDS PASSED ===
