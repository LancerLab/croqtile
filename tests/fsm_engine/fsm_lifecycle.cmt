# RUN: bash %s 2>&1 | FileCheck %s

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../.."
ST="$ROOT/.codex/skills/fsm-engine/scripts/state-transition.sh"
PRE="$ROOT/.codex/skills/fsm-engine/scripts/pre-step-check.sh"
POST="$ROOT/.codex/skills/fsm-engine/scripts/post-step-check.sh"
DIR="$(mktemp -d)"

trap "rm -rf $DIR" EXIT

echo "=== TEST: Full FSM lifecycle ==="

bash "$ST" INIT "$DIR" max_iteration=2
mkdir -p "$DIR"/{iters,logs,ncu}
printf "iter\tkernel\tarch\ttflops\teff_pct\tdecision\tbottleneck\tidea_summary\trun_command\n" > "$DIR/results.tsv"
touch "$DIR/idea-log.jsonl"
touch "$DIR/iters/iter000_baseline.co"
bash "$POST" INIT "$DIR"
echo "INIT: $(jq -r '.fsm.current_state' "$DIR/loop-state.json")"

bash "$ST" BASELINE "$DIR"
bash "$PRE" BASELINE "$DIR"
bash "$ST" SET "$DIR" baseline_tflops=350.5 current_best_tflops=350.5 current_best_iter=0 current_best_kernel=iter000_baseline.co
echo "compile" > "$DIR/logs/iter000_compile.log"
echo "350.5" > "$DIR/logs/iter000_timing.log"
bash "$POST" BASELINE "$DIR"
echo "BASELINE: $(jq -r '.fsm.current_state' "$DIR/loop-state.json")"

bash "$ST" PROFILE "$DIR"
ITER_AFTER_BASELINE=$(jq -r '.fsm.iteration' "$DIR/loop-state.json")
echo "ITER_AFTER_BASELINE: $ITER_AFTER_BASELINE"
bash "$ST" SET "$DIR" ncu_ran_this_iter=true bottleneck_identified=true last_bottleneck=dram_throughput
bash "$POST" PROFILE "$DIR"

bash "$ST" IDEATE "$DIR"
echo '{"iter":1,"idea":"test idea","category":"macro"}' >> "$DIR/idea-log.jsonl"
bash "$ST" SET "$DIR" idea_is_novel=true idea_logged=true
bash "$POST" IDEATE "$DIR"

bash "$ST" IMPLEMENT "$DIR"
touch "$DIR/iters/iter001_test.co"
echo "ok" > "$DIR/logs/iter001_compile.log"
bash "$ST" SET "$DIR" compile_succeeded=true correctness_verified=true
bash "$POST" IMPLEMENT "$DIR"

bash "$ST" MEASURE "$DIR"
echo "380.2" > "$DIR/logs/iter001_timing.log"
bash "$ST" SET "$DIR" timing_captured=true this_iter_tflops=380.2
bash "$POST" MEASURE "$DIR"

bash "$ST" DECIDE "$DIR"
bash "$ST" SET "$DIR" decision_made=true this_iter_decision=KEEP current_best_tflops=380.2 current_best_iter=1 current_best_kernel=iter001_test.co consecutive_discards=0
bash "$POST" DECIDE "$DIR"

bash "$ST" STORE "$DIR"
printf "iter001\titer001_test.co\tsm_90a\t380.2\t65.5\tKEEP\tdram_throughput\ttest idea\tbash run\n" >> "$DIR/results.tsv"
bash "$ST" SET "$DIR" results_appended=true git_committed=true
bash "$POST" STORE "$DIR"
echo "STORE_BEST: $(jq -r '.metrics.current_best_tflops' "$DIR/loop-state.json")"

bash "$ST" PROFILE "$DIR"
ITER_AFTER_LOOP=$(jq -r '.fsm.iteration' "$DIR/loop-state.json")
echo "ITER_AFTER_LOOP: $ITER_AFTER_LOOP"

ALL_GUARDS_RESET=$(jq '[.guard_flags | to_entries[] | select(.value == true)] | length' "$DIR/loop-state.json")
echo "GUARDS_RESET: $ALL_GUARDS_RESET"

bash "$ST" SET "$DIR" ncu_ran_this_iter=true bottleneck_identified=true last_bottleneck=compute_bound
bash "$ST" IDEATE "$DIR"
echo '{"iter":2,"idea":"second idea","category":"ncu_micro"}' >> "$DIR/idea-log.jsonl"
bash "$ST" SET "$DIR" idea_is_novel=true idea_logged=true
bash "$ST" IMPLEMENT "$DIR"
touch "$DIR/iters/iter002_second.co"
echo "ok" > "$DIR/logs/iter002_compile.log"
bash "$ST" SET "$DIR" compile_succeeded=true correctness_verified=true
bash "$ST" MEASURE "$DIR"
echo "340.1" > "$DIR/logs/iter002_timing.log"
bash "$ST" SET "$DIR" timing_captured=true this_iter_tflops=340.1
bash "$ST" DECIDE "$DIR"
bash "$ST" SET "$DIR" decision_made=true this_iter_decision=DISCARD consecutive_discards=1
bash "$ST" STORE "$DIR"
printf "iter002\titer002_second.co\tsm_90a\t340.1\t58.6\tDISCARD\tcompute_bound\tsecond idea\tbash run\n" >> "$DIR/results.tsv"
bash "$ST" SET "$DIR" results_appended=true git_committed=true
bash "$POST" STORE "$DIR"

bash "$ST" DONE "$DIR"
FINAL_STATE=$(jq -r '.fsm.current_state' "$DIR/loop-state.json")
FINAL_BEST=$(jq -r '.metrics.current_best_tflops' "$DIR/loop-state.json")
FINAL_ITER=$(jq -r '.metrics.current_best_iter' "$DIR/loop-state.json")
echo "FINAL_STATE: $FINAL_STATE"
echo "FINAL_BEST: $FINAL_BEST"
echo "FINAL_BEST_ITER: $FINAL_ITER"

RESULTS_LINES=$(wc -l < "$DIR/results.tsv")
echo "RESULTS_LINES: $RESULTS_LINES"

IDEAS=$(wc -l < "$DIR/idea-log.jsonl")
echo "IDEAS_LOGGED: $IDEAS"

echo "=== LIFECYCLE PASSED ==="

# CHECK: INIT: INIT
# CHECK: BASELINE: BASELINE
# CHECK: ITER_AFTER_BASELINE: 1
# CHECK: STORE_BEST: 380.2
# CHECK: ITER_AFTER_LOOP: 2
# CHECK: GUARDS_RESET: 0
# CHECK: FINAL_STATE: DONE
# CHECK: FINAL_BEST: 380.2
# CHECK: FINAL_BEST_ITER: 1
# CHECK: RESULTS_LINES: 3
# CHECK: IDEAS_LOGGED: 2
# CHECK: === LIFECYCLE PASSED ===
