// RUN: choreo -es -t cc %s -o - | FileCheck %s

// Test: barrier at thread/group levels (CPU: barriers are no-ops)
__co__ void test_barriers() {
  parallel bx by 1 : block {
    // CHECK-NOT: __syncthreads
    // CHECK-NOT: __syncwarp
    sync.barrier : group;
    sync.barrier : thread;
  }
}

// Test: fence at thread/group/block visibility (CPU: seq_cst full fence is
// the default; release/acquire/acq_rel emit the corresponding directional
// fences)
__co__ void test_fences() {
  parallel bx by 1 : block {
    // CHECK: std::atomic_thread_fence(std::memory_order_seq_cst);
    sync.fence : block;

    // CHECK: std::atomic_thread_fence(std::memory_order_seq_cst);
    sync.fence : group;

    // CHECK: std::atomic_thread_fence(std::memory_order_seq_cst);
    sync.fence : thread;

    // CHECK: std::atomic_thread_fence(std::memory_order_release);
    sync.fence.rel : block;

    // CHECK: std::atomic_thread_fence(std::memory_order_acquire);
    sync.fence.acq : block;

    // CHECK: std::atomic_thread_fence(std::memory_order_acq_rel);
    sync.fence.acq_rel : block;

    // CHECK: std::atomic_thread_fence(std::memory_order_seq_cst);
    sync.fence.sc : block;
  }
}
