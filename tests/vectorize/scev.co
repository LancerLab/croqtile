// RUN: choreo --vectorize %s | FileCheck --match-full-lines %s
___co__ void vecadd(s32 [N, C, H, W] a, s32 [N,C,H, W] b)
{
  parallel q by 1 {
    l1_a = dma.copy a => local;
    l1_b = dma.copy b => local;
    with {n, c, h, w} in [a.span] {
      foreach n, c, h, w: vectorize(w, 128) {
        index_0 = h * W + w;
        index_1 = h + 1;
        index_2 = h * 3;
        index_3 = h % W; // not supported by scev
        index_4 = h / W;
        index_5 = index_1 + index_2;
        index_6 = l1_a.span(0) + index_1 * 2;
        s32 val = l1_a.data.at(n, c, h, w);
        val = 1;
        index_0 = 1;
    }
  }
}
}

// CHECK: [scev] start scalar evolution analysis.
// CHECK: param: `::vecadd::C` -> ::vecadd::C
// CHECK: param: `::vecadd::W` -> ::vecadd::W
// CHECK: param: `::vecadd::H` -> ::vecadd::H
// CHECK: param: `::vecadd::N` -> ::vecadd::N
// CHECK: pi:    `anon_pb_0__elem__x` -> ::vecadd::paraby_0::anon_pb_0__elem__x
// CHECK: pi:    `q__elem__x` -> ::vecadd::paraby_0::paraby_1::q__elem__x
// CHECK: iv:    `n` -> {0, +, 1} <::loop_n0>
// CHECK: iv:    `c` -> {0, +, 1} <::loop_n0::loop_c1>
// CHECK: iv:    `h` -> {0, +, 1} <::loop_n0::loop_c1::loop_h2>
// CHECK: iv:    `w` -> {0, +, 128} <::loop_n0::loop_c1::loop_h2::loop_w3>
// CHECK{LITERAL}: decl:  `index_0` -> {{0, +, ::vecadd::W} <::loop_n0::loop_c1::loop_h2>, +, 128} <::loop_n0::loop_c1::loop_h2::loop_w3>
// CHECK: decl:  `index_1` -> {1, +, 1} <::loop_n0::loop_c1::loop_h2>
// CHECK: decl:  `index_2` -> {0, +, 3} <::loop_n0::loop_c1::loop_h2>
// CHECK: decl:  `index_3` -> (::vecadd::paraby_0::paraby_1::within_0::h % ::vecadd::W)
// CHECK: decl:  `index_4` -> {0, +, (1 / ::vecadd::W)} <::loop_n0::loop_c1::loop_h2>
// CHECK: decl:  `index_5` -> {1, +, 4} <::loop_n0::loop_c1::loop_h2>
// CHECK: decl:  `index_6` -> {(::vecadd::N + 2), +, 2} <::loop_n0::loop_c1::loop_h2>
// CHECK: decl:  `val` -> l1_a.data[n, c, h, w]
// CHECK: asgn:  `val` is re-assigned, invalidate its scev.
// CHECK: asgn:  `index_0` is re-assigned, invalidate its scev.