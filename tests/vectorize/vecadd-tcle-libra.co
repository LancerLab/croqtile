// REQUIRES: TARGET-GCU400 GCUSIM
// RUN: choreo -t topscc -arch=gcu400 %s -o %s.topscc.result && %s.topscc.result | FileCheck --match-full-lines %s
#include "choreo.h"
__cok__ {
  __co_device__ extern "C" void k_vecadd(float *a, float *b, float *c, int total_elems) {
    constexpr int bpe = sizeof(float);
    constexpr int vec_len = TCLE_MAX_VECTOR_LENGTH / bpe;
    using UindexType = typename tcle::altivector<uint32_t, vec_len>::VT;
    using fType = typename tcle::altivector<float, vec_len>::VT;
    auto seq = tcle::mid<UindexType, 0>(0);
    __vector signed int vec_upper = (__vector signed int)(total_elems);
    for (uint32_t i = 0; i < total_elems; i+= vec_len) {
      auto mask = seq < vec_upper;
      fType a_vec = tcle::vsel(mask, tcle::load<fType>((__TCLE_AS__ char *)(a + i)), (fType)0);
      fType b_vec = tcle::vsel(mask, tcle::load<fType>((__TCLE_AS__ char *)(b + i)), (fType)0);
      fType c_vec = a_vec + b_vec;
      tcle::store(c_vec, (__TCLE_AS__ char *)(c + i));
      seq = seq + vec_len;
    }
  }
}

#define M 2
#define N 1000
__co__ auto vecadd(f32 [M, N] a, f32 [M, N] b)  {
  f32 [a.span] c;
  parallel by 1  {
    l1_a = dma.copy a => local;
    l1_b = dma.copy b => local;
    local f32[l1_a.span(0), l1_a.span(1)] l1_c;
    foreach {i} in [l1_a.span(0)] {
      call k_vecadd(l1_a.chunkat(i, _), l1_b.chunkat(i, _), l1_c.chunkat(i, _), N);
    }
    out_store = dma.copy l1_c => c;
  }
  return c;
}

int main() { /// host program
auto a = choreo::make_spandata<choreo::f32>(M, N);
auto b = choreo::make_spandata<choreo::f32>(M, N);
a.fill_random(-10.0f, 10.0f);
b.fill_random(-10.0f, 10.0f);

auto res = vecadd(a.view(), b.view());

// verification
for (size_t i = 0; i < res.shape()[0]; ++i)
  for (size_t j = 0; j < res.shape()[1]; ++j) {
    if (a[i][j] + b[i][j] != res[i][j]) {
      std::cout << "i: " << i << ", j: " << j << ", res: " << res[i][j]<< ", ref " << a[i][j] + b[i][j]  << "\n";
      choreo::choreo_assert(a[i][j] + b[i][j] == res[i][j], "values are not equal.");
    }
  }

std::cout << "Test Passed\n" << std::endl;
}