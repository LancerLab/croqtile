__co__ void vecadd(s32 [H, W] a, s32 [H, W] b, f32 uni)
{
  parallel q by 1 {
    l1_a = dma.copy a => local;
    l1_b = dma.copy b => local;
    with {i, j} in [a.span] {
      foreach i, j: vectorize(j, 128) {
        index = i * W + j; // stride = 1, scev => {}
        val = 0; // uni
        if (i==0) { //uni
          call abc(val);
        } else {
          if (index < 100) {
            val = l1_a.data.at(i, j); // vary
            call abc(val);
          } else {
            val = l1_b.data.at(i, j); // vary
            call abc(val);
          }
        }
        call abc(val);
      }
    }
  }
}
