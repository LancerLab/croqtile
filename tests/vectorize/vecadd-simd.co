// CODEGEN:   __vector float val = tcle::load<__vector float>((__TCLE_AS__ char *)((float*)l1_a.data() + (__iv_i * 512) + __vec_iv_j[0])) + tcle::load<__vector float>((__TCLE_AS__ char *)((float*)l1_b.data() + (__iv_i * 512) + __vec_iv_j[0]));
// CODEGEN:   tcle::store(val, (__TCLE_AS__ char *)((float*)l1_c + (__iv_i * 512) + __vec_iv_j[0]));
