// REQUIRES: TARGET-GCU300
// RUN: choreo -gs -arch=gcu300 --liveness --mem-reuse %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --match-full-lines %s && rm -f %s.topscc.result
// RUN: choreo --liveness -dv=liveness -sa=liveness %s -o - | FileCheck --match-full-lines --check-prefix=LIVENESS %s

#include "choreo.h"

__cok__{

__co_device__ void foo0(u8* a, u8* b, int n) {
  for (int i = 0; i < n; i++)
    b[i] = a[i];
}

}

#define K 512
#define N 1

__co__ auto mem_reuse0(u8 [K, K, N] i0, u8 [K, K, N] i1) {
  u8 [K, K, N * 2] output;

  parallel p by 1, q by 2 {
    foreach idx in [2, 1, N] {
      shared u8 [output.span / #idx] s0;

      s1 = dma.copy.async i0.chunkat(idx) => shared;
      s2 = dma.copy.async i1.chunkat(idx) => shared;
      wait s1, s2;

      local u8 [s1.span] l1;
      inthreads.async (q == 0) {
        local u8 [l1.span] l0{0};
        dma.copy s1 => l1;
        call foo0(l1, l0, |l0|);
        dma.copy l0 => s0.chunkat(_, _, q);
      }
      
      local u8 [s2.span] l2;
      inthreads.async (q == 1) {
        local u8 [l2.span] l0{0};
        dma.copy s2 => l2;
        call foo0(l2, l0, |l0|);
        dma.copy l0 => s0.chunkat(_, _, q);
      }
      sync.shared;

      dma.copy s0 => output.chunkat(idx);
    }
  }
  
  return output;
}

int main()
{
  choreo::u8 a[K][K][N] = {0};
  choreo::u8 b[K][K][N] = {0};
  auto a_data = choreo::make_spanview<3, choreo::u8>((choreo::u8*)a, {K, K, N});
  auto b_data = choreo::make_spanview<3, choreo::u8>((choreo::u8*)b, {K, K, N});
  a_data.fill_random(0, 4);
  b_data.fill_random(0, 4);

  auto res = mem_reuse0(a_data, b_data);

  std::cout << "shape of res: " << res.shape()[0] << std::endl;
  std::cout << "shape of res: " << res.shape()[1] << std::endl;
  std::cout << "shape of res: " << res.shape()[2] << std::endl;

  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j)
      for (size_t k = 0; k < 1; ++k) {
        auto aa = (int)a[i][j][k];
        auto bb = (int)b[i][j][k];
        auto r = (int)res[i][j][k];
        auto rr = (int)res[i][j][k + 1];
        if (aa == r && bb == rr) continue;
        std::cout << "index: " << i << ", " << j << ", " << k << std::endl;
        std::cout << "a: " << aa << std::endl;
        std::cout << "b: " << bb << std::endl;
        std::cout << "res: " << r << ' ' << rr << std::endl;
        choreo::choreo_assert(false, "values are not equal.");
      }

  std::cout << "pass" << std::endl;
  return 0;
}

// CHECK: pass


