// LIVENESS:  (  1)   global u8 [ 512 512 (1 * 2)  ] output
// LIVENESS:  (  2)   parallel p = {p__elem__x} by [1] {
// LIVENESS:  (  3)     parallel q = {q__elem__x} by [2] {
// LIVENESS:  (  4)       with idx = {idx__elem__0, idx__elem__1, idx__elem__2} in [ (1 * 2)  1 1 ] {
// LIVENESS:  (  5)         foreach idx(::) {
// LIVENESS:  (  6)           shared u8 [ (output.span /  (ubound idx) )  ] s0
// LIVENESS:  (  7)           shared u8 mdspan<3> [256, 512, 1] s1__buf__
// LIVENESS:  (  8)           s1 = dma.copy.async i0.ChunkAt(idx) => s1__buf__
// LIVENESS:  (  9)           shared u8 mdspan<3> [256, 512, 1] s2__buf__
// LIVENESS:  ( 10)           s2 = dma.copy.async i1.ChunkAt(idx) => s2__buf__
// LIVENESS:  ( 11)           wait s1, s2
// LIVENESS:  ( 12)           local u8 [ s1.span ] l1
// LIVENESS:  ( 13)           inthreads.async  (q == 0)  {
// LIVENESS:  ( 14)             local u8 [ l1.span ] l0 = {0}
// LIVENESS:  ( 15)             dma.copy s1 => l1
// LIVENESS:  ( 16)             call foo0(l1, l0,  (sizeof l0) )
// LIVENESS:  ( 17)             dma.copy l0 => s0.ChunkAt(__choreo_no_tiling__, __choreo_no_tiling__, q)
// LIVENESS:  ( 18)           }
// LIVENESS:  ( 19)           local u8 [ s2.span ] l2
// LIVENESS:  ( 20)           inthreads.async  (q == 1)  {
// LIVENESS:  ( 21)             local u8 [ l2.span ] l0 = {0}
// LIVENESS:  ( 22)             dma.copy s2 => l2
// LIVENESS:  ( 23)             call foo0(l2, l0,  (sizeof l0) )
// LIVENESS:  ( 24)             dma.copy l0 => s0.ChunkAt(__choreo_no_tiling__, __choreo_no_tiling__, q)
// LIVENESS:  ( 25)           }
// LIVENESS:  ( 26)           sync.shared
// LIVENESS:  ( 27)           dma.copy s0 => output.ChunkAt(idx)
// LIVENESS:  ( 28)         }
// LIVENESS:  ( 29)       }
// LIVENESS:  ( 30)     }
// LIVENESS:  ( 31)   }
// LIVENESS:  ( 32)   return output
// LIVENESS:  ( 33) }

