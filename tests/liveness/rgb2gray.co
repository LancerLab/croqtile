// RUN: choreo --liveness -dv=liveness -sa=liveness %s -o - | FileCheck --match-full-lines %s

__co__ auto rgb2gray(f32 [N, 3, H, W] input) {
  f32 [N, H, W] out;
  parallel q by 6 {
    // TODO: use N, H, W, q?
    with index={n, c, h, w} in [N, 3, H, W]/{#q, 3, 16, 512} {
      foreach n, h {
        input_L1_A = dma.copy.async input.chunkat(q#n, c, h, w) => local;
        input_L1_B = dma.any;
        local f32 [input_L1_A.span(0), input_L1_A.span(2), input_L1_A.span(3)] out_L1;
        foreach w(1:) {
          input_L1_B = dma.copy.async input.chunkat(q#n, c, h, w) => local;
          wait input_L1_A;
          dma.copy out_L1 => out.chunkat(q#n, h, w - 1);
          swap(input_L1_A, input_L1_B);
        }
        input_L1 = select(#w % 2, input_L1_B, input_L1_A);
        wait input_L1;
        dma.copy out_L1 => out.chunkat(q#n, h, w(-1));
      }
    }
  }
  return out;
}

