// CHECK: (  1)   global f32 [ N H W ] out
// CHECK: (  2)   parallel q = {q__elem__x} by [6] {
// CHECK: (  3)     with index = {n, c, h, w} in  ([ N 3 H W ] / { (ubound q) , 3, 16, 512})  {
// CHECK: (  4)       foreach n(::), h(::) {
// CHECK: (  5)         anon_0 =  (q # n) 
// CHECK: (  6)         local f32 mdspan<4> [1, 3, 16, 512] input_L1_A__buf__
// CHECK: (  7)         input_L1_A = dma.copy.async input.ChunkAt(anon_0, c, h, w) => input_L1_A__buf__
// CHECK: (  8)         local f32 mdspan<4> [1, 3, 16, 512] input_L1_B__buf__
// CHECK: (  9)         input_L1_B = dma.any
// CHECK: ( 10)         local f32 [ input_L1_A.span(0) input_L1_A.span(2) input_L1_A.span(3) ] out_L1
// CHECK: ( 11)         anon_1 = 1
// CHECK: ( 12)         foreach w(anon_1::1) {
// CHECK: ( 13)           anon_2 =  (q # n) 
// CHECK: ( 14)           input_L1_B = dma.copy.async input.ChunkAt(anon_2, c, h, w) => input_L1_B__buf__
// CHECK: ( 15)           wait input_L1_A
// CHECK: ( 16)           anon_3 =  (q # n) 
// CHECK: ( 17)           anon_4 =  (w - 1) 
// CHECK: ( 18)           dma.copy out_L1 => out.ChunkAt(anon_3, h, anon_4)
// CHECK: ( 19)           swap(input_L1_A, input_L1_B)
// CHECK: ( 20)         }
// CHECK: ( 21)         unknown input_L1 = select( ( (ubound w)  % 2) , input_L1_B, input_L1_A)
// CHECK: ( 22)         wait input_L1
// CHECK: ( 23)         anon_5 =  (q # n) 
// CHECK: ( 24)         dma.copy out_L1 => out.ChunkAt(anon_5, h, w[-1])
// CHECK: ( 25)       }
// CHECK: ( 26)     }
// CHECK: ( 27)   }
// CHECK: ( 28)   return out
// CHECK: ( 29) }
