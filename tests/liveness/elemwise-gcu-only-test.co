// CHECK:         range: [7, 13] 
// CHECK: VAR    ::ele_add::paraby_0::paraby_1::within_0::foreach_0::foreach_1::lhs_load__buf__.span
// CHECK:         range: [7, 7] 
// CHECK: VAR    ::ele_add::paraby_0::paraby_1::within_0::foreach_0::foreach_1::lhs_load
