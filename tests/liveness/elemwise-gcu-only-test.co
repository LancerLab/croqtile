// CHECK:         range: [0, 17] 
// CHECK: VAR    ::ele_add::rhs.span
// CHECK:         range: [0, 0] 
// CHECK: BUFFER ::ele_add::output
// CHECK:         range: [1, 21] 
// CHECK: VAR    ::ele_add::output.span
// CHECK:         range: [1, 1] 
