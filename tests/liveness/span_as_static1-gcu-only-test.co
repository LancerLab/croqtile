// RUN: choreo -dv=liveness -sa=liveness %s -o - | FileCheck --match-full-lines %s

#include "choreo.h"
#include <random>

/*
http://wiki.enflame.cn/display/AUS/indim3_split0_outdim3_split1_perm1302

Memory Hierarchy
  D2C linear copy
  C2C transpose
  C2D deslice

input_shape_d = {a1, a2, a3, b, c, d};
input_reshape_d = {a4, a5, b * c * d};
input_shape_c = {1, a5, b * c * d};  // indim=3 split=0
input_reshape_c = {a5, b, c, d};
output_shape_c = {b, d, a5, c};
output_reshape_c = {b * d, 1, a5 * c};  // outdim=3 split=1
output_reshape_d = {b * d, a4, a5 * c};
output_shape_d = {b, d, a1, a2, a3, c};
*/

//                    s32 [A1,A2,A3,B, C, D] input
__co__ auto transpose(s32 [8, 2, 3, 2, 4, 2] input) {
  s32[input.span[(3), (5), (0), (1), (2), (4)]] output;
          // s32[ B,   D,  A1,  A2,  A3,   C] output;
  // python3 1.py
  // a4 = 3, a5 = 16
  parallel p by 1 {
    with index = {a4, a5, b, c, d} in [3, 1, 1, 1, 1] {
      foreach index {
        input_shape_c = dma.copy.async input.span_as([3, 16, 16]).chunkat(a4, a5, b#c#d) => local;
        wait input_shape_c;
        local s32[2, 2, 16, 4] output_shape_c;
        dma.transp<1, 3, 0, 2> input_shape_c.span_as([16, 2, 4, 2]) => output_shape_c;
        out_store = dma.copy.async output_shape_c.span_as([4, 1, 64]) => output.span_as([4, 3, 64]).chunkat(b#d, a4, a5#c);
        wait out_store;
      }
    }
  }
  return output;
}

int main() { /// host program

  #define aa1 8
  #define aa2 2
  #define aa3 3
  #define bb  2
  #define cc  4
  #define dd  2

  std::mt19937 mt(std::random_device{}());

  choreo::s32 x[aa1][aa2][aa3][bb][cc][dd] = {0};
  std::vector<int> bounds = {aa1, aa2, aa3, bb, cc, dd};
  int i = 0;
  for (size_t a1 = 0; a1 < bounds[0]; ++a1)
    for (size_t a2 = 0; a2 < bounds[1]; ++a2)
      for (size_t a3 = 0; a3 < bounds[2]; ++a3)
        for (size_t b = 0; b < bounds[3]; ++b)
          for (size_t c = 0; c < bounds[4]; ++c)
            for (size_t d = 0; d < bounds[5]; ++d)
              x[a1][a2][a3][b][c][d] = mt() % 10;

  // abcde => cadbe
  auto res = transpose(choreo::make_spanview<6, choreo::s32>(
      (int *)x, {aa1, aa2, aa3, bb, cc, dd}));

  for (int j=0; j<6; j++)
    std::cout << "res.shape()[" << j << "] = " << res.shape()[j] << "\n";

  // verfication
  for (size_t a1 = 0; a1 < bounds[0]; ++a1)
    for (size_t a2 = 0; a2 < bounds[1]; ++a2)
      for (size_t a3 = 0; a3 < bounds[2]; ++a3)
        for (size_t b = 0; b < bounds[3]; ++b)
          for (size_t c = 0; c < bounds[4]; ++c)
            for (size_t d = 0; d < bounds[5]; ++d) {
              if (x[a1][a2][a3][b][c][d] != res[b][d][a1][a2][a3][c]) {
                std::cout << a1 << ", " << a2 << ", " << a3 << ", " << b << ", " << c
                          << ", " << d << "\n";
                std::cout << "\tx: " << x[a1][a2][a3][b][c][d]
                          << "\n\tres: " << res[b][d][a1][a2][a3][c] << "\n";
                choreo::choreo_assert(x[a1][a2][a3][b][c][d] == res[b][d][a1][a2][a3][c], "values are not equal.");
              }
            }

  std::cout << "Test Passed\n" << std::endl;
}

// CHECK: (  0) transpose(s32 mdspan<6> [8, 2, 3, 2, 4, 2] input) {
// CHECK{LITERAL}: (  1)   global s32 [[ input(3) input(5) input(0) input(1) input(2) input(4) ] ] output
// CHECK: (  2)   parallel anon_pb_0 = {anon_pb_0__elem__x} by [1] : block {
// CHECK: (  3)     parallel p = {p__elem__x} by [1] : thread {
// CHECK: (  4)       with index = {a4, a5, b, c, d} in [ 3 1 1 1 1 ] {
// CHECK: (  5)         foreach index(::) {
// CHECK: (  6)           anon_0 =  ( (b # c)  # d) 
// CHECK: (  7)           local s32 mdspan<3> [1, 16, 16] input_shape_c__buf__
// CHECK: (  8)           input_shape_c = dma.copy.async input.SpanAs([ 3 16 16 ]).ChunkAt(a4, a5, anon_0) => input_shape_c__buf__
// CHECK: (  9)           wait input_shape_c
// CHECK: ( 10)           local s32 [ 2 2 16 4 ] output_shape_c
// CHECK: ( 11)           dma.transp transpose: dims{1, 3, 0, 2} input_shape_c.SpanAs([ 16 2 4 2 ]) => output_shape_c
// CHECK: ( 12)           anon_1 =  (b # d) 
// CHECK: ( 13)           anon_2 =  (a5 # c) 
// CHECK: ( 14)           out_store = dma.copy.async output_shape_c.SpanAs([ 4 1 64 ]) => output.SpanAs([ 4 3 64 ]).ChunkAt(anon_1, a4, anon_2)
// CHECK: ( 15)           wait out_store
// CHECK: ( 16)         }
// CHECK: ( 17)       }
// CHECK: ( 18)     }
// CHECK: ( 19)   }
// CHECK: ( 20)   return output
// CHECK: ( 21) }

// CHECK: BUFFER ::transpose::input
// CHECK:         range: [0, 16]
// CHECK: VAR    ::transpose::input.span
// CHECK:         range: [0, 0]
// CHECK: BUFFER ::transpose::output
// CHECK:         range: [1, 20]
// CHECK: VAR    ::transpose::output.span
// CHECK:         range: [1, 1]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::p
// CHECK:         range: [3, 3]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::p__elem__x
// CHECK:         range: [3, 3]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::a4
// CHECK:         range: [4, 16]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::a5
// CHECK:         range: [4, 16]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::b
// CHECK:         range: [4, 16]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::c
// CHECK:         range: [4, 16]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::d
// CHECK:         range: [4, 16]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::index
// CHECK:         range: [4, 16]
// CHECK: BUFFER ::transpose::paraby_0::paraby_1::within_0::foreach_0::input_shape_c__buf__
// CHECK: 	      range: [7, 11]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::input_shape_c__buf__.span
// CHECK: 	      range: [7, 7]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::input_shape_c
// CHECK:         range: [8, 11]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::input_shape_c.span
// CHECK:         range: [8, 8]
// CHECK: BUFFER ::transpose::paraby_0::paraby_1::within_0::foreach_0::output_shape_c
// CHECK:         range: [10, 15]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::output_shape_c.span
// CHECK:         range: [10, 10]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::anon_1
// CHECK:         range: [12, 14]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::anon_2
// CHECK:         range: [13, 14]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::out_store
// CHECK:         range: [14, 15]
// CHECK: VAR    ::transpose::paraby_0::paraby_1::within_0::foreach_0::out_store.span
// CHECK:         range: [14, 14]
