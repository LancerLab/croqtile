// REQUIRES: TARGET-GCUALL SHELL-ONLY
// RUN: choreo -t topscc %s -gs | bash -s | FileCheck %s
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck %s
// RUN: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s

__co__ void nowait(f32 [15] input) {
  parallel p by 1 {
    f0 = dma.copy.async input => local;
    f1 = dma.copy.async input => local;
    swap(f0, f1);
    wait f1;
  }
}

int main() {
  choreo::f32 i[15];
  nowait(choreo::make_spanview(i));
}

// CHECK: [choreo-rt] Error is detected: future (defined at line 7:10) has never been waited.
