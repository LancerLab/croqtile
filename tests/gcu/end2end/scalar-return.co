// REQUIRES: TARGET-GCUALL
// RUN: choreo -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-DOCKER: choreo -t topscc -gs -st %s | bash -s | FileCheck --match-full-lines %s
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s

#include <iostream>

__co__ auto int_ret() { return 3; }

__co__ auto float_ret() { return 1.5f; }


int main() {
  auto res0 = int_ret();
  std::cout << "int return: " << res0 << std::endl;

  auto res1 = float_ret();
  std::cout << "float return: " << res1 << std::endl;
}

// CHECK: int return: 3
// CHECK: float return: 1.5
