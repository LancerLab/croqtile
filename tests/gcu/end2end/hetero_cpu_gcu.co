// RUN: choreo -t hetero -gs %s | bash -s -- --execute
// RUN-COCR: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// REQUIRES: TARGET-GCUALL

#include "choreo.h"
#include <cmath>

__co__ void hetero_add_copy(f32 [1024] A, f32 [1024] &B) {
  // CPU: A[i] += 1.0
  parallel.async by 1 : device(cpu) {
    foreach i in [1024] {
      A.at(i) = A.at(i) + 1.0;
    }
  }

  // GCU: identity copy via DMA (global -> shared -> local -> shared -> global)
  parallel.async by 1 : device(gcu) {
    parallel p by 1 : block {
      shared f32[1024] l2_buf;
      load_ev = dma.copy.async B.chunkat(p) => shared;
      wait load_ev;
      parallel q by 1 : thread {
        to_local = dma.copy.async load_ev.data => local;
        wait to_local;
        to_shared = dma.copy.async to_local.data => l2_buf;
        wait to_shared;
      }
      store_ev = dma.copy.async l2_buf => B.chunkat(p);
      wait store_ev;
    }
  }

  sync.global;
}

int main() {
  choreo::f32 a_buf[1024], b_buf[1024];
  auto A = choreo::make_spanview<1, choreo::f32>(a_buf, {1024});
  auto B = choreo::make_spanview<1, choreo::f32>(b_buf, {1024});

  for (int i = 0; i < 1024; ++i) {
    A[i] = static_cast<float>(i);
    B[i] = static_cast<float>(i * 2);
  }

  hetero_add_copy(A, B);

  bool pass = true;
  for (int i = 0; i < 1024; ++i) {
    float expected_a = static_cast<float>(i) + 1.0f;
    if (std::fabs(A[i] - expected_a) > 1e-5f) {
      std::cerr << "CPU FAIL at " << i << ": expected " << expected_a
                << " got " << A[i] << "\n";
      pass = false;
      break;
    }
  }

  for (int i = 0; i < 1024; ++i) {
    float expected_b = static_cast<float>(i * 2);
    if (std::fabs(B[i] - expected_b) > 1e-5f) {
      std::cerr << "GCU FAIL at " << i << ": expected " << expected_b
                << " got " << B[i] << "\n";
      pass = false;
      break;
    }
  }

  if (pass) std::cout << "Test Passed\n";
  else std::cerr << "Test Failed\n";
  return pass ? 0 : 1;
}
