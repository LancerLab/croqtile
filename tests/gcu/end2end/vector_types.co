// REQUIRES: TARGET-GCU300
// RUN: choreo -t topscc -gs --vectorize %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s

#define N 4
#define M 1024

__co__ auto ele_add_f32(f32 [N, M] a, f32 [N, M] b)  {
  f32 [a.span] c;
  parallel p by 2, q by 1 {
    l1_a = dma.copy a.chunkat(p, q) => local;
    l1_b = dma.copy b.chunkat(p, q) => local;

    local f32[l1_a.span(0), l1_a.span(1)] l1_c;
    foreach idx in l1_a.span
      l1_c.at(idx) = l1_a.data.at(idx) + l1_b.data.at(idx);;

    out_store = dma.copy l1_c => c.chunkat(p, q);
  }
  return c;
}
