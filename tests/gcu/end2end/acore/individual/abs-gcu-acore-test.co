// SKIP: merged into acore-lib-merged-test.co
// REQUIRES: TARGET-GCU300 LIBCALL
// RUN: choreo -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// Unary __lib_abs end-to-end test on GCU3.

__co__ f32 [6, 256] lib_abs_test(f32 [6, 256] input) {
  f32[input.span] output;

  parallel p by 6 {
    foreach x in 1 {
      in_tile = dma.copy.async input.chunkat(p, x) => local;
      wait in_tile;

      local f32[in_tile.span] l1_out;

      __lib_abs(l1_out, in_tile.data, |in_tile.span|);

      out_store = dma.copy.async l1_out => output.chunkat(p, x);
      wait out_store;
    }
  }
  return output;
}

int main() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 256);
  inp.fill_random(-10, 10);

  auto res = lib_abs_test(inp.view());

  bool passed = true;
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 256; ++j) {
      float expected = std::abs((float)inp[i][j]);
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "Mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        passed = false;
      }
    }

  if (passed)
    std::cout << "Test Passed" << std::endl;
  else
    std::cout << "Test Failed" << std::endl;
}

// CHECK: Test Passed
