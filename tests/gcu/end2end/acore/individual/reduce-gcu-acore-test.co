// SKIP: merged into acore-lib-merged-test.co
// REQUIRES: TARGET-GCU300 LIBCALL
// RUN: choreo -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// Reduce __lib_reduce_sum end-to-end test on GCU3.

__co__ f32 [6, 1] lib_reduce_sum_test(f32 [6, 128] input) {
  f32[6, 1] output;

  parallel p by 6 {
    foreach x in 1 {
      in_tile = dma.copy.async input.chunkat(p, x) => local;
      wait in_tile;

      local f32[1, 1] l1_out;

      __lib_reduce_sum(l1_out, in_tile.data, |in_tile.span|, 128, 128);

      out_store = dma.copy.async l1_out => output.chunkat(p, x);
      wait out_store;
    }
  }
  return output;
}

int main() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-5, 5);

  auto res = lib_reduce_sum_test(inp.view());

  bool passed = true;
  for (size_t i = 0; i < 6; ++i) {
    float expected = 0.0f;
    for (size_t j = 0; j < 128; ++j)
      expected += (float)inp[i][j];
    if (std::abs(res[i][0] - expected) > 1.0f) {
      std::cerr << "Mismatch at [" << i << "]: "
                << res[i][0] << " vs " << expected << std::endl;
      passed = false;
    }
  }

  if (passed)
    std::cout << "Test Passed" << std::endl;
  else
    std::cout << "Test Failed" << std::endl;
}

// CHECK: Test Passed
