// REQUIRES: TARGET-GCU300
// RUN: choreo -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// RUN-COCR: cocc -t gcu -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
// MMA end-to-end test on GCU3 using acore::matmul micro-kernel backend.
// Computes C[128, 128] = A[128, 32] * B[32, 128] using mma.fill/load/exec/store.

__co__ f32 [128, 128] mma_matmul(f16 [128, 32] A, f16 [32, 128] B) {
  f32[128, 128] output;

  parallel p by 1 {
    local f16[128, 32] lhs;
    local f16[32, 128] rhs;
    local f32[128, 128] out;
    dma.copy A => lhs;
    dma.copy B => rhs;
    mc = mma.fill.f32 0;
    ma = mma.load lhs;
    mb = mma.load rhs;
    mma.row.col mc, ma, mb;
    mma.store mc, out;
    dma.copy out => output;
  }
  return output;
}

int main() {
  auto a = choreo::make_spandata<choreo::f16>(128, 32);
  auto b = choreo::make_spandata<choreo::f16>(32, 128);
  a.fill_random(-1, 1);
  b.fill_random(-1, 1);

  auto res = mma_matmul(a.view(), b.view());

  std::cout << res.shape()[0] << std::endl;
  std::cout << res.shape()[1] << std::endl;

  bool passed = true;
  for (size_t i = 0; i < 128 && passed; ++i)
    for (size_t j = 0; j < 128 && passed; ++j) {
      float expected = 0.0f;
      for (size_t k = 0; k < 32; ++k)
        expected += (float)a[i][k] * (float)b[k][j];
      if (std::abs(res[i][j] - expected) > 1.0f) {
        std::cerr << "Mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        passed = false;
      }
    }

  if (passed)
    std::cout << "Test Passed" << std::endl;
  else
    std::cout << "Test Failed" << std::endl;
}

// CHECK: 128
// CHECK-NEXT: 128
// CHECK-NEXT: Test Passed
