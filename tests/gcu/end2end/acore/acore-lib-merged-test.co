// ---------------------------------------------------------------------------
// Binary kernels (f32 [6, 128])
// ---------------------------------------------------------------------------

__co__ f32 [6, 128] lib_add_test(f32 [6, 128] A, f32 [6, 128] B) {
  f32[A.span] output;
  parallel p by 6 {
    foreach x in 1 {
      a_tile = dma.copy.async A.chunkat(p, x) => local;
      b_tile = dma.copy.async B.chunkat(p, x) => local;
      wait a_tile;
      wait b_tile;
      local f32[a_tile.span] l1_out;
      __lib_add(l1_out, a_tile.data, b_tile.data, |a_tile.span|);
      out_store = dma.copy.async l1_out => output.chunkat(p, x);
      wait out_store;
    }
  }
  return output;
}

__co__ f32 [6, 128] lib_mul_test(f32 [6, 128] A, f32 [6, 128] B) {
  f32[A.span] output;
  parallel p by 6 {
    foreach x in 1 {
      a_tile = dma.copy.async A.chunkat(p, x) => local;
      b_tile = dma.copy.async B.chunkat(p, x) => local;
      wait a_tile;
      wait b_tile;
      local f32[a_tile.span] l1_out;
      __lib_mul(l1_out, a_tile.data, b_tile.data, |a_tile.span|);
      out_store = dma.copy.async l1_out => output.chunkat(p, x);
      wait out_store;
    }
  }
  return output;
}

// ---------------------------------------------------------------------------
// Reduce kernel (f32 [6, 128] -> f32 [6, 1])
// ---------------------------------------------------------------------------

__co__ f32 [6, 1] lib_reduce_sum_test(f32 [6, 128] input) {
  f32[6, 1] output;
  parallel p by 6 {
    foreach x in 1 {
      in_tile = dma.copy.async input.chunkat(p, x) => local;
      wait in_tile;
      local f32[1, 1] l1_out;
      __lib_reduce_sum(l1_out, in_tile.data, |in_tile.span|, 128, 128);
      out_store = dma.copy.async l1_out => output.chunkat(p, x);
      wait out_store;
    }
  }
  return output;
}

// ---------------------------------------------------------------------------
// Binary kernel with acore::add_relu (s32 [6, 17, 64])
// ---------------------------------------------------------------------------

__co__ s32 [6, 17, 64] add_relu(s32 [6, 17, 64] lhs, s32 [6, 17, 64] rhs) {
  s32[lhs.span] output;
  parallel p by 6 {
    foreach x in 17
      foreach y in 4 {
        lhs_load = dma.copy.async lhs.chunkat(p, x, y) => local;
        rhs_load = dma.copy.async rhs.chunkat(p, x, y) => local;
        wait lhs_load, rhs_load;
        local s32[lhs_load.span] l1_out;
        call acore::add_relu(l1_out, lhs_load.data, rhs_load.data, |l1_out.span|, 1);
        out_store = dma.copy.async l1_out => output.chunkat(p, x, y);
        wait out_store;
      }
  }
  return output;
}

// ===========================================================================
// Host verification
// ===========================================================================

bool test_relu() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-10, 10);
  auto res = acore_relu(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float expected = (inp[i][j] > 0) ? inp[i][j] : 0.0f;
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "relu mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_exp() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-3, 3);
  auto res = lib_exp_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float expected = std::exp((float)inp[i][j]);
      if (std::abs(res[i][j] - expected) > 0.01f * std::abs(expected)) {
        std::cerr << "exp mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_silu() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-5, 5);
  auto res = lib_silu_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float x = (float)inp[i][j];
      float expected = x / (1.0f + std::exp(-x));
      if (std::abs(res[i][j] - expected) > 0.02f) {
        std::cerr << "silu mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_sigmoid() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-5, 5);
  auto res = lib_sigmoid_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float x = (float)inp[i][j];
      float expected = 1.0f / (1.0f + std::exp(-x));
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "sigmoid mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_gelu() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-3, 3);
  auto res = lib_gelu_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float x = (float)inp[i][j];
      float expected = 0.5f * x * (1.0f + std::erf(x * 0.7071067811865476f));
      if (std::abs(res[i][j] - expected) > 0.02f) {
        std::cerr << "gelu mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_tanh() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-3, 3);
  auto res = lib_tanh_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float expected = std::tanh((float)inp[i][j]);
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "tanh mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

