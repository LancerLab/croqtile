      }
    }
  return true;
}

bool test_sqrt() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 256);
  inp.fill_random(1, 100);
  auto res = lib_sqrt_test(inp.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 256; ++j) {
      float expected = std::sqrt((float)inp[i][j]);
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "sqrt mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_add() {
  auto a = choreo::make_spandata<choreo::f32>(6, 128);
  auto b = choreo::make_spandata<choreo::f32>(6, 128);
  a.fill_random(-10, 10);
  b.fill_random(-10, 10);
  auto res = lib_add_test(a.view(), b.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float expected = (float)a[i][j] + (float)b[i][j];
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "add mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_mul() {
  auto a = choreo::make_spandata<choreo::f32>(6, 128);
  auto b = choreo::make_spandata<choreo::f32>(6, 128);
  a.fill_random(-5, 5);
  b.fill_random(-5, 5);
  auto res = lib_mul_test(a.view(), b.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 128; ++j) {
      float expected = (float)a[i][j] * (float)b[i][j];
      if (std::abs(res[i][j] - expected) > 0.01f) {
        std::cerr << "mul mismatch at [" << i << "][" << j << "]: "
                  << res[i][j] << " vs " << expected << std::endl;
        return false;
      }
    }
  return true;
}

bool test_reduce_sum() {
  auto inp = choreo::make_spandata<choreo::f32>(6, 128);
  inp.fill_random(-5, 5);
  auto res = lib_reduce_sum_test(inp.view());
  for (size_t i = 0; i < 6; ++i) {
    float expected = 0.0f;
    for (size_t j = 0; j < 128; ++j)
      expected += (float)inp[i][j];
    if (std::abs(res[i][0] - expected) > 1.0f) {
      std::cerr << "reduce_sum mismatch at [" << i << "]: "
                << res[i][0] << " vs " << expected << std::endl;
      return false;
    }
  }
  return true;
}

bool test_add_relu() {
  auto a = choreo::make_spandata<choreo::s32>(6, 17, 64);
  auto b = choreo::make_spandata<choreo::s32>(6, 17, 64);
  a.fill_random(-10, 10);
  b.fill_random(-10, 10);
  auto res = add_relu(a.view(), b.view());
  for (size_t i = 0; i < 6; ++i)
    for (size_t j = 0; j < 17; ++j)
      for (size_t k = 0; k < 64; ++k) {
        int value = a[i][j][k] + b[i][j][k];
        value = (value > 0) ? value : 0;
        if (value != res[i][j][k]) {
          std::cerr << "add_relu mismatch at [" << i << "][" << j << "][" << k
                    << "]: " << res[i][j][k] << " vs " << value << std::endl;
          return false;
        }
      }
  return true;
}

int main() {
  int failures = 0;

  if (!test_relu()) { std::cerr << "FAIL: relu\n"; ++failures; }
  if (!test_exp()) { std::cerr << "FAIL: exp\n"; ++failures; }
  if (!test_silu()) { std::cerr << "FAIL: silu\n"; ++failures; }
  if (!test_sigmoid()) { std::cerr << "FAIL: sigmoid\n"; ++failures; }
  if (!test_gelu()) { std::cerr << "FAIL: gelu\n"; ++failures; }
  if (!test_tanh()) { std::cerr << "FAIL: tanh\n"; ++failures; }
  if (!test_abs()) { std::cerr << "FAIL: abs\n"; ++failures; }
  if (!test_neg()) { std::cerr << "FAIL: neg\n"; ++failures; }
  if (!test_sqrt()) { std::cerr << "FAIL: sqrt\n"; ++failures; }
  if (!test_add()) { std::cerr << "FAIL: add\n"; ++failures; }
  if (!test_mul()) { std::cerr << "FAIL: mul\n"; ++failures; }
  if (!test_reduce_sum()) { std::cerr << "FAIL: reduce_sum\n"; ++failures; }
  if (!test_add_relu()) { std::cerr << "FAIL: add_relu\n"; ++failures; }

  if (failures == 0)
    std::cout << "Test Passed" << std::endl;
  else
    std::cout << failures << " test(s) failed" << std::endl;
}

// CHECK: Test Passed
