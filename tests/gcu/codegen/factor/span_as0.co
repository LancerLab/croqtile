// RUN: choreo -gs -t factor %s | FileCheck --match-full-lines %s

__co__ auto span_as0(f32 [32, 18, 9] a) {
  f32 [a.span] b;
  f32 [a.span] o;
  parallel p by 3 {
    with index = {x, y} in [4, 4] {
      foreach index {
        a_local = dma.copy a.span_as([ 16, 9, 36 ]).chunkat(x, p, y) => local;
        b_local = dma.copy b.span_as([ 144, 36 ]).chunkat(p, p) => local;
        o_store = dma.copy a_local => o.span_as([ 16, 9, 36 ]).chunkat(x, p, y);
      }
    }
  }
}

// CHECK:   auto a_type = DRAMType(FloatType(32), {32, 18, 9});
// CHECK:   auto b_type = DRAMType(FloatType(32), {32, 18, 9});
// CHECK:   auto o_type = DRAMType(FloatType(32), {32, 18, 9});

// CHECK:  D(host_func_)("__choreo_span_as0", {a_type, b_type, o_type, StreamType()}, [&](auto args) {
// CHECK:    auto & a = args[0];
// CHECK:    auto & b = args[1];
// CHECK:    auto & o = args[2];
// CHECK:    Dim3 grid_dim(1);
// CHECK:    Dim3 block_dim(3);
// CHECK:    auto ts = launch_kernel_("__choreo_span_as0_parallel", grid_dim, block_dim, args.back(), {args[0], args[1], args[2]}, {});
// CHECK:    return std::vector<Value>{};
// CHECK:  }, true); // end of choreo-factor host program

// CHECK:  D(func_)("__choreo_span_as0_parallel", {a_type, b_type, o_type}, {}, [&](auto args, auto results) {
// CHECK:    auto & a = args[0];
// CHECK:    auto & b = args[1];
// CHECK:    auto & o = args[2];
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto a_local__buf__ = alloc_(L1Type(FloatType(32),{4, 3, 9}));
// CHECK:    auto a_local = alloc_dma_(SDMAType());
// CHECK:    auto b_local__buf__ = alloc_(L1Type(FloatType(32),{48, 12}));
// CHECK:    auto b_local = alloc_dma_(SDMAType());
// CHECK:    auto o_store = alloc_dma_(SDMAType());
// CHECK:    var_ x(IntType(32));
// CHECK:    x = 0;
// CHECK:    var_ y(IntType(32));
// CHECK:    y = 0;
// CHECK:    for_(x, 4, 1, [&](auto iv_x) {
// CHECK:      for_(y, 4, 1, [&](auto iv_y) {
// CHECK:        auto anon_0 = bitcast_(DRAMType(FloatType(32), {16, 9, 36}), a);
// CHECK:        async_load_(a_local, anon_0, a_local__buf__, {Value(4)*iv_x,Value(3)*thread_id,Value(9)*iv_y});
// CHECK:        wait_dma_(a_local);
// CHECK:        auto anon_1 = bitcast_(DRAMType(FloatType(32), {144, 36}), b);
// CHECK:        async_load_(b_local, anon_1, b_local__buf__, {Value(48)*thread_id,Value(12)*thread_id});
// CHECK:        wait_dma_(b_local);
// CHECK:        auto anon_2 = bitcast_(DRAMType(FloatType(32), {16, 9, 36}), o);
// CHECK:        async_store_(o_store, a_local__buf__, anon_2, {Value(4)*iv_x,Value(3)*thread_id,Value(9)*iv_y});
// CHECK:        wait_dma_(o_store);
// CHECK:      }); // end of choreo-foreach block on 'y'.
// CHECK:      y = 0;
// CHECK:    }); // end of choreo-foreach block on 'x'.
// CHECK:    x = 0;
// CHECK:  }); // end of choreo-factor device function
