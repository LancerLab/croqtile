// CHECK:    auto & input = args[0];
// CHECK:    auto & out = results[0];
// CHECK:    auto thread_id = thread_id_();
// CHECK:    auto block_id = block_id_();
// CHECK:    auto a = alloc_(SRAMType(FloatType(32),{128, 1})).shared_(SharedType::kBlockShared);
// CHECK:    auto __choreo_anon_fut__0 = alloc_dma_(CDMAType());
// CHECK:    auto lin = alloc_(L1Type(FloatType(32),{64, 1}));
// CHECK:    auto res = alloc_(L1Type(FloatType(32),{64, 1}));
// CHECK:    auto __choreo_anon_fut__1 = alloc_dma_(SDMAType());
// CHECK:    auto __choreo_anon_fut__2 = alloc_dma_(SDMAType());
// CHECK:    async_load_(__choreo_anon_fut__0, input, a, {0, 0});
// CHECK:    wait_dma_(__choreo_anon_fut__0);
// CHECK:    async_load_(__choreo_anon_fut__1, a, lin, {Value(64)*thread_id,0});
// CHECK:    wait_dma_(__choreo_anon_fut__1);
// CHECK:    call_("kernel", {lin.addr_(),res.addr_(),Value(64)});
// CHECK:    async_store_(__choreo_anon_fut__2, res, out, {Value(64)*thread_id,0});
// CHECK:    wait_dma_(__choreo_anon_fut__2);
// CHECK:  }); // end of choreo-factor device function

