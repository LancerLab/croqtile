// CHECK:  choreo::runtime_check(hp0.shape()[0] == hp1.shape()[1], "The shapes of the 1st parameter (dim: 0) and the 2nd parameter (dim: 1) are inconsistent.");
// CHECK:  choreo::runtime_check(hp1.shape()[1] == hp1.shape()[2], "The shapes of the 2nd parameter (dim: 1) and the 2nd parameter (dim: 2) are inconsistent.");
