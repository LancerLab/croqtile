// CHECK:  choreo::runtime_check((size_t)0 + ((hp0.shape()[2]*(hp0.shape()[1]*hp0.shape()[0])))*4 + (((hp0.shape()[1]*hp0.shape()[0])*hp0.shape()[0]))*4 <= (size_t){{[0-9]+}}, "total memory usage at global level (compile time and runtime) should not exceed {{[0-9]+}} bytes, {{.*}}");
// CHECK:  choreo::runtime_check((size_t)0 + ((hp0.shape()[2]*(hp0.shape()[1]*hp0.shape()[0])))*4 + (((hp0.shape()[1]*hp0.shape()[0])*hp0.shape()[0]))*4 + ((hp0.shape()[2]*hp0.shape()[1]))*4 <= (size_t){{[0-9]+}}, "total memory usage at global level (compile time and runtime) should not exceed {{[0-9]+}} bytes, {{.*}}");
// CHECK:  choreo::runtime_check((size_t)0 + ((hp0.shape()[2]*(hp0.shape()[1]*hp0.shape()[0])))*4 + (((hp0.shape()[1]*hp0.shape()[0])*hp0.shape()[0]))*4 + ((hp0.shape()[2]*hp0.shape()[1]))*4 + ((hp0.shape()[2]*(hp0.shape()[2]*hp0.shape()[1])))*4 <= (size_t){{[0-9]+}}, "total memory usage at global level (compile time and runtime) should not exceed {{[0-9]+}} bytes, {{.*}}");
