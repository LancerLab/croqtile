// RUN: choreo -es %s | FileCheck %s
// REQUIRES: TARGET-GCUALL

#define PART_SIZE 1024
#define TILE_SIZE 256
__co__ void EmbeddingCacheReplaceChoreo_kernel(
    s64[capacity_in_set, set_associativity, warp_size] keys, // global key table
    f32[capacity_in_set, set_associativity, warp_size, embedding_vec_size] vals, // global value table
    u64[capacity_in_set, set_associativity, warp_size] slot_counter, // global LRU counter
    s64[len] d_keys, // input query key
    f32[len, embedding_vec_size] d_values, // input query value
    u64 global_counter, // global counter
    int dim_grid, int dim_block                    //
) {
  parallel blockIdx by dim_grid {
    parallel threadIdx by dim_block {
      // Local buffer declaration, block processing key/counter
      local s64[PART_SIZE, set_associativity, warp_size] buffer_key;
      local u64[PART_SIZE, set_associativity, warp_size] buffer_counter;
      local s64[TILE_SIZE] buffer_query;
      local u32[TILE_SIZE] buffer_src_set;
    }
  }
}

// CHECK: __global__ void __choreo_device_EmbeddingCacheReplaceChoreo_kernel(int64_t * keys, float * vals, uint64_t * slot_counter, int64_t * d_keys, float * d_values, uint64_t global_counter, int dim_grid, int dim_block, unsigned capacity_in_set, unsigned embedding_vec_size, unsigned len, unsigned set_associativity, unsigned warp_size, unsigned long mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_counter, unsigned long mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_key, unsigned long mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_query, unsigned long mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_src_set) {
// CHECK:   int64_t* buffer_key = (int64_t*)(anon_0 + mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_key);
// CHECK:   uint64_t* buffer_counter = (uint64_t*)(anon_0 + mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_counter);
// CHECK:   int64_t* buffer_query = (int64_t*)(anon_0 + mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_query);
// CHECK:   unsigned int* buffer_src_set = (unsigned int*)(anon_0 + mr_offset_EmbeddingCacheReplaceChoreo_kernel_paraby_0_paraby_1_buffer_src_set);
