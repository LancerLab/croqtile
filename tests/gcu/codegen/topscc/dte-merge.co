// ============================================================================
// Test 10: Nested loops with sync DMA inside
// fA alloc. Outer loop: fB → inner loop: fC, sync fD.
// All sequential through waits. fE after loops reuses. Total: 1 DTE.
// ============================================================================
__co__ void test_nested_loops(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    fA = dma.copy.async input => buf_a;
    wait fA;
    foreach i in 2 {
      fB = dma.copy.async buf_a => output;
      wait fB;
      foreach j in 3 {
        fC = dma.copy.async output => buf_b;
        wait fC;
        fD = dma.copy buf_b => output;
      }
    }
    fE = dma.copy.async input => buf_b;
    wait fE;
  }
}

