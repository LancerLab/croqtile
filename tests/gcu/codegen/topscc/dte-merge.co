// ============================================================================
// Test 3: Chained reuse (A→B→C share one slot)
// Verifies that stale entries from A and B don't block C from reusing.
// ============================================================================
__co__ void test_chained_reuse(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    fA = dma.copy.async input => buf_a;
    wait fA;
    fB = dma.copy.async buf_a => output;
    wait fB;
    fC = dma.copy.async output => buf_a;
    wait fC;
  }
}

// MERGE: __choreo_device_test_chained_reuse
// MERGE: tops::private_dte __dte_fA__;
// MERGE-NOT: __dte_fB__;
// MERGE-NOT: __dte_fC__;

// NOMERGE: __choreo_device_test_chained_reuse
// NOMERGE: tops::private_dte __dte_fA__;
// NOMERGE: tops::private_dte __dte_fB__;
// NOMERGE: tops::private_dte __dte_fC__;


// ============================================================================
// Test 4: Interleaved alloc/wait
// A and B in-flight together (2 slots). A waited → C reuses A's slot.
// B waited → D reuses B's slot. Total: 2 DTEs.
// ============================================================================
__co__ void test_interleaved(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    fA = dma.copy.async input => buf_a;
    fB = dma.copy.async input => buf_b;
    wait fA;
    fC = dma.copy.async buf_a => output;
    wait fB;
    fD = dma.copy.async buf_b => output;
    wait fC;
    wait fD;
  }
}

// MERGE: __choreo_device_test_interleaved
// MERGE: tops::private_dte __dte_fA__;
// MERGE: tops::private_dte __dte_fB__;
// MERGE-NOT: __dte_fC__;
// MERGE-NOT: __dte_fD__;

// NOMERGE: __choreo_device_test_interleaved
// NOMERGE: tops::private_dte __dte_fA__;
// NOMERGE: tops::private_dte __dte_fB__;
// NOMERGE: tops::private_dte __dte_fC__;
// NOMERGE: tops::private_dte __dte_fD__;


// ============================================================================
// Test 5: Loop reuse (same future name across iterations)
// fA alloc. fB in loop reuses fA's slot each iteration.
// fC after loop reuses via merge. Total: 1 DTE.
// ============================================================================
__co__ void test_loop_reuse(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    fA = dma.copy.async input => buf_a;
    wait fA;
    foreach i in 3 {
      fB = dma.copy.async buf_a => output;
      wait fB;
    }
    fC = dma.copy.async input => buf_b;
    wait fC;
  }
}

// MERGE: __choreo_device_test_loop_reuse
