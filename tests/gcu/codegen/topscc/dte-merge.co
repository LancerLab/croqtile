// NOMERGE: tops::private_dte __dte_fB__;
// NOMERGE: tops::private_dte __dte_fC__;


// ============================================================================
// Test 8: Multiple concurrent, then sequential
// fA, fB, fC all in-flight together (3 slots). All waited.
// fD, fE, fF sequential — each reuses one of the 3 slots.
// ============================================================================
__co__ void test_multi_concurrent(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    local f32 [128] buf_c;
    fA = dma.copy.async input => buf_a;
    fB = dma.copy.async input => buf_b;
    fC = dma.copy.async input => buf_c;
    wait fA;
    wait fB;
    wait fC;
    fD = dma.copy.async buf_a => output;
    wait fD;
    fE = dma.copy.async buf_b => output;
    wait fE;
    fF = dma.copy.async buf_c => output;
    wait fF;
  }
}

