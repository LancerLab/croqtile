// ============================================================================
// Test 7: Partial wait (one future kept in-flight)
// fA and fB in-flight together (2 slots). fA waited → fC reuses fA.
// fB still in-flight → its slot cannot be reused until waited.
// ============================================================================
__co__ void test_partial_wait(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    local f32 [128] buf_c;
    fA = dma.copy.async input => buf_a;
    fB = dma.copy.async input => buf_b;
    wait fA;
    fC = dma.copy.async buf_a => output;
    wait fC;
    wait fB;
  }
}

// MERGE: __choreo_device_test_partial_wait
