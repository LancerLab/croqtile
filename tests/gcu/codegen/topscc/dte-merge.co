// NOMERGE: tops::private_dte __dte_fA__;
// NOMERGE: tops::private_dte __dte_fB__;
// NOMERGE: tops::private_dte __dte_fC__;


// ============================================================================
// Test 6: Sequential with sync DMA interleaved
// fA async, waited. fB sync (no future). fC async reuses fA.
// fC waited. fD sync. fE async reuses fC. Total: 1 DTE.
// ============================================================================
__co__ void test_sync_interleaved(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    fA = dma.copy.async input => buf_a;
    wait fA;
    fB = dma.copy buf_a => output;
    fC = dma.copy.async input => buf_b;
    wait fC;
    fD = dma.copy buf_b => output;
    fE = dma.copy.async input => buf_a;
    wait fE;
  }
}

