// ============================================================================
// Test 9: Two independent sequential chains
// Chain 1: fA → fB. Chain 2: fC → fD.
// Both chains sequential, reuse same slot. Total: 1 DTE.
// ============================================================================
__co__ void test_two_chains(f32 [128] input, f32 [128] output) {
  parallel p by 1 {
    local f32 [128] buf_a;
    local f32 [128] buf_b;
    fA = dma.copy.async input => buf_a;
    wait fA;
    fB = dma.copy.async buf_a => output;
    wait fB;
    fC = dma.copy.async input => buf_b;
    wait fC;
    fD = dma.copy.async buf_b => output;
    wait fD;
  }
}

