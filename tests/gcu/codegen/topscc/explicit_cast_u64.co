// RUN: choreo -es -t topscc -arch=gcu400 %s 2>&1 | FileCheck %s

__co__ auto test_u64_s64_cast(int i, float f) {
  u64 a = __to<u64>(i);
  s64 b = __to<s64>(i);
  f32 c = __to<f32>(a);
  s32 d = __to<s32>(b);
  u64 e = __to<u64>(b);
  s64 g = __to<s64>(a);
  return d;
}

// CHECK: uint64_t a = static_cast<uint64_t>(i);
// CHECK: int64_t b = static_cast<int64_t>(i);
// CHECK: float c = static_cast<float>(a);
// CHECK: int d = static_cast<int>(b);
// CHECK: uint64_t e = static_cast<uint64_t>(b);
// CHECK: int64_t g = static_cast<int64_t>(a);
