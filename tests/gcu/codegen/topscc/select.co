// COIR: bool [[COND:v[0-9]+]] = (arg0 == {{v[0-9]+}});
// COIR: float* [[SELECTED:v[0-9]+]] = [[COND]] ? {{v[0-9]+}} : {{v[0-9]+}};
// COIR: [[SELECTED]][{{.*}}] = {{.*}};
// COIR: ({{v[0-9]+}} ? __fut_{{[0-9]+}} : __fut_{{[0-9]+}}).wait();
