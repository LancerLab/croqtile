// RUN: choreo -t topscc -es %s -o - | FileCheck %s --check-prefix=CLASSIC
// RUN: cocc -t topscc -es %s -o - | FileCheck %s --check-prefix=COIR

__co__ void select_func(f32 [32, 4] a, f32 [32, 4] b) {
  parallel p by 1 {
    f = dma.copy a => local;
    h = dma.copy a => local;
    c = select(0+1, f, h);
  }
}

__co__ void select_buffer(s32 which) {
  parallel p by 1 {
    local f32[4, 8] a, b;
    z = select(which, a, b);
    z.at(0, 0) = 1.0f;
  }
}

__co__ void select_future(s32 which, f32 [15] input) {
  parallel p by 1 {
    f0 = dma.copy.async input => local;
    f1 = dma.copy.async input => local;
    f2 = select(which, f0, f1);
    wait f2;
  }
}

