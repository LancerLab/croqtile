// RUN: choreo -t topscc -es %s -o - | FileCheck %s

#include "choreo.h"

__co__ auto foo(bf16[2, 3] i) {
  global bf16 [2,5] res;
  parallel p by 1 {
    dma.copy i => local;
    dma.pad<{0,0}, {0,2}, {0,0}, 1.2f> i => res;
  }
  return res;
}

// CHECK: __global__ void __choreo_device_foo(choreo::bf16 * i, choreo::bf16 * res) {
// CHECK:   choreo::choreo_sdte __choreo_dte_pool__[1];
// CHECK:   for (int __i = 0; __i < 1; ++__i) __choreo_dte_pool__[__i].init();
// CHECK:   __local__ __valigned__ unsigned char anon_1[512];
// CHECK:   choreo::bfloat16* anon_0 = (choreo::bfloat16*)(anon_1 + 0);
// CHECK:   choreo::future __choreo_anon_fut__0(__choreo_dte_pool__[0], "", {{[0-9]*}}, {{[0-9]*}}, anon_0);
// CHECK:   tops::mdspan __mds0_i(tops::Global, (choreo::bfloat16*)i, 2, 3);
// CHECK:   tops::mdspan __mds1_anon_0(tops::Private, (choreo::bfloat16*)anon_0, 2, 3);
// CHECK:   tops::memcpy(*__choreo_anon_fut__0.get_ctx(), __mds1_anon_0, __mds0_i);
// CHECK:   choreo::future __choreo_anon_fut__1(__choreo_dte_pool__[0], "", {{[0-9]*}}, {{[0-9]*}}, res);
// CHECK:   tops::mdspan __mds2_i(tops::Global, (choreo::bfloat16*)i, 2, 3);
// CHECK:   tops::mdspan __mds3_res(tops::Global, (choreo::bfloat16*)res, 2, 5);
// CHECK:   unsigned int __pad_low_i1[] = {0, 0};
// CHECK:   unsigned int __pad_high_i1[] = {0, 2};
// CHECK:   unsigned int __pad_mid_i1[] = {0, 0};
// CHECK:   tops::pad(*__choreo_anon_fut__1.get_ctx(), __mds3_res, __mds2_i, __pad_low_i1, __pad_high_i1, __pad_mid_i1, f32_to_bf16(1.200000f));
// CHECK: }

__co__ auto foo1(s32 [N, M] a) {
  global s32[N+1, M] res;
  parallel p by 1, q by 2 {
    f1 = dma.pad<{1,0}, {0,0}, {0,0}, -1>.async a.chunkat(_, q) => local;
    wait f1;
    dma.copy f1.data => res.chunkat(_, q);
  }
  return res;
}

// CHECK: __global__ void __choreo_device_foo1(int * a, int * res, unsigned M, unsigned N, unsigned long mr_offset_foo1_paraby_2_paraby_3_f1__buf__) {
// CHECK:   choreo::choreo_sdte __choreo_dte_pool__[2];
// CHECK:   for (int __i = 0; __i < 2; ++__i) __choreo_dte_pool__[__i].init();
// CHECK:   __local__ __valigned__ unsigned char anon_2[1572352];
// CHECK:   int* f1__buf__ = (int*)(anon_2 + mr_offset_foo1_paraby_2_paraby_3_f1__buf__);
// CHECK:   choreo::future f1(__choreo_dte_pool__[0], "f1", {{.*}}, {{.*}}, f1__buf__);
// CHECK:   if ((M / 2 - 1 + M * (N - 1) + 1 == M / 2 * N)) {
// CHECK:     tops::mdspan __mds4_a(tops::Global, (int*)a + (M / 2 * __tops_tid_x()), N, (M / 2));
// CHECK:     tops::mdspan __mds5_f1__buf__(tops::Private, (int*)f1__buf__, (N + 1), (M / 2));
// CHECK:     unsigned int __pad_low_a2[] = {1, 0};
// CHECK:     unsigned int __pad_high_a2[] = {0, 0};
// CHECK:     unsigned int __pad_mid_a2[] = {0, 0};
// CHECK:     tops::event f1__event__ = tops::pad_async(*f1.get_ctx(), __mds5_f1__buf__, __mds4_a, __pad_low_a2, __pad_high_a2, __pad_mid_a2, -1);
// CHECK:     f1.set_event(f1__event__);
// CHECK:   } else {
// CHECK:     tops::mdspan __mds6_a(tops::Global, (int*)a, N, M);
// CHECK:     tops::mdspan __mds7_f1__buf__(tops::Private, (int*)f1__buf__, (N + 1), (M / 2));
// CHECK:     unsigned int __pad_low_a3[] = {1, 0};
// CHECK:     unsigned int __pad_high_a3[] = {0, 0};
// CHECK:     unsigned int __pad_mid_a3[] = {0, 0};
// CHECK:     int __slice_offset0__a_2_f1__buf__[] = {0, (int)((M / 2 * __tops_tid_x()))};
// CHECK:     unsigned int __slice_shape1__a_2_f1__buf__[] = {static_cast<unsigned int>(N), static_cast<unsigned int>((M / 2))};
// CHECK:     tops::event f1__event__ = tops::slice_pad_async(*f1.get_ctx(), __mds7_f1__buf__, __mds6_a, __slice_offset0__a_2_f1__buf__, __slice_shape1__a_2_f1__buf__, __pad_low_a3, __pad_high_a3, __pad_mid_a3, -1);
// CHECK:     f1.set_event(f1__event__);
// CHECK:   } // end DMA opt:
// CHECK:   f1.wait();
// CHECK:   choreo::future __choreo_anon_fut__2(__choreo_dte_pool__[1], "", {{.*}}, {{.*}});
// CHECK:   if ((M / 2 - 1 + M * N + 1 == M / 2 * (N + 1))) {
// CHECK:     tops::mdspan __mds8_f1(tops::Private, (int*)f1.data(), (N + 1), (M / 2));
// CHECK:     tops::mdspan __mds9_res(tops::Global, (int*)res + (M / 2 * __tops_tid_x()), (N + 1), (M / 2));
// CHECK:     tops::memcpy(*__choreo_anon_fut__2.get_ctx(), __mds9_res, __mds8_f1);
// CHECK:   } else {
// CHECK:     tops::mdspan __mds10_f1(tops::Private, (int*)f1.data(), (N + 1), (M / 2));
// CHECK:     tops::mdspan __mds11_res(tops::Global, (int*)res, (N + 1), M);
// CHECK:     int __deslice_offset0__res_2_f1[] = {0, (int)((M / 2 * __tops_tid_x()))};
// CHECK:     tops::deslice(*__choreo_anon_fut__2.get_ctx(), __mds11_res, __mds10_f1, __deslice_offset0__res_2_f1);
// CHECK:   } // end DMA opt:
// CHECK: }

int main()
{
  {
    auto input = choreo::make_spandata<choreo::bf16>(2, 3);
    input.fill(1.5f);
    
    auto res = foo(input.view());
  
    for (int i = 0; i < res.shape()[0]; ++i) {
      for (int j = 0; j < res.shape()[1]; ++j) {
        std::cout << (float)res[i][j] << " ";
      }
      std::cout << std::endl;
    }
  }

  {
    auto input = choreo::make_spandata<choreo::s32>(4, 8);
    input.fill(99);
    
    auto res = foo1(input.view());

    assert(res.shape()[0] == 5);
    assert(res.shape()[1] == 8);
  
    for (int i = 0; i < res.shape()[0]; ++i) {
      for (int j = 0; j < res.shape()[1]; ++j) {
        if (i == 0) assert(res[i][j] == -1);
        else assert(res[i][j] == 99);
        std::cout << res[i][j] << " ";
      }
      std::cout << std::endl;
    }
  }

  return 0;
}
