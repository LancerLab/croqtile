// RUN: choreo -t topscc -arch=gcu300 -es %s -o - 2>&1 | FileCheck --check-prefix=ACORE %s
// RUN: choreo -t topscc -arch=gcu300 -es --use-target-lib=false %s -o - 2>&1 | FileCheck --check-prefix=FALLBACK %s

// Test __lib_* unary/activation builtins with target lib on (acore) and off.

__co__ void test_unary(f32 [128] input) {
  parallel p by 4 {
    in_tile = dma.copy.async input.chunkat(p) => local;
    wait in_tile;
    local f32[in_tile.span] dst;

    // Elementwise math
    __lib_abs(dst, in_tile.data, |in_tile.span|);
    __lib_neg(dst, in_tile.data, |in_tile.span|);
    __lib_sign(dst, in_tile.data, |in_tile.span|);
    __lib_sqrt(dst, in_tile.data, |in_tile.span|);
    __lib_rsqrt(dst, in_tile.data, |in_tile.span|);
    __lib_cbrt(dst, in_tile.data, |in_tile.span|);
    __lib_reciprocal(dst, in_tile.data, |in_tile.span|);
    __lib_exp(dst, in_tile.data, |in_tile.span|);
    __lib_log(dst, in_tile.data, |in_tile.span|);
    __lib_erf(dst, in_tile.data, |in_tile.span|);
    __lib_erfc(dst, in_tile.data, |in_tile.span|);
    __lib_ceil(dst, in_tile.data, |in_tile.span|);
    __lib_floor(dst, in_tile.data, |in_tile.span|);
    __lib_trunc(dst, in_tile.data, |in_tile.span|);
    __lib_round(dst, in_tile.data, |in_tile.span|);
    __lib_sin(dst, in_tile.data, |in_tile.span|);
    __lib_cos(dst, in_tile.data, |in_tile.span|);
    __lib_tan(dst, in_tile.data, |in_tile.span|);
    __lib_asin(dst, in_tile.data, |in_tile.span|);
    __lib_acos(dst, in_tile.data, |in_tile.span|);
    __lib_atan(dst, in_tile.data, |in_tile.span|);
    __lib_sinh(dst, in_tile.data, |in_tile.span|);
    __lib_cosh(dst, in_tile.data, |in_tile.span|);
    __lib_tanh(dst, in_tile.data, |in_tile.span|);

    // Unary activations (no extra params)
    __lib_relu(dst, in_tile.data, |in_tile.span|);
    __lib_gelu(dst, in_tile.data, |in_tile.span|);
    __lib_selu(dst, in_tile.data, |in_tile.span|);
    __lib_sigmoid(dst, in_tile.data, |in_tile.span|);
    __lib_silu(dst, in_tile.data, |in_tile.span|);
    __lib_swish(dst, in_tile.data, |in_tile.span|);
    __lib_softplus(dst, in_tile.data, |in_tile.span|);
    __lib_hard_swish(dst, in_tile.data, |in_tile.span|);
    __lib_mish(dst, in_tile.data, |in_tile.span|);
    __lib_quick_gelu(dst, in_tile.data, |in_tile.span|);
    __lib_log_sigmoid(dst, in_tile.data, |in_tile.span|);
  }
}

