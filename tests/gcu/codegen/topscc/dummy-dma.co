// RUN: choreo -t topscc -es %s -o - | FileCheck %s

__co__ auto foo(f32 [32, 4] a, s8 [1] b, int c) {
  parallel p by 1 {
    d = dma.any;
    with tiling in [8, 2] {
      d = dma.copy a.chunkat(tiling) => local;
    }
  }
}

// CHECK:   choreo::future d(__choreo_dte_pool__[0], "d", {{[0-9]+}}, {{[0-9]+}}, d__buf__);
// CHECK:   {
// CHECK:     tops::mdspan __mds0_a(tops::Global, (float*)a, 32, 4);
// CHECK:     tops::mdspan __mds1_d(tops::Private, (float*)d.data(), 4, 2);
// CHECK:     tops::slice(*d.get_ctx(), __mds1_d, __mds0_a, __slice_offset0__a_2_d__buf__);
// CHECK:   }
