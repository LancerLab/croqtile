// RUN: choreo -t topscc -arch=gcu300 -es %s -o - 2>&1 | FileCheck --check-prefix=ACORE %s
// RUN: choreo -t topscc -arch=gcu300 -es --use-target-lib=false %s -o - 2>&1 | FileCheck --check-prefix=FALLBACK %s

// Test __lib_* GLU-family binary activation builtins.

__co__ void test_glu(f32 [128] A, f32 [128] B) {
  parallel p by 4 {
    a_tile = dma.copy.async A.chunkat(p) => local;
    b_tile = dma.copy.async B.chunkat(p) => local;
    wait a_tile;
    wait b_tile;
    local f32[a_tile.span] dst;

    __lib_glu(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_swiglu(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_geglu(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_reglu(dst, a_tile.data, b_tile.data, |a_tile.span|);
  }
}

// ACORE: acore::glu(
// ACORE: acore::swiglu(
// ACORE: acore::geglu(
// ACORE: acore::reglu(

// FALLBACK-NOT: acore::
// FALLBACK: choreo::lib_glu<float>(
// FALLBACK: choreo::lib_swiglu<float>(
// FALLBACK: choreo::lib_geglu<float>(
// FALLBACK: choreo::lib_reglu<float>(
