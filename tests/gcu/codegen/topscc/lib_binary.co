// RUN: choreo -t topscc -arch=gcu300 -es %s -o - 2>&1 | FileCheck --check-prefix=ACORE %s
// RUN: choreo -t topscc -arch=gcu300 -es --use-target-lib=false %s -o - 2>&1 | FileCheck --check-prefix=FALLBACK %s

// Test __lib_* binary elementwise builtins.

__co__ void test_binary(f32 [128] A, f32 [128] B) {
  parallel p by 4 {
    a_tile = dma.copy.async A.chunkat(p) => local;
    b_tile = dma.copy.async B.chunkat(p) => local;
    wait a_tile;
    wait b_tile;
    local f32[a_tile.span] dst;

    __lib_add(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_sub(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_mul(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_div(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_max(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_min(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_pow(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_atan2(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_fmod(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_remainder(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_gt(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_ge(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_lt(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_le(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_eq(dst, a_tile.data, b_tile.data, |a_tile.span|);
    __lib_ne(dst, a_tile.data, b_tile.data, |a_tile.span|);
  }
}

