// RUN: choreo -es -t topscc %s -o - | FileCheck %s

__co__  void foo(f32 [24] a) {
  parallel p by 6 {
    shared event ep, ec;
    trigger ec;
    pred = p >= 3;
    inthreads.async (pred) { wait ec; trigger ep; }; // an event is set after all stmts are executed
    inthreads.async (!pred) { wait ep; trigger ec;}; // all the stmts can not execute until event is set
    sync.barrier : block;
  }
}

// CHECK: __global__ void __choreo_device_foo(float * a) {
// CHECK:   __shared__ __volatile__ bool ep; // shared event
// CHECK:   ep = false;
// CHECK:   __shared__ __volatile__ bool ec; // shared event
// CHECK:   ec = false;
// CHECK:   ec = true;
// CHECK:   bool pred = (__tops_tid_x() >= 3);
// CHECK:   if ((__tops_tid_x() >= 3)) {
// CHECK:     while (ec == false) continue; // spinlock
// CHECK:     ec = false; // reset event
// CHECK:     ep = true;
// CHECK:   } // end inthreads
// CHECK:   if ((!(__tops_tid_x() >= 3))) {
// CHECK:     while (ep == false) continue; // spinlock
// CHECK:     ep = false; // reset event
// CHECK:     ec = true;
// CHECK:   } // end inthreads
// CHECK:   __syncthreads(); // sync.barrier:block degraded
// CHECK: }

__co__  void eventarray(f32 [24] a) {
  parallel p by 6 {
    shared event e1[2], e2[3][4], e3[1][2][3];
    trigger e2;
    wait e2[0];
    wait e2[2][3];
    trigger e1[0], e2[1];
    wait e1[0], e2[1];
    trigger e2[0][0], e3[0], e3[0][1];
    wait e2[0][0], e3[0], e3[0][1];
  }
}

// CHECK:   __shared__ __volatile__ bool e1[2]; // shared event
// CHECK:   e1[0] = false;
// CHECK:   e1[1] = false;

// CHECK:   __shared__ __volatile__ bool e2[3][4]; // shared event
// CHECK:   e2[0][0] = false;
// CHECK:   e2[0][1] = false;
// CHECK:   e2[0][2] = false;
// CHECK:   e2[0][3] = false;
// CHECK:   e2[1][0] = false;
// CHECK:   e2[1][1] = false;
// CHECK:   e2[1][2] = false;
// CHECK:   e2[1][3] = false;
// CHECK:   e2[2][0] = false;
// CHECK:   e2[2][1] = false;
// CHECK:   e2[2][2] = false;
// CHECK:   e2[2][3] = false;

// CHECK:   __shared__ __volatile__ bool e3[1][2][3]; // shared event
// CHECK:   e3[0][0][0] = false;
// CHECK:   e3[0][0][1] = false;
// CHECK:   e3[0][0][2] = false;
// CHECK:   e3[0][1][0] = false;
// CHECK:   e3[0][1][1] = false;
// CHECK:   e3[0][1][2] = false;

// CHECK:   e2[0][0] = true;
// CHECK:   e2[0][1] = true;
// CHECK:   e2[0][2] = true;
// CHECK:   e2[0][3] = true;
// CHECK:   e2[1][0] = true;
// CHECK:   e2[1][1] = true;
// CHECK:   e2[1][2] = true;
// CHECK:   e2[1][3] = true;
// CHECK:   e2[2][0] = true;
// CHECK:   e2[2][1] = true;
// CHECK:   e2[2][2] = true;
// CHECK:   e2[2][3] = true;

// CHECK:   while (!e2[0][0] || !e2[0][1] || !e2[0][2] || !e2[0][3] || false) continue;
// CHECK:   e2[0][0] = false;
// CHECK:   e2[0][1] = false;
// CHECK:   e2[0][2] = false;
// CHECK:   e2[0][3] = false;

// CHECK:   while (!e2[2][3] || false) continue;
// CHECK:   e2[2][3] = false;

// CHECK:   e1[0] = true;
// CHECK:   e2[1][0] = true;
// CHECK:   e2[1][1] = true;
// CHECK:   e2[1][2] = true;
// CHECK:   e2[1][3] = true;

// CHECK:   while (!e1[0] || false) continue;
// CHECK:   e1[0] = false;

// CHECK:   while (!e2[1][0] || !e2[1][1] || !e2[1][2] || !e2[1][3] || false) continue;
// CHECK:   e2[1][0] = false;
// CHECK:   e2[1][1] = false;
// CHECK:   e2[1][2] = false;
// CHECK:   e2[1][3] = false;

// CHECK:   e2[0][0] = true;

// CHECK:   e3[0][0][0] = true;
// CHECK:   e3[0][0][1] = true;
// CHECK:   e3[0][0][2] = true;
// CHECK:   e3[0][1][0] = true;
// CHECK:   e3[0][1][1] = true;
// CHECK:   e3[0][1][2] = true;

// CHECK:   e3[0][1][0] = true;
// CHECK:   e3[0][1][1] = true;
// CHECK:   e3[0][1][2] = true;

// CHECK:   while (!e2[0][0] || false) continue;
// CHECK:   e2[0][0] = false;

// CHECK:   while (!e3[0][0][0] || !e3[0][0][1] || !e3[0][0][2] || !e3[0][1][0] || !e3[0][1][1] || !e3[0][1][2] || false) continue;
// CHECK:   e3[0][0][0] = false;
// CHECK:   e3[0][0][1] = false;
// CHECK:   e3[0][0][2] = false;
// CHECK:   e3[0][1][0] = false;
// CHECK:   e3[0][1][1] = false;
// CHECK:   e3[0][1][2] = false;

// CHECK:   while (!e3[0][1][0] || !e3[0][1][1] || !e3[0][1][2] || false) continue;
// CHECK:   e3[0][1][0] = false;
// CHECK:   e3[0][1][1] = false;
// CHECK:   e3[0][1][2] = false;

