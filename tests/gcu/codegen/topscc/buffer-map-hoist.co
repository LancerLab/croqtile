// RUN: choreo -t topscc -es -arch=gcu300 %s -o - | FileCheck %s
// RUN: cocc -t topscc -es -arch=gcu300 %s -o - | FileCheck %s --check-prefix=COIR
// RUN: choreo -t topscc -es -arch=gcu300 --no-map-hoist %s -o - | FileCheck %s --check-prefix=NO_HOIST

// A loop-invariant buffer.map inside a foreach must be hoisted out of the
// loop, so the map is emitted exactly once BEFORE the loop and its matching
// unmap sinks out of the loop and is emitted exactly once AFTER it. When
// --no-map-hoist is passed, the map must stay inside the loop instead.

#include "choreo.h"

__co__ s32 [128] buffer_map_hoist(s32 [128] input) {
  s32[input.span] output;

  parallel p by 1 {
    local s32[|input.span|] local_out;
    foreach {i} in [|input.span|] {
      mapped_input = input.map<local>(0, |input.span|);
      local_out.at(i) = mapped_input.data.at(i) + 2;
    }
    dma.copy local_out => output;
  }

  return output;
}

