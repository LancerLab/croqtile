// RUN: choreo -t topscc -es -dp=memreuse %s -o - | FileCheck %s
__co__ auto foo(f32 [32, 4] a) {
  f32 [a.span + {1, 1}] data;
  parallel p by 2 {
    shared f32 [a.span] b;
    local f32 [a.span] c;
    local s32 [a.span] c_s32;
    dma.copy a => b;
    f0 = dma.copy.async b => c;
    wait f0; 
    dma.transp<1,0> c => local;
  }
  return data;
}

// CHECK: __global__ void __choreo_device_foo(float * a, float * data) {
// CHECK:   choreo::choreo_sdte __choreo_dte_pool__[2];
// CHECK:   for (int __i = 0; __i < 2; ++__i) __choreo_dte_pool__[__i].init();
// CHECK:   __shared__ float b[128];
// CHECK:   __local__ __valigned__ float c[128];
// CHECK:   __local__ __valigned__ int c_s32[128];
// CHECK:   choreo::choreo_cdte_priv choreo_topscc_ctx0;
// CHECK:   choreo::future __choreo_anon_fut__0(choreo_topscc_ctx0, "", {{[0-9]+}}, {{[0-9]+}}, b);
// CHECK:   tops::mdspan __mds0_a(tops::Global, (float*)a, 32, 4);
// CHECK:   tops::mdspan __mds1_b(tops::Shared, (float*)b, 32, 4);
// CHECK:   tops::memcpy(*__choreo_anon_fut__0.get_ctx(), __mds1_b, __mds0_a);
// CHECK:   choreo::future f0(__choreo_dte_pool__[0], "f0", {{[0-9]+}}, {{[0-9]+}}, c);
// CHECK:   tops::mdspan __mds2_b(tops::Shared, (float*)b, 32, 4);
// CHECK:   tops::mdspan __mds3_c(tops::Private, (float*)c, 32, 4);
// CHECK:   tops::event f0__event__ = tops::memcpy_async(*f0.get_ctx(), __mds3_c, __mds2_b);
// CHECK:   f0.set_event(f0__event__);
// CHECK:   f0.wait();
// CHECK:   __local__ __valigned__ float anon_0[128];
// CHECK:   choreo::future __choreo_anon_fut__1(__choreo_dte_pool__[1], "", {{[0-9]*}}, {{[0-9]*}}, anon_0);
// CHECK:   tops::mdspan __mds4_c(tops::Private, (float*)c, 32, 4);
// CHECK:   tops::mdspan __mds5_anon_0(tops::Private, (float*)anon_0, 4, 32);
// CHECK:   int __transpose_layout0__c[] = {1, 0};
// CHECK:   tops::transpose(*__choreo_anon_fut__1.get_ctx(), __mds5_anon_0, __mds4_c, __transpose_layout0__c);
// CHECK: }
