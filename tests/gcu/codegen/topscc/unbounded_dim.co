// RUN: choreo %s -es -o - | FileCheck %s
// REQUIRES: TARGET-GCUALL

__co__ void foo(global f32 [M, ??] data) {
  parallel p by 1
    dma.copy data.subspan(7, 4).at(p, p) => local;
}

int main() {
  float* d = nullptr;
  topsMalloc(&d, 700);
  foo(choreo::make_spanview<2>(d, {7, 100}));
}

// CHECK:   tops::mdspan __mds0_data(tops::Global, (float*)data, M, -1);
// CHECK: choreo::runtime_check(data.shape()[1] == choreo::__inf__, "must set 'choreo::__inf__' to the unbounded dimension on the 1st parameter ('data', dim: 1): got " + std::to_string(data.shape()[1]) + ".");
