// RUN: choreo -es -t topscc %s -o - | FileCheck %s

__co__ void ml() {
  parallel p = {x, y, z} by [1, 1, 2], {o, r, s} by [2, 2, 3] {
  }
  parallel p = {x, y, z} by [1, 2, 1], q by 7 {
  }
}

// CHECK: void ml() {
// CHECK:   dim3 __ml_gdims0(1, 1, 2);
// CHECK:   dim3 __ml_bdims0(2, 2, 3);
// CHECK:   __choreo_device_ml0<<<__ml_gdims0, __ml_bdims0>>>();
// CHECK:   dim3 __ml_gdims1(1, 2, 1);
// CHECK:   dim3 __ml_bdims1(7, 1, 1);
// CHECK:   __choreo_device_ml1<<<__ml_gdims1, __ml_bdims1>>>();
// CHECK: }
