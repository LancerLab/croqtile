// FALLBACK: choreo::lib_reduce_sum<float>(
// FALLBACK: choreo::lib_reduce_max<float>(
// FALLBACK: choreo::lib_reduce_min<float>(
// FALLBACK: choreo::lib_reduce_prod<float>(
// FALLBACK: choreo::lib_reduce_mean<float>(
