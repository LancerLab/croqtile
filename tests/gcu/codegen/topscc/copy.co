// RUN: choreo -t topscc -es --use-hetero-tileflow -dp=memreuse %s -o - | FileCheck %s --check-prefix=CHECK-HT
// RUN: choreo -t topscc -es -dp=memreuse %s -o - | FileCheck %s --check-prefix=CHECK-NHT
__co__ auto foo(f32 [32, 4] a) {
  f32 [a.span] data;
  dma.copy a => data;
  parallel p by 2 {
    dma.copy data.chunkat(p, p) => local;
  }
  return data;
}


// CHECK-HT: __global__ void __choreo_device_foo(float * a, float * data) {
// CHECK-HT:   __local__ __valigned__ float anon_0[32];
// CHECK-HT:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK-HT:   tops::mdspan __mds0_data(tops::Global, (float*)data, 32, 4);
// CHECK-HT:   tops::mdspan __mds1_anon_0(tops::Private, (float*)anon_0, 16, 2);
// CHECK-HT:   int __slice_offset0__data_2_anon_0[] = {(int)((__tops_tid_x() * 16)), (int)((__tops_tid_x() * 2))};
// CHECK-HT:   tops::slice(*__choreo_anon_fut__0.get_ctx(), __mds1_anon_0, __mds0_data, __slice_offset0__data_2_anon_0);
// CHECK-HT: }

// CHECK-HT: choreo::spanned_data<choreo::f32, 2> foo(const choreo::spanned_view<choreo::f32, 2> & a) {
// CHECK-HT:   choreo::runtime_check(a.shape()[0] == 32, "shape inconsistent on the 1st parameter ('a', dim: 0)
// CHECK-HT:   choreo::runtime_check(a.shape()[1] == 4, "shape inconsistent on the 1st parameter ('a', dim: 1)
// CHECK-HT:   float * a__device = nullptr;
// CHECK-HT:   choreo::abend_true(topsMalloc(&a__device, 512ULL));
// CHECK-HT:   choreo::abend_true(topsMemcpy(a__device, a.data(), 512ULL, topsMemcpyHostToDevice));
// CHECK-HT:   auto data = choreo::make_spandata<choreo::f32, 2>({32, 4});
// CHECK-HT:   float * data__device = nullptr;
// CHECK-HT:   choreo::abend_true(topsMalloc(&data__device, 512ULL));
// CHECK-HT:   float * data__device = a__device;
// CHECK-HT:   dim3 __foo_gdims0(1, 1, 1);
// CHECK-HT:   dim3 __foo_bdims0(2, 1, 1);
// CHECK-HT:   __choreo_device_foo<<<__foo_gdims0, __foo_bdims0>>>(a__device, data__device);
// CHECK-HT:   choreo::abend_true(topsMemcpy(data.data(), data__device, 512ULL, topsMemcpyDeviceToHost));
// CHECK-HT:   return data;
// CHECK-HT: }

// CHECK-NHT: __global__ void __choreo_device_foo(float * a, float * data) {
// CHECK-NHT:   __local__ __valigned__ float anon_0[32];
// CHECK-NHT:   tops_dte_ctx_t choreo_topscc_ctx0;
// CHECK-NHT:   choreo::future __choreo_anon_fut__0(choreo_topscc_ctx0, "", 7, 5, anon_0);
// CHECK-NHT:   tops::mdspan __mds0_data(tops::Global, (float*)data, 32, 4);
// CHECK-NHT:   tops::mdspan __mds1_anon_0(tops::Private, (float*)anon_0, 16, 2);
// CHECK-NHT:   int __slice_offset0__data_2_anon_0[] = {(int)((__tops_tid_x() * 16)), (int)((__tops_tid_x() * 2))};
// CHECK-NHT:   tops::slice(*__choreo_anon_fut__0.get_ctx(), __mds1_anon_0, __mds0_data, __slice_offset0__data_2_anon_0);
// CHECK-NHT: }

// CHECK-NHT: choreo::spanned_data<choreo::f32, 2> foo(const choreo::spanned_view<choreo::f32, 2> & a) {
// CHECK-NHT:   choreo::runtime_check(a.shape()[0] == 32, "shape inconsistent on the 1st parameter ('a', dim: 0)
// CHECK-NHT:   choreo::runtime_check(a.shape()[1] == 4, "shape inconsistent on the 1st parameter ('a', dim: 1)
// CHECK-NHT:   float * a__device = nullptr;
// CHECK-NHT:   choreo::abend_true(topsMalloc(&a__device, 512ULL));
// CHECK-NHT:   choreo::abend_true(topsMemcpy(a__device, a.data(), 512ULL, topsMemcpyHostToDevice));
// CHECK-NHT:   auto data = choreo::make_spandata<choreo::f32, 2>({32, 4});
// CHECK-NHT:   float * data__device = nullptr;
// CHECK-NHT:   choreo::abend_true(topsMalloc(&data__device, 512ULL));
// CHECK-NHT:   choreo::abend_true(topsMemcpy(data__device, a__device, 512ULL, topsMemcpyDeviceToDevice));
// CHECK-NHT:   dim3 __foo_gdims0(1, 1, 1);
// CHECK-NHT:   dim3 __foo_bdims0(2, 1, 1);
// CHECK-NHT:   __choreo_device_foo<<<__foo_gdims0, __foo_bdims0>>>(a__device, data__device);
// CHECK-NHT:   choreo::abend_true(topsDeviceSynchronize());
// CHECK-NHT:   choreo::abend_true(topsMemcpy(data.data(), data__device, 512ULL, topsMemcpyDeviceToHost));
// CHECK-NHT:   choreo::abend_true(topsFree(a__device));
// CHECK-NHT:   choreo::abend_true(topsFree(data__device));
// CHECK-NHT:   return data;
// CHECK-NHT: }
