// RUN: not choreo -t topscc -arch=gcu300 -es %s -o - 2>&1 | FileCheck %s

// Test that unsupported MMA tile sizes are rejected on GCU target.
// acore::matmul supports static M in {1, 16, 32, 49, 64, 96, 128, 256}
// (M=512/1024 are addmm-only) or 64-aligned for dynamic M.
// M=48 is not in either set.

__co__ void mma_bad_size(f16 [48, 256] A, f16 [256, 256] B) {
  parallel p by 1, q by 1 {
    local f16[48, 256] lhs;
    local f16[256, 256] rhs;
    local f16[48, 256] out;
    dma.copy A => lhs;
    dma.copy B => rhs;
    mc = mma.fill 0;
    foreach k in [1] {
      ma = mma.load lhs.chunkat(p, k);
      mb = mma.load rhs.chunkat(k, q);
      mma.row.col mc, ma, mb;
    }
    mma.store mc, out.chunkat(p, q);
  }
}

// CHECK: MMA config {{.*}} is not supported by acore
