// RUN: choreo %s -dvec | FileCheck %s
// RUN: choreo %s -es | FileCheck %s --check-prefix=CODEGEN
#define I 32
#define J 256
#define K 768

#define NUM_BLOCK 2
// TODO: make it 12
#define NUM_THREAD 8 

__co__ auto sigmoid(f32 [I, J, K] lhs) {
  f32 [lhs.span] out;
  parallel p by NUM_BLOCK, q by NUM_THREAD {
    foreach r in [4] {
      lfl = dma.copy lhs.chunkat(p,q,r) => local;
      local f32 [lfl.span] lout;
      foreach index = {i, j, k} in lfl.span: vectorize(k, 32)
        lout.at(index) = 1.0f / (1.0f + __exp(0.0f - lfl.data.at(index)));
      dma.copy lout => out.chunkat(p,q,r);
    }
  }
  return out;
}


int main() {
  auto a = choreo::make_spandata<choreo::f32>(I, J, K);
  a.fill_random(-1.0, 1.0);

  auto res = sigmoid(a.view());
  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j)
      for (size_t k = 0; k < res.shape()[2]; ++k) {
        auto sm = 1.0f / (1.0f + expf(-a[i][j][k]));
        if (fabs(sm - res[i][j][k]) > 0.001f) {
          std::cout << sm << " != " << res[i][j][k] << "\n";
          choreo::choreo_assert(sm == res[i][j][k], "values are not equal.");
        }
      }

  std::cout << "Passed.\n";
}
// CHECK: call:  widen `__exp(CAST(f32=>f32: ' (0.000000f - lfl.data[index]) ') )`, type: mutable vector<f32,32>
// CODEGEN: __vector float anon_1 = 1.000000f / (1.000000f + tcle::exp(0.000000f - tcle::load<__vector float>((__TCLE_AS__ char *)((float *)lfl.data() + (__iv_i * 6144) + (__iv_j * 192) + __vec_iv_k[0]))));
// CODEGEN: tcle::store(anon_1, (__TCLE_AS__ char *)((float *)lout + (__iv_i * 6144) + (__iv_j * 192) + __vec_iv_k[0]));

