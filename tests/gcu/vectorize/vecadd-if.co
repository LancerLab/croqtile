// REQUIRES: TARGET-GCU300
// RUN: choreo -es %s | FileCheck %s --check-prefix=CODEGEN

#define N 4
#define M 512

__co__ auto vecadd(f32 [N, M] a, f32 [N, M] b)  {
  f32 [a.span] c;
  parallel p by 1, q by 1 {
    l1_a = dma.copy a.chunkat(p, q) => local;
    l1_b = dma.copy b.chunkat(p, q) => local;

    local f32[l1_a.span(0), l1_a.span(1)] l1_c;
    foreach {i, j} in [l1_a.span(0), l1_a.span(1)]: vectorize(j, 32) {
      f32 val = 0.0f;
      if (i * M + j < 2000)
        val = l1_a.data.at(i, j) + l1_b.data.at(i, j);
      l1_c.at(i, j) = val;
    }

    out_store = dma.copy l1_c => c.chunkat(p, q);
  }
  return c;
}

int main() { /// host program
  auto a = choreo::make_spandata<choreo::f32>(N, M);
  auto b = choreo::make_spandata<choreo::f32>(N, M);
  a.fill_random(-10.0f, 10.0f);
  b.fill_random(-10.0f, 10.0f);

  auto res = vecadd(a.view(), b.view());
  
  // verification
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j) {
      auto index = i * M + j;
      auto ref = index < 2000? (a[i][j] + b[i][j]) : 0.0f;
      if (ref != res[i][j]) {
        choreo::choreo_assert(a[i][j] + b[i][j] == res[i][j], "values are not equal.");
      }
    }

  std::cout << "Test Passed\n" << std::endl;
}

