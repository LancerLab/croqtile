// TODO: choreo -t factor -vn -sa=valno -sa=valno %s | FileCheck --match-full-lines %s
// RUN: choreo -t factor -dv=symrepl -sa=symrepl %s | FileCheck --check-prefix=SYMRP %s

__co__ auto foo0(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32 [(M + N) + K, (M * N) * K, M * (N + K)]   o1;
  s32 [M + (N + K), M * (N * K), M * N + M * K] o2;
  s32 [N + K + M,   N * K * M,   K * M + N * M] o3;
// CHECK: Alias "::foo0::o1.span" -> [[VN0:\#[0-9]+]]
// CHECK: Alias "::foo0::o2.span" -> [[VN0]]
// CHECK: Alias "::foo0::o3.span" -> [[VN0]]
// SYMRP: REPLACE  (M +  (N + K) )  WITH  ( (M + N)  + K) 
// SYMRP: REPLACE  (M *  (N * K) )  WITH  ( (M * N)  * K) 
// SYMRP: REPLACE  ( (M * N)  +  (M * K) )  WITH  (M *  (N + K) ) 
// SYMRP: REPLACE  ( (N + K)  + M)  WITH  ( (M + N)  + K) 
// SYMRP: REPLACE  ( (N * K)  * M)  WITH  ( (M * N)  * K) 
// SYMRP: REPLACE  ( (K * M)  +  (N * M) )  WITH  (M *  (N + K) ) 

  s32 [M - (N - K)] o4;
  s32 [M - N + K  ] o5;
// CHECK: Alias "::foo0::o4.span" -> [[VN01:\#[0-9]+]]
// CHECK: Alias "::foo0::o5.span" -> [[VN01]]
// SYMRP: REPLACE  ( (M - N)  + K)  WITH  (M -  (N - K) ) 

  s32 [M / N * M] o6;
  s32 [M * M / N] o7;
// CHECK: Alias "::foo0::o6.span" -> [[VN02:\#[0-9]+]]
// CHECK-NOT: Alias "::foo0::o7.span" -> [[VN02]]

  s32 [M / N + 16, M % N + 32] o8;
  s32 [16 + M / N, 32 + M % N] o9;
// CHECK: Alias "::foo0::o8.span" -> [[VN03:\#[0-9]+]]
// CHECK: Alias "::foo0::o9.span" -> [[VN03]]
// SYMRP: REPLACE  (16 +  (M / N) )  WITH  ( (M / N)  + 16)
// SYMRP: REPLACE  (32 +  (M % N) )  WITH  ( (M % N)  + 32)
}

__co__ auto foo1(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32 [M+K+N, K+M+N]     output1;
  s32 [K+(N+M), M+(K+N)] output2;
// CHECK: New VN [[VN1:\#[0-9]+]]: '[[VN10:\#[0-9]+]],[[VN10]]'
// CHECK: Alias "[[VN10]],[[VN10]](0)" -> [[VN10]]
// CHECK: Alias "[[VN10]],[[VN10]](1)" -> [[VN10]]
// CHECK: Alias "::foo1::output1.span" -> [[VN1]]
// CHECK: Alias "::foo1::output2.span" -> [[VN1]]
// SYMRP: REPLACE  ( (K + M)  + N)  WITH  ( (M + K)  + N) 
// SYMRP: REPLACE  (K +  (N + M) )  WITH  ( (M + K)  + N) 
// SYMRP: REPLACE  (M +  (K + N) )  WITH  ( (M + K)  + N)
}

__co__ auto foo2(s32 [6, ?, 128] lhs, s32 [6, ?, 128] rhs) {
  s32 [lhs.span(0), 2*lhs.span(1), lhs.span(2)]             output1;
  s32 [lhs.span(0), lhs.span(1)*2, lhs.span(2)]             output2;
  s32 [lhs.span(0), lhs.span(1) + lhs.span(1), lhs.span(2)] output3;
// CHECK: Alias "::foo2::output1.span" -> [[VN2:\#[0-9]+]]
// CHECK: Alias "::foo2::output2.span" -> [[VN2]]
// CHECK: Alias "::foo2::output3.span" -> [[VN2]]
// SYMRP: REPLACE  (lhs.span(1) * 2)  WITH  (2 * lhs.span(1)) 
// SYMRP: REPLACE  (lhs.span(1) + lhs.span(1))  WITH  (2 * lhs.span(1))
}

__co__ auto foo3(s32 [M, K] lhs, s32 [K, N] rhs) {

  s32[(M+N) * (K+N)]         output1;
  s32[M*K + M*N + N*K + N*N] output2;
// CHECK: Alias "::foo3::output1.span" -> [[VN3:\#[0-9]+]]
// CHECK: Alias "::foo3::output2.span" -> [[VN3]]
// SYMRP: REPLACE  ( ( ( (M * K)  +  (M * N) )  +  (N * K) )  +  (N * N) )  WITH  ( (M + N)  *  (K + N) )
}

__co__ auto foo4(s32 [M, K] lhs, s32 [K, N] rhs, int c) {
  s32[M * (K+N), M*K + M*N] output3;
  s32[M * (N+K), K*M + N*M] output4;
// CHECK: New VN [[VN4:\#[0-9]+]]: '[[VN40:\#[0-9]+]],[[VN40]]'
// CHECK: Alias "[[VN40]],[[VN40]](0)" -> [[VN40]]
// CHECK: Alias "[[VN40]],[[VN40]](1)" -> [[VN40]]
// CHECK: Alias "::foo4::output3.span" -> [[VN4]]
// CHECK: Alias "::foo4::output4.span" -> [[VN4]]
// SYMRP: REPLACE  ( (M * K)  +  (M * N) )  WITH  (M *  (K + N) )
// SYMRP: REPLACE  (M *  (N + K) )  WITH  (M *  (K + N) ) 
// SYMRP: REPLACE  ( (K * M)  +  (N * M) )  WITH  (M *  (K + N) )
}

__co__ void foo5(s32[1,2,3] lhs, s32[1,2,1] rhs, int a, int b, int c) {
  s32 [|lhs.span| + 5, |lhs.span * 2| + 5, |lhs.span| + |rhs.span|] o1;
  s32 [5 + |lhs.span|, 5 + |2 * lhs.span|, |rhs.span| + |lhs.span|] o2;
// CHECK: Alias "::foo5::o1.span" -> [[VN5:\#[0-9]+]]
// CHECK: Alias "::foo5::o2.span" -> [[VN5]]
// SYMRP: REPLACE  (5 +  (sizeof lhs.span) )  WITH  ( (sizeof lhs.span)  + 5) 
// SYMRP: REPLACE  (5 +  (sizeof  (2 * lhs.span) ) )  WITH  ( (sizeof  (lhs.span * 2) )  + 5) 
// SYMRP: REPLACE  ( (sizeof rhs.span)  +  (sizeof lhs.span) )  WITH  ( (sizeof lhs.span)  +  (sizeof rhs.span) )

  int x4 = 5;
  int y4 = 10;
  int p4 = (x4 < y4+1) ? x4+100 : y4+100;
  int q4 = (y4+1 > x4) ? x4+100 : y4+100;
// CHECK: <Simplify> '{{.*}} < {{.*}}' to 'true'
// CHECK: Alias "::foo5::p4" -> [[VN7:\#[0-9]+]]
// `>` is canonicalized to `<`
// CHECK: <Simplify> '{{.*}} < {{.*}}' to 'true'
// CHECK: Alias "::foo5::q4" -> [[VN7]]
// SYMRP: REPLACE  ( ( (y4 + 1)  > x4)  ?  (x4 + 100)  :  (y4 + 100) )  WITH  ( (x4 <  (y4 + 1) )  ?  (x4 + 100)  :  (y4 + 100) )

  int m4 = (x4 <= y4+2) ? x4+200 : y4+200;
  int n4 = (y4+2 >= x4) ? x4+200 : y4+200;
// CHECK: <Simplify> '{{.*}} <= {{.*}}' to 'true'
// CHECK: Alias "::foo5::m4" -> [[VN71:\#[0-9]+]]
// `>=` is canonicalized to `<=`
// CHECK: <Simplify> '{{.*}} <= {{.*}}' to 'true'
// CHECK: Alias "::foo5::n4" -> [[VN71]]
// SYMRP: REPLACE  ( ( (y4 + 2)  >= x4)  ?  (x4 + 200)  :  (y4 + 200) )  WITH  ( (x4 <=  (y4 + 2) )  ?  (x4 + 200)  :  (y4 + 200) )

  ituple<3> x5 = {c*2, a+b, b*c};
  ituple<3> y5 = {2*c, b+a, c*b};
// CHECK: Alias "::foo5::x5" -> [[VN8:\#[0-9]+]]
// CHECK: Alias "::foo5::y5" -> [[VN8]]
// SYMRP: REPLACE  (2 * c)  WITH  (c * 2) 
// SYMRP: REPLACE  (b + a)  WITH  (a + b) 
// SYMRP: REPLACE  (c * b)  WITH  (b * c)

  // ituple<3> z5 = {c, 1, 2};
  // TODO: z5+z5 <=> x5 <=> y5
  // maybe handle it in valno pass.

}

__co__ void foo6(int a, int x) {
  int c = 5 + a;
  int ref = c;
  int b1 = x * (a + ref + 10);
  int b2 = x * a + 5 * x + a * x + x * 10;
// CHECK: Alias "::foo6::b1" -> [[VN9:\#[0-9]+]]
// CHECK: Alias "::foo6::b2" -> [[VN9]]
// SYMRP: REPLACE c WITH  (5 + a) 
// SYMRP: REPLACE  ( ( ( (x * a)  +  (5 * x) )  +  (a * x) )  +  (x * 10) )  WITH  (x *  ( (a + ref)  + 10) )
}

__co__ void foo7() {
  with {p, q} in [16, 32] {
    foreach p, q {
      shared s32 [#p + 1, #q * 2] s_output1;
      shared s32 [1 + #p, 2 * #q] s_output2;
    }
  }
// CHECK: Alias "::foo7::within_0::foreach_0::s_output1.span" -> [[VN10:\#[0-9]+]]
// CHECK: Alias "::foo7::within_0::foreach_0::s_output2.span" -> [[VN10]]
// SYMRP: REPLACE  (1 +  (ubound p) )  WITH  ( (ubound p)  + 1) 
// SYMRP: REPLACE  (2 *  (ubound q) )  WITH  ( (ubound q)  * 2)
}

__co__ void foo8(int a, int b, int c) {
  mds1 : [a*b, b+c, c*(a+b)];
  mds2 : [b*a, c+b, c*b + a*c];
  s32 [mds1] o1;
  s32 [mds2] o2;
// CHECK: Alias "::foo8::mds1" -> [[VN11:\#[0-9]+]]
// CHECK: Alias "::foo8::mds2" -> [[VN11]]
// CHECK: Alias "::foo8::o1.span" -> [[VN11]]
// CHECK: Alias "::foo8::o2.span" -> [[VN11]]
// SYMRP: REPLACE  (b * a)  WITH  (a * b) 
// SYMRP: REPLACE  (c + b)  WITH  (b + c) 
// SYMRP: REPLACE  ( (c * b)  +  (a * c) )  WITH  (c *  (a + b) )
}

__co__ void foo9(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32 [cdiv(M+5, K*2)] o5;
  s32 [cdiv(5+M, 2*K)] o6;
// SYMRP: REPLACE  ( (5 + M)  cdiv  (2 * K) )  WITH  ( (M + 5)  cdiv  (K * 2) )
}

__co__ void noReplace(s32 [M, K] lhs, s32 [K, N] rhs) {
  s32 [M % K] o1;
  s32 [K % M] o2;
  s32 [cdiv(M, K)] o3;
  s32 [M / K]      o4;
// SYMRP-NOT: REPLACE
}
