// RUN: choreo -t topscc %s -es -o - 2>&1 |FileCheck %s

__co__ void foo() {
  parallel p by 2
    foreach k in 24
    parallel q by #k / 3;
}

__co__ void bar() {
  parallel p by 2
    foreach k in [24]
    parallel q by #k / 3;
}

__co__ void baz() {
  parallel p by 2
    foreach {k} in [24]
    parallel q by #k / 3;
}

// CHECK-NOT: error:
