
// RUN: choreo -es -fopt-dma=false %s | FileCheck --match-full-lines %s

__co__ auto matmul(f16[M, K] lhs, f16[K, N] rhs) {
  f16[M, N] output;

  // The tile size of l1
  // lhs -> (mLLen, kLLen)
  // rhs -> (kLLen, nLLen)
  // acc -> (mLLen, nLLen)
  mLLen = 256;
  nLLen = 1024;
  kLLen = 384;
  mLCnt = 16; // 16 = 4 * mq(4)
  nLCnt = 3; // 6 = 1 * p(2) * nq(3)
  kLCnt = 12;

  // The tile size of l2
  // lhs -> (mSLen, kSLen)
  // rhs -> (kSLen, nSLen)
  // acc -> (mSLen, nSLen)
  mSLen = mLLen * mLCnt;
  nSLen = nLLen * nLCnt;
  kSLen = kLLen * kLCnt;

  mSRem = M % mSLen;
  nSRem = N % nSLen;
  kSRem = K % kSLen;
  mLRem = M % mLLen;
  nLRem = N % nLLen;
  kLRem = K % kLLen;
  mLPad = mLLen - mLRem;
  nLPad = nLLen - nLRem;
  kLPad = kLLen - kLRem;

  parallel p by 2, {mq, nq} by [4, 3] {
    with ms in [M / mSLen] foreach ms(:1:) {
      with ns in [N / (nSLen * #p)] foreach ns(:1:) {
        with ml in [mSLen / (mLLen * #mq)] foreach ml {
          with nl in [nSLen / (nLLen * #nq)] foreach nl {
            local f16[mLLen, nLLen] acc{0};
            with ks in [K / kSLen] foreach ks(:1:) {
              lhsS = dma.copy.async lhs.subspan(mSLen, K).at(ms, 0).modspan(_, kSLen).at(0, ks) => shared;
              rhsS = dma.copy.async rhs.subspan(K, nSLen).at(0, ns # p).modspan(kSLen, _).at(ks, 0) => shared;
              wait lhsS, rhsS;
              with kl in [kSRem / kLLen] foreach kl(:1:) {
                lhsL = dma.pad<{0, 0}, {0, kLPad}, {0, 0}, 0>.async lhsS.chunkat(ml # mq, _).modspan(_, kLLen).at(0, kl) => local;
                lhsL2 = dma.pad<{0, 0}, {0, kLPad}, {0, 0}, 0> lhsS.chunkat(ml # mq, _).modspan(_, kLLen).at(0, kl) => local;
                rhsL = dma.pad<{0, 0}, {kLPad, 0}, {0, 0}, 0>.async rhsS.data.chunkat(_, nl # nq).modspan(kLLen, _).at(kl, 0) => local;
                wait lhsL, rhsL;
              }
            }
          }
        }
      }
    }
  }
}

