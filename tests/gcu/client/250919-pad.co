// CHECK: choreo::half* lhsL__buf__ = (choreo::half*)(anon_10 + mr_offset_matmul_paraby_0_paraby_1_within_0_foreach_0_within_1_foreach_1_within_2_foreach_2_within_3_foreach_3_within_4_foreach_4_within_5_foreach_5_lhsL__buf__);
// CHECK: tops::private_dte choreo_topscc_ctx2;
// CHECK: tops::mdspan __mds4_lhsS(tops::Shared, (choreo::half*)lhsS.data(), 4096, (K % 4608));
// CHECK: tops::mdspan __mds5_lhsL__buf__(tops::Private, (choreo::half*)lhsL__buf__, 256, (K % 4608 % 384 + (384 - K % 384)));
// CHECK: unsigned int __pad_low_lhsS1[] = {0, 0};
// CHECK: unsigned int __pad_high_lhsS1[] = {0, static_cast<unsigned int>((384 - K % 384))};
// CHECK: unsigned int __pad_mid_lhsS1[] = {0, 0};
// CHECK: int __slice_offset0__lhsS_2_lhsL__buf__[] = {(int)(((__tops_tid_x() + __iv_ml__elem__0 * 4) * 256)), (int)((__iv_kl__elem__0 * 384))};
// CHECK: unsigned int __slice_shape1__lhsS_2_lhsL__buf__[] = {256, static_cast<unsigned int>((K % 4608 % 384))};
// CHECK: tops::event lhsL__event__ = tops::slice_pad_async(*lhsL.get_ctx(), __mds5_lhsL__buf__, __mds4_lhsS, __slice_offset0__lhsS_2_lhsL__buf__, __slice_shape1__lhsS_2_lhsL__buf__, __pad_low_lhsS1, __pad_high_lhsS1, __pad_mid_lhsS1, f32_to_f16(static_cast<float>(0)));
// CHECK: lhsL.set_event(lhsL__event__);
// CHECK: auto anon_7 = __iv_ml__elem__0 * 4 + __tops_tid_x();
// CHECK: choreo::half* lhsL2__buf__ = (choreo::half*)(anon_10 + mr_offset_matmul_paraby_0_paraby_1_within_0_foreach_0_within_1_foreach_1_within_2_foreach_2_within_3_foreach_3_within_4_foreach_4_within_5_foreach_5_lhsL2__buf__);
// CHECK: tops::private_dte choreo_topscc_ctx3;
// CHECK: tops::mdspan __mds6_lhsS(tops::Shared, (choreo::half*)lhsS.data(), 4096, (K % 4608));
// CHECK: tops::mdspan __mds7_lhsL2__buf__(tops::Private, (choreo::half*)lhsL2__buf__, 256, (K % 4608 % 384 + (384 - K % 384)));
// CHECK: unsigned int __pad_low_lhsS2[] = {0, 0};
// CHECK: unsigned int __pad_high_lhsS2[] = {0, static_cast<unsigned int>((384 - K % 384))};
// CHECK: unsigned int __pad_mid_lhsS2[] = {0, 0};
// CHECK: int __slice_offset1__lhsS_2_lhsL2__buf__[] = {(int)(((__tops_tid_x() + __iv_ml__elem__0 * 4) * 256)), (int)((__iv_kl__elem__0 * 384))};
// CHECK: unsigned int __slice_shape2__lhsS_2_lhsL2__buf__[] = {256, static_cast<unsigned int>((K % 4608 % 384))};
// CHECK: tops::slice_pad(*lhsL2.get_ctx(), __mds7_lhsL2__buf__, __mds6_lhsS, __slice_offset1__lhsS_2_lhsL2__buf__, __slice_shape2__lhsS_2_lhsL2__buf__, __pad_low_lhsS2, __pad_high_lhsS2, __pad_mid_lhsS2, f32_to_f16(static_cast<float>(0)));
// CHECK: auto anon_8 = __iv_nl__elem__0 * 3 + __tops_tid_y();
// CHECK: choreo::half* rhsL__buf__ = (choreo::half*)(anon_10 + mr_offset_matmul_paraby_0_paraby_1_within_0_foreach_0_within_1_foreach_1_within_2_foreach_2_within_3_foreach_3_within_4_foreach_4_within_5_foreach_5_rhsL__buf__);
// CHECK: tops::private_dte choreo_topscc_ctx4;
// CHECK: tops::mdspan __mds8_rhsS(tops::Shared, (choreo::half*)rhsS.data(), (K % 4608), 3072);
// CHECK: tops::mdspan __mds9_rhsL__buf__(tops::Private, (choreo::half*)rhsL__buf__, (K % 4608 % 384 + (384 - K % 384)), 1024);
// CHECK: unsigned int __pad_low_rhsS3[] = {0, 0};
// CHECK: unsigned int __pad_high_rhsS3[] = {static_cast<unsigned int>((384 - K % 384)), 0};
// CHECK: unsigned int __pad_mid_rhsS3[] = {0, 0};
// CHECK: int __slice_offset2__rhsS_2_rhsL__buf__[] = {(int)((__iv_kl__elem__0 * 384)), (int)(((__tops_tid_y() + __iv_nl__elem__0 * 3) * 1024))};
// CHECK: unsigned int __slice_shape3__rhsS_2_rhsL__buf__[] = {static_cast<unsigned int>((K % 4608 % 384)), 1024};
