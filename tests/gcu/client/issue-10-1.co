// REQUIRES: TARGET-GCUALL
// SHELL-ONLY
// RUN: choreo -gs -t topscc %gcu_arch %s | bash -s -- --execute | FileCheck --check-prefix=CHKRUN --match-full-lines %s

#include "choreo.h"

__cok__ {
  __co_device__ extern "C" void kernel(float* ptr, double f64, float f32) {
    ptr[0] = f64;
    ptr[1] = f32;
  }
}

__co__ f32 [2] func() {
  global f32 [2] out;
  parallel p by 1 {
    parallel q by 1 {
      local f32 [2] buf;
      call kernel(buf, 0.64, 0.32f);
      dma.copy buf => out;
    }
  }
  return out;
}

int main() {
  auto res = func();
  if (std::abs(res.data()[0] - 0.64) >= 0.000001) {
    std::cout << "Error: " << res.data()[0] << std::endl;
    return 1;
  } 
  if (std::abs(res.data()[1] - 0.32f) >= 0.000001f) {
    std::cout << "Error: " << res.data()[1] << std::endl;
    return 1;
  }  
  std::cout << "Passed." << std::endl;
  return 0;
}

// CHKRUN: Passed.
