// CHECK: BUFFER ::foo::paraby_0::paraby_1::ss
// CHECK: 	range: [4, 5]  [10, 12] 

// CHECK: BUFFER ::bar::paraby_2::paraby_3::ss
// CHECK: 	range: [23, 35] 

// MEMREUSE: shared buffer: ::foo::paraby_0::paraby_1::ss
// MEMREUSE: 	using spm:   anon_1
// MEMREUSE: 	with offset: 0
// MEMREUSE: shared buffer: ::foo::paraby_0::paraby_1::cond_if_0::ll
// MEMREUSE: 	using spm:   anon_1
// MEMREUSE: 	with offset: 0

