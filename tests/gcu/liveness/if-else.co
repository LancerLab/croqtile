// RUN: choreo -es -dv=liveness %s | FileCheck --match-full-lines %s
// RUN: choreo -es -dv=memreuse %s | FileCheck --match-full-lines --check-prefix=MEMREUSE %s

#include "choreo.h"

#define N 64

__co__ auto foo(int x) {
  f32 [N] o{0.0f};
  parallel p by 1 {
    shared f32[N] ss{3.0f};
    if (x > 50) {
      double ff = 1.5;
      shared f32[N] ll{5.0f};
      dma.copy ll => o;
    } else {
      res = dma.copy ss => local;
      dma.copy res => o;
    }
  }
  return o;
}

__co__ auto bar(int x) {
  f32 [N] o{0.0f};
  parallel p by 1 {
    shared f32[N] ss{3.0f};
    if (x > 50) {
      double ff = 1.5;
      shared f32[N] ll{5.0f};
      dma.copy ll => o;
    } else {
      res = dma.copy ss => local;
      dma.copy res => o;
    }
    dma.copy ss => local;
  }
  return o;
}

int main() {
  auto res = foo(51);
  for(int i=0; i<res.shape()[0]; ++i) {
    std::cout << res[i] << ' ';
  }
  std::cout << "\n";
  return 0;
}

