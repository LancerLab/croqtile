// RUN: choreo -dv=liveness -sa=liveness %s -o - | FileCheck --match-full-lines %s
// REQUIRES: TARGET-GCUALL

#include "choreo.h"

__cok__ {
extern "C" void relu_kernel(float* input, float* out) {
  constexpr int m = 256;
  constexpr int n = 256;
  for (int i = 0; i < m; ++i) {
    for (int j = 0; j < n; ++j) {
      out[i*n+j] = input[i*n+j] > 0.0f ? input[i*n+j] : 0.0f;
    }
  }
}
}

__co__ f32 [512, 1024] relu(f32 [512, 1024] input) { /// device program
  f32[input.span(0), input.span(1)] output; // use same shape as input

  parallel p by 2 {  // p is sip_index
    with index = {n_tile} in [16] {  // decl your tiled spans
      foreach n_tile {
        shared f32[input.span(0)/#p, input.span(1)/#n_tile] l2_out;
        input_load = dma.copy.async input.chunkat(p, n_tile) => shared;
        parallel q by 1 {
          input_load_s = dma.copy.async input_load.data => local after input_load;
          out_load_s = dma.copy.async l2_out => local;
          wait input_load_s, out_load_s;
          call relu_kernel(input_load_s.data, out_load_s.data); // |span| calculate the total size of span.
          out_store_s = dma.copy.async out_load_s.data => l2_out; // can use defined vars
          wait out_store_s;
        }
        out_store = dma.copy.async l2_out => output.chunkat(p, n_tile); // can use defined vars
        wait out_store;
      }
    }
  } // can use python styling
  return output;
}


// CHECK: (  0) relu(f32 mdspan<2> [512, 1024] input) {
// CHECK: (  1)   global f32 [ input.span(0) input.span(1) ] output
// CHECK: (  2)   parallel p = {p__elem__x} by [2] : block {
// CHECK: (  3)     with index = {n_tile} in [ 16 ] {
// CHECK: (  4)       foreach n_tile(::) {
// CHECK: (  5)         shared f32 [ (input.span(0) /  (ubound p) )  (input.span(1) /  (ubound n_tile) )  ] l2_out
// CHECK: (  6)         shared f32 mdspan<2> [256, 64] input_load__buf__
// CHECK: (  7)         input_load = dma.copy.async input.Chunk( (ubound p) , (ubound n_tile) ).At(p, n_tile) => input_load__buf__, chain_to input_load_s
// CHECK: (  8)         parallel q = {q__elem__x} by [1] : thread {
// CHECK: (  9)           local f32 mdspan<2> [256, 64] input_load_s__buf__
// CHECK: ( 10)           input_load_s = dma.copy.async input_load => input_load_s__buf__, chain_from input_load
// CHECK: ( 11)           local f32 mdspan<2> [256, 64] out_load_s__buf__
// CHECK: ( 12)           out_load_s = dma.copy.async l2_out => out_load_s__buf__
// CHECK: ( 13)           wait input_load_s, out_load_s
// CHECK: ( 14)           call relu_kernel( (dataof input_load_s) ,  (dataof out_load_s) )
// CHECK: ( 15)           out_store_s = dma.copy.async out_load_s => l2_out
// CHECK: ( 16)           wait out_store_s
// CHECK: ( 17)         }
// CHECK: ( 18)         out_store = dma.copy.async l2_out => output.Chunk( (ubound p) , (ubound n_tile) ).At(p, n_tile)
// CHECK: ( 19)         wait out_store
// CHECK: ( 20)       }
// CHECK: ( 21)     }
// CHECK: ( 22)   }
// CHECK: ( 23)   return output
// CHECK: ( 24) }

