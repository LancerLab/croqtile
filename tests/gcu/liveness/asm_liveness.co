// CHECK: DEF: ::asm_liveness_test::x
// CHECK: (  1)   global s32 [ 64 ] z
// CHECK: DEF: ::asm_liveness_test::z
// CHECK: (  2)   parallel anon_pb_0 = {anon_pb_0__elem__x} by [1] : block {
// CHECK: DEF: ::asm_liveness_test::paraby_0::anon_pb_0
// CHECK: DEF: ::asm_liveness_test::paraby_0::anon_pb_0__elem__x
// CHECK: (  3)     parallel p = {p__elem__x} by [1] : thread {
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::p
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::p__elem__x
// CHECK: (  4)       local s32 mdspan<1> [64] lx__buf__
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::lx__buf__
// CHECK: (  5)       lx = dma.copy x.Chunk( (ubound p) ).At(p) => lx__buf__
// CHECK: USE: ::asm_liveness_test::x
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::p
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::p__elem__x
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::p
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx__buf__
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::lx
