// REQUIRES: TARGET-GCUALL
// RUN: choreo -es -dv=liveness %s | FileCheck --match-full-lines %s
// Live-range analysis check for GCC extended asm statements.
// Verifies that the liveness analyzer correctly tracks:
//   - spanned (buffer) operands create USE points; scalar operands do not
//   - buffer writes and the "memory" clobber create USE points, never DEF

#include "choreo.h"

#define N 64

__co__ auto asm_liveness_test(s32 [N] x) {
  s32 [N] z;
  parallel p by 1 {
    lx = dma.copy x.chunkat(p) => local;
    local s32 [lx.span] lz;
    foreach {i} in [lx.span(0)] {
      s32 a = lx.data.at(i);
      s32 b;
      __asm__ volatile("v.add %0, %1"
        : "=r"(b)
        : "r"(a)
        : "memory");
      lz.at(i) = b;
    }
    dma.copy lz => z.chunkat(p);
  }
  return z;
}

int main() { return 0; }

