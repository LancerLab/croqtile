// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::lz
// CHECK: (  7)       with {i} in [ lx.span(0) ] {
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::within_0::i
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx.span
// CHECK: (  8)         foreach i(::) {
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::within_0::i
// CHECK: (  9)           mutable s32 a = lx.data[i]
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx__buf__
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx__buf__
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::within_0::foreach_0::a
// CHECK: ( 10)           mutable s32 b
// CHECK: DEF: ::asm_liveness_test::paraby_0::paraby_1::within_0::foreach_0::b
// The asm statement appears as its own numbered line with USE points:
// CHECK: ( 11)           __asm__ volatile ("v.add %0, %1" : "=r"(b) : "r"(a) : "memory")
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lx__buf__
// CHECK: USE: ::asm_liveness_test::paraby_0::paraby_1::lz
