// RUN: choreo -dv=liveness -sa=liveness %s -o - | FileCheck --match-full-lines %s
// REQUIRES: TARGET-GCUALL

__co__ auto foo(s32[128] off_buff_L3, s32[102400, 512] input, s32[102400, 512] id,
                s32[10] para) {
  s32[id.span] output;

  parallel p by 10 {

    local s32[1, 512] output_L1;
    local s32[128] off_buff;
    dma.copy off_buff_L3 => off_buff;
    para_L1 = dma.copy para => local;

    with {d0, d1} in [10240, 1] {
      foreach d0, d1 {
        input_L1 = dma.copy input.chunkat(p#d0, d1) => local;
        id_L1 = dma.copy id.chunkat(p#d0, d1) => local;

        call call_gather_kernel(
            input_L1.data, id_L1.data, output_L1, off_buff, para_L1.data);

        dma.copy output_L1 => output.chunkat(p#d0, d1);
      }
    }
  }
  return output;
}

// CHECK: (  0) foo(s32 mdspan<1> [128] off_buff_L3, s32 mdspan<2> [102400, 512] input, s32 mdspan<2> [102400, 512] id, s32 mdspan<1> [10] para) {
// CHECK: (  1)   global s32 [ id.span ] output
// CHECK: (  2)   parallel anon_pb_0 = {anon_pb_0__elem__x} by [1] : block {
// CHECK: (  3)     parallel p = {p__elem__x} by [10] : thread {
// CHECK: (  4)       local s32 [ 1 512 ] output_L1
// CHECK: (  5)       local s32 [ 128 ] off_buff
// CHECK: (  6)       dma.copy off_buff_L3 => off_buff
// CHECK: (  7)       local s32 mdspan<1> [10] para_L1__buf__
// CHECK: (  8)       para_L1 = dma.copy para => para_L1__buf__
// CHECK: (  9)       with {d0, d1} in [ 10240 1 ] {
// CHECK: ( 10)         foreach d0(::), d1(::) {
// CHECK: ( 11)           anon_0 =  (p # d0) 
// CHECK: ( 12)           local s32 mdspan<2> [1, 512] input_L1__buf__
// CHECK: ( 13)           input_L1 = dma.copy input.Chunk( (ubound (p # d0) ) ,  (ubound d1) ).At(anon_0, d1) => input_L1__buf__
// CHECK: ( 14)           anon_1 =  (p # d0) 
// CHECK: ( 15)           local s32 mdspan<2> [1, 512] id_L1__buf__
// CHECK: ( 16)           id_L1 = dma.copy id.Chunk( (ubound (p # d0) ) ,  (ubound d1) ).At(anon_1, d1) => id_L1__buf__
// CHECK: ( 17)           call call_gather_kernel( (dataof input_L1) ,  (dataof id_L1) , output_L1, off_buff,  (dataof para_L1) )
// CHECK: ( 18)           anon_2 =  (p # d0) 
// CHECK: ( 19)           dma.copy output_L1 => output.Chunk( (ubound (p # d0) ) ,  (ubound d1) ).At(anon_2, d1)
// CHECK: ( 20)         }
// CHECK: ( 21)       }
// CHECK: ( 22)     }
// CHECK: ( 23)   }
// CHECK: ( 24)   return output
// CHECK: ( 25) }

