// RUN: choreo -dv=liveness -sa=liveness -ddir=build %s -o - | FileCheck --match-full-lines %s
// REQUIRES: TARGET-GCUALL

__co__ auto rgb2gray(f32 [N, 3, H, W] input) {
  f32 [N, H, W] out;
  parallel q by 6 {
    // TODO: use N, H, W, q?
    with index={n, c, h, w} in [N, 3, H, W]/{#q, 3, 16, 512} {
      foreach n, h {
        input_L1_A = dma.copy.async input.chunkat(q#n, c, h, w) => local;
        input_L1_B = dma.any;
        local f32 [input_L1_A.span(0), input_L1_A.span(2), input_L1_A.span(3)] out_L1;
        foreach w(1:) {
          input_L1_B = dma.copy.async input.chunkat(q#n, c, h, w) => local;
          wait input_L1_A;
          dma.copy out_L1 => out.chunkat(q#n, h, w - 1);
          swap(input_L1_A, input_L1_B);
        }
        input_L1 = select(#w % 2, input_L1_B, input_L1_A);
        wait input_L1;
        dma.copy out_L1 => out.chunkat(q#n, h, w(-1));
      }
    }
  }
  return out;
}

// CHECK: (  0) rgb2gray(f32 mdspan<4> [::rgb2gray::N, 3, ::rgb2gray::H, ::rgb2gray::W] input) {
// CHECK: (  1)   global f32 [ N H W ] out
// CHECK: (  2)   parallel anon_pb_0 = {anon_pb_0__elem__x} by [1] : block {
// CHECK: (  3)     parallel q = {q__elem__x} by [6] : thread {
// CHECK: (  4)       with index = {n, c, h, w} in  ([ N 3 H W ] / { (ubound q) , 3, 16, 512})  {
// CHECK: (  5)         foreach n(::), h(::) {
// CHECK: (  6)           anon_0 =  (q # n) 
// CHECK: (  7)           local f32 mdspan<4> [1, 3, 16, 512] input_L1_A__buf__
// CHECK: (  8)           input_L1_A = dma.copy.async input.Chunk( (ubound (q # n) ) , (ubound c) ,  (ubound h) , (ubound w) ).At(anon_0, c, h, w) => input_L1_A__buf__
// CHECK: (  9)           local f32 mdspan<4> [1, 3, 16, 512] input_L1_B__buf__
// CHECK: ( 10)           input_L1_B = dma.any
// CHECK: ( 11)           local f32 [ input_L1_A.span(0) input_L1_A.span(2) input_L1_A.span(3) ] out_L1
// CHECK: ( 12)           anon_1 = 1
// CHECK: ( 13)           foreach w(anon_1::1) {
// CHECK: ( 14)             anon_2 =  (q # n) 
// CHECK: ( 15)             input_L1_B = dma.copy.async input.Chunk( (ubound  (q # n) ) , (ubound c) ,  (ubound h) , (ubound w) ).At(anon_2, c, h, w) => input_L1_B__buf__
// CHECK: ( 16)             wait input_L1_A
// CHECK: ( 17)             anon_3 =  (q # n) 
// CHECK: ( 18)             anon_4 =  (w - 1) 
// CHECK: ( 19)             dma.copy out_L1 => out.Chunk( (ubound (q # n) ) ,  (ubound h) , (ubound (w - 1) ) ).At(anon_3, h, anon_4)
// CHECK: ( 20)             swap(input_L1_A, input_L1_B)
// CHECK: ( 21)           }
// CHECK: ( 22)           async=>local f32 mdspan<4> [1, 3, 16, 512] input_L1 = select( ( (ubound w)  % 2) , input_L1_B, input_L1_A)
// CHECK: ( 23)           wait input_L1
// CHECK: ( 24)           anon_5 =  (q # n) 
// CHECK: ( 25)           dma.copy out_L1 => out.Chunk( (ubound (q # n) ) ,  (ubound h) , (ubound w[-1]) ).At(anon_5, h, w[-1])
// CHECK: ( 26)         }
// CHECK: ( 27)       }
// CHECK: ( 28)     }
// CHECK: ( 29)   }
// CHECK: ( 30)   return out
// CHECK: ( 31) }

