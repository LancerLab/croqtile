// REQUIRES: TARGET-GCUALL
// RUN: choreo -e -adf %s | FileCheck %s
__cok__ {
  struct st {};
  __device__ void abc(const std::vector<std::map<st*,std::string>> &a = {std::make_pair<>((st*)a, "aa")}, int) {}

  __device__ static inline constexpr st const *def(const ID &&a = foo<ID>(1, {}) + 1, float* b = nullptr) {
    return a + (int)b;
  }

  __device__  
  extern int foo(int a,  __private__ __align__ char* c = nullptr, float f = 1.0f, void** v = nullptr) {} ;

  __device__ extern int index ();

  template <typename T>
  __device__ __attribute__((noinline, no_mem_alias_in_vldst_tar))
  void dynamic_scaled_int8_quant_kernel(
    int8_t* out, float* scales, T* in,
    const DYNAMIC_SCALED_INT8_QUANT_OP_PARAS para) {}

  // __device__ void illegal_fun0() const; // illegal parsing, 'const' function
}

// CHECK: DeviceFunction: abc -> void (unknown, s32)
// CHECK: DeviceFunction: def -> unknown * (unknown, f32 *)
// CHECK: DeviceFunction: foo -> s32 (s32, s8 *, f32, unknown *)
// CHECK: DeviceFunction: index -> s32 ()
// CHECK: DeviceFunction: dynamic_scaled_int8_quant_kernel -> template <typename T> void (s8 *, f32 *, unknown *, unknown)

// CHECK: struct st {};
// CHECK: __device__ void abc(const std::vector<std::map<st*,std::string>> &a = {std::make_pair<>((st*)a, "aa")}, int) {}
// CHECK  __device__ static inline constexpr st const *def(const ID &&a = foo<ID>(1, {}) + 1, float* b = nullptr) {
// CHECK:   return a + (int)b;
// CHECK: }
// CHECK: __device__  
// CHECK  extern int foo(int a,  __private__ __align__ char* c = nullptr, float f = 1.0f, void** v = nullptr) {} ;
// CHECK: __device__ extern int index ();
// CHECK: template <typename T>
// CHECK: __device__ __attribute__((noinline, no_mem_alias_in_vldst_tar))
// CHECK: void dynamic_scaled_int8_quant_kernel(
// CHECK:   int8_t* out, float* scales, T* in,
// CHECK:   const DYNAMIC_SCALED_INT8_QUANT_OP_PARAS para) {}
