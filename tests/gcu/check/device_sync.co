// RUN: choreo -t topscc -arch=gcu300 %s 2>&1 | FileCheck %s

__co__ void sync_in_device() {
  parallel d by 2 : device {
    sync.global;   // valid at device scope
    sync.barrier : block;   // barrier at device scope (no Choreo error)
    parallel p by 2 : block {
      parallel t by 6 : thread {
        sync.barrier : block;  // valid inside kernel
      }
    }
  }
}

// CHECK: warning: sync.barrier : block inside a parallel : thread scope; the barrier may have no effect.
