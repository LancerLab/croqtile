// RUN: not choreo -t topscc -arch=gcu3 %s 2>&1 | FileCheck %s
__co__ auto illegal_call(f32 [36] input) {
  global f32 [3] l3_ptr;
  parallel p by 3 {
    call foo(input);
    call foo(l3_ptr);
    l3_ptr.at(p) = 1.0f;
    input.at(p) = 2.0f;
  }
}

// CHECK: error: function call 'foo` with global data 'input` is not allowed.

// CHECK: error: function call 'foo` with global data 'l3_ptr` is not allowed.

// CHECK: error: global data access 'l3_ptr[p]` is not allowed.
// CHECK:       l3_ptr.at(p) = 1.0f;

// CHECK: error: global data access 'input[p]` is not allowed.
// CHECK:       input.at(p) = 2.0f;
