// RUN: choreo -gs -t topscc -arch=gcu300 %s 2>&1 | FileCheck %s

__co__ auto foo0(f32 [2,2,3,4,5,6] i, u8 [N, M] i1) {
  f32 [i.span] o;
  u8 [M, N] i2;
  parallel p by 1 {
    with {x, y} in [N/1024, M/128] {
      foreach x, y {
        b = dma.transp<1, 0> i1.chunkat(x, y) => shared;
        c = dma.copy b => i2.chunkat(y, x);
      }
    }
  }
  return o;
}

// CHECK:  choreo::runtime_check((static_cast<long long>(M) * static_cast<long long>(N) < 4294967296LL), "The size of data transferred by DMA cannot exceed 2^32
