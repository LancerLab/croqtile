// RUN: choreo -arch=gcu300 %s 2>&1 | FileCheck --check-prefix=CHECK %s
// RUN: choreo -D__GCU4__ -arch=gcu400 %s 2>&1 | FileCheck --check-prefix=GCU4CHK %s

__co__ void bar() {
  sync.global;
  sync.shared;  // error
  sync.local;   // error
  parallel by 3 {
    sync.global;  // error
    sync.shared;
    sync.local;
    parallel by 2 {
      sync.global;  // error
      sync.shared;
      sync.local;
#ifdef __GCU4__
      parallel by 1 {
        sync.global;
        sync.shared;
        sync.local;
      }
#endif
    }
  }
}

// CHECK: error: unsupported: shared synchronization in sequential scope.
// CHECK: error: GCU300 does not support local synchronization.
// CHECK: error: unsupported: global synchronization in block scope.
// CHECK: error: GCU300 does not support local synchronization.
// CHECK: error: unsupported: global synchronization in thread scope.
// CHECK: error: GCU300 does not support local synchronization.

// GCU4CHK: error: unsupported: shared synchronization in sequential scope.
// GCU4CHK: error: unsupported: local synchronization in sequential scope.
// GCU4CHK: error: unsupported: global synchronization in block scope.
// GCU4CHK: error: unsupported: local synchronization in block scope.
// GCU4CHK: error: unsupported: global synchronization in group scope.
// GCU4CHK: error: unsupported: global synchronization in thread scope.
