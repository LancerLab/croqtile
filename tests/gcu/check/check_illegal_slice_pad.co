// RUN: not choreo -gs -t topscc -arch=gcu210 %s 2>&1 | FileCheck %s

// Combined slice+pad DMA is not supported on gcu2.
__co__ s32 [8, 6] test_slice_pad(s32 [4, 4] input) {
  s32 [8, 6] output;
  parallel p by 2 {
    f = dma.pad<{1, 1}, {1, 1}, {0, 0}, -1>.async input.chunkat(p, _) => local;
    wait f;
    dma.copy f.data => output.chunkat(p, _);
  }
  return output;
}

// CHECK: combined slice+pad DMA is not supported
