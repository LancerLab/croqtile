// RUN: choreo --target topscc -dv=muchk -sa=muchk -arch=gcu400 --mem-reuse=false %s 2>&1 | FileCheck %s

// `shared<group>` is budgeted per-GROUP (per SIP) against the 896 KiB L1 VDMEM
// limit. `local` is rejected on gcu400+, so on-chip scratchpad is expressed as
// `shared<group>`. A single 896 KiB + 4 B buffer exceeds the per-GROUP limit
// (and, multiplied by 8 SIPs, also the 7 MiB joint pool).
__co__ auto mem_usage_check_group_shared(s32 [128, 128] i0) {
  s32 [i0.span] output;

  parallel p by 1 {
    shared<group> f32[229377] g; // 917508 B = 896 KiB + 4 B (over per-GROUP limit)
  }

  return output;
}

// CHECK: [MemUsage] Memory usage limit of architecture GCU400 is:
// CHECK: 0x0000e0000 bytes(896 KB)
// CHECK: error: groupshared memory OUT OF BOUND!
// CHECK: compile-time groupshared memory:
// CHECK: Used: 917508 bytes, Limit: 917504 bytes.
