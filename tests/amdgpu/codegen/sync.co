// RUN: choreo -es -n -t hip -arch=gfx1030 %s 2>&1 | FileCheck %s

// Test: barrier at thread/group levels
__co__ void test_barriers() {
  parallel bx by 1 : group {
    // CHECK: __builtin_amdgcn_wave_barrier()
    sync.barrier : thread;

    // CHECK: __builtin_amdgcn_wave_barrier()
    sync.barrier : group;
  }
}

// Test: fence at thread/block visibility (HIP: seq_cst is the default;
// release/acquire emit directional __builtin_amdgcn_fence; acq_rel emits the
// full __threadfence* forms)
__co__ void test_fences() {
  parallel bx by 1 : block {
    // CHECK: __builtin_amdgcn_fence(__ATOMIC_SEQ_CST, "agent")
    sync.fence : block;

    // CHECK: __builtin_amdgcn_fence(__ATOMIC_SEQ_CST, "workgroup")
    sync.fence : thread;

    // CHECK: __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent")
    sync.fence.rel : block;

    // CHECK: __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup")
    sync.fence.acq : thread;

    // CHECK: __threadfence()
    sync.fence.acq_rel : block;

    // CHECK: __builtin_amdgcn_fence(__ATOMIC_SEQ_CST, "agent")
    sync.fence.seq_cst : block;
  }
}
