// RUN: choreo -es -n -t hip -arch=gfx1030 %s 2>&1 | FileCheck %s

// Test: barrier at thread level (sync.shared equivalent) and fence at
// thread/group visibility (sync.local equivalent) in a thread-parallel scope.
__co__ void sync_levels(s32 [64] a) {
  parallel p by 64 : thread {
    shared s32 [64] s;
    s.at(p) = a.at(p);
    sync.barrier : thread;
    sync.fence  : thread;
    s.at(p) = s.at(p) + 1;
  }
}

// CHECK: __builtin_amdgcn_wave_barrier()
// CHECK: __threadfence_block()
