    with index = {x, y} in [10, 10] {  // totally 100 chunks
      foreach x {
        // empty loop body
      }
    }
    // end kernel function
  }

  return global_buffer;
}

// host program
int bar(int a[], int b[]) {
  return ele_add(a, b);
}
