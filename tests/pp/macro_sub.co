// RUN:choreo -E %s | FileCheck --match-full-lines %s
#define K 14 // 14 is the answer
#define T 14 /* 14 is the answer */
__co__ void foo() {
  println("K: ", K);
  println("\"K\": ", K);
  println(R"(T)", T);
  __cpp__(R"(printf("time spend: %lld\n", start - end);)");
}

// CHECK: println("K: ", K);
// CHECK: println("\"K\": ", K);
// CHECK: println(R"(T)", T);
// CHECK: __cpp__(R"(printf("time spend: %lld\n", start - end);)");