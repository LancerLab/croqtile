// RUN: test "$(copp %s -o - | grep -c '^__co__ void __choreo_template_scale_')" -eq 32

template <int N>
__co__ void scale(s32 [N] data) {
  static_assert(N > 0, "N must be positive");
}

template __co__ scale<1>;
