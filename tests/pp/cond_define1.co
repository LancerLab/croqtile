// RUN: choreo -n -E %s | grep -v "\<CHECK\>" | FileCheck --match-full-lines %s

   show me value ABC
#ifndef BBC
#define ABC 30
#else
#define ABC 300
   show me value ABC
__co__ int foo(f32 d[]) {
   show me value ABC
}
#endif
   show me value ABC

// CHECK: show me value ABC
// CHECK: #ifndef BBC
// CHECK: #define ABC 30
// CHECK: #else
// CHECK: #define ABC 300
// CHECK: show me value ABC
// CHECK: show me value 30
// CHECK: #endif
// CHECK: show me value ABC
