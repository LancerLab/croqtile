// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t factor -f16n %s -o %s.result && bash %s.result --execute | FileCheck --match-full-lines %s

#include <chrono>
#include <cmath>
#include <iomanip>
#include <iostream>
#include <limits>
#include <random>
#include <sstream>
#include <string>

#define MATM 16
#define MATN 16
#define MATK 16

__cok__ {
  extern "C" void copy_kernel(__fp16 *lhs, __fp16 *rhs, __fp16 *out, int mm, int nn, int kk) {
    for (int m = 0; m < mm; ++m) {
      for (int n = 0; n < nn; ++n) {
        for (int k = 0; k < kk; ++k) {
          // out[m * nn + n] = lhs[m * kk + k];
          out[m * nn + n] = rhs[k * nn + n];
        }
      }
    }
  }
}

__co__ f16[16, 16] copy(f16[16, 16] lhs, f16[16, 16] rhs) {
  f16[16, 16] out;
  mdspan<3> tile : [4, 4, 4];
  parallel p by 1 {
    with tiling = {m_tile, n_tile, k_tile} in [16 / tile(0), 16 / tile(1), 16 / tile(2)] {
      foreach m_tile, n_tile {
        foreach k_tile {
          local f16[tile(0), tile(1)] out_local{0};
          lhs_load = dma.copy.async lhs.chunkat(m_tile, k_tile) => local;
          rhs_load = dma.copy.async rhs.chunkat(k_tile, n_tile) => local;
          wait lhs_load, rhs_load;
          call copy_kernel(lhs_load.data, rhs_load.data, out_local, tile(0), tile(1), tile(2));
          dma.copy out_local => out.chunkat(m_tile, n_tile);
        }
      }
    }
  }
  return out;
}

int main() {
  choreo::f16 *lhs, *rhs;
  lhs = new choreo::f16[MATM * MATK];
  rhs = new choreo::f16[MATK * MATN];

  for (int k = 0; k < MATK; k++) {
    for (int m = 0; m < MATM; m++) {
      lhs[m * MATK + k] = std::stof(std::to_string(m)+"."+std::to_string(k));
    }
    for (int n = 0; n < MATN; n++) {
      rhs[k * MATN + n] = std::stof(std::to_string(k)+"."+std::to_string(n));
    }
  }

  auto res = copy(choreo::make_spanview<2, choreo::f16>(lhs, {MATM, MATK}),
                    choreo::make_spanview<2, choreo::f16>(rhs, {MATK, MATN}));

  std::cout << "lhs: " << std::endl;
  for (int m = 0; m < MATM; ++m) {
    for (int k = 0; k < MATK; ++k) {
      std::cout << std::setw(3) << lhs[m * MATK + k] << "  ";
    }
    std::cout << std::endl;
  }
  std::cout << "rhs: " <<std::endl;
  for (int k = 0; k < MATK; ++k) {
    for (int n = 0; n < MATN; ++n) {
      std::cout << std::setw(3) << rhs[k * MATN + n] << "  ";
    }
    std::cout << std::endl;
  }
  std::cout << "gcu: " <<std::endl;
  for (int m = 0; m < MATM; m++) {
    for (int n = 0; n < MATN; n++) {
      std::cout << std::setw(4) << res.data()[m * MATN + n] << "  ";
    }
    std::cout << std::endl;
  }

  delete[] lhs;
  delete[] rhs;

  std::cout << "Test Complete.\n";

  return 0;
}
// CHECK: Test Complete.
