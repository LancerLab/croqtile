// REQUIRES: TARGET-GCU300
// SHELL-ONLY
// RUN: choreo -t topscc -gs %s -o %s.result && bash %s.result |FileCheck %s && rm -f %s.result

#include "choreo.h"

__co__ auto test(s32 [M, N] input) {
  global s32 [M, N] output{-1};
  mTile = 32;
  nTile = 32;
  mRem = M % mTile;
  nRem = N % nTile;
  println("mRem: ", mRem);
  println("nRem: ", nRem);
  parallel by 1 {
    with m in [M / mTile] foreach m(:1:) {
      with n in [N / nTile] foreach n(:1:) {
        if (((m + 1) * mTile > M) && (m * mTile < M) && ((n + 1) * nTile > N) && (n * nTile < N)) {
          println("m: ", m);
          println("n: ", n);
          l1buffer = dma.pad<{0, 0}, {mTile - mRem, nTile - nRem}, {0, 0}, 9> input.modspan(mTile, nTile).at(m, n) => local; // Here
          foreach i in [mTile] {
            foreach j in [nTile] {
              l1buffer.data.at(i, j) = l1buffer.data.at(i, j) + l1buffer.data.at(i, j);
            }
          }
          dma.copy l1buffer.subspan(mRem, nRem) => output.modspan(mTile, nTile).at(m, n);
        }
      }
    }
  }
  return output;
}

int main() {
  size_t M = 36;
  size_t N = 66;
  auto input = choreo::make_spandata<choreo::s32, 2>({M, N});
  input.fill(11);

  auto res = test(input.view());
  std::cout << res.shape()[0] << std::endl;
  std::cout << res.shape()[1] << std::endl;


  for (size_t i = 0; i < res.shape()[0]; ++i) {
    for (size_t j = 0; j < res.shape()[1]; ++j) {
      std::cout << res[i][j] << ' ';
    }
    std::cout << "\n";
  }

  std::cout << "Test Passed\n" << std::endl;
}

