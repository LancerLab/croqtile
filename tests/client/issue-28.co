// RUN: choreo %s -es 2>&1 | FileCheck %s

__co__ auto foo(s32 [16, 32] a) {
  s32 [a.span] res;
  with index in [4, 4] {
    foreach index {
      f = dma.copy a.chunkat(index) => global;
      dma.copy f.data => res.chunkat(index);
    }
  }
  return res;
}

int main() {
  int data[16][32];
  std::fill_n(&data[0][0], sizeof(data) / sizeof(a[0][0][0]), 1);
  auto res = foo(choreo::make_spanview<2>((choreo::s32*)data, {16, 32}));

  for (int i = 0; i < 16; ++i)
    for (int j = 0; j < 32; ++j)
      if (res[i][j] != 1) {
        std::cerr << "[" << i << ", " << j << "] value is not expected.\n";
        abort();
      }

  std::cout << "passed\n";
  return 0;
}

// CHECK: passed
