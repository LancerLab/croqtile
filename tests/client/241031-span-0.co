// RUN: choreo -gs  -gs %s | FileCheck %s --match-full-lines

__co__ f32[3145728] normal_add(f32[3145728] lhs, f32[3145728] rhs) {
  f32[3145728] output;
  parallel p by 12 {
    shared f32[3145728/#p] l2_lhs_buf;
    shared f32[3145728/#p] l2_rhs_buf;
    l2_lhs_load = dma.copy.async lhs.chunkat(p) => l2_lhs_buf;
    l2_rhs_load = dma.copy.async rhs.chunkat(p) => l2_rhs_buf;
    wait l2_lhs_load, l2_rhs_load;

    with ll_index= {x} in [2] {//L2 mem per sip is 2MB,L1 mem per sip is 1MB, 2 = 2MB / 1 MB
      foreach x {
        local f32[l2_lhs_buf.span(0)/#x] l1_lhs_buf;
        local f32[l2_rhs_buf.span(0)/#x] l1_rhs_buf;
        l1_lhs_load = dma.copy.async l2_lhs_buf.chunkat(x) => l1_lhs_buf; // 12_2hs,chunkat or l2_lhs.data.chunkat?
        l1_rhs_load = dma.copy.async l2_rhs_buf.chunkat(x) => l1_rhs_buf;
        wait l1_lhs_load, l1_rhs_load;
        call normal_kernel(l1_lhs_buf,l1_rhs_buf,l1_lhs_buf, |l1_lhs_buf.span|);
        l1_out_store = dma.copy.async l1_lhs_buf => l2_lhs_buf.chunkat(x);
        wait l1_out_store;
      }
    }
    l2_out_store = dma.copy.async l2_lhs_load.data => output.chunkat(p);
    wait l2_out_store;
  }
  return output;
}

