// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs %s | FileCheck %s
// RUN: choreo -gs -t factor %s -o %s.factor.result && bash %s.factor.result --execute | FileCheck --check-prefix=CHKRUN --match-full-lines %s && rm -f %s.factor.result
// RUN: choreo -gs -t topscc %s -o %s.topscc.result && bash %s.topscc.result --execute | FileCheck --check-prefix=CHKRUN --match-full-lines %s && rm -f %s.topscc.result

#include <cmath>
#include <algorithm>
#include <vector>
#include <iostream>
#include "choreo.h"
#include <cfloat>

__cok__ { /// kernel program

__co_device__ extern "C" void matmul_kernel(float * lhs, float* rhs, float * out,int m, int k, int n) {
  for (int i = 0; i < m; ++i)
    for (int j = 0; j < n; ++j)
      for (int z = 0; z < k; ++z)
        out[i*n + j] += lhs[i*k+z]*rhs[z*n+j];
}

__co_device__ extern "C" void softmax_kernel(float* input, float* output, int m, int n) {
  for (int i = 0; i < m; ++i) {
    float max_val = input[i * n];
    // Find the maximum value in the current row (to avoid numerical overflow)
    for (int j = 0; j < n; ++j)
      max_val = (max_val > input[i * n + j])?max_val: input[i * n + j];

    float sum = 0.0f;
    // Compute the exp of each element and accumulate it in sum
    for (int j = 0; j < n; ++j) {
      output[i * n + j] = expf(input[i * n + j] - max_val);
      sum += output[i * n + j];
    }

    // Normalize each element by dividing it by sum
    for (int j = 0; j < n; ++j)
      output[i * n + j] /= sum;
  }
}

} /// end of kernel decl

__co__ f32 [256, 512] attention(f32 [256, 512] lhs, f32 [512, 256] rhs, f32 [256, 512] v) {

  f32[lhs.span(0), rhs.span(1)] output1;
  f32[lhs.span(0), v.span(1)] output;

  parallel p by 1 {
    with index = {m_tile, k_tile, n_tile} in [64, 1, 8] {  // decl your tiled spans
      foreach m_tile, n_tile {
        local f32[4, 32] l1_out {0};
        foreach k_tile {
          lhs_load = dma.copy lhs.chunkat(m_tile, k_tile) => local;
          rhs_load = dma.copy rhs.chunkat(k_tile, n_tile) => local;

          call matmul_kernel(lhs_load.data, rhs_load.data, l1_out,4,512,32);
          dma.copy l1_out => output1.chunkat(m_tile, n_tile);
        }
      }
    }
    with index = {m_tile1, n_tile1} in [256/64, 1] {  // Define tile size
      foreach m_tile1 {
        local f32[64,256] local_output;

        // Use DMA to load tile data into local memory
        local_input = dma.copy output1.chunkat(m_tile1, n_tile1) => local;

        // Call the softmax kernel function
        call softmax_kernel(local_input.data, local_output, 64, 256);

        // Copy the result back to global memory
        dma.copy local_output => output1.chunkat(m_tile1,n_tile1);
      }
    }
    with index = {m_tile2, k_tile2, n_tile2} in [64, 1, 8] {  // decl your tiled spans
      foreach m_tile2, n_tile2 {
        local f32[4, 64] l1_out_v {0};
        foreach k_tile2 {
          lhs_load_v = dma.copy output1.chunkat(m_tile2, k_tile2) => local;
          rhs_load_v = dma.copy v.chunkat(k_tile2, n_tile2) => local;

          call matmul_kernel(lhs_load_v.data, rhs_load_v.data, l1_out_v,4,256,64);
          dma.copy l1_out_v => output.chunkat(m_tile2, n_tile2);
        }
      }
    }
  }
  return output;
}
// Function to calculate dot product of two vectors
extern "C" float dot_product(const float *a, const float *b, int size) {
    float result = 0.0;
    for (int i = 0; i < size; ++i) {
        result += a[i] * b[i];
    }
    return result;
}

// Function to calculate softmax of a vector
extern "C" void softmax(float *vector, int size) {
    float sum = 0.0;
    for (int i = 0; i < size; ++i) {
        vector[i] = exp(vector[i]);
        sum += vector[i];
    }
    for (int i = 0; i < size; ++i) {
        vector[i] /= sum;
    }
}
// Function to perform dot-product attention
extern "C" void cpu_attention(const float *query, const float *key, const float *value,
                           float *output, int seq_len, int embedding_dim) {

   float * temp = (float*) malloc(sizeof(float) * seq_len * seq_len);
   float max_attention = FLT_MIN;
   // Calculate attention scores
    for (int i = 0; i < seq_len; ++i) {
        for (int j = 0; j < seq_len; ++j) {
            float attention_score = dot_product(&query[i * embedding_dim], &key[j * embedding_dim], embedding_dim)/sqrt((float)embedding_dim);
            temp[i * seq_len + j] = attention_score;
        }
    }

    // Apply softmax to get attention weights
    for (int i = 0; i < seq_len; ++i) {
        softmax(&temp[i * seq_len], seq_len);
    }

    // Calculate the weighted sum of values using attention weights
    for (int i = 0; i < seq_len; ++i) {
        for (int j = 0; j < embedding_dim; ++j) {
           output[i * embedding_dim + j] = 0.0;
            for (int k = 0; k < seq_len; ++k) {
                output[i * embedding_dim + j]  += temp[i * seq_len + k] * value[k * embedding_dim + j];
            }
        }
    }
    free(temp);
}
int main() {
    // Define matrix sizes
    int m = 256;  // Rows in Q and output
    int n = 512;  // Columns in K and V (and output)
    int k = 512;  // Columns in Q and rows in K

    // Allocate memory for Q, K, V
    choreo::f32 key[256][512];  // Query matrix (256 x 512)
    choreo::f32 q[512][256];  // Key matrix (512 x 512)
    choreo::f32 v[256][512];    // Value matrix (512 x 512)

    // Initialize Q, K, V with some values (example)
    std::fill(&key[0][0], &key[0][0] + 256 * 512, 1.0f);  // Fill lhs (Q) with 1.0
    std::fill(&q[0][0], &q[0][0] + 512 * 256, 1.0f);  // Fill rhs (K) with 1.0
    std::fill(&v[0][0], &v[0][0] + 256 * 512, 1.0f);      // Fill v (V) with 1.0

    auto k_data = choreo::make_spanview<2, choreo::f32>((choreo::f32*)key, {256, 512});
    auto q_data = choreo::make_spanview<2, choreo::f32>((choreo::f32*)q, {512, 256});
    auto v_data = choreo::make_spanview<2, choreo::f32>((choreo::f32*)v, {256, 512});


    // Call attention function
    auto result = attention(k_data, q_data, v_data);

    // Output the final result
    std::cout << "Attention Output (Softmax(QK^T) * V):\n";
    for (int i = 0; i < m; ++i) {
        for (int j = 0; j < n; ++j) {
            std::cout << result[i][j] << " ";
        }
        std::cout << "\n";
    }
    std::cout << "Test Complete.\n";

    return 0;
}

