// RUN: choreo %s -i | FileCheck --match-full-lines --check-prefix=INFER %s
// RUN: choreo -es %s | FileCheck --match-full-lines %s

#include "choreo.h"

__co__ void cofoo0() {
  int a = 1, b = 2, c = 3;
  int x = 1000;
  y = a + 1;
  u8 [a,b,c,x,y] mds;
  parallel p by b {
    with idx={ia,ib,ic,ix,iy} in [a,b,c,x,y] {
      foreach idx {}
    }
  }
  bool t = true, f = false;
}

int main() {}


// INFER: Symbol:    ::cofoo0::a, Type: int
// INFER: Symbol:    ::cofoo0::b, Type: int
// INFER: Symbol:    ::cofoo0::c, Type: int
// INFER: Symbol:    ::cofoo0::x, Type: int
// INFER: Symbol:    ::cofoo0::y, Type: int
// INFER: Symbol:    ::cofoo0::mds, Type: global u8 mdspan<5> [1, 2, 3, 1000, 2]
// INFER: Bounded:   ::cofoo0::paraby_0::p, Type: {int}->[2](pv)
// INFER: Bounded:   ::cofoo0::paraby_0::p__elem__x, Type: {int}->[2](pi:x)
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::idx, Type: {int,int,int,int,int}->[1, 2, 3, 1000, 2]
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::ia, Type: {int}->[1]
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::ib, Type: {int}->[2]
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::ic, Type: {int}->[3]
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::ix, Type: {int}->[1000]
// INFER: Bounded:   ::cofoo0::paraby_0::within_0::iy, Type: {int}->[2]
// INFER: Symbol:    ::cofoo0::t, Type: bool
// INFER: Symbol:    ::cofoo0::f, Type: bool
// INFER: Function:  ::cofoo0, Type: void (*)()

// CHECK: __global__ void __choreo_device_cofoo0(unsigned char * mds) {
// CHECK:   {
// CHECK:     int __iv_ia = 0;
// CHECK:     int __iv_ib = 0;
// CHECK:     int __iv_ic = 0;
// CHECK:     int __iv_ix = 0;
// CHECK:     int __iv_iy = 0;
// CHECK:     for (__iv_ia = 0; __iv_ia < 1; ++__iv_ia) {
// CHECK:       for (__iv_ib = 0; __iv_ib < 2; ++__iv_ib) {
// CHECK:         for (__iv_ic = 0; __iv_ic < 3; ++__iv_ic) {
// CHECK:           for (__iv_ix = 0; __iv_ix < 1000; ++__iv_ix) {
// CHECK:             for (__iv_iy = 0; __iv_iy < 2; ++__iv_iy) {
// CHECK:             } // iy
// CHECK:             __iv_iy = 0;
// CHECK:           } // ix
// CHECK:           __iv_ix = 0;
// CHECK:         } // ic
// CHECK:         __iv_ic = 0;
// CHECK:       } // ib
// CHECK:       __iv_ib = 0;
// CHECK:     } // ia
// CHECK:     __iv_ia = 0;
// CHECK:   }
// CHECK: }

// CHECK: void cofoo0() {
// CHECK:   unsigned char * mds__device = nullptr;
// CHECK:   choreo::abend_true(topsMalloc(&mds__device, 12000ULL));
// CHECK:   dim3 __cofoo0_gdims0(1, 1, 1);
// CHECK:   dim3 __cofoo0_bdims0(2, 1, 1);
// CHECK:   __choreo_device_cofoo0<<<__cofoo0_gdims0, __cofoo0_bdims0>>>(mds__device);
