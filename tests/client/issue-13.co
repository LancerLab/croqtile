// RUN: choreo -t topscc %s -es -o - 2>&1 |FileCheck %s

__co__ auto foo(f32 [32, 4] a, s8 [1] b, int c) {
  int d = 996;
  parallel p by 2 {
    call kernel0();
    call kernel1(a, b, c, d);
    call kernel2<b.span(0)+3, d>(b, a.span(0));
  }
}


// CHECK: __global__ void __choreo_device_foo(float * a, char * b, int c) {
// CHECK:   kernel0();
// CHECK:   kernel1((float*)a, (char*)b, c, (996));
// CHECK:   kernel2<(4), (996)>((char*)b, (32));
// CHECK: }
