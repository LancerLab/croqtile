// RUN: choreo -t factor -gs %s -o - | FileCheck %s --match-full-lines

__cok__ {
  extern "c" void vector_mul_kernel(float *lhs, float *rhs, float *out,
                                    int lspan, int rspan) {
    for (inti = 0; i < lspan; i++) {
      for (int j = 0; j < rspan; j++) {
        out[i * rspan + j] = lhs[i] * rhs[j];
      }
    }
  }
}

__co__ f32[512, 512] vector_mul(f32[512] lhs, f32[512] rhs) {
  f32[512, 512] output;
  parallel p by 4 {
    lhs_share = dma.copy.async lhs => shared;
    rhs_share = dma.copy.async rhs.chunkat(p) => shared;
    local f32[lhs_share.span(0), rhs_share.span(0)] l2_out;
    with index = {lhs_tile, rhs_tile} in[128, 128] {
      wait lhs_share, rhs_share;
      foreach
        lhs_tile {
          foreach
            rhs_tile {
              lhs_local = dma.copy.async lhs_share => local;
              rhs_local = dma.copy.async rhs_share => local;
              wait lhs_local, rhs_local;

              local f32[lhs_local.span(0) / #lhs_tile,
                        rhs_local.span(0) / #rhs_tile] l1_out;

              call vector_mul_kernel(lhs_local.data, rhs_local.data, l1_out,
                                     | lhs_local.span |, | rhs_local.span |);

              l1_out_store = dma.copy.async l1_out => l2_out.chunkat(lhs_tile, rhs_tile);
              wait l1_out_store;
            }
        }
    }

    // out_store = dma.copy.async l2_out => output.chunkat(1, p);
    with one in[1] {
      foreach
        one {
          out_store = dma.copy.async l2_out => output.chunkat(one, p);
          wait out_store;
        }
    }
  }
  return output;
}

