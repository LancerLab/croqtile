// REQUIRES: TARGET-GCUALL
// RUN: choreo -gs -t factor %s -o %s.factor.result && bash %s.factor.result --execute | FileCheck --check-prefix=CHKRUN --match-full-lines %s && rm -f %s.factor.result

#include "choreo.h"

__cok__ {
  __co_device__ extern "C" void kernel(float* ptr, float f32) {
    ptr[1] = f32;
  }
}

__co__ f32 [2] func() {
  global f32 [2] out;
  parallel p by 1 {
    parallel q by 1 {
      local f32 [2] buf;
      call kernel(buf, 0.32f);
      dma.copy buf => out;
    }
  }
  return out;
}

int main() {
  auto res = func();

  if (std::abs(res.data()[1] - 0.32f) >= 0.000001f) {
    std::cout << "Error: " << res.data()[1] << std::endl;
    return 1;
  }  
  std::cout << "Passed." << std::endl;
  return 0;
}



// CHKRUN: Passed.
