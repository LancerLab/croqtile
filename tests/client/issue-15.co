// CHECK:     int __iv_y = 0;
// CHECK:     for (__iv_x = 0; __iv_x < ((2)+(c))%(c); ++__iv_x) {
// CHECK:       for (__iv_y = 0; __iv_y < ((2)+(c))*(32); ++__iv_y) {
// CHECK:       } // y
// CHECK:       __iv_y = 0;
// CHECK:     } // x
// CHECK:     __iv_x = 0;
// CHECK:   }
// CHECK:   kernel0();
// CHECK:   kernel1((float*)a, (char*)b, c, (996));
// CHECK:   kernel2<(4), (997)>((char*)b, ((1028)*((2)+(c))));
