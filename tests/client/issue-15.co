// RUN: choreo -t topscc %s -es -o - 2>&1 |FileCheck %s

__co__ auto foo(f32 [32, 4] a, s8 [1] b, int c) {
  int d = 996;
  int e = a.span(0) + d;
  int f = 2 + c;
  parallel p by 2 {
    with index = {x, y} in [f % c, f*a.span(0)] {
      foreach index {}
    }
    call kernel0();
    call kernel1(a, b, c, d);
    call kernel2<b.span(0)+3, d + 1>(b, e * f);
  }
}


