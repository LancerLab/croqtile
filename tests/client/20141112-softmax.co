// RUN: choreo -i %s | FileCheck --match-full-lines %s
// RUN: choreo %s 2>&1 | FileCheck --check-prefix=CHKERR %s

__co__ f32 [M] softmax(f32 [M, N] input,int TILE_M) {
  f32[input.span(0)] output;

  parallel p by 1 {
    with index = {m_tile, n_tile} in [M/TILE_M, N/N] {  // Define tile size
      foreach m_tile {
        local f32[TILE_M] local_output;

        // Use DMA to load tile data into local memory
        local_input = dma.copy input.chunkat(m_tile, n_tile) => local;

        // Call the softmax kernel function
        call kernel(local_input.data, local_output, TILE_M, N);

        // Copy the result back to global memory
        dma.copy local_output => output.chunkat(m_tile);
      }
    }
  }
  return output;
}

// CHECK: Parameter: ::softmax::input, Type: f32 mdspan<2> [::softmax::M, ::softmax::N]
// CHECK: Parameter: ::softmax::TILE_M, Type: int
// CHECK: Symbol:    ::softmax::output, Type: global f32 mdspan<1> [::softmax::M]
// CHECK: Bounded:   ::softmax::paraby_0::p, Type: {int}->[1]
// CHECK: Bounded:   ::softmax::paraby_0::within_0::index, Type: {int,int}->[::softmax::M/::softmax::TILE_M, 1]
// CHECK: Bounded:   ::softmax::paraby_0::within_0::m_tile, Type: {int}->[::softmax::M/::softmax::TILE_M]
// CHECK: Bounded:   ::softmax::paraby_0::within_0::n_tile, Type: {int}->[1]
// CHECK: Symbol:    ::softmax::paraby_0::within_0::foreach_0::local_output, Type: local f32 mdspan<1> [::softmax::TILE_M]
// CHECK: Future:    ::softmax::paraby_0::within_0::foreach_0::local_input, Type: sync=>local f32 mdspan<2> [::softmax::TILE_M, ::softmax::N]
// CHECK: Future:    ::softmax::paraby_0::within_0::foreach_0::(anon), Type: sync=>global f32 mdspan<1> [::softmax::TILE_M]
// CHECK: Function:  ::softmax, Type: f32 mdspan<1> [::softmax::M] (*)(f32 mdspan<2> [::softmax::M, ::softmax::N], int)

// CHKERR: GCU forbids local variable 'local_output` to be dynamically shaped (by [::softmax::TILE_M]).
// CHKERR: GCU forbids local variable 'local_input__buf__` to be dynamically shaped (by [::softmax::TILE_M, ::softmax::N]).
// CHKERR: Totally 2 errors have been detected.
