// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto placeholder(f32 [24, 17, 128] a) {
   f = dma.none;
   parallel p by 8 {
     with index = {x, y} in [17, 4] {
       f1 = dma.none;
       f2 = f;   // illegal assignment of dma.none
       f3 = dma.none;
       f4 = dma.none;
       foreach x, y(1: -1) {
          f5 = dma.none;
          f = dma.copy.async a.chunkat(p, x, y) => local;
          f1 = dma.copy a.chunkat(p, x, y) => local;
          f3 = dma.copy.async a.chunkat(p, x, y) => local;
          f5 = dma.copy.async a.chunkat(p, x, y) => local;
          swap(f4, f);  // can not swap placeholder
          swap(f1, f3); // async vs sync
          swap(f5, f);  // ok.
       }
       f4 = dma.copy.async a.chunkat(p, x, y) => local;
       swap(f4, f3);  // ok.
       f32 [f1.span] data;
       call kernel(|f.span|, |f1.span|, |f3.span|, data);
     }
   }
   return f.data;
}

// CHECK: can not initialize vairable `f2' with a placeholder.
// CHECK: only support swapping of 'future'. (f4: placeholder<FUTURE>).
// CHECK: swapping data of different types (sync=>local f32 mdspan<3> [] vs. async=>local f32 mdspan<3> []
