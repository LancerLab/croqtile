// RUN: not choreo -es -t cute -arch=sm_90a %s -o /dev/null 2>&1 | FileCheck %s

__co__ void trigger_after_wait_operation_future() {
  parallel b by 1 : block {
    shared f16[64, 64] lhs;
    shared f16[128, 64] rhs;
    shared event done;

    parallel g by 2 : group-4 {
      inthreads.async (g == 0) {
        acc = mma.fill.f32 0.0f;
        qk = mma.row.row.async acc, lhs, rhs;
        wait qk;
        trigger done after qk;
      }
      inthreads.async (g == 1) {
        wait done;
      }
    }
  }
}

// CHECK: error: trigger-after cannot bind future '{{.*}}qk' after it was explicitly waited; trigger the event directly after the wait.
// CHECK: Totally 1 errors have been detected.
