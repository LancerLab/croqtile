// A placeholder cannot be an array dimension.  The compiler must report the
// reserved placeholder token rather than treating it as an undeclared symbol.
//
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ void placeholder_array_dim(int M) {
  parallel by 1 : block {
    parallel by 1 : thread {
      shared s8 [M] arr[_];
    }
  }
}

// CHECK-NOT: symbol `_' is used before declaration.
// CHECK: error: placeholder `_` is not a value; use it only in a dimension or chunkat wildcard position.
// CHECK-NOT: symbol `_' is used before declaration.
