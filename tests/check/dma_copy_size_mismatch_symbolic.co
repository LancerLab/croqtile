// A symbolic total is rejected when the size check can prove the two sides
// unequal; independent extents remain undecidable and are accepted.
//
// RUN: not choreo -es -t cc %s 2>&1 | FileCheck %s

__co__ void dma_copy_size_mismatch_symbolic(int M) {
  global f32 [M] src;
  global f32 [M + 1] dst;
  dma.copy src => dst;
}

// A static slot count multiplies the element extent, hiding the offset inside
// a product until the factor is distributed.
__co__ void dma_copy_size_mismatch_product(int M) {
  global f32 [M] src[3];
  global f32 [M + 1] dst[3];
  dma.copy src => dst;
}

// Different structural bases can still have a single-monomial difference.
__co__ void dma_copy_size_mismatch_monomial(int M) {
  global f32 [M] src[3];
  global f32 [M] dst[2];
  dma.copy src => dst;
}

// A multi-term difference with a definite sign is also provably nonzero.
__co__ void dma_copy_size_mismatch_sign(int M, int N) {
  global f32 [M + N + 1] src;
  global f32 [M] dst;
  dma.copy src => dst;
}

// CHECK: error: DMA statement has a size mismatch between 'from' and 'to': {{.*}}M != {{.*}}M + 1
// CHECK: error: DMA statement has a size mismatch between 'from' and 'to': {{.*}}dma_copy_size_mismatch_product::M * 3) != {{.*}}dma_copy_size_mismatch_product::M + 1) * 3)
// CHECK: error: DMA statement has a size mismatch between 'from' and 'to': {{.*}}dma_copy_size_mismatch_monomial::M * 3) != {{.*}}dma_copy_size_mismatch_monomial::M * 2)
// CHECK: error: DMA statement has a size mismatch between 'from' and 'to': {{.*}}dma_copy_size_mismatch_sign::M + {{.*}}dma_copy_size_mismatch_sign::N) + 1) != {{.*}}dma_copy_size_mismatch_sign::M
