// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto illegal_arith(bf16 x, f16 y) {
  f32 f = x + y; // error even auto promotion
  s32 s = 1501;
  f64 d = s * x;
  return f;
}
// CHECK: error: in operation "+": unable to apply to the types (mutable bf16 vs. mutable f16).
// CHECK: error: in operation "*": unable to apply to the types (mutable s32 vs. mutable bf16).
