// RUN: choreo -es -adf %s -o - 2>&1 | FileCheck %s
__cok__ {
  __device__ void getVoid();
  __device__ int* getIntPtr();
  __device__ std::set<int>* getUnKnown();
  __device__ __fp16 getfp16();
  __device__ void foo(int a=1, int b=2, int c); // illegal, default value for c is not set
}

__co__ void func() {
  parallel by 1 {
    mutable d = call getVoid(); // illegal, void type
    mutable e = call getUnKnown(); // illegal, unknown type
    mutable f = call getIntPtr(); // illegal, pointer type to span type, span type should not be mutable
    // illegal, __fp16 is parsed as an identifer, not a type, todo: some typical identifiers may be parsed as types
    mutable f16 g = call getfp16();
  }
}

// CHECK: error: Missing default argument on 3th parameter
// CHECK: error: can not initialize `d' with a void type.
// CHECK: error: `e' with a type of "unknown mdspan<>" can not be declared as 'mutable'.
// CHECK: error: `f' with a type of "s32 mdspan<>" can not be declared as 'mutable'.
// CHECK: warning: can not infer the type of `g' from the initialization expression '