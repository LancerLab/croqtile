// RUN: choreo -gs -t factor -arch=gcu300 %s 2>&1 | FileCheck %s --check-prefix=CHECK3

__co__ auto foo0(f32 [2,2,3,4,5,6] i, u8 [N, M] i1) {
  f32 [i.span] o;
  u8 [M, N] i2;
  parallel p by 1 {
    with {x, y} in [N/1024, M/128] {
      foreach x, y {
        b = dma.transp<1, 0> i1.chunkat(x, y) => shared;
        c = dma.copy b => i2.chunkat(y, x);
      }
    }
  }
  return o;
}

// CHECK3: choreo::runtime_check(((hp1.shape()[1] * hp1.shape()[0]) < 4294967296), "The size of data transferred by DMA cannot exceed 2^32,

