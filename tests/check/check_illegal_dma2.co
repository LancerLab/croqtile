// CHECK3: choreo::runtime_check(hp1.shape()[1] < 16777216ULL, "On GCU300, must satisfy: the 2nd dim ::foo0::M < 16777216,
// CHECK3: choreo::runtime_check((((hp1.shape()[0] + 127) / 128) * 128) < 16777216ULL, "On GCU300, must satisfy: CeilTo128Byte(src_dim0_size * bpe) < 2^24,

