// RUN: choreo %s 2>&1 | FileCheck %s
// RUN: choreo -arch=gcu400 %s 2>&1 | FileCheck --check-prefix=GCU4CHK %s

__co__ void bar() {
  sync.global;
  sync.shared;  // error
  sync.local;   // error
  parallel by 3 {
    sync.global;  // error
    sync.shared;
    sync.local;
    parallel by 2 {
      sync.global;  // error
      sync.shared;
      sync.local;
      parallel by 1 {
        sync.global;
        sync.shared;
        sync.local;
      }
    }
  }
}

// CHECK: error: unsupported: shared synchronization in global scope.
// CHECK: error: GCU300 does not support local synchronization.
// CHECK: error: unsupported: global synchronization in shared scope.
// CHECK: error: GCU300 does not support local synchronization.
// CHECK: error: unsupported: global synchronization in local scope.
// CHECK: error: GCU300 does not support local synchronization.
// CHECK: error: the parallel level (depth: 3) is not supported by current GCU architecture (GCU300).
// CHECK: error: unsupported: global synchronization in sub-local scope.
// CHECK: error: GCU300 does not support local synchronization.

// GCU4CHK: error: unsupported: shared synchronization in global scope.
// GCU4CHK: error: unsupported: local synchronization in global scope.
// GCU4CHK: error: unsupported: global synchronization in shared scope.
// GCU4CHK: error: unsupported: local synchronization in shared scope.
// GCU4CHK: error: unsupported: global synchronization in local scope.
// GCU4CHK: error: unsupported: global synchronization in sub-local scope.
