// RUN: not choreo -sa check %s 2>&1 | FileCheck %s

__co__ auto illegal_select(f32 [128, 128] i) {
  tile_factor : [32, 16];

  parallel p by 1 {
    with idx = {x_tile, y_tile} in [32, 16] {
      foreach x_tile, y_tile {
        i_shared = dma.copy.async i.chunkat(x_tile, y_tile) => shared;
        // TODO(wsj) expect an error (need do checking after valno when we have storage type)
        shared f32 [4, 4] i_shared0;
        parallel q by 1{
          tile_factor_local : [1, 4];
          local f32 [i_shared.span / tile_factor_local] i_local0, i_local1, i_local2, i_local3;
          local f32 [4] i_local4;
          local s32 [i_shared.span / tile_factor_local] i_local5;
          // TODO(wsj) expect an error (need do checking after typeinfer when we have shape detail)
          // local f32 [4, 4] i_local6;
          with idx = {p_tile, q_tile} in [1, 4] {
            i_local_s0 = dma.copy.async i_shared.chunkat(p_tile, q_tile) => select(q_tile % 2, i_local0, i_local4) after i_shared;
            i_local_s1 = dma.copy.async i_shared.chunkat(p_tile, q_tile) => select(q_tile % 2, i_local0, i_local5) after i_shared;
            // i_local_s2 = dma.copy.async i_shared.chunkat(p_tile, q_tile) => select(q_tile % 2, i_local0, i_shared0) after i_shared;
            // i_local_s3 = dma.copy.async i_shared.chunkat(p_tile, q_tile) => select(q_tile % 2, i_local0, i_local6) after i_shared;
          }
        }
      }
    }
  }
}

