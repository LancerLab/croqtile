// RUN: choreo -muc -sa mucheck %s | FileCheck %s

#include "choreo.h"

__cok__ {
extern "C" void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}

}

__co__ auto ele_add(s32 [6, ?, 128] lhs, s32 [6, ?, 128] rhs) {
  s32[lhs.span] output;

  parallel p by 6 {
    with idx0 = {q, x, y} in lhs.span / {#p, 2, 32}, // [6/6, lhs.span(1) / 2, 128/32] = [1, lhs.span(1) / 2, 4 ]
         idx1 = {w, z, b} in rhs.span / {#p, 2, 32}
    where x <-> z {
      foreach idx0 {
        lhs_load = dma.copy.async lhs.chunkat(q, x, y) => local;
        rhs_load = dma.copy.async rhs.chunkat(q, z, y) => local;
        wait lhs_load, rhs_load;

        local s32[lhs_load.span] l1_out;
        call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|);

        out_store = dma.copy.async l1_out => output.chunkat(q,x,y);
        wait out_store;
      }
    }
  } // can use python styling
  return output;
}

// CHECK: [MemUsage] Function parameter `::ele_add::lhs`(global) need 6 * ::ele_add::$0 * 128 * 4 bytes.
// CHECK: [MemUsage] Function parameter `::ele_add::rhs`(global) need 6 * ::ele_add::$1 * 128 * 4 bytes.
// CHECK: [MemUsage] global `::ele_add::output` need : 6 * ::ele_add::$0 * 128 * 4 bytes.
// CHECK: [MemUsage] local `::ele_add::paraby_0::within_0::foreach_0::lhs_load` need 1536 bytes(1.5 KB).
// CHECK: [MemUsage] local `::ele_add::paraby_0::within_0::foreach_0::rhs_load` need 1536 bytes(1.5 KB).
// CHECK: [MemUsage] local `::ele_add::paraby_0::within_0::foreach_0::l1_out` need 1536 bytes(1.5 KB).