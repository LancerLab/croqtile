// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto illegal_mdspan(f32 [3, 4] a) {
  parallel p by 2 {
    with idx in [1, 2, 3] {
      dma.copy a.chunkat(p, idx) => local;
    }
  }
}

// CHECK: error: un-matched ranks between spanned data (2) and bounded variables (4).
// CHECK: Totally 1 errors have been detected.
