// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto foo() {
  s32[4,2,4,8,2] output;
  parallel p by 1 {
    with index = {d, e} in input.span[2, 2] {
      foreach index {
        shared s32[4,2,4,8,2] oo{100};
        dma.copy oo.span_as([4,8,8,2]).chunkat(d,_,_,e) => output.span_as([4,8,8,2]).chunkat(d,_,_,e);
      }
    }
  }
  return output;
}

// CHECK: error: slice and deslice in single DMA statement is not supported yet.