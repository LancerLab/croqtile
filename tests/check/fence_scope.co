// RUN: choreo -n -sa=CHECK %s 2>&1 | FileCheck %s

// Test: sync.fence : block inside thread scope (warning only)
__co__ void test_fence_block_in_thread() {
  parallel bx by 1 : thread {
    // CHECK: warning: sync.fence : block inside a parallel : thread scope; the fence scope exceeds the enclosing parallel level.
    sync.fence : block;
  }
}

// Test: sync.barrier : block without cooperative scope (error on targets that require it)
// The GPU target does not require cooperative for block barriers (uses __syncthreads).
__co__ void test_barrier_block_ok() {
  parallel bx by 1 : block {
    sync.barrier : block;
  }
}
