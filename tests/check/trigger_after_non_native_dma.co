// RUN: not choreo -es -t cute -arch=sm_90a %s -o /dev/null 2>&1 | FileCheck %s

__co__ void trigger_after_non_native_dma(global f16[64, 64] input) {
  parallel b by 1 : block {
    shared f16[64, 64] tile;
    shared event full;

    load = dma.copy.async input => tile;
    trigger full after load;
    wait full;
  }
}

// CHECK: error: trigger-after requires native completion-event binding; use an explicit wait followed by a direct trigger for this DMA future.
// CHECK: Totally 1 errors have been detected.
