// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto foo() {
  parallel by 2 {
    parallel by 4 : sublocal {}
  }
}


__co__ auto bar() {
  parallel by 2 : shared {
    parallel by 4 {}
  }
}

__co__ auto baz() {
  parallel p by 3 : local {
    parallel by 2 : shared {}
  }

  parallel p by 3 : shared {
    parallel by 4 : shared {}
  }
}

// CHECK: error: For nested parallel-by, either all must explicitly specify their parallelism level, or none should specify it — allowing Choreo to automatically infer the levels.
