// RUN: not choreo -gs %s 2>&1 | FileCheck %s

__co__ auto foo(f32 [2,4] a, int b) {
  f32 [a.span] c;
  parallel by 1 {
    a = "hello";
    b = &c;
    c = "world";
  }
  d = &a;
}

