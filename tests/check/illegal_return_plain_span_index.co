// Returning an indexed element of a plain span is not a whole symbol, so the
// single-span return scaffold cannot represent it.
//
// RUN: not choreo %s 2>&1 | FileCheck %s

__co__ auto ret_plain_span_index() {
  f32 [4] a;
  return a[0];
}

// CHECK: error: returning an indexed element of a span is not supported
