// SM90 sparse atoms consume one uint32_t metadata value. A u64 register is a
// register, so the generic "load it with mma.load" guidance sends the reader
// to a fix that cannot work; report the u32 width requirement instead.
//
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ auto reject_u64_sparse_metadata(
    f16 [64, 16] lhs_packed, f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    lhs_s = dma.copy lhs_packed => shared;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel by 1 : group-4 {
      u64 me = __to<u64>(0);
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: sparse WGMMA metadata register must be a 32-bit unsigned integer (u32); SM90 sparse atoms consume a uint32_t metadata value
