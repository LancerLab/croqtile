// The loop-range check now supplies explicit compiler facts (step = 0) rather
// than relying on message classification; enriching a message must not inflate
// occurrences, and the whole rejection stays inside the token budget.
//
// RUN: not choreo -es -t cc -agent-diagnostics=- %s -o /dev/null 2>/dev/null | FileCheck %s

__co__ void zero_step(f32 [6, 4] x) {
  parallel p by 1 : block {
    with {a} in [6] {
      foreach a(0:6:0) {
        x.at(a, 0) = 1.0f;
      }
    }
  }
}

// CHECK: <compile_result status="rejected" {{.*}} diagnostics="1" omitted="0" {{.*}}>
// CHECK-NEXT: <diagnostic severity="error" category="loop-range"{{.*}}occurrences="1"{{.*}}tokens="{{[1-9][0-9]?}}">
// CHECK-NEXT: <constraint>foreach step; predicate: step != 0</constraint>
// CHECK-NEXT: <observed>step = 0; valid: {{.*}}</observed>
// CHECK-NEXT: <location file="{{.*}}loop_range_repair.co" line="{{[0-9]+}}" column="{{[0-9]+}}">foreach a(0:6:0) {</location>
// CHECK-NEXT: <repair priority="high" confidence="certain"><do>Set the foreach step to at least 1.</do><why>{{.*}}</why><alt>{{.*}}</alt></repair>
// CHECK-NEXT: </diagnostic>
// CHECK-NEXT: </compile_result>
