// RUN: choreo -e %s | FileCheck %s --match-full-lines

__co__ int with_foreach(int b, f32 mdspan<4> input) {
  ndims : [3, b, 7];
  int sum = 0;
  parallel p by 6 { 
    with index in ndims {
      foreach index {
        f = dte.linear input.chunkat(p, index) => local;
        sum = sum + index(0);
        wait f;
        call cfunction(sum);
      }
    }
  }
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: with_foreach
// CHECK:  `- Return type: int
// CHECK:  `- Parameters
// CHECK:    `-  type: int, symbol: b
// CHECK:    `-  type: f32 <4>, symbol: input
// CHECK:  `- Type Decl: ndims - [ 3 b 7 ]
// CHECK:  `- Var Decl (int): sum = 0
// CHECK:  `- Parellelization:  IV symbol: p, bound: 6
// CHECK:   `- With Block:
// CHECK:     (within constraints)
// CHECK:     `- index in ndims
// CHECK:     (with statements)
// CHECK:     `- Foreach Block:
// CHECK:      `- Iteration variables: index
// CHECK:      `- DMA.linear
// CHECK:        `- future: f
// CHECK:        `- from: input.ChunkAt(p, index)
// CHECK:        `- to: local
// CHECK:      `- Assign: sum =  (sum + index(0))
// CHECK:      `- WAIT: f
// CHECK:      `- Call: cfunction
// CHECK:        `- with arguements:sum
