// RUN: choreo -e %s | FileCheck --match-full-lines %s
#include <iostream>

// device program
__co__ f16 mdspan<1> spanned(f32 mdspan<3> d, int f) {
  dim1 : [100, 100];
  mdspan dim2 : [9, f];

  f32 [dim1] data0;
  u8 [10, 20, 30] data1;
  f16 [d.span] data2;
  s32 [dim2 / {1, 3}] data3;
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: spanned
// CHECK:  `- Return type: f16 <1>
// CHECK:  `- Parameters
// CHECK:    `-  type: f32 <3>, symbol: d
// CHECK:    `-  type: int, symbol: f
// CHECK:  `- Type Decl: dim1 - [ 100 100 ]
// CHECK:  `- Type Decl: dim2 - [ 9 f ]
// CHECK:  `- Var Decl (f32 [ dim1 ]): data0
// CHECK:  `- Var Decl (u8 [ 10 20 30 ]): data1
// CHECK:  `- Var Decl (f16 d.span): data2
// CHECK:  `- Var Decl (s32  (dim2 / {1, 3}) ): data3
