// RUN: choreo -e %s | FileCheck --match-full-lines %s

// recognize the __co__ function

#include <iostream>

// device program
__co__ int if_else(int a) {
   if (a > 0) {
      a = a - 1;
      a = a - 1;
   }

   if (a > 0) {
      a = a - 1;
      a = a - 1;
   }
   else {
      a = a + 1;
      a = a + 1;
   }

   if (a > 0) {
      a = a - 1;
      a = a - 1;
      if (a > 0) {
          a = a - 1;
          a = a - 1; 
      }
   }

   if (a > 0) {
      a = a - 1;
      a = a - 1;
      if (a > 0) {
          a = a - 1;
          a = a - 1; 
      }
      else {
          a = a + 1;
          a = a + 1; 
      }      
   }

   if (a > 0) {
      a = a - 1;
      a = a - 1;
      if (a > 0) {
          a = a - 1;
          a = a - 1; 
      }     
   }  
   else {
      a = a + 1;
      a = a + 1;
   }
   
}

