// REQUIRES: TARGET-GCUALL
// RUN: choreo -e %s | FileCheck --match-full-lines %s

__co__ int identity(int loc) { /// device program
  print(loc);
  return loc;
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: identity
// CHECK:  `- Return type: s32
// CHECK:  `- Parameters:
// CHECK:    `-  type: s32, symbol: loc
// CHECK:  `- Call: print (built-in)
// CHECK:    `- with arguments: loc
// CHECK:  `- Return: loc

__co__ void prints(int a, f32 [3, 2] b) {
  print("hello");
  println("this is ", a);

  print!("wor" "ld!");
  println!("that is ", b.span);
}

// CHECK:  `- Call: print (built-in)
// CHECK:    `- with arguments: "hello"
// CHECK:  `- Call: println (built-in)
// CHECK:    `- with arguments: "this is ", a
// CHECK:  `- Call: print (compile-time built-in)
// CHECK:    `- with arguments: "world!"
// CHECK:  `- Call: println (compile-time built-in)
// CHECK:    `- with arguments: "that is ", b.span
