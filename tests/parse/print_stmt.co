// REQUIRES: TARGET-GCUALL
// RUN: choreo -e %s | FileCheck --match-full-lines %s

#include "choreo.h"

__cok__ { /// kernel program
} /// end of kernel decl


__co__ int identity(int loc) { /// device program
  print(loc);
  return loc;
}

int main() { /// host program
  choreo::int loc = 7;
  auto res
    = identity(input_data, loc);
  std::cout << res.data();
}
// CHECK: ChoreoFunction
// CHECK:  `- Name: identity
// CHECK:  `- Return type: int
// CHECK:  `- Parameters
// CHECK:    `-  type: int, symbol: loc
// CHECK:  `- Call: print (built-in)
// CHECK:    `- with arguments: loc
// CHECK:  `- Return: loc
