// RUN: choreo -e %s | FileCheck --match-full-lines %s

__co__ void floats(bool a, int b, half8 c, half d, bfp16 e, float f, double g) {
  half8 aa = 1;
  half bb = 2.0f;
  bfp16 cc = 3;
  float dd = 3.0f;
  double ee = 75.0;
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: floats
// CHECK:  `- Return type: void
// CHECK:  `- Parameters
// CHECK:    `-  type: bool, symbol: a
// CHECK:    `-  type: int, symbol: b
// CHECK:    `-  type: half8, symbol: c
// CHECK:    `-  type: half, symbol: d
// CHECK:    `-  type: bfp16, symbol: e
// CHECK:    `-  type: float, symbol: f
// CHECK:    `-  type: double, symbol: g
// CHECK:  `- Var Decl (half8): aa = 1
// CHECK:  `- Var Decl (half): bb = 2.000000f
// CHECK:  `- Var Decl (bfp16): cc = 3
// CHECK:  `- Var Decl (float): dd = 3.000000f
// CHECK:  `- Var Decl (double): ee = 75.000000
