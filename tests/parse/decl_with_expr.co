// RUN: choreo -e %s | FileCheck %s

__co__ u8 scalar_decls(int a, int b) {
  int c = a + (b - a) * a + a / 5 - b % a;
  c = 6 + 1;
  int d = b + 2;
  int e = 6 + 1;
  bool y = true;
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: scalar_decls
// CHECK:  `- Return type: u8
// CHECK:  `- Parameters
// CHECK:    `-  type: int, symbol: a
// CHECK:    `-  type: int, symbol: b
// CHECK:  `- Decl (int): c =  ( ( (a +  ( (b - a)  * a) )  +  (a / 5) )  -  (b % a) )
// CHECK:  `- Assign: c =  (6 + 1)
// CHECK:  `- Decl (int): d =  (b + 2)
// CHECK:  `- Decl (int): e =  (6 + 1)
// CHECK:  `- Decl (bool): y = true

// host program
int host(int a, int b) {
  return scalar_decls(a, b);
}
