// RUN: choreo -e %s | FileCheck --match-full-lines %s

__co__ int span_as(s32 [32, 18, 9] a) {
  f32 [a.span] b;
  parallel p by 2 {
     dma.copy a.span_as([16, 9, 36]).chunkat(p, p, p) => local;
//     ns_b = b.span_as([96, 9, 6]);
//     dma.copy ns_b.chunkat(p, p, p) => local;
  }
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: span_as
// CHECK:  `- Return type: int
// CHECK:  `- Parameters
// CHECK:    `-  type: s32 [ 32 18 9 ], symbol: a
// CHECK:  `- Var Decl (f32 [ a.span ], default): b
// CHECK:  `- Parallelization:  index symbol: p, bound [0, 2)
// CHECK:   `- DMA.copy
// CHECK:     `- from: anon_0(a.span_as[ 16 9 36 ]).ChunkAt(p, p, p)
// CHECK:     `- to: local
