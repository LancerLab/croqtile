// REQUIRES: TARGET-GCUALL
// RUN: choreo -e %s | FileCheck --match-full-lines %s
__cok__ {

  template <typename T>
  __device__ void print_buffer(__private__ T * buffer, int len);
  template <typename T>
  __device__ void print_vector(T vec, int len);

  template <typename T, int vector_length, bool high>
  __device__
      typename tcle::altivector<unsigned int, vector_length>::VT get_i64_part(
          __private__ T * ptr);
  template <typename T, int vector_length, bool high>
  __device__
      typename tcle::altivector<unsigned int, vector_length>::VT get_i64_part(
          T * ptr);

  template <typename T, int vector_length>
  __device__ bool contain(__private__ T * array, T key);
  template <typename T, int vector_length>
  __device__ int index(__private__ T * array, T key);
  template <typename T, int vector_length>
  __device__ int index(T * array, T key);

  template <typename T, int vector_length>
  __device__ int argmin(__private__ T * array,
                        int segment_length = vector_length,
                        int priority_segment = 0);

  template <typename T, typename T_K, int BS_GATHER_LEN = 0, int LOOP_SIZE,
            T_K empty_key>
  __attribute__((noinline, no_mem_alias_in_vldst, no_mem_alias_in_tar,
                 dtu_vld_latency(512))) __device__ int
  indexAllVecL3(__private__ int* out_slot_idx,
                __private__ int* out_empty_slot_idx, __private__ T* buffer_key,
                __private__ uint32_t* buffer_key_indices, int k_total_end,
                __private__ T* buffer_query, char* ld_tmp_addr,
                char* st_tmp_addr, uint32_t q_len);

  template <typename T, typename T_K, int vector_length, int LOOP_SIZE>
  __attribute__((noinline, no_mem_alias_in_vldst, no_mem_alias_in_tar,
                 dtu_vld_latency(512))) __device__ int
  argminAllVecL3(__private__ int* out_slot_idx,
                 __private__ T* buffer_counter_addr,
                 __private__ uint32_t* buffer_key_indices, int k_total_end,
                 char* ld_tmp_addr, char* st_tmp_addr, uint32_t q_len);

  template <int LOOP_SIZE>
  __attribute__((noinline, no_mem_alias_in_vldst, no_mem_alias_in_tar,
                 dtu_vld_latency(512))) __device__ void
  load_and_store_func_L3(
      float* input, uint32_t* indices, int* ind_offset, int* empty_offset,
      int* argmin_offset, int query_offset, float* d_values_addr,
      char* ld_tmp_addr, char* st_tmp_addr, int indices_cnt, int table_dim,
      int feature_dim, int feature_size, int feature_ld_cnt);

  template <typename key_type, uint32_t m_seed = 0>
  __device__ void MurmurHash3_32(__private__ key_type * keys,
                                 __private__ uint32_t* index, int index_mod,
                                 int keys_count);
}

// CHECK:  DeviceFunction: print_buffer -> template <typename T> void (unknown *, s32)
// CHECK:  DeviceFunction: print_vector -> template <typename T> void (unknown, s32)
// CHECK:  DeviceFunction: get_i64_part -> template <typename T, int vector_length, bool high> unknown (unknown *)
// CHECK:  DeviceFunction: get_i64_part -> template <typename T, int vector_length, bool high> unknown (unknown *)
// CHECK:  DeviceFunction: contain -> template <typename T, int vector_length> bool (unknown *, unknown)
// CHECK:  DeviceFunction: index -> template <typename T, int vector_length> s32 (unknown *, unknown)
// CHECK:  DeviceFunction: index -> template <typename T, int vector_length> s32 (unknown *, unknown)
// CHECK:  DeviceFunction: argmin -> template <typename T, int vector_length> s32 (unknown *, s32, s32)
// CHECK:  DeviceFunction: indexAllVecL3 -> template <typename T, typename T_K, int BS_GATHER_LEN = 0, int LOOP_SIZE, T_K empty_key> s32 (s32 *, s32 *, unknown *, unknown *, s32, unknown *, s8 *, s8 *, unknown)
// CHECK:  DeviceFunction: argminAllVecL3 -> template <typename T, typename T_K, int vector_length, int LOOP_SIZE> s32 (s32 *, unknown *, unknown *, s32, s8 *, s8 *, unknown)
// CHECK:  DeviceFunction: load_and_store_func_L3 -> template <int LOOP_SIZE> void (f32 *, unknown *, s32 *, s32 *, s32 *, s32, f32 *, s8 *, s8 *, s32, s32, s32, s32, s32)
// CHECK:  DeviceFunction: MurmurHash3_32 -> template <typename key_type, uint32_t m_seed = 0> void (unknown *, unknown *, s32, s32)