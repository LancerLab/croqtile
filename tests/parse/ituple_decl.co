// RUN: choreo -e %s | FileCheck --match-full-lines %s

__co__ bf16 tuple_decls(int a, int b) {
  nvals : [100, 10, 1, b];
  ituple val2 = [a, 9, 102];
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: tuple_decls
// CHECK:  `- Return type: bf16
// CHECK:  `- Parameters
// CHECK:    `-  type: int, symbol: a
// CHECK:    `-  type: int, symbol: b
// CHECK:  `- Decl (tuple): nvals [100, 10, 1, b]
// CHECK:  `- Decl (tuple): val2 [a, 9, 102]

// host program
int host(int a, int b) {
  return tuple_decls(a, b);
}
