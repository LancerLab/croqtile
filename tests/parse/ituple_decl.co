// RUN: choreo -e %s | FileCheck %s --match-full-lines

__co__ bf16 tuple_decls(int a, int b) {
  ituple val2 = {a, 9, 102};
  nvals = {100, 10, 1, b};
  nvals_reference_all = nvals;
  nvals_reference = nvals_reference_all {(2), (1)};
}

// CHECK: ChoreoFunction
// CHECK:  `- Name: tuple_decls
// CHECK:  `- Return type: bf16
// CHECK:  `- Parameters
// CHECK:    `-  type: int, symbol: a
// CHECK:    `-  type: int, symbol: b
// CHECK:  `- Decl (ituple): val2 = {a, 9, 102}
// CHECK:  `- Decl (ituple): nvals = {100, 10, 1, b}
// CHECK:  `- Decl (ituple): nvals_reference_all = nvals
// CHECK:  `- Decl (ituple): nvals_reference = nvals_reference_all {(2), (1)}

// host program
int host(int a, int b) {
  return tuple_decls(a, b);
}
