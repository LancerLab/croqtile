// RUN: choreo -t topscc -es -pa=loopnorm -ln %s -o - | FileCheck %s
__co__ void func(int a) {
  foreach idx in [4,6,12] {}

  foreach {i, j, k} in [1,2,3] : vectorize(j, 32) {}

  with  {i, j, k} in [1,2,3] {
    foreach i {}
  }

  with {i, j} in [4, 6] {
    foreach i(1:0) {}
  }
}


// CHECK:  `- With Block:
// CHECK:    (within constraints)
// CHECK:    `- idx = {idx__elem__0, idx__elem__1, idx__elem__2} in [ 4 6 12 ]
// CHECK:    (with statements)
// CHECK:    `- Foreach Block:
// CHECK:     `- Iteration variables: idx
// CHECK:  `- With Block:
// CHECK:    (within constraints)
// CHECK:    `- {i, j, k} in [ 1 2 3 ]
// CHECK:    (with statements)
// CHECK:    `- Var Decl (u32): vj =  call vectorize(j, 32)
// CHECK:    `- Foreach Block:
// CHECK:     `- Iteration variables: i
// CHECK:     `- Foreach Block:
// CHECK:      `- Iteration variables: j
// CHECK:      `- Suffixes:      call vectorize(j, 32)
// CHECK:      `- Foreach Block:
// CHECK:       `- Iteration variables: k
// CHECK:  `- With Block:
// CHECK:    (within constraints)
// CHECK:    `- {i, j, k} in [ 1 2 3 ]
// CHECK:    (with statements)
// CHECK:    `- Foreach Block:
// CHECK:     `- Iteration variables: i
// CHECK:  `- With Block:
// CHECK:    (within constraints)
// CHECK:    `- {i, j} in [ 4 6 ]
// CHECK:    (with statements)
// CHECK:    `- Assign: anon_0 = 1
// CHECK:    `- Assign: anon_1 = 0
// CHECK:    `- Foreach Block:
// CHECK:     `- Iteration variables: i
// CHECK:     `- Loop Control: (anon_0:anon_1:1)
