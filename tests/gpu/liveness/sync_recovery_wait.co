// REQUIRES: TARGET-GPU
// RUN: env CHOREO_SYNC_RECOVERY=1 choreo -n -es -t cute -arch=sm_90a --mem-reuse %s -o - 2>/dev/null | FileCheck %s
//
// Sync-recovery completion-wait milestone: tenant y is engine-read (dma copy
// out of the slot); tenant x then overwrites the same slot. The coloring
// merges them, so the handover y -> x carries a WAR completion obligation: the
// receiving tenant may write only once the engine has drained the reads it
// issued. The drain is per-thread state of the issuing (producer) threads, so
// the wait is inserted inside the producer tenant, after its last access and
// before the trigger that hands the slot over.
//
// CHECK: cde::cp_async_bulk_wait_group_read<0>();
// CHECK-NEXT: (void)sig.arrive();

__co__ s32 [16] reuse_wait(s32 [16] src) {
  s32 [16] out;

  parallel p by 1 : block {
    parallel q by 2 : group-4 {
      shared event sig;

      inthreads.async (q == 1) {
        shared s32 [16] y;
        dma.copy y => out;
        trigger sig;
      }

      inthreads.async (q == 0) {
        wait sig;
        shared s32 [16] x;
        x.at(0) = src.at(0);
        out.at(1) = x.at(0);
      }

      sync.barrier : block;
    }
  }

  return out;
}

int main() { return 0; }
