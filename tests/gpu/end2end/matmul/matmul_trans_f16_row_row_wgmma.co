// REQUIRES: TARGET-SM_90A
// RUN: choreo -gs -t cute -arch=sm_90a %s -o %s.cute.result && CUDA_VISIBLE_DEVICES=1 CHOREO_DISABLE_TIMING=1 bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define WARP_M 64
#define WARP_N 128
#define TILE_K 64
#define WARP_K 16

#define M 128
#define N 128
#define K 64

__co__ void matmul(global f16 [M, K] lhs, global f16 [N, K] rhs,
                   global f16 [N, M] output) {
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(N, WARP_N)] : block {
    shared f16 [WARP_M, TILE_K] lhs_s;
    shared f16 [WARP_N, TILE_K] rhs_s;
    mc = mma.fill.f16 0.0f;

    foreach {iv_k} in [cdiv(K, TILE_K)] {
      tma.copy.swiz<128> lhs.subspan(WARP_M, TILE_K).at(block_m, iv_k) => lhs_s;
      tma.copy.swiz<128> rhs.chunkat(block_n, iv_k) => rhs_s;

      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<128> lhs_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<128> rhs_s.chunkat(_, iv_warp);
          mma.row.row mc, ma, mb;
        }
      }
    }

    shared f16 [WARP_N, WARP_M] output_s;
    mma.store.transp mc, output_s;
    tma.copy output_s => output.subspan(WARP_N, WARP_M).at(block_n, block_m);
  }
}

int main() {
  auto lhs_h = choreo::make_spandata<choreo::f16>(M, K);
  auto rhs_h = choreo::make_spandata<choreo::f16>(N, K);
  auto res_h = choreo::make_spandata<choreo::f16>(N, M);
  lhs_h.fill_random(0.0f, 2.0f);
  rhs_h.fill_random(0.0f, 2.0f);
  res_h.fill(0.0f);

  half* a_d = nullptr;
  half* b_d = nullptr;
  half* c_d = nullptr;
  choreo::abend_true(cudaMalloc(&a_d, M * K * sizeof(half)));
  choreo::abend_true(cudaMalloc(&b_d, N * K * sizeof(half)));
  choreo::abend_true(cudaMalloc(&c_d, N * M * sizeof(half)));

  choreo::abend_true(
      cudaMemcpy(a_d, lhs_h.data(), M * K * sizeof(half), cudaMemcpyHostToDevice));
  choreo::abend_true(
      cudaMemcpy(b_d, rhs_h.data(), N * K * sizeof(half), cudaMemcpyHostToDevice));
  choreo::abend_true(
      cudaMemcpy(c_d, res_h.data(), N * M * sizeof(half), cudaMemcpyHostToDevice));

  auto lhs_d = choreo::make_spanview<choreo::f16, 2>(a_d, {M, K});
  auto rhs_d = choreo::make_spanview<choreo::f16, 2>(b_d, {N, K});
  auto res_d = choreo::make_spanview<choreo::f16, 2>(c_d, {N, M});

  matmul(lhs_d, rhs_d, res_d);
  choreo::abend_true(cudaDeviceSynchronize());
  choreo::abend_true(
      cudaMemcpy(res_h.data(), c_d, N * M * sizeof(half), cudaMemcpyDeviceToHost));

  float base_tol = 0.05f;
  float rel_tol = 0.02f;
  size_t step_i = std::max<size_t>(1, M / 8);
  size_t step_j = std::max<size_t>(1, N / 8);
  for (size_t i = 0; i < M; i += step_i)
    for (size_t j = 0; j < N; j += step_j) {
      float ref = 0.0f;
      for (size_t kk = 0; kk < K; ++kk)
        ref += choreo::to_f32(lhs_h[(int)i][(int)kk]) *
               choreo::to_f32(rhs_h[(int)j][(int)kk]);
      float got = choreo::to_f32(res_h[(int)j][(int)i]);
      float tol = base_tol + rel_tol * std::abs(ref);
      choreo::choreo_assert(std::abs(got - ref) <= tol,
                            "values are not equal.");
    }

  std::cout << "Test Passed\n" << std::endl;
}

// CHECK: Test Passed
