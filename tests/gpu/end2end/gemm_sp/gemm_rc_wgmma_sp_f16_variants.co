  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, 32);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, 8);
  auto rhs = choreo::make_spandata<choreo::f16>(256, 64);
  init_pattern_sparse_a<choreo::f16, 64>(lhs_dense);
  init_pattern_b<choreo::f16, 256, 64>(rhs);
  encode_wgmma_sp<choreo::f16, 64>(lhs_dense, lhs_packed, lhs_meta);
