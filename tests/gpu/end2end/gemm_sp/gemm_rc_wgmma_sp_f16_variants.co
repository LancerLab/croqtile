// REQUIRES: TARGET-SM_90A
// RUN: choreo -gs -t cute -arch=sm_90a %s -o %s.cute.result && CHOREO_DISABLE_TIMING=1 bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 64

template <typename T>
using SparsePolicyWGMMA = choreo::utils::SparsePolicyWGMMA<T>;

template <typename T, int NVAL, int KVAL>
void init_random_b(choreo::spanned_data<T, 2>& rhs, std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  for (size_t kk = 0; kk < KVAL; ++kk)
    for (size_t col = 0; col < NVAL; ++col) {
      float value = dist(gen);
      if (std::fabs(value) < 0.1f) value = (value < 0.0f ? -0.25f : 0.25f);
      rhs[col][kk] = choreo::utils::from_f32<T>(value);
    }
}

template <typename T, int NVAL, int KVAL>
int verify_result(const char* tag, choreo::spanned_data<T, 2>& lhs_dense,
                  choreo::spanned_data<T, 2>& rhs,
                  choreo::spanned_data<float, 2>& res, float tolerance) {
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < NVAL; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < KVAL; ++k)
        ref += choreo::to_f32(lhs_dense[i][k]) * choreo::to_f32(rhs[j][k]);
      float got = res[i][j];
      float diff = std::abs(got - ref);
      if (diff > tolerance) ++errors;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

__co__ auto matmul_sp_f16_n32_k64(f16 [M, 32] lhs_packed, u8 [M, 8] lhs_meta, f16 [32, 64] rhs) {
  f32 [M, 32] output{0.0f};
  int WARP_M = 64, WARP_N = 32, TILE_K = 64, WARP_K = 32;
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(32, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(64, TILE_K)] {
      lhs_load_s = tma.copy.swiz<64> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<128> rhs.chunkat(block_n, iv_k) => shared;
      lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<64> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<128> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }
  return output;
}

__co__ auto matmul_sp_f16_n32_k32(f16 [M, 16] lhs_packed, u8 [M, 4] lhs_meta, f16 [32, 32] rhs) {
  f32 [M, 32] output{0.0f};
  int WARP_M = 64, WARP_N = 32, TILE_K = 32, WARP_K = 32;
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(32, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(32, TILE_K)] {
      lhs_load_s = tma.copy.swiz<32> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<64> rhs.chunkat(block_n, iv_k) => shared;
      lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<32> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<64> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }
  return output;
}

int run_case_f16_n32_k64() {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, 64);
  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, 32);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, 8);
  auto rhs = choreo::make_spandata<choreo::f16>(32, 64);
  SparsePolicyWGMMA<choreo::f16>::init_structured_sparse_A(lhs_dense, gen);
  init_random_b<choreo::f16, 32, 64>(rhs, gen);
  SparsePolicyWGMMA<choreo::f16>::encode(lhs_dense, lhs_packed, lhs_meta);
  auto res = matmul_sp_f16_n32_k64(lhs_packed.view(), lhs_meta.view(), rhs.view());
  return verify_result<choreo::f16, 32, 64>("f16_n32_k64", lhs_dense, rhs, res, 1.0e-1f);
}

int run_case_f16_n32_k32() {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, 32);
  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, 16);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, 4);
  auto rhs = choreo::make_spandata<choreo::f16>(32, 32);
  SparsePolicyWGMMA<choreo::f16>::init_structured_sparse_A(lhs_dense, gen);
  init_random_b<choreo::f16, 32, 32>(rhs, gen);
  SparsePolicyWGMMA<choreo::f16>::encode(lhs_dense, lhs_packed, lhs_meta);
  auto res = matmul_sp_f16_n32_k32(lhs_packed.view(), lhs_meta.view(), rhs.view());
  return verify_result<choreo::f16, 32, 32>("f16_n32_k32", lhs_dense, rhs, res, 1.0e-1f);
}

int main() {
  int errors = 0;
  errors += run_case_f16_n32_k64();
  errors += run_case_f16_n32_k32();
  choreo::choreo_assert(errors == 0, "Sparse WGMMA f16 variants failed");
  std::cout << "Test Passed\n";
}

// CHECK: Test Passed
