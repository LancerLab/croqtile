// REQUIRES: TARGET-SM_90A
// RUN: choreo -gs -t cute -arch=sm_90a %s -o %s.cute.result && CHOREO_DISABLE_TIMING=1 bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 64

void init_structured_sparse_a(choreo::spanned_data<choreo::f8_e4m3, 2>& lhs_dense,
                              std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::uniform_int_distribution<int> pick(0, 3);
  std::memset(lhs_dense.data(), 0, lhs_dense.bytes());
  for (size_t row = 0; row < M; ++row)
    for (size_t group = 0; group < 64 / 4; ++group) {
      int idx0 = pick(gen);
      int idx1 = pick(gen);
      while (idx1 == idx0) idx1 = pick(gen);
      if (idx0 > idx1) std::swap(idx0, idx1);

      float v0 = dist(gen);
      float v1 = dist(gen);
      if (std::fabs(v0) < 0.1f) v0 = (v0 < 0.0f ? -0.5f : 0.5f);
      if (std::fabs(v1) < 0.1f) v1 = (v1 < 0.0f ? -0.75f : 0.75f);

      size_t base = group * 4;
      lhs_dense[row][base + idx0] = choreo::utils::from_f32<choreo::f8_e4m3>(v0);
      lhs_dense[row][base + idx1] = choreo::utils::from_f32<choreo::f8_e4m3>(v1);
    }
}

template <int NVAL>
void init_random_b(choreo::spanned_data<choreo::f8_e4m3, 2>& rhs,
                   std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  for (size_t kk = 0; kk < 64; ++kk)
    for (size_t col = 0; col < NVAL; ++col) {
      float value = dist(gen);
      if (std::fabs(value) < 0.1f) value = (value < 0.0f ? -0.25f : 0.25f);
      rhs[col][kk] = choreo::utils::from_f32<choreo::f8_e4m3>(value);
    }
}

void compress_structured_sparse_a(
    choreo::spanned_data<choreo::f8_e4m3, 2>& lhs_dense,
    choreo::spanned_data<choreo::f8_e4m3, 2>& lhs_packed,
    choreo::spanned_data<choreo::u8, 2>& lhs_meta) {
  std::memset(lhs_packed.data(), 0, lhs_packed.bytes());
  lhs_meta.fill(0);
  for (size_t row = 0; row < M; ++row)
    for (size_t group = 0; group < 64 / 4; ++group) {
      size_t base = group * 4;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (choreo::to_f32(lhs_dense[row][base + i]) != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          ++nz;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 sparse pattern");
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);

      size_t sparse_col = group * 2;
      lhs_packed[row][sparse_col + 0] = lhs_dense[row][base + idxs[0]];
      lhs_packed[row][sparse_col + 1] = lhs_dense[row][base + idxs[1]];

      choreo::u8 nibble = 0;
      if (idxs[0] == 0 && idxs[1] == 1)
        nibble = 0x4;
      else if (idxs[0] == 1 && idxs[1] == 2)
        nibble = 0x9;
      else if (idxs[0] == 2 && idxs[1] == 3)
        nibble = 0xE;
      else if (idxs[0] == 0 && idxs[1] == 2)
        nibble = 0x8;
      else if (idxs[0] == 1 && idxs[1] == 3)
        nibble = 0xD;
      else if (idxs[0] == 0 && idxs[1] == 3)
        nibble = 0xC;
      else
        choreo::choreo_assert(false, "Invalid fp8 2:4 sparse pattern");

      size_t byte_col = group / 2;
      if ((group & 1) == 0)
        lhs_meta[row][byte_col] = nibble;
      else
        lhs_meta[row][byte_col] |= static_cast<choreo::u8>(nibble << 4);
    }
}

template <int NVAL>
int verify_result(const char* tag,
                  choreo::spanned_data<choreo::f8_e4m3, 2>& lhs_dense,
                  choreo::spanned_data<choreo::f8_e4m3, 2>& rhs,
                  choreo::spanned_data<float, 2>& res, float tolerance) {
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < NVAL; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < 64; ++k)
        ref += choreo::to_f32(lhs_dense[i][k]) * choreo::to_f32(rhs[j][k]);
      float got = res[i][j];
      float diff = std::abs(got - ref);
      if (diff > tolerance) {
        if (errors < 8)
          std::cout << tag << " mismatch at (" << i << ", " << j
                    << ") gpu=" << got << " ref=" << ref
                    << " diff=" << diff << "\n";
        ++errors;
      }
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

__co__ auto matmul_sp_fp8_n32(f8_e4m3 [M, 32] lhs_packed, u8 [M, 8] lhs_meta,
                              f8_e4m3 [32, 64] rhs) {
  f32 [M, 32] output{0.0f};
  int WARP_M = 64, WARP_N = 32, TILE_K = 64, WARP_K = 64;
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(32, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(64, TILE_K)] {
      lhs_load_s = tma.copy.swiz<32> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<64> rhs.chunkat(block_n, iv_k) => shared;
      lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<32> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<64> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }
  return output;
}

__co__ auto matmul_sp_fp8_n64(f8_e4m3 [M, 32] lhs_packed, u8 [M, 8] lhs_meta,
                              f8_e4m3 [64, 64] rhs) {
