__co__ auto matmul_sp_fp8_n256(f8_e4m3 [M, 32] lhs_packed, u8 [M, 8] lhs_meta,
                               f8_e4m3 [256, 64] rhs) {
  f32 [M, 256] output{0.0f};
  int WARP_M = 64, WARP_N = 256, TILE_K = 64, WARP_K = 64;
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(256, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(64, TILE_K)] {
      lhs_load_s = tma.copy.swiz<32> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<64> rhs.chunkat(block_n, iv_k) => shared;
      lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<32> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<64> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }
  return output;
}

int run_case_fp8_n32() {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f8_e4m3>(M, 64);
  auto lhs_packed = choreo::make_spandata<choreo::f8_e4m3>(M, 32);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, 8);
  auto rhs = choreo::make_spandata<choreo::f8_e4m3>(32, 64);
  SparsePolicyWGMMA<choreo::f8_e4m3>::init_structured_sparse_A(lhs_dense, gen);
  init_random_b<32>(rhs, gen);
  SparsePolicyWGMMA<choreo::f8_e4m3>::encode(lhs_dense, lhs_packed, lhs_meta);
  auto res = matmul_sp_fp8_n32(lhs_packed.view(), lhs_meta.view(), rhs.view());
  return verify_result<32>("fp8e4m3_n32_k64_swiz32_32", lhs_dense, rhs, res,
                           0.5f);
}

int run_case_fp8_n64() {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f8_e4m3>(M, 64);
  auto lhs_packed = choreo::make_spandata<choreo::f8_e4m3>(M, 32);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, 8);
  auto rhs = choreo::make_spandata<choreo::f8_e4m3>(64, 64);
  SparsePolicyWGMMA<choreo::f8_e4m3>::init_structured_sparse_A(lhs_dense, gen);
  init_random_b<64>(rhs, gen);
  SparsePolicyWGMMA<choreo::f8_e4m3>::encode(lhs_dense, lhs_packed, lhs_meta);
  auto res = matmul_sp_fp8_n64(lhs_packed.view(), lhs_meta.view(), rhs.view());
  return verify_result<64>("fp8e4m3_n64_k64_swiz32_32", lhs_dense, rhs, res,
                           0.5f);
}

