int main() {
  int errors = 0;
  errors += run_case_fp8_n32();
  errors += run_case_fp8_n64();
  errors += run_case_fp8_n96();
  errors += run_case_fp8_n128();
  errors += run_case_fp8_n256();
  choreo::choreo_assert(errors == 0, "Sparse WGMMA fp8 variants failed");
  std::cout << "Test Passed\n";
}

// CHECK: Test Passed
