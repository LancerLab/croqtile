// REQUIRES: TARGET-SM_86+
// RUN: choreo -gs -t cute -arch=sm_86 %s -o %s.cute.result && bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result
// cocc not yet tested: CoIR emitBarrier does not support grid-level sync
// or cooperative launch attributes.

// Cooperative launch end2end test: validates that grid-level sync works
// correctly when multiple blocks exchange data through global memory.
// Without cooperative launch, block 0 could read a[1] before block 1
// writes it, producing stale (0) values. With grid sync, both blocks
// reliably see each other's writes.

#include "choreo.h"

__co__ s32[2] coop_grid_sync() {
  s32[2] a;
  s32[2] b;

  parallel bx by 2 : block<cooperative> {
    a.at(bx) = bx + 1;       // block 0 writes 1, block 1 writes 2
    sync.barrier : block;    // grid-level sync
    b.at(bx) = a.at(1 - bx); // read neighbor's value
  }
  return b;
}

int main() {
  auto res = coop_grid_sync();
  choreo::choreo_assert(res[0] == 2,
    "block 0 should see block 1's value (2)");
  choreo::choreo_assert(res[1] == 1,
    "block 1 should see block 0's value (1)");
  std::cout << "Test Passed\n";
}

// CHECK: Test Passed
