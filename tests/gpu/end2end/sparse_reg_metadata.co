// F1 (section 2.3): sparse metadata may be a plain u32 register instead of
// mma.load from shared memory. (SM90 sparse atoms take one uint32_t metadata
// register, so u64 is out of scope.) This round uses a uniform 2:4 pattern
// (indices 0 and 1 selected in every group of four), so every metadata byte
// is 0x44 and the per-thread WGMMA descriptor is the constant 0x44444444.
// The compressed A is produced by the host encoder; the result must match the
// dense reference bit-exactly (within tolerance).
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -t cute -gs %cuda_arch %s | bash -s -- --execute | FileCheck --match-full-lines %s

__co__ auto sparse_reg_metadata(f16 [64, 16] lhs_packed, f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  int WARP_M = 64, WARP_N = 8, TILE_K = 32, WARP_K = 32;
  parallel {block_m, block_n} by [cdiv(64, WARP_M), cdiv(8, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(32, TILE_K)] {
      lhs_load_s = tma.copy.swiz<32> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<64> rhs.chunkat(block_n, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = lhs_load_s.chunkat(_, iv_warp);
          mb = rhs_load_s.chunkat(_, iv_warp);
          u32 me = __to<u32>(0x44444444);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }
  return output;
}

int main() { /// host program
  std::mt19937 gen(123);
  std::uniform_real_distribution<float> dist(0.25f, 1.0f);

  auto dense = choreo::make_spandata<choreo::f16>(64, 32);
  auto packed = choreo::make_spandata<choreo::f16>(64, 16);
  auto meta = choreo::make_spandata<choreo::u8>(64, 4);
  auto rhs = choreo::make_spandata<choreo::f16>(8, 32);

  // Uniform 2:4 pattern: non-zero values at indices 0 and 1 of each group of
  // four, zeros at 2 and 3.
  for (size_t i = 0; i < 64; ++i)
    for (size_t g = 0; g < 8; ++g) {
      dense[i][4 * g + 0] =
          choreo::utils::from_f32<choreo::f16>(dist(gen));
      dense[i][4 * g + 1] =
          choreo::utils::from_f32<choreo::f16>(dist(gen));
      dense[i][4 * g + 2] =
          choreo::utils::from_f32<choreo::f16>(0.0f);
      dense[i][4 * g + 3] =
          choreo::utils::from_f32<choreo::f16>(0.0f);
    }

  for (size_t j = 0; j < 8; ++j)
    for (size_t k = 0; k < 32; ++k)
      rhs[j][k] = choreo::utils::from_f32<choreo::f16>(dist(gen));

  choreo::utils::SparsePolicyWGMMA<choreo::f16>::encode(dense, packed, meta);

  int meta_errors = 0;
  for (size_t i = 0; i < 64; ++i)
    for (size_t c = 0; c < 4; ++c)
      if (static_cast<unsigned>(meta[i][c]) != 0x44u) ++meta_errors;

  auto res = sparse_reg_metadata(packed.view(), rhs.view());

  int errors = 0;
  for (size_t i = 0; i < 64; ++i)
    for (size_t j = 0; j < 8; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < 32; ++k)
        ref += choreo::to_f32(dense[i][k]) * choreo::to_f32(rhs[j][k]);
      if (std::abs(res[i][j] - ref) > 1.0e-1f) ++errors;
    }

  std::cout << "meta_errors=" << meta_errors << " errors=" << errors
            << std::endl;
  choreo::choreo_assert(meta_errors == 0, "metadata is not uniform 0x44");
  choreo::choreo_assert(errors == 0, "results are not equal");
  std::cout << "Test Passed\n" << std::endl;
}

// CHECK: Test Passed
