// REQUIRES: TARGET-GPU LIBRARY-CUTE GDB
// RUN: choreo -gs -t cute -g %s -o %s.cute.gdb.sh && bash %s.cute.gdb.sh --compile-link && exe=$(grep -o '/tmp/[^ ]*\.exe' %s.cute.gdb.sh | head -1) && gdb -q -batch "$exe" -ex "set pagination off" -ex "break debug_builtin_non_scalar_types" -ex "break __choreo_device_debug_builtin_non_scalar_types" -ex "run" -ex "next" -ex "next" -ex "next" -ex "next" -ex "ptype a" -ex "ptype b" -ex "ptype idx" -ex "print a[0]" -ex "print a[1]" -ex "print a[2]" -ex "print b[0]" -ex "print b[1]" -ex "print b[2]" -ex "print idx[0]" -ex "print idx[1]" -ex "print idx[2]" -ex "print idx.ub[0]" -ex "print idx.ub[1]" -ex "print idx.ub[2]" -ex "continue" -ex "next" -ex "next" -ex "next" -ex "next" -ex "ptype didx" -ex "print didx[0]" -ex "print didx[1]" -ex "print didx[2]" -ex "print didx.ub[0]" -ex "print didx.ub[1]" -ex "print didx.ub[2]" 2>&1 | FileCheck %s --check-prefix=GDB && rm -f %s.cute.gdb.sh
// RUN: choreo -gs -t cute -g %s -o %s.cute.run.sh && bash %s.cute.run.sh --compile-link && exe=$(grep -o '/tmp/[^ ]*\.exe' %s.cute.run.sh | head -1) && "$exe" 2>&1 | FileCheck %s --check-prefix=PRINT && rm -f %s.cute.run.sh

__co__ void debug_builtin_non_scalar_types(s32 [32, 64] lhs, s32 x) {
  a : [7, 8, 9];
  ituple<3> b = {1, x, 3};

  with idx in [b] {
    println(111, idx);
  }

  parallel by 1 : block {
    with didx in [b] {
      println(222, didx);
    }
  }
}

int main() {
  auto lhs = choreo::make_spandata<choreo::s32>(32, 64);
  lhs.fill(0);
  debug_builtin_non_scalar_types(lhs.view(), 1);
  std::cout << "Run Done\n";
  return 0;
}

