// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 1
// GDB: ${{[0-9]+}} = 1
// GDB: ${{[0-9]+}} = 3
// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 0
// GDB: ${{[0-9]+}} = 1
// GDB: ${{[0-9]+}} = 1
