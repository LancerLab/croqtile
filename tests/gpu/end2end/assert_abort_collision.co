// REQUIRES: TARGET-GPU
// RUN: choreo -t cute -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// A device-side `assert` lowers to a direct `__co_abort__()` call.  The abort
// fallback in the runtime headers must not turn into an ambiguous
// `__builtin_trap` redefinition, or the generated CUDA fails to compile.

__co__ s32 [16] guarded_copy(s32 [16] x) {
  s32 [x.span] output;
  parallel p by 16 {
    assert(x.at(0) != 12345, "sentinel value leaked");
    output.at(p) = x.at(p);
  }
  return output;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(16);
  a.fill_random(-10, 10);

  auto res = guarded_copy(a.view());

  for (size_t i = 0; i < 16; ++i) {
    if (a[i] != res[i])
      choreo::choreo_assert(a[i] == res[i], "copy mismatch");
  }

  std::cout << "Test Passed\n" << std::endl;
}

// CHECK: Test Passed
