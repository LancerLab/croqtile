// REQUIRES: TARGET-SM_90A
// RUN: choreo -gs -t cute -arch=sm_90a %s -o %s.cute.result && CHOREO_DISABLE_TIMING=1 bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 64
#define N 16
#define K 64

#define TILE_K 64
#define WARP_K 32
#define LHS_SWIZ TILE_K
#define RHS_SWIZ (2 * TILE_K)

#if LHS_SWIZ != 32 && LHS_SWIZ != 64 && LHS_SWIZ != 128
#error "LHS_SWIZ must be one of 32, 64, 128"
#endif

#if RHS_SWIZ != 32 && RHS_SWIZ != 64 && RHS_SWIZ != 128
#error "RHS_SWIZ must be one of 32, 64, 128"
#endif

#if LHS_SWIZ != TILE_K
#error "Sparse packed 16-bit A must use swizzle equal to TILE_K"
#endif

#if RHS_SWIZ != (2 * TILE_K)
#error "Dense 16-bit B must use swizzle equal to 2 * TILE_K"
#endif

__co__ auto matmul_sp_k32_f16_n16(f16 [M, K / 2] lhs_packed,
                                  u8 [M, K / 8] lhs_meta, f16 [N, K] rhs) {
  f32 [M, N] output{0.0f};

  int WARP_M = 64, WARP_N = 16;

  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(N, WARP_N)] : block {
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(K, TILE_K)] {
      lhs_load_s = tma.copy.swiz<64> lhs_packed.chunkat(block_m, iv_k) => shared;
      rhs_load_s = tma.copy.swiz<128> rhs.chunkat(block_n, iv_k) => shared;
      lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => shared;
      foreach {iv_warp} in [cdiv(TILE_K, WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<64> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<128> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    mma.store mc, output.chunkat(block_m, block_n);
  }

  return output;
}

void init_pattern_sparse_a(choreo::spanned_data<choreo::f16, 2>& lhs_dense) {
  for (size_t row = 0; row < M; ++row) {
    for (size_t group = 0; group < K / 4; ++group) {
      size_t base = group * 4;
      lhs_dense[row][base + 0] = choreo::utils::from_f32<choreo::f16>(
          1.0f + 0.125f * static_cast<float>(row) +
          0.03125f * static_cast<float>(group));
      lhs_dense[row][base + 1] = choreo::utils::from_f32<choreo::f16>(0.0f);
      lhs_dense[row][base + 2] = choreo::utils::from_f32<choreo::f16>(
          -0.5f - 0.0625f * static_cast<float>(row) +
          0.015625f * static_cast<float>(group));
      lhs_dense[row][base + 3] = choreo::utils::from_f32<choreo::f16>(0.0f);
    }
  }
}

void init_pattern_b(choreo::spanned_data<choreo::f16, 2>& rhs) {
  for (size_t col = 0; col < N; ++col)
    for (size_t kk = 0; kk < K; ++kk) {
      float value = (static_cast<float>((kk % 7) - 3) * 0.25f) +
                    static_cast<float>(col + 1) * 0.5f;
      rhs[col][kk] = choreo::utils::from_f32<choreo::f16>(value);
    }
}

void encode_wgmma_sp_k32(choreo::spanned_data<choreo::f16, 2>& lhs_dense,
                         choreo::spanned_data<choreo::f16, 2>& lhs_packed,
                         choreo::spanned_data<choreo::u8, 2>& lhs_meta) {
  lhs_meta.fill(0);
  for (size_t row = 0; row < M; ++row) {
    for (size_t group = 0; group < K / 4; ++group) {
      size_t base = group * 4;
      int idx0 = -1;
      int idx1 = -1;
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (choreo::to_f32(lhs_dense[row][base + i]) != 0.0f) {
          if (nz == 0)
            idx0 = i;
          else if (nz == 1)
            idx1 = i;
          ++nz;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 sparse pattern");
      if (idx0 > idx1) std::swap(idx0, idx1);

      size_t sparse_col = group * 2;
      lhs_packed[row][sparse_col + 0] = lhs_dense[row][base + idx0];
      lhs_packed[row][sparse_col + 1] = lhs_dense[row][base + idx1];

      choreo::u8 nibble = static_cast<choreo::u8>(idx0 | (idx1 << 2));
      size_t byte_col = group / 2;
      if ((group & 1) == 0)
        lhs_meta[row][byte_col] = nibble;
      else
        lhs_meta[row][byte_col] |= static_cast<choreo::u8>(nibble << 4);
    }
  }
}

int main() {
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, K);
  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, K / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u8>(M, K / 8);
  auto rhs = choreo::make_spandata<choreo::f16>(N, K);

  init_pattern_sparse_a(lhs_dense);
  init_pattern_b(rhs);
  encode_wgmma_sp_k32(lhs_dense, lhs_packed, lhs_meta);

  auto res = matmul_sp_k32_f16_n16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  int errors = 0;
  constexpr float tolerance = 1.0e-2f;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K; ++k)
        ref += choreo::to_f32(lhs_dense[i][k]) * choreo::to_f32(rhs[j][k]);
      float got = res[i][j];
      float diff = std::abs(got - ref);
      if (diff > tolerance) {
        if (errors < 8)
          std::cout << "mismatch at (" << i << ", " << j << ") gpu=" << got
                    << " ref=" << ref << " diff=" << diff << "\n";
        ++errors;
      }
    }

  choreo::choreo_assert(errors == 0, "Sparse WGMMA verification failed");
  std::cout << "Test Passed\n";
}

// CHECK: Test Passed
