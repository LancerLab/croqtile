// A sparse WGMMA metadata register must have a defined value before the atom
// consumes it. A plain `u32 me;` declaration leaves the metadata register
// uninitialized, so reject it instead of emitting an indeterminate value.
//
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ auto sparse_metadata_uninitialized(
    f16 [64, 16] lhs_packed, f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    lhs_s = dma.copy lhs_packed => shared;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel by 1 : group-4 {
      u32 me;
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: sparse WGMMA metadata register must be initialized before use
