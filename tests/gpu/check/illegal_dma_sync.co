// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - 2>&1 | FileCheck %s

__co__ void foo(f32 [128, 128] input) {
  
  parallel b by 1 : block {
    parallel g by 2 : group-4 {
      shared f32 [128, 128] input_s;
      shared event full[2];
      
      inthreads (g == 0) {
        foreach {order} in [2] {
          load = tma.copy.async input.chunkat(_, _) => input_s;
          trigger full.at(order) after load;
        }
        tma.copy.async input.chunkat(_, _) => input_s;
      }
      foreach {order} in [2] {
        load = tma.copy.async input.chunkat(_, _) => input_s;
        trigger full.at(order) after load;
      }
    }
  }
}

// CHECK: error: forbid to associated async dma without a named future or a named event.
// CHECK: warning: Be careful to trigger event outside inthreads block
