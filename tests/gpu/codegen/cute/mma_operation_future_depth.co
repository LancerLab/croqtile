// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void mma_operation_future_depth() {
  parallel b by 1 : block {
    shared f16 [64, 64] lhs;
    shared f16 [128, 64] rhs;
    shared event qk_done;
    shared event pv_done;

    parallel g by 2 : group-4 {
      inthreads.async (g == 0) {
        qk_acc = mma.fill.f32 0.0f;
        qk = mma.row.row.async qk_acc, lhs, rhs;
        pv_acc = mma.fill.f32 0.0f;
        pv = mma.row.row.async pv_acc, lhs, rhs;
        wait qk;
        trigger qk_done;
        wait pv;
        trigger pv_done;
      }

      inthreads.async (g == 1) {
        wait qk_done;
        wait pv_done;
      }
    }
  }
}

// CHECK-COUNT-2: warpgroup_commit_batch();
// CHECK: warpgroup_wait<1>();
// CHECK-NEXT: qk_done.arrive();
// CHECK: warpgroup_wait<0>();
// CHECK-NEXT: pv_done.arrive();
