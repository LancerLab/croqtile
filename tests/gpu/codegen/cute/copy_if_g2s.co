// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v "\<CHECK\>" | FileCheck %s
// RUN: choreo -gs -t cute -arch=sm_90a %s -o %s.cute.result && bash %s.cute.result --compile-link && rm -f %s.cute.result

#define TILE_M 64
#define TILE_K 64

__co__ void test_copy_if_g2s(f16 [M, K] input) {
  parallel {block_m, block_k} by [cdiv(M, TILE_M), cdiv(K, TILE_K)] : block
  parallel wg by 1 : group-4 {
    shared f16 [TILE_M, TILE_K] s_tail_m;
    shared f16 [TILE_M, TILE_K] s_tail_k;
    shared f16 [TILE_M, TILE_K] s_tail_mk;

    base_m = block_m * TILE_M;
    base_k = block_k * TILE_K;
    remain_m = M - base_m;
    remain_k = K - base_k;
    TM = (TILE_M < remain_m) ? TILE_M : remain_m;
    TK = (TILE_K < remain_k) ? TILE_K : remain_k;

    dma.copy.swiz<128>.zfill
      input.view(TILE_M, TILE_K).from(base_m, 0) => s_tail_m.subspan(TM, TILE_K);

    dma.copy.swiz<128>.zfill
      input.view(TILE_M, TILE_K).from(0, base_k) => s_tail_k.subspan(TILE_M, TK);

    dma.copy.swiz<128>.zfill
      input.view(TILE_M, TILE_K).from(base_m, base_k) => s_tail_mk.subspan(TM, TK);
  }
}

int main() { return 0; }

// CHECK-NOT: copy_swizzled_tail_g2s_128b
// CHECK: choreo::copy_if_g2s<false,
// CHECK-SAME: cute::elem_less(__coord, cute::make_shape(
// CHECK-SAME: TM
// CHECK-SAME: cute::Int<64>{}
// CHECK: choreo::copy_if_g2s<false,
// CHECK-SAME: cute::elem_less(__coord, cute::make_shape(
// CHECK-SAME: cute::Int<64>{}
// CHECK-SAME: TK
// CHECK: choreo::copy_if_g2s<false,
// CHECK-SAME: cute::elem_less(__coord, cute::make_shape(
// CHECK-SAME: TM
// CHECK-SAME: TK