// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void mma_operation_future() {
  parallel b by 1 : block {
    shared f16 [64, 64] lhs;
    shared f16 [128, 64] rhs;
    shared event done;

    parallel g by 2 : group-4 {
      inthreads.async (g == 0) {
        acc = mma.fill.f32 0.0f;
        [[schedule(k_tiles(0, 1, 2, 3))]]
        qk = mma.row.row.async acc, lhs, rhs;
        wait qk;
        trigger done;
      }

      inthreads.async (g == 1) {
        wait done;
      }
    }
  }
}

// CHECK: warpgroup_commit_batch();
// CHECK: warpgroup_wait<0>();
// CHECK-NEXT: done.arrive();
// CHECK: done.wait(done__phase); // wait event(raw mbarrier)
// CHECK-NEXT: done__phase ^= 1;
