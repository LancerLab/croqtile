// A .view(...).from(...) on a TMA source contributes each coordinate to its
// own tensor dimension; CUDA coordinate order is reversed (col, row).
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a %s -o - 2>&1 | grep -v '^ *//' | FileCheck %s --check-prefix=NOERR --implicit-check-not=error:

__co__ void tma_view_from_coords(f32 [64, 32] x) {
  parallel b by 1 : block {
    shared f32 [64, 32] s;
    load = tma.copy.async x.view(64, 32).from(5, 6) => s;
    wait load;
  }
}

// CHECK: tma_load_2d_shared_cta_global_mbarrier({{.*}}, 6, 5);

// A rank-reducing .from(...) keeps the pre-view coordinates: fold them
// through the pre-view stride frame, then split by the flattened map's inner
// extent.  For global f32 [2, 64, 32], the origin (1, 5, 7) is element 2215,
// i.e. map coordinates (outer 69, inner 7), emitted (inner, outer).
__co__ void tma_view_from_rank_reduce(global f32 [2, 64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32).from(1, 5, 7) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_from_rank_reduce
// CHECK: tma_load_2d_shared_cta_global_mbarrier({{.*}}, 7, 69);

// An explicit-stride view that keeps the flattened layout stays valid: the
// innermost stride is 1 and the row stride equals the source's inner extent.
// (The box stays within both map extents and the 256-element box limit.)
__co__ void tma_view_stride_ok(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(128, 8: 16, 1) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_stride_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// An intermediate view replaced by a later subspan is not diagnosed.
__co__ void tma_view_dead(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32: 16, 1).subspan(64, 16) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_dead
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// A root-subview TMA source (its own map path) with a layout-preserving
// view must not be diagnosed by the flattened-map check.
__co__ void tma_view_root_subview(global f32 [2, 64, 4, 128] input) {
  parallel bm by 1 : block {
    in_head = input.subspan(1, 64, 1, 128).at(0, 0, 0, 0).sqz();
    load = tma.copy.async in_head.view(64, 128) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_root_subview
// CHECK: tma_load

// A rank-2 global source with a layout-preserving view stays valid (this is
// the branch that also diagnoses over-wide boxes; the non-global parameter
// form above takes a different path).
__co__ void tma_view_rank2_global(global f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_rank2_global
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// A layout-preserving view on a shadowed device parameter stays valid.
__co__ void tma_view_shadow_ok(f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_shadow_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// The merged-stderr run asserts the whole file compiles with no diagnostic.
// (stderr is not merged into the CHECK run: a CHECK-LABEL would bind to the
// kernel name inside an info diagnostic and truncate the checked region.)
// NOERR: tma_load_2d_shared_cta_global_mbarrier

// A named layout-preserving view also stays valid.
__co__ void tma_view_named_ok(global f32 [64, 32] x) {
  parallel b by 1 : block {
    v = x.view(64, 32);
    load = tma.copy.async v => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_named_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// A rank-2 tile no wider than the map in either extent stays valid.
__co__ void tma_view_outer_ok(global f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 32) => shared;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_outer_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// A wide inner tile under TMA swizzle is split into legal box dims rather
// than diagnosed by the 256-element box limit.
__co__ void tma_view_swiz_split_ok(global f16 [64, 1024] x) {
  parallel b by 1 : block {
    shared f16 [64, 1024] s;
    load = tma.copy.async.swiz<128> x => s;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_swiz_split_ok
// CHECK: tma_load_3d_shared_cta_global_mbarrier

// A box of exactly the 256-element driver limit stays valid.
__co__ void tma_view_box_256_ok(global f32 [256, 32] x) {
  parallel b by 1 : block {
    shared f32 [256, 32] s;
    load = tma.copy.async x.view(256, 32) => s;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_box_256_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier

// A box that exceeds the map along a non-innermost dimension is the ordinary
// TMA out-of-bounds-fill pattern (padded boundary tile): it stays valid and
// the driver zero-fills the excess rows.
__co__ void tma_view_padded_rows_ok(global f16 [32, 128] x) {
  parallel b by 1 : block {
    shared f16 [64, 128] s;
    load = tma.copy.async x.view(64, 128) => s;
    wait load;
  }
}

// CHECK-LABEL: __choreo_device_tma_view_padded_rows_ok
// CHECK: tma_load_2d_shared_cta_global_mbarrier
