// The canonical IV of a single-matcher `with` is named after its source.
// Body references canonicalized to __iv_<matcher> resolve to it, nested withs
// with the same source name get distinct C++ variables, and a later foreach
// cannot inherit a stale rename from an earlier with block.
//
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s

__co__ void explicit_matcher_canonical_body(f32 [2, 8, 4] a) {
  parallel p by 1 : block {
    with index = {x} in [2] {
      foreach x {
        dma.copy a.subspan(1, 8, 4).at(x, 0, 0) => local;
      }
    }
  }
}

__co__ void later_foreach_not_renamed(f32 [3, 8, 4] a) {
  parallel p by 1 : block {
    with index = {x} in [2] {
      foreach index {
        dma.copy a.subspan(1, 8, 4).at(index, 0, 0) => local;
      }
    }
    foreach {x} in [3] {
      dma.copy a.subspan(1, 8, 4).at(x, 0, 0) => local;
    }
  }
}

__co__ void nested_source_shadow() {
  parallel p by 1 : block {
    with a = {x} in [2] {
      foreach x {
        with a = {y} in [3] {
          println(x + y);
        }
      }
    }
  }
}

__co__ void event_wait_redirect(f32 [2] a) {
  parallel p by 1 : block {
    shared event ev[2];
    with index = {x} in [2] {
      foreach x {
        wait ev[x];
      }
    }
  }
}

__co__ void shadowed_host_iv(f32 [64] x) {
  with i in [2] {
    with i in [3] {
      parallel p by 1 : block {
        println(i);
      }
    }
  }
}

__co__ void shadowed_param(f32 [64] x) {
  parallel p by 1 : block {
    with index = {x} in [2] {
      foreach index {
        println(x);
      }
    }
  }
}

__co__ void shadowed_host_param(f32 [64] x) {
  with x in [2] {
    println(x);
  }
}

__co__ void parallel_shadow(f32 [4] p) {
  with i in [2] {
    parallel i by 4 : thread {
      p.at(i) = 0.0f;
    }
  }
}

// A local declared in a range-source foreach body shadows the canonical loop
// IV for subsequent value references, while its own initializer still resolves
// to the source.
__co__ void foreach_source_local_shadow() {
  parallel p by 1 : block {
    foreach index in [2] {
      s32 index = 5;
      println(index);
    }
  }
}

// A shadow in the then branch must not leak into the else branch.
__co__ void foreach_shadow_else_scope() {
  parallel p by 1 : block {
    foreach index in [2] {
      if (index == 0) {
        s32 index = 5;
        println(index);
      } else {
        println(index);
      }
    }
  }
}

// CHECK-LABEL: __global__{{.*}}explicit_matcher_canonical_body
// CHECK: for (int __iv_index = 0; __iv_index < 2; ++__iv_index)
// CHECK: (float*)a + (__iv_index * 32)
// CHECK-LABEL: __global__{{.*}}later_foreach_not_renamed
// CHECK: for (int __iv_index = 0; __iv_index < 2; ++__iv_index)
// CHECK: for (int __iv_x = 0; __iv_x < 3; ++__iv_x)
// CHECK: (float*)a + (__iv_x * 32)
// CHECK-LABEL: __global__{{.*}}nested_source_shadow
// CHECK: for (int __iv_a = 0; __iv_a < 2; ++__iv_a)
// CHECK: int __iv_a__2 = 0;
// CHECK: __iv_a + __iv_a__2
// CHECK-LABEL: __global__{{.*}}event_wait_redirect
// CHECK: ev[__iv_index].wait(((__iv_index & 3) >> 1));
// CHECK-LABEL: __global__ void __choreo_device_shadowed_host_iv({{.*}}int __iv_i, int __iv_i__2)
// CHECK-LABEL: __global__{{.*}}shadowed_param
// CHECK: for (int __iv_index = 0; __iv_index < 2; ++__iv_index)
// CHECK: printf("{%lld}\n", static_cast<long long>(__iv_index));
// CHECK-LABEL: void shadowed_host_param(
// CHECK: int __iv_x = 0;
// CHECK: printf("{%lld}\n", static_cast<long long>(__iv_x));
// CHECK-LABEL: __global__{{.*}}parallel_shadow
// CHECK: __choreo_vtid_x
// CHECK-NOT: + __iv_i)
// CHECK-LABEL: __global__{{.*}}foreach_source_local_shadow
// CHECK: for (int __iv_index = 0; __iv_index < 2; ++__iv_index)
// CHECK: int index = 5;
// CHECK: printf("%lld\n", static_cast<int64_t>(index));
// CHECK-LABEL: __global__{{.*}}foreach_shadow_else_scope
// CHECK: int index = 5;
// CHECK: printf("%lld\n", static_cast<int64_t>(index));
// CHECK: } else {
// CHECK: printf("%lld\n", static_cast<long long>(__iv_index));
