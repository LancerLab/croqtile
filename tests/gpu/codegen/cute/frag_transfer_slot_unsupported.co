// A fragment transfer addresses whole fragment variables. A span-array slot
// is an element expression, so it must be diagnosed instead of crashing while
// resolving the operand name.
//
// RUN: not choreo -es -t cute -arch=sm_86 %s -o - 2>&1 | FileCheck %s

__co__ auto frag_transfer_slot_unsupported() {
  parallel p by 32 : thread {
    frag f32 [16, 16] a[2] {1.0f};
    frag f32 [16, 16] b[2] {0.0f};
    copy(b[1], a[1]);
  }
  return 0;
}

// CHECK: error: frag transfer operands must be fragment variables; span-array slots and element expressions are not supported.
