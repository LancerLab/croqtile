// A declared global span array owns one tightly packed slot per array
// element: the device allocation covers the whole declaration and one flat
// copy initializes it (global buffers cannot carry alignas).
//
// RUN: choreo -es -t cute -arch=sm_86 %s -o - | grep -v '^ *//' | FileCheck %s

__co__ void global_slots(f32 [8] x) {
  global f32 [8] g[4];
  parallel p by 1 : block {
    dma.copy x => g[3];
  }
}

__co__ void global_slots_init(f32 [8] x) {
  global f32 [8] g[4] {1.0f};
  parallel p by 1 : block {
    dma.copy x => g[3];
  }
}

__co__ auto global_slot_return(f32 [8] x) {
  global f32 [8] g[1];
  parallel p by 1 : block {
    dma.copy x => g[0];
  }
  return g;
}

__co__ void global_dyn_slots(int n, f32 [4, n] x) {
  global f32 [4, n] g[2] {1.0f};
  parallel p by 1 : block {
    dma.copy x => g[1];
  }
}

// CHECK: (float*)g + (3)*(8) + 0
// CHECK: cudaMalloc(&g__device, 128ULL)
// CHECK: make_spandata<choreo::f32, 2>({4, 8})
// CHECK: cudaMemcpy(g__device, g.data(), 128ULL, cudaMemcpyHostToDevice)
// A one-slot declaration is indistinguishable from its span and can be
// returned with the single-span shape.
// CHECK: make_spandata<choreo::f32, 1>({8})
// CHECK: return g;
// A symbolic dimension that is also a parameter is not re-emitted as an
// extra kernel parameter (duplicate names do not compile).
// CHECK: __global__ void __choreo_device_global_dyn_slots(int n, float * x, float * g)
// CHECK-NOT: unsigned n
// Dynamic declarations build the runtime size as an explicit 64-bit
// product: every factor is cast before multiplying.
// CHECK: cudaMalloc(&g__device, (uint64_t)(4) * (uint64_t)(n) * 4 * (uint64_t)(2))
// CHECK: cudaMemcpy(g__device, g.data(), (uint64_t)(4) * (uint64_t)(n) * 4 * (uint64_t)(2), cudaMemcpyHostToDevice)
// CHECK: __choreo_device_global_dyn_slots{{.*}}>>>(n, x__device, g__device)

// A fully symbolic shape has no literal to carry the ULL suffix; every
// factor is cast before multiplying so the size stays 64-bit.
__co__ void global_symbolic_slots(int m, int n, f32 [m, n] x) {
  global f32 [m, n] g[2] {1.0f};
  parallel p by 1 : block {
    dma.copy x => g[1];
  }
}

// CHECK: cudaMalloc(&g__device, (uint64_t)(m) * (uint64_t)(n) * 4 * (uint64_t)(2))

// A plain global span (no slot dimension) takes the same 64-bit sizing path.
__co__ void global_plain_dyn(int m, int n, f32 [m, n] x) {
  global f32 [m, n] g;
  parallel p by 1 : block {
    dma.copy x => g;
  }
}

// CHECK: cudaMalloc(&g__device, (uint64_t)(m) * (uint64_t)(n) * 4)
