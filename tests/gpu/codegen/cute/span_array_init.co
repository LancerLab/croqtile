// A span-array declaration initializes every slot (not just slot 0) at the
// declaration's slot stride, which follows the emitted layout: packed for a
// regular C++ array, physical (alignas-padded) for aligned slots. The
// initial value is evaluated once and each slot is filled through a hoisted
// base pointer.
//
// RUN: choreo -es -t cute -arch=sm_86 %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=DEFAULT
// RUN: choreo -es -t cute -arch=sm_86 --mem-reuse=false %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=NOMEM

__co__ void init_span_arrays(f32 [8] x) {
  parallel p by 1 : block {
    shared f32 [8] s[2] {1.0f};
    alignas(256) shared f32 [8] t[2] {1.0f};
    dma.copy x => s[1];
    dma.copy x => t[1];
  }
}

// DEFAULT: const float __init_s = 1.000000f;
// DEFAULT: float* __p = ((float*)(s)) + __slot * (8);
// DEFAULT: __p[__e] = __init_s;
// DEFAULT: const float __init_t = 1.000000f;
// DEFAULT: float* __p = ((float*)(t)) + __slot * (64);
// NOMEM: __shared__ float s[2][8];
// NOMEM: float* __p = ((float*)(s)) + __slot * (8);
// NOMEM: __shared__ alignas(256) float t[2][64];
// NOMEM: float* __p = ((float*)(t)) + __slot * (64);

// fp8 element types are initialized through the element conversion
// (from_f32), not a raw literal assignment that does not compile. Other
// element types (u8/sub-byte/bool) keep the raw literal, which constructs
// directly.
__co__ void init_fp8_span(f8_e4m3 [8] x) {
  parallel p by 1 : block {
    shared f8_e4m3 [8] s[2] {1.0f};
    dma.copy x => s[1];
  }
}

// DEFAULT: const f8_e4m3 __init_s = choreo::utils::from_f32<f8_e4m3>(1.000000f);

// A non-array span takes the per-element loop path with the same conversion.
__co__ void init_fp8_scalar_span(f8_e4m3 [8] x) {
  parallel p by 1 : block {
    shared f8_e4m3 [8] s {1.0f};
    dma.copy x => s;
  }
}

// DEFAULT: for (int __e = 0; __e < 8; ++__e) s[__e] = choreo::utils::from_f32<f8_e4m3>(1.000000f);

// A single-element span is assigned directly (indexed) instead of taking the
// fill loop.
__co__ void init_one_element(global f32 [1] x) {
  parallel p by 1 : block {
    shared f32 [1] s {1.0f};
    dma.copy x => s;
  }
}

__co__ void init_one_fp8(global f8_e4m3 [1] x) {
  parallel p by 1 : block {
    shared f8_e4m3 [1] s {1.0f};
    dma.copy x => s;
  }
}

// CHECK-NOT: for (int __e = 0; __e < 1; ++__e)
// DEFAULT: s[0] = 1.000000f;
// DEFAULT: s[0] = choreo::utils::from_f32<f8_e4m3>(1.000000f);
