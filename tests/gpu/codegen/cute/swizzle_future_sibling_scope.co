// A future-only DMA must not leak its swizzle provenance to a same-named
// future in a sibling scope. The second scope's natural future therefore
// loads its MMA fragment without the first scope's swizzled XOR phase.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void swizzle_future_sibling_scope(f16 [64, 16] lhs, f16 [16, 64] rhs) {
  f16 [64, 64] output{0.0f};
  parallel outer by 1 : block {
    parallel pb0 by 1 : group-4 {
      shared f16 [64, 16] s0;
      load = dma.copy.swiz<128> lhs.chunkat(_, _) => s0;
    }
    parallel pb1 by 1 : group-4 {
      shared f16 [64, 16] a_s;
      shared f16 [16, 64] b_s;
      load = dma.copy lhs.chunkat(_, _) => a_s;
      dma.copy rhs.chunkat(_, _) => b_s;
      ma = mma.load load.chunkat(_, _);
      mc = mma.fill.f32 0.0f;
      mma.row.col mc, ma, b_s;
      mma.store mc, output.chunkat(_, _);
    }
  }
}

// The first future's destination is swizzled; the second future's is natural.
// CHECK: Layout_K_SW128_Atom<f16>
// CHECK: Layout_K_INTER_Atom<f16>
// CHECK: ma[__mma_load_i] = __mma_load_src[__mma_load_logical];
// CHECK-NOT: __mma_load_byte
