// One metadata fragment is loaded before two sibling warp loops and consumed by
// one exec in each.  The two consumers agree on the A K chunk loop, but the
// single metadata index can only name one warp loop, so the disagreement must
// be diagnosed instead of silently indexing the later consumer with the first
// warp chunk.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a --use-prepack %s -o - 2>&1 | FileCheck %s

__co__ auto prepack_multi_consumer_warp(u32 [64, 4] meta,
                                        f16 [64, 16] lhs_packed,
                                        f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    shared f16 [64, 16] lhs2_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy lhs_packed => lhs2_s[1];
    rhs_s = dma.copy rhs => shared;
    rhs2_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(kk, ww);
          foreach wa in [1] {
            mma.row.row.sp mc, lhs_s[1].chunkat(wa, kk),
                rhs_s.chunkat(_, kk), me;
          }
          foreach wb in [1] {
            mma.row.row.sp mc, lhs2_s[1].chunkat(wb, kk),
                rhs2_s.chunkat(_, kk), me;
          }
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: prepacked metadata 'me' is consumed by execs with different warp chunk loops '__iv_wa' and '__iv_wb'
