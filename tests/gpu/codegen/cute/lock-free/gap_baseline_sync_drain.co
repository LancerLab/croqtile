// Gap decomposition baseline, from
// Documents/Documentation/performance-gap-cuda-vs-croqtile-spmm.md.
// CUDA best 1845 TFLOPS vs CroqTile best 1279 TFLOPS with an identical macro
// configuration -- the gap is in what the generated code can express.
//
// Feature map (F1..F7 in the note) and where each is pinned today:
//   F4 group barrier   -> this file: compiler-injected named_barrier_sync(...,15)
//   F6 commit/drain    -> this file: commit_batch always followed by wait<0>()
//   F1 metadata operand-> gap_baseline_metadata.co (current rejection)
//   F2 decoupled ring  -> needs event-ring semantics; no baseline assertion yet
//   F3 TMA box split   -> runtime cuTensorMapEncodeTiled failure (section 5)
//   F5 scoped arena    -> shared-lifetime model; needs a budget assertion
//   F7 narrow producer -> role table; needs a thread-count assertion
//
// These RUN lines must keep passing unchanged after --lock-free lands: with
// the flag OFF the generated code has to stay byte-for-byte the same.
//
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s --check-prefix=BARRIER
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s --check-prefix=DRAIN

#define WARP_M 64
#define WARP_N 128
#define TILE_K 64
#define WARP_K 16
#define STAGES 2

__co__ void foo(global f16 [M, K] lhs,
                global f16 [N, K] rhs,
                global f16 [M, N] output) {
  parallel {block_m, block_n} by [cdiv(M, WARP_M), cdiv(N, WARP_N)] : block {
    shared event full[STAGES], empty[STAGES];
    shared f16 [WARP_M, TILE_K] lhs_s[STAGES];
    shared f16 [WARP_N, TILE_K] rhs_s[STAGES];
    shared f16 [WARP_M, WARP_N] output_s;

    parallel p by 2 : group-4, t by 128 : thread {
      inthreads.async (p == 0) {
        foreach {iv_k} in [cdiv(K, TILE_K)] {
          stage = iv_k % STAGES;
          wait empty.at(iv_k);
          lhs_load = tma.copy.async.swiz<128> lhs.subspan(WARP_M, TILE_K).at(block_m, iv_k) => lhs_s[stage];
          rhs_load = tma.copy.async.swiz<128> rhs.subspan(WARP_N, TILE_K).at(block_n, iv_k) => rhs_s[stage];
          trigger full.at(iv_k) after lhs_load, rhs_load;
        }
      }

      inthreads.async (p == 1) {
        mc = mma.fill.f16 0.0f;
        foreach {s} in [STAGES]
          trigger empty.at(s);
        foreach {iv_k} in [cdiv(K, TILE_K)] {
          stage = iv_k % STAGES;
          wait full.at(iv_k);
          foreach {iv_wk} in [cdiv(TILE_K, WARP_K)] {
            mma.row.row mc, lhs_s[stage].chunkat(_, iv_wk),
                            rhs_s[stage].chunkat(_, iv_wk);
          }
          trigger empty.at(iv_k);
        }
        mma.store mc, output_s;
        tma.copy output_s => output.subspan(WARP_M, WARP_N).at(block_m, block_n);
      }
    }
  }
}

// BARRIER: choreo::named_barrier_sync(128, 15);
// BARRIER: cde::fence_proxy_async_shared_cta();
// BARRIER: choreo::named_barrier_sync(128, 15);

// DRAIN: warpgroup_commit_batch();
// DRAIN-NEXT: warpgroup_wait<0>();
