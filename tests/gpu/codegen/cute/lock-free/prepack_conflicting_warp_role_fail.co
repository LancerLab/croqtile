// A canonical warp loop is present, but the metadata chunk order names a
// different warp loop and omits the canonical one.  Reject the conflicting
// role sources instead of silently emitting the metadata's loop.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a --use-prepack %s -o - 2>&1 | FileCheck %s

__co__ auto prepack_conflicting_warp_role(u32 [64, 8] meta,
                                          f16 [64, 16] lhs_packed,
                                          f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 8] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach iv_warp in [1] {
        foreach kk in [2] {
          foreach ww in [4] {
            me = mma.load meta_s[1].chunkat(kk, ww);
            mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
                rhs_s.chunkat(_, kk), me;
          }
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: prepacked metadata role conflict: canonical warp loop '__iv_iv_warp' is not the metadata warp loop '__iv_ww'
