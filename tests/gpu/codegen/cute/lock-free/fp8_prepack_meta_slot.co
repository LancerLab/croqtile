// The fp8 sparse K=64 prepacked metadata tile loader must use the
// slot-adjusted metadata base and take the tile address from the metadata
// buffer itself: the raw base biased the row computation by one slot, and
// with a separate `<ref>_mdata` alias the A operand's address made the V2
// snippet subtract pointers into different objects (V1 read the packed A as
// metadata).
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=V1

__co__ auto fp8_prepack_meta_slot(u32 [64, 2] meta, f8_e4m3 [64, 32] lhs_packed,
                                  f8_e4m3 [8, 64] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 2] meta_s[2];
    shared f8_e4m3 [64, 32] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      mma.row.row.sp mc, lhs_s[1], rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// Both operands of the pointer difference carry the same `+ (1)*(128)` slot
// offset, so it cancels and the row offset stays inside the slot.
// CHECK: (((unsigned int*)meta_s + (1)*(128))) - (((unsigned int*)meta_s + (1)*(128)))

// With a separate `<ref>_mdata` alias, the fp8 tile loader must address the
// metadata buffer rather than the A operand; the old code subtracted
// pointers into two different objects (V2) or read the packed A as metadata
// (V1).
__co__ auto fp8_prepack_mdata_slot(f8_e4m3 [64, 32] lhs, u32 [64, 4] lhs_meta,
                                   f8_e4m3 [8, 64] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f8_e4m3 [64, 32] lhs_s[2];
    shared u32 [64, 4] lhs_s_mdata[2];
    dma.copy lhs => lhs_s[1];
    dma.copy lhs_meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load lhs_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK-LABEL: __choreo_device_fp8_prepack_mdata_slot
// CHECK: int __sp_v1 = (int)((((unsigned int*)lhs_s_mdata + (1)*(256))) - (((unsigned int*)lhs_s_mdata + (1)*(256))))

// V1: auto* __sp_meta_u32_ptr = (uint32_t*)(((unsigned int*)lhs_s_mdata + (1)*(256)));
