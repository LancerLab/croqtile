// The fp8 sparse K=64 prepacked-v2 metadata tile loader must use the
// slot-adjusted metadata base. tile_addr already includes the A operand's
// span-array slot, so passing the raw buffer base made the snippet subtract
// an un-slotted base and bias the row computation by one slot (stages >= 1
// read the wrong metadata).
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto fp8_prepack_meta_slot(u32 [64, 2] meta, f8_e4m3 [64, 32] lhs_packed,
                                  f8_e4m3 [8, 64] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 2] meta_s[2];
    shared f8_e4m3 [64, 32] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      mma.row.row.sp mc, lhs_s[1], rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// Both operands of the pointer difference carry the same `+ (1)*(128)` slot
// offset, so it cancels and the row offset stays inside the slot.
// CHECK: ((unsigned int*)meta_s + (1)*(128)) - (((unsigned int*)meta_s + (1)*(128)))
