// A no-chunkat fp8 tile load uses the thread preset.  The consumer's A M chunk
// is indexed by a one-iteration loop, matching the metadata tile's one-column
// warp extent; the layout is consistent and the kernel must compile.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto prepack_fp8_thread_preset_loop(u32 [64, 1] meta,
                                          f8_e4m3 [64, 32] lhs_packed,
                                          f8_e4m3 [8, 64] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 1] meta_s[2];
    shared f8_e4m3 [64, 32] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach ww in [1] {
        me = mma.load meta_s[1];
        foreach wa in [1] {
          mma.row.row.sp mc, lhs_s[1].chunkat(wa, _), rhs_s, me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: me = __sp_meta_u32_ptr[__sp_row * (1) + __sp_u32_col * (1)];
// CHECK: GMMA_64x8x64_F32E4M3E4M3_SS_TN
