// A unit-extent warp loop is the metadata load's fixed slot 0, so the load may
// be hoisted out of that loop; the index and the consumer see the same warp
// chunk.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto prepack_hoisted_unit_warp(u32 [64, 4] meta,
                                     f16 [64, 16] lhs_packed,
                                     f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        me = mma.load meta_s[1].chunkat(_, kk);
        foreach ww in [1] {
          mma.row.row.sp mc, lhs_s[1].chunkat(ww, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: int __sp_k_idx = (__iv_kk) * 2 + (0);
// CHECK: GMMA_64x8x16_F32F16F16_SS

// The K role gets the same treatment: a unit K loop has only slot 0, so the
// load can also sit outside it.
__co__ auto prepack_hoisted_unit_k(u32 [64, 4] meta,
                                   f16 [64, 16] lhs_packed,
                                   f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      foreach kk in [1] {
        mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
            rhs_s.chunkat(_, kk), me;
      }
    }
    mma.store mc, output;
  }
  return output;
}
