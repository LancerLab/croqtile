// CTMMA sparse metadata accepts a plain u32 scalar (a register, or a shared
// scalar the atom call reads into a register) or a buffer loaded with
// mma.load. Passing a shared buffer by name would hand the atom a pointer
// where it expects the metadata value, so it is diagnosed.
//
// RUN: not choreo -es -t cute -arch=sm_86 %s 2>&1 | FileCheck %s

__co__ auto ctmma_buffer_meta(f16 [16, 16] lhs, u8 [16, 4] lhs_meta,
                              f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u8 [16, 4] a_s_mdata[2];
    dma.copy lhs => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      mma.row.row.sp mc, ma, mb, a_s_mdata;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: sparse CTMMA metadata must be a plain u32 register or loaded with mma.load
