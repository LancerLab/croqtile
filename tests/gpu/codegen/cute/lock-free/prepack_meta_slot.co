// A prepacked-u32 metadata buffer declared as a span array is loaded from
// the requested slot: the metadata snippets index from the slot-adjusted
// base, not slot 0 (u32 and v2 encodings, multi-column and single-column
// metadata), and an `_mdata` metadata alias uses the alias's own element
// type/slot stride.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=V2

__co__ auto prepack_meta_slot(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                              f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    dma.copy meta => meta_s[1];
    lhs_s = dma.copy lhs_packed => shared;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

__co__ auto prepack_single_slot(u32 [64, 1] meta, f16 [64, 16] lhs_packed,
                                f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 1] meta_s[2];
    dma.copy meta => meta_s[1];
    lhs_s = dma.copy lhs_packed => shared;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

__co__ auto prepack_mdata_slot(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                               f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 4] lhs_s_mdata[2];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load lhs_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: uint32_t __sp_u32_val = ((unsigned int*)meta_s + (1)*(256))[__sp_packed_row * (4) + __sp_k_idx * (1)];
// CHECK: uint32_t __sp_u32_val = ((unsigned int*)lhs_s_mdata + (1)*(256))[__sp_packed_row * (4) + __sp_k_idx * (1)];
// V2: me = ((const uint32_t*)(((unsigned int*)meta_s + (1)*(256))))[((__sp_packed_row >> 4) * (4) + __sp_k_idx) * 16 + (__sp_packed_row & 15)];
// V2: me = ((const uint32_t*)(((unsigned int*)meta_s + (1)*(64))) + ((__sp_row >> 4) << 4) + (__sp_row & 15))[(0 & 0) << 4];

// A plain (non-array) metadata buffer is broadcast across A slots: the base
// must not take the A operand's slot index.
__co__ auto prepack_broadcast_mdata(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                                    f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 4] lhs_s_mdata;
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load lhs_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// The prepacked snippets take the K-tile and warp-chunk indices from the
// enclosing foreach IVs; a kernel without those loops uses 0 instead of
// referencing undefined `__iv_iv_k`/`__iv_iv_warp` identifiers.
// CHECK: int __sp_k_idx = (0) * 2 + (0);
// V2: int __sp_k_idx = (0) * 2 + (0);

// Broadcast metadata stays at the buffer base (no `[1]` slot subscript).
// CHECK: uint32_t __sp_u32_val = lhs_s_mdata[__sp_packed_row * (4) + __sp_k_idx * (1)];
// V2: me = ((const uint32_t*)(lhs_s_mdata))[((__sp_packed_row >> 4) * (4) + __sp_k_idx) * 16 + (__sp_packed_row & 15)];

// A single-column `_mdata` alias must be addressed through the metadata
// buffer, not the A operand (which would feed packed A values to the sparse
// atom as metadata).
__co__ auto prepack_single_mdata_alias(u32 [64, 1] meta, f16 [64, 16] lhs_packed,
                                       f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 1] lhs_s_mdata[2];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load lhs_s[1];
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: (((unsigned int*)lhs_s_mdata + (1)*(64)))[__sp_local_row * (1)]

// A chunked operand with a `_mdata` alias keeps the metadata at tile 0: the
// operand's chunk offset lives in the A frame (a uniform-sparsity pattern
// legitimately reuses one metadata tile for every K chunk).
__co__ auto prepack_single_mdata_alias_chunk(u32 [64, 1] meta, f16 [64, 16] lhs_packed,
                                             f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 1] lhs_s_mdata[2];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach iv_k in [2] {
        me = mma.load lhs_s[1].chunkat(_, iv_k);
        mma.row.row.sp mc, lhs_s[1].chunkat(_, iv_k), rhs_s.chunkat(_, iv_k), me;
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: (((unsigned int*)lhs_s_mdata + (1)*(64)))[__sp_local_row * (1)]
// V2: int __sp_row = (0 >> 0) + __sp_lr;
