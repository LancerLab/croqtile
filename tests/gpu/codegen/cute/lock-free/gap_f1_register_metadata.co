// F1 (section 2.3): sparse metadata may be supplied as a plain u32 register
// instead of mma.load from a shared buffer. The kernel can then keep metadata
// on its own TMA ring and consume it from registers. (SM90 sparse atoms take
// one uint32_t metadata register, so u64 is out of scope.)
//
// RUN: choreo -es -t cute -arch=sm_90a --lock-free %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto f1_register_metadata(
    f16 [64, 16] lhs_packed, f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    lhs_s = dma.copy lhs_packed => shared;
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel by 1 : group-4 {
      u32 me = __to<u32>(0);
      mma.row.row.sp mc, lhs_s, rhs_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: __global__ void __choreo_device_f1_register_metadata
// CHECK: unsigned int me =
// CHECK-NOT: load_fragment_e
// CHECK-NOT: wgmma_make_sparse_metadata_desc
// CHECK: ::fma({{.*}}, me);
