// A prepacked metadata tile index that comes from a non-foreach loop cannot
// be resolved to a packed K tile.  The compiler must reject it instead of
// silently indexing tile 0 for every iteration.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a --use-prepack %s -o - 2>&1 | FileCheck %s

__co__ auto prepack_nonforeach_loop_index(u32 [64, 4] meta,
                                          f16 [64, 16] lhs_packed,
                                          f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      with {k} in [2] {
        while (k < 2) {
          me = mma.load meta_s[1].chunkat(_, k);
          mma.row.row.sp mc, lhs_s[1], rhs_s, me;
          break;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: prepacked metadata chunk index 'k' is not a foreach loop variable; use a foreach K/warp loop to index the metadata tile
