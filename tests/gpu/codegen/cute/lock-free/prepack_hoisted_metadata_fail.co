// A prepacked metadata load must be inside the K loop used by its consumers;
// otherwise the load builds its index without that IV and picks K index 0.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a --use-prepack %s -o - 2>&1 | FileCheck %s

__co__ auto prepack_hoisted_metadata(u32 [64, 4] meta,
                                    f16 [64, 16] lhs_packed,
                                    f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s[1];
      foreach kk in [2] {
        foreach ww in [1] {
          mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: prepacked metadata 'me' is loaded outside the K loop '__iv_kk' that indexes it
