// An implicit-E prepacked metadata buffer with one packed column uses the
// single-column tile-load snippet, matching the explicit `mma.load` path
// instead of decoding the buffer with the packed layout.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=V2

__co__ auto prepack_implicit_single_col(u32 [64, 1] meta,
                                        f16 [64, 16] lhs_packed,
                                        f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 1] lhs_s_mdata[2];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      mma.row.row.sp mc, lhs_s[1], rhs_s;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: uint32_t __sp_u32_val = (((unsigned int*)lhs_s_mdata + (1)*(64)))[__sp_local_row * (1)];
// CHECK: GMMA_64x8x32_F32F16F16_SS{{.*}}lhs_s_meta
// V2: lhs_s_meta = ((const uint32_t*)(((unsigned int*)lhs_s_mdata + (1)*(64))) + ((__sp_row >> 4) << 4) + (__sp_row & 15))[(0 & 0) << 4];
// V2: GMMA_64x8x32_F32F16F16_SS{{.*}}lhs_s_meta
