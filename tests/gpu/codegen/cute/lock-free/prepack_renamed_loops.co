// Prepacked metadata indexing resolves the K-tile and warp-chunk roles from
// the A operand's K chunk IV and its position in the metadata `chunkat`.
// Renamed loop names and nesting order are not used.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=V2

__co__ auto prepack_renamed_loops(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                                  f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(ww, kk);
          mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// An outer output-tile loop above the K/warp pair is not part of the
// metadata index.
__co__ auto prepack_renamed_outer_loops(u32 [64, 4] meta,
                                       f16 [64, 16] lhs_packed,
                                       f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach tt in [4] {
        foreach kk in [2] {
          foreach ww in [1] {
            me = mma.load meta_s[1].chunkat(ww, kk);
            mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
          }
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// The K tile count need not exceed the warp chunk count.
__co__ auto prepack_renamed_wide_warp(u32 [64, 8] meta,
                                      f16 [64, 16] lhs_packed,
                                      f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 8] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [4] {
          me = mma.load meta_s[1].chunkat(ww, kk);
          mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// The warp loop may be nested outside the K loop.
__co__ auto prepack_renamed_warp_outer(u32 [64, 4] meta,
                                       f16 [64, 16] lhs_packed,
                                       f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach ww in [1] {
        foreach kk in [2] {
          me = mma.load meta_s[1].chunkat(ww, kk);
          mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// An intermediate loop whose range is smaller than the K loop must not be
// selected as K.
__co__ auto prepack_renamed_intermediate(u32 [64, 8] meta,
                                         f16 [64, 16] lhs_packed,
                                         f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 8] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach zz in [1] {
          foreach ww in [4] {
            me = mma.load meta_s[1].chunkat(ww, kk);
            mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
          }
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// The exec A operand's chunkat indices also identify the roles when the
// metadata is implicit (no explicit E load).
__co__ auto prepack_renamed_a_chunk(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                                    f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] lhs_s[2];
    shared u32 [64, 4] lhs_s_mdata[2];
    dma.copy lhs_packed => lhs_s[1];
    dma.copy meta => lhs_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          mma.row.row.sp mc, lhs_s[1].chunkat(ww, kk),
              rhs_s.chunkat(_, kk);
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// The A K chunk IV identifies the K role even when the metadata chunk order
// is K-first.  The A operand keeps its normal M/K order (K at axis 1).
__co__ auto prepack_renamed_kfirst_meta_a_chunk(u32 [64, 4] meta,
                                                f16 [64, 16] lhs_packed,
                                                f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(kk, ww);
          mma.row.row.sp mc, lhs_s[1].chunkat(_, kk),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// A column-major A has its K chunk at axis 0.  The established last-is-K
// metadata order must still resolve to that same K IV.
__co__ auto prepack_renamed_lastk_meta_col_a(u32 [64, 4] meta,
                                             f16 [16, 64] lhs_packed,
                                             f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [16, 64] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(ww, kk);
          mma.col.row.sp mc, lhs_s[1].chunkat(kk, _),
              rhs_s.chunkat(_, kk), me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// A canonical K role is decisive even when the warp role is renamed and the
// unchunked A operand cannot identify K.  The K-first metadata order must not
// overwrite the canonical K with the positional fallback.
__co__ auto prepack_partial_canon_kfirst(u32 [64, 4] meta,
                                         f16 [64, 16] lhs_packed,
                                         f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach iv_k in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(iv_k, ww);
          mma.row.row.sp mc, lhs_s[1], rhs_s, me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// The same partial-canonical loops with the established last-is-K metadata
// order must resolve to the same canonical K role.
__co__ auto prepack_partial_canon_lastk(u32 [64, 4] meta,
                                        f16 [64, 16] lhs_packed,
                                        f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach iv_k in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1].chunkat(ww, iv_k);
          mma.row.row.sp mc, lhs_s[1], rhs_s, me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

