// Prepacked metadata indexing derives the K-tile and warp-chunk loop roles
// from the loop structure, not from the source names. Renaming the loops must
// still emit the snippets' indices from the actual iteration variables.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack %s -o - | grep -v '^ *//' | FileCheck %s
// RUN: choreo -es -t cute -arch=sm_90a --use-prepack-v2 %s -o - | grep -v '^ *//' | FileCheck %s --check-prefix=V2

__co__ auto prepack_renamed_loops(u32 [64, 4] meta, f16 [64, 16] lhs_packed,
                                  f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach kk in [2] {
        foreach ww in [1] {
          me = mma.load meta_s[1];
          mma.row.row.sp mc, lhs_s[1], rhs_s, me;
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// An outer output-tile loop above the renamed K/warp pair is not part of the
// metadata index: the K index must stay the loop immediately enclosing the
// warp loop.
__co__ auto prepack_renamed_outer_loops(u32 [64, 4] meta,
                                       f16 [64, 16] lhs_packed,
                                       f16 [8, 32] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared u32 [64, 4] meta_s[2];
    shared f16 [64, 16] lhs_s[2];
    dma.copy meta => meta_s[1];
    dma.copy lhs_packed => lhs_s[1];
    rhs_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      foreach tt in [4] {
        foreach kk in [2] {
          foreach ww in [1] {
            me = mma.load meta_s[1];
            mma.row.row.sp mc, lhs_s[1], rhs_s, me;
          }
        }
      }
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: int __sp_k_idx = (__iv_kk) * 2 + (__iv_ww);
// V2: int __sp_k_idx = (__iv_kk) * 2 + (__iv_ww);
// CHECK: int __sp_k_idx = (__iv_kk) * 2 + (__iv_ww);
// V2: int __sp_k_idx = (__iv_kk) * 2 + (__iv_ww);
