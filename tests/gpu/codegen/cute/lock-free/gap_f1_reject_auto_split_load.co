// The auto-split guard covers every sparse E carrier: the mma.load path also
// builds one descriptor and would reuse it across K atoms.
//
// RUN: not choreo -es -t cute -arch=sm_90a --lock-free %s 2>&1 | FileCheck %s

__co__ auto f1_reject_auto_split_load(f16 [64, 32] lhs_packed,
                                      u8 [64, 8] lhs_meta, f16 [8, 64] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    a_s = dma.copy lhs_packed => shared;
    b_s = dma.copy rhs => shared;
    meta_s = dma.copy lhs_meta => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 1 : group-4 {
      me = mma.load meta_s;
      mma.row.row.sp mc, a_s, b_s, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: error: sparse WGMMA metadata cannot be reused across auto-split K iterations
