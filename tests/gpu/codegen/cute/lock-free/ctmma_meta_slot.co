// CTMMA (SM80) sparse metadata is addressed from the A operand's span-array
// slot: the `_mdata_ptr` base folds the operand's slot offset so a
// double-buffered A tile consumes the matching metadata stage.
//
// RUN: choreo -es -t cute -arch=sm_86 %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto ctmma_meta_slot(f16 [16, 16] lhs, u8 [16, 4] lhs_meta,
                            f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u8 [16, 4] a_s_mdata[2];
    dma.copy lhs => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      mma.row.row.sp mc, ma, mb;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: uint8_t* ma_mdata_ptr = (uint8_t*)((unsigned char*)a_s_mdata + (1)*(64));
