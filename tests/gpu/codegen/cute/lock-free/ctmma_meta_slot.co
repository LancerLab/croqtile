// CTMMA (SM80) sparse metadata is addressed from the A operand's span-array
// slot: the `_mdata_ptr` base folds the operand's slot offset so a
// double-buffered A tile consumes the matching metadata stage.
//
// RUN: choreo -es -t cute -arch=sm_86 %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto ctmma_meta_slot(f16 [16, 16] lhs, u8 [16, 4] lhs_meta,
                            f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u8 [16, 4] a_s_mdata[2];
    dma.copy lhs => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      mma.row.row.sp mc, ma, mb;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK: uint8_t* ma_mdata_ptr = (uint8_t*)((unsigned char*)a_s_mdata + (1)*(64));

// A plain (non-array) metadata buffer is broadcast across A slots: it must
// not take the A operand's slot index, which would read a data byte as the
// metadata pointer.
__co__ auto ctmma_meta_broadcast(f16 [16, 16] lhs, u8 [16, 4] lhs_meta,
                                 f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u8 [16, 4] a_s_mdata;
    dma.copy lhs => a_s[1];
    dma.copy lhs_meta => a_s_mdata;
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      mma.row.row.sp mc, ma, mb;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK-LABEL: __choreo_device_ctmma_meta_broadcast
// CHECK: uint8_t* ma_mdata_ptr = (uint8_t*)a_s_mdata;

// A shared u32 scalar is a per-thread value the atom call reads into
// register; it is accepted directly.
__co__ auto ctmma_meta_scalar(f16 [16, 16] lhs, f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u32 m_s;
    dma.copy lhs => a_s[1];
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      mma.row.row.sp mc, ma, mb, m_s;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK-LABEL: __choreo_device_ctmma_meta_scalar

// Metadata loaded explicitly with mma.load is a register fragment; the exec
// consumes it by value.
__co__ auto ctmma_meta_loaded(f16 [16, 16] lhs, u8 [16, 4] lhs_meta,
                              f16 [8, 32] rhs) {
  f32 [16, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [16, 16] a_s[2];
    shared u8 [16, 4] a_s_mdata[2];
    dma.copy lhs => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    b_s = dma.copy rhs => shared;
    mc = mma.fill.f32 0.0f;
    parallel p by 32 : thread {
      ma = mma.load a_s[1];
      mb = mma.load b_s;
      me = mma.load a_s_mdata[1];
      mma.row.row.sp mc, ma, mb, me;
    }
    mma.store mc, output;
  }
  return output;
}

// CHECK-LABEL: __choreo_device_ctmma_meta_loaded
// CHECK: ::fma({{.*}}, me, 0);
