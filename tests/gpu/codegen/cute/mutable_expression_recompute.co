// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void mutable_expression_recompute() {
  parallel b by 1 : block {
    mutable u32 ring = 0;
    first_stage = ring & 1;
    ring = (ring + 1) & 3;

    foreach {i} in [2] {
      stage = ring & 1;
      ring = (ring + 1) & 3;
    }
  }
}

