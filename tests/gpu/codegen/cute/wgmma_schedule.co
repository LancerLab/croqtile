// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - 2>&1 | FileCheck %s

__co__ void wgmma_schedule() {
  parallel b by 1 : block {
    shared bf16[64, 64] lhs;
    shared bf16[64, 128] rhs;
    parallel g by 1 : group-4 {
      acc = mma.fill.f32 0.0f;
      [[schedule(k_tiles(3, 2, 1, 0))]]
      mma.row.col acc, lhs, rhs;
    }
  }
}

// CHECK-LABEL: __choreo_device_wgmma_schedule
// CHECK-NOT: for (int __choreo_wgmma_k_iter
// CHECK: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_0
// CHECK: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_1
// CHECK: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_2
// CHECK: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_3
// CHECK: ::fma({{.*}}_order_0, {{.*}}_order_0
// CHECK-NEXT: {{.*}}::fma({{.*}}_order_1, {{.*}}_order_1
// CHECK-NEXT: {{.*}}::fma({{.*}}_order_2, {{.*}}_order_2
// CHECK-NEXT: {{.*}}::fma({{.*}}_order_3, {{.*}}_order_3
// CHECK-NEXT: warpgroup_commit_batch();
