// A branch-local buffer written after an event release, inside a persistent
// loop, must not reuse the operand arena. The producer's next-iteration fill
// waits only for the release trigger, not for the write that follows it, so
// the two accesses are concurrent across the loop boundary. The one-iteration
// HB graph orders the fill before the write and the dropped (cross-iteration)
// release edge is not enough; without the loop-carried check the write lands
// at offset 0, on top of the operand. The no-loop form
// (trigger_dependency_buffer_reuse.co) remains the safe positive control.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void loop_carried_buffer_interference(global f16 [64, 64] a,
                                             global f16 [64, 64] out) {
  parallel by 1 : block {
    shared event full[1], empty[1];
    shared f16 [64, 64] operand;
    parallel g by 2 : group-4 {
      inthreads.async (g == 0) {
        foreach {t} in [2] {
          wait empty[0];
          load = tma.copy.async a => operand;
          trigger full[0] after load;
        }
      }
      inthreads.async (g == 1) {
        shared f16 [64, 64] reuse_s;
        foreach {t} in [2] {
          wait full[0];
          trigger empty[0];
          reuse_s.at(0, 0) = 1.0f;
          tma.copy reuse_s => out;
        }
      }
    }
  }
}

// CHECK: f16* operand = (f16*)(anon_{{.*}} + 0);
// CHECK: f16* reuse_s = (f16*)(anon_{{.*}} + 8192);
