// A fragment array (`frag f32 [16,16] mc[3]`) stores one slot of
// registers-per-thread registers per element; element accesses from
// different slots must address different registers.
//
// RUN: choreo -es -t cute -arch=sm_86 %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto fragment_array_slot() {
  parallel p by 32 : thread {
    frag f32 [16, 16] mc[3];
    mc[0].at(0, 0) = 1.0f;
    mc[2].at(0, 0) = 2.0f;
  }
  return 0;
}

// CHECK: float mc[24];
// CHECK: mc[(0)*(8) +
// CHECK: mc[(2)*(8) +

// Register-direct automap used by `apply` must fold the span-array slot
// offset into the mapped register, so `mc[2].at(i,j)` does not alias slot 0.
__co__ auto fragment_array_apply_slot() {
  parallel p by 32 : thread {
    frag f32 [16, 16] acc;
    frag f32 [16, 16] mc[3] {0.0f};
    apply {i, j} in acc.span {
      acc.at(i, j) = mc[2].at(i, j);
    }
  }
  return 0;
}

// CHECK-LABEL: __choreo_device_fragment_array_apply_slot
// CHECK: { // apply acc
// CHECK: acc[__r] = mc[(2)*(8) + __r];

__device__ __forceinline__ void consume_fragment(float* values) {
  values[0] = values[0] + 1.0f;
}

// A whole array element passed to a device call addresses its slot with the
// fragment layout's registers-per-thread (the declaration's slot stride), not
// the span's element count.
__co__ auto fragment_array_call() {
  parallel p by 32 : thread {
    frag f32 [16, 16] mc[3] {0.0f};
    call consume_fragment(mc[2]);
  }
  return 0;
}

// CHECK-LABEL: __choreo_device_fragment_array_call
// CHECK: consume_fragment({{.*}}mc + (2)*(8));

// A whole-array copy must transfer every slot, not just the first one.
__co__ auto fragment_array_copy() {
  parallel p by 32 : thread {
    frag f32 [16, 16] a[2] {1.0f};
    frag f32 [16, 16] b[2] {0.0f};
    copy(b, a);
  }
  return 0;
}

// CHECK-LABEL: __choreo_device_fragment_array_copy
// CHECK: { // frag.copy
// CHECK-NEXT: #pragma unroll
// CHECK-NEXT: for (int __r = 0; __r < 16; ++__r)
// CHECK-NEXT: b[__r] = a[__r];
// CHECK: } // frag.copy

// A fragment-array ChunkAt must fold the slot offset into its register index,
// just like `at` and whole-array accesses.
__co__ auto fragment_array_chunkat_slot() {
  parallel p by 32 : thread {
    frag f32 [16, 16] mc[3] {0.0f};
    with {i, j} in [1, 1] {
      call consume_fragment(mc[2].chunkat(i, j));
    }
  }
  return 0;
}

// CHECK-LABEL: __choreo_device_fragment_array_chunkat_slot
// CHECK: consume_fragment({{.*}}mc[(2)*(8) + {{.*}});

// A fragment-array span_as alias is a pointer into the fragment registers. Its
// slot offset must use the fragment layout's registers-per-thread, not the
// span's element count.
__co__ auto fragment_array_span_as_alias() {
  parallel p by 32 : thread {
    frag f32 [16, 16] mc[3] {0.0f};
    q1 = mc[2].span_as(16, 16);
    call consume_fragment(q1);
  }
  return 0;
}

// CHECK-LABEL: __choreo_device_fragment_array_span_as_alias
// CHECK: auto* q1 = static_cast<float*>((float*)mc + (2)*(8));
// CHECK-NOT: mc + (2)*(256)
// CHECK: consume_fragment((float*)q1);
