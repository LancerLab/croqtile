// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a --stmatrix %s -o - | FileCheck %s

__co__ void ordered_group_fast_path(
    global bf16[128, 128] q, global bf16[128, 128] k,
    global bf16[128, 128] v) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s;
    shared bf16[128, 128] k_s;
    shared bf16[128, 128] v_s;
    shared event full;

    parallel p by 3 : group-4 {
      inthreads.async (p == 0) {
        q_load = tma.copy.async.swiz<128> q => q_s;
        k_load = tma.copy.async.swiz<128> k => k_s;
        v_load = tma.copy.async.swiz<128> v => v_s;
        trigger full after q_load, k_load, v_load;
      }
      inthreads.async (p > 0) {
        cid = p - 1;
        frag bf16[64, 128] probs {0.0f};
        wait full;
        scores = mma.fill.f32 0.0f;
        [[schedule(k_tiles(0, 1, 2, 3, 4, 5, 6, 7))]]
        qk = mma.row.row.async scores,
          q_s.subspan(64, 128).at(cid, 0), k_s;
        wait qk;
        output = mma.fill.f32 0.0f;
        [[schedule(k_tiles(7, 6, 5, 4, 0, 1, 2, 3))]]
        pv = mma.row.col.async output, probs, v_s;
        wait pv;
      }
    }
  }
}

// CHECK-LABEL: __choreo_device_ordered_group_fast_path
// CHECK: float scores[64];
// CHECK-NOT: __frag_init_val
// CHECK: wgmma_bf16_m64n128k16_ss_k128_order_01234567<true>(
// CHECK: wgmma_bf16_m64n128k16_rs_k128_order_76540123(
// CHECK-NOT: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_
