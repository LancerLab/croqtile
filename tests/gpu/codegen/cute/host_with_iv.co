// A host-level single-source `with` declares its iteration variable in the
// host scope, and a host-scope IV used inside a device block is passed to the
// kernel as a plain int parameter.
//
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s

__co__ void host_with_iv() {
  with i in [2] {
    println(i);
  }
}

__co__ void host_with_device(f32 [64] x) {
  with i in [2] {
    parallel p by 1 : block {
      println(i);
    }
  }
}

// CHECK: int __iv_i = 0;
// CHECK: printf({{.*}}__iv_i
// CHECK-LABEL: __global__{{.*}}host_with_device
// CHECK: int __iv_i)
