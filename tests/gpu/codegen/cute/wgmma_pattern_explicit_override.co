// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void wgmma_pattern_explicit_override() {
  parallel b by 1 : block {
    shared bf16[64, 128] lhs;
    shared bf16[128, 128] rhs;
    parallel g by 1 : group-4 {
      acc = mma.fill.f32 0.0f;
      [[schedule(k_tiles(7, 6, 5, 4, 3, 2, 1, 0))]]
      mma.row.row acc, lhs, rhs;
    }
  }
}

// CHECK-NOT: __choreo_wgmma_group_bf16_m64n128k16_ss_k128
// CHECK-LABEL: __choreo_device_wgmma_pattern_explicit_override
// CHECK-NOT: for (int __choreo_wgmma_k_iter
// CHECK: uint64_t __choreo_wgmma_desc_{{[0-9]+}}_order_0
// CHECK: {{.*}}::fma({{.*}}_order_0, {{.*}}_order_0
