// The 2-D TMA issue path reads two coordinates, so a rank-1 tile (a
// rank-reducing view) is diagnosed instead of aborting on an out-of-range
// coordinate lookup.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ void tma_rank1_view(f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64).from(5, 0) => shared;
    wait load;
  }
}

// CHECK: error: TMA copy requires a tile with at least 2 dimensions.
