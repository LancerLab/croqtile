// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - 2>&1 | FileCheck %s

__co__ void foo(f32 [128, 128] input) {
  
  parallel b by 1 : block {
    parallel g by 2 : group-4 {
      shared f32 [128, 128] input_s;
      shared event full[2];
      
      inthreads (g == 0) {
        foreach {order} in [2] {
          load = tma.copy.async input.chunkat(_, _) => input_s;
          trigger full.at(order) after load;
        }
      }

      inthreads (g == 1) {
        foreach {order} in [2]
          wait full.at(order);
      }
    }
  }
}

// CHECK: choreo::tma_load_2d_shared_cta_global_mbarrier((void*)(input_s), (const void*)&__choreo_tma_0_tensor_map, (uint64_t*)&(full[(__iv_order) % 2]), 0, 0);
// CHECK: full[(__iv_order) % 2].wait(((((__iv_order) / 2) & 1)));
