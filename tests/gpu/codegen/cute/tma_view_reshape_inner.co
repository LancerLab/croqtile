// A view that re-shapes the source's innermost dimension makes the flattened
// 2-D tensor map (inner = the source's innermost dimension) and the
// view-derived box describe different regions. The box's row stride must
// equal the map's inner extent and its innermost stride must be 1; diagnose
// it instead of encoding an incoherent map (driver reject or silent
// zero-fill).
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ void tma_view_reshape_inner(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// An explicit-stride view can keep a coherent row stride yet request a wider
// innermost extent than the map provides; the box must stay within the map.
__co__ void tma_view_overwide_stride(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(1024, 32: 16, 1) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// A rank-2 source with an over-wide view box is diagnosed too: the box's
// innermost extent must stay within the map's inner extent.
__co__ void tma_view_rank2_wide(global f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 64) => shared;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// The same over-wide view is diagnosed when the source is a shadowed device
// parameter (host-allocated parameter) ...
__co__ void tma_view_shadow_wide(f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 64) => shared;
    wait load;
  }
}

// ... and on the store side of a shadowed parameter.
__co__ auto tma_view_store_wide(f32 [64, 32] out) {
  parallel b by 1 : block {
    shared f32 [32, 64] s;
    tma.copy s => out.view(32, 64);
  }
  return out;
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A returned function-local global (not a parameter) takes the Choreo-output
// branch; its over-wide view is diagnosed there too.
__co__ auto tma_view_store_local_wide(f32 [64, 32] x) {
  global f32 [64, 32] out;
  parallel b by 1 : block {
    shared f32 [32, 64] s;
    dma.copy x => out;
    tma.copy s => out.view(32, 64);
  }
  return out;
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.
// CHECK: error: TMA view box is wider than the tensor map's innermost extent.
