// A view that re-shapes the source's innermost dimension makes the flattened
// 2-D tensor map (inner = the source's innermost dimension) and the
// view-derived box describe different regions. The box's row stride must
// equal the map's inner extent and its innermost stride must be 1; diagnose
// it instead of encoding an incoherent map (driver reject or silent
// zero-fill).
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s
// RUN: not choreo -es -t cute -arch=sm_90a -agent-diagnostics=- %s -o /dev/null 2>/dev/null | FileCheck %s --check-prefix=FACTS

__co__ void tma_view_reshape_inner(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(64, 32) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// An explicit-stride view can keep a coherent row stride yet request a wider
// innermost extent than the map provides; the box must stay within the map.
__co__ void tma_view_overwide_stride(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(1024, 32: 16, 1) => shared;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A rank-2 source with an over-wide view box is diagnosed too: the box's
// innermost extent must stay within the map's inner extent.
__co__ void tma_view_rank2_wide(global f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 64) => shared;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// The same over-wide view is diagnosed when the source is a shadowed device
// parameter (host-allocated parameter) ...
__co__ void tma_view_shadow_wide(f32 [64, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 64) => shared;
    wait load;
  }
}

// ... and on the store side of a shadowed parameter.
__co__ auto tma_view_store_wide(f32 [64, 32] out) {
  parallel b by 1 : block {
    shared f32 [32, 64] s;
    tma.copy s => out.view(32, 64);
  }
  return out;
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A returned function-local global (not a parameter) takes the Choreo-output
// branch; its over-wide view is diagnosed there too.
__co__ auto tma_view_store_local_wide(f32 [64, 32] x) {
  global f32 [64, 32] out;
  parallel b by 1 : block {
    shared f32 [32, 64] s;
    dma.copy x => out;
    tma.copy s => out.view(32, 64);
  }
  return out;
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.
// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A computed root subview flattened to 2-D uses its outermost stride as the
// map's inner extent; a view box wider than that is diagnosed.
__co__ void tma_view_root_subview_wide(global f32 [2, 64, 4, 128] input) {
  parallel bm by 1 : block {
    in_head = input.subspan(1, 64, 1, 128).at(0, 0, 0, 0).sqz();
    load = tma.copy.async in_head.view(8, 1024) => shared;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A view whose explicit stride list rank differs from the tile rank still
// must not request a box wider than the map.
__co__ void tma_view_stride_rank_mismatch(global f32 [64, 32, 16] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(128, 32: 16) => shared;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// Any box dimension above 256 is rejected outright by the driver. The map's
// outer extent stays above the box so only the driver limit fires.
__co__ void tma_view_driver_wide(global f32 [1024, 32] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(512, 8) => shared;
    wait load;
  }
}

// CHECK: error: TMA box dimension exceeds the 256-element driver limit.

// A swizzled copy splits the innermost dimension, but the logical box must
// still lie within the logical map.
__co__ void tma_view_swiz_inner_wide(global f16 [64, 128] x) {
  parallel b by 1 : block {
    shared f16 [32, 256] s;
    load = tma.copy.async.swiz<128> x.view(32, 256) => s;
    wait load;
  }
}

// CHECK: error: TMA view box is wider than the tensor map's innermost extent.

// A rank-2 global source with an explicit-stride view that ignores the
// source's row stride would lower to a dense box and load the wrong elements.
__co__ void tma_view_rank2_stride(global f32 [64, 64] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 32: 2, 1) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// A shadowed parameter takes the non-global TMA branch; an explicit-stride
// view that ignores the source row stride must be diagnosed there too.
__co__ void tma_view_shadow_stride(f32 [64, 64] x) {
  parallel b by 1 : block {
    load = tma.copy.async x.view(32, 32: 2, 1) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// A returned function-local global takes the Choreo-output branch; an
// explicit-stride view on the store destination must be validated too.
__co__ auto tma_view_store_local_stride(f32 [64, 64] x) {
  global f32 [64, 64] out;
  parallel b by 1 : block {
    shared f32 [32, 32] s;
    dma.copy x => out;
    tma.copy s => out.view(32, 32: 2, 1);
  }
  return out;
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// A computed root subview derives its map inner extent from the subview's
// outermost stride; an explicit-stride view that ignores it must be diagnosed.
__co__ void tma_view_root_subview_stride(global f32 [2, 64, 4, 128] input) {
  parallel bm by 1 : block {
    in_head = input.subspan(1, 64, 1, 128).at(0, 0, 0, 0).sqz();
    load = tma.copy.async in_head.view(64, 128: 128, 1) => shared;
    wait load;
  }
}

// CHECK: error: TMA view layout does not match the flattened tensor map

// The over-wide view diagnostic carries both the requested box inner extent
// and the map inner extent, plus a concrete repair.
// FACTS: <diagnostic severity="error" category="tma-view-box"{{.*}}>
// FACTS-NEXT: <constraint>TMA view box within the flattened tensor map; predicate: view.box_inner &lt;= map.inner</constraint>
// FACTS-NEXT: <observed>view.box_inner = 32; map.inner = 16; valid: view.box_inner &lt;= map.inner</observed>
// FACTS: <do>Reshape the view so its innermost box extent does not exceed the tensor map&apos;s innermost extent.</do>
