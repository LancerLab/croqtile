// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void event_ready_scalar() {
  parallel b by 1 : block {
    shared event empty = ready;
    parallel g by 2 : group-4 {
      inthreads.async (g == 0) {
        wait empty;
      }
      inthreads.async (g == 1) {
        trigger empty;
      }
    }
  }
}

// CHECK: shared event empty lowered to CTA named barrier 14 (trigger=128, wait=128)
// CHECK-NOT: empty__mem
// CHECK: prime ready event 'empty' (named barrier 14)
// CHECK: bar.arrive %0, %1;
// CHECK-SAME: "r"(14), "r"(256)
// CHECK: wait event(named barrier) empty
// CHECK-NEXT: asm volatile("bar.sync %0, %1;" :: "r"(14), "r"(256)
// CHECK: trigger event(named barrier) empty
// CHECK-NEXT: asm volatile("bar.arrive %0, %1;" :: "r"(14), "r"(256)
