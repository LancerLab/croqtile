// A one-slot sparse A metadata array is a broadcast.  The A operand may still
// carry a slot index, but the emitted `<frag>_mdata_ptr` must stay at the
// metadata buffer base instead of folding that slot past the only element.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto wgmma_sparse_one_slot(f16 [64, 16] lhs_packed, u8 [64, 4] lhs_meta,
                                  f16 [32, 8] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] a_s[2];
    shared u8 [64, 4] a_s_mdata[1];
    dma.copy lhs_packed => a_s[1];
    dma.copy lhs_meta => a_s_mdata[0];
    rhs_s = dma.copy rhs => shared;
    parallel wg by 1 : group-4 {
      mc = mma.fill.f32 0.0f;
      ma = mma.load a_s[1];
      mma.row.col.sp mc, ma, rhs_s;
      mma.store mc, output;
    }
  }
  return output;
}

// CHECK: uint8_t* ma_mdata_ptr = (uint8_t*)a_s_mdata;
// CHECK: wgmma_make_sparse_metadata_desc<32, false>(ma_mdata_ptr, 32 / 8, 1);
// CHECK: ::fma({{.*}}, ma_meta);
