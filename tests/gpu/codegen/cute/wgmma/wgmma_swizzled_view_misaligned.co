// A non-zero view offset into a tiled-swizzled WGMMA operand cannot be mapped
// to the descriptor's physical base yet (and the descriptor's base_offset
// phase is not modeled), so reject it instead of silently reading the wrong
// tile.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ void swizzled_view_col_offset(global bf16[128, 128] q, global bf16[128, 128] k) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s;
    shared bf16[128, 128] k_s;
    shared event full;
    parallel p by 2 : group-4 {
      inthreads.async (p == 0) {
        q_load = tma.copy.async.swiz<128> q => q_s;
        k_load = tma.copy.async.swiz<128> k => k_s;
        trigger full after q_load, k_load;
      }
      inthreads.async (p == 1) {
        wait full;
        scores = mma.fill.f32 0.0f;
        qk = mma.row.row.async scores,
          q_s.view(64, 32).from(0, 32), k_s.view(128, 32).from(0, 0);
        wait qk;
      }
    }
  }
}

__co__ void swizzled_view_row_offset(global bf16[128, 128] q, global bf16[128, 128] k) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s;
    shared bf16[128, 128] k_s;
    shared event full;
    parallel p by 2 : group-4 {
      inthreads.async (p == 0) {
        q_load = tma.copy.async.swiz<128> q => q_s;
        k_load = tma.copy.async.swiz<128> k => k_s;
        trigger full after q_load, k_load;
      }
      inthreads.async (p == 1) {
        wait full;
        scores = mma.fill.f32 0.0f;
        qk = mma.row.row.async scores,
          q_s.view(64, 32).from(1, 0), k_s.view(128, 32).from(0, 0);
        wait qk;
      }
    }
  }
}

// CHECK: error: swizzled WGMMA operand views with a non-zero offset are not supported (the tiled-swizzle physical mapping is not implemented).
