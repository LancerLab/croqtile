// Zero-offset views of a swizzled shared buffer are accepted and contribute
// no base offset: with and without an explicit `.from(0, ...)` (a view
// without `.from` carries no offsets at all). Non-zero view offsets are
// rejected (see the misaligned test) until the tiled-swizzle physical mapping
// is implemented.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s

__co__ void swizzled_view_zero_offset(global bf16[128, 128] q, global bf16[128, 128] k) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s;
    shared bf16[128, 128] k_s;
    shared event full;
    parallel p by 2 : group-4 {
      inthreads.async (p == 0) {
        q_load = tma.copy.async.swiz<128> q => q_s;
        k_load = tma.copy.async.swiz<128> k => k_s;
        trigger full after q_load, k_load;
      }
      inthreads.async (p == 1) {
        wait full;
        scores = mma.fill.f32 0.0f;
        qk = mma.row.row.async scores,
          q_s.view(64, 32).from(0, 0), k_s.view(128, 32).from(0, 0);
        wait qk;
      }
    }
  }
}

__co__ void swizzled_view_no_from(global bf16[128, 128] q, global bf16[128, 128] k) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s;
    shared bf16[128, 128] k_s;
    shared event full;
    parallel p by 2 : group-4 {
      inthreads.async (p == 0) {
        q_load = tma.copy.async.swiz<128> q => q_s;
        k_load = tma.copy.async.swiz<128> k => k_s;
        trigger full after q_load, k_load;
      }
      inthreads.async (p == 1) {
        wait full;
        scores = mma.fill.f32 0.0f;
        qk = mma.row.row.async scores, q_s.view(64, 32), k_s.view(128, 32);
        wait qk;
      }
    }
  }
}

// CHECK-LABEL: __choreo_device_swizzled_view_zero_offset
// CHECK: auto* __choreo_wgmma_ptr_{{[0-9]+}}_iter = {{.*}}(q_s)
// CHECK-LABEL: __choreo_device_swizzled_view_no_from
// CHECK: auto* __choreo_wgmma_ptr_{{[0-9]+}}_iter = {{.*}}(q_s)
