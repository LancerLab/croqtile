// An implicit sparse WGMMA metadata operand uses the A load's
// `<frag>_mdata_ptr`, which must be declared from the A source's
// `<ref>_mdata` buffer. The pointer must carry the A operand's slot offset
// before the descriptor consumes it.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | grep -v '^ *//' | FileCheck %s

__co__ auto wgmma_sparse_implicit(f16 [64, 16] lhs_packed, u8 [64, 4] lhs_meta,
                                  f16 [32, 8] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] a_s[2];
    shared u8 [64, 4] a_s_mdata[2];
    dma.copy lhs_packed => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    parallel wg by 1 : group-4 {
      mc = mma.fill.f32 0.0f;
      ma = mma.load a_s[1];
      mma.row.col.sp mc, ma, rhs_s;
      mma.store mc, output;
    }
  }
  return output;
}

// CHECK: uint8_t* ma_mdata_ptr = (uint8_t*)((unsigned char*)a_s_mdata + (1)*({{[0-9]+}}));
// CHECK: wgmma_make_sparse_metadata_desc<32, false>(ma_mdata_ptr, 32 / 8, 1);
// CHECK: ::fma({{.*}}, ma_meta);
