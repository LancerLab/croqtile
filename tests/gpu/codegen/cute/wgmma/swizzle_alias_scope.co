// An alias must inherit the swizzle mode of the buffer it references, not a
// same-named buffer from a sibling scope.  Here an outer q_s array slot is
// loaded with B128, a sibling scope also declares q_s with B32, and the
// aliasing scope has a later q_s declaration that is not visible at the
// alias.  The alias lookup must resolve q_s as a reference, so qa keeps B128
// instead of picking up the sibling's B32 mode through the raw-name fallback.
//
// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void swizzle_alias_scope(global bf16[128, 128] q, global bf16[128, 128] k) {
  parallel b by 1 : block {
    shared bf16[128, 128] q_s[2];
    shared bf16[128, 128] k_s;
    dma.copy.swiz<128> q => q_s[0];
    dma.copy.swiz<128> k => k_s;

    // Sibling scope: same short name, different swizzle mode.
    parallel p0 by 1 : group-4 {
      shared bf16[128, 128] q_s[2];
      dma.copy.swiz<32> q => q_s[0];
    }

    parallel p by 1 : group-4 {
      qa = q_s[0];
      // Declared after the alias, so the alias still refers to the outer q_s.
      shared bf16[128, 128] q_s[2];
      scores = mma.fill.f32 0.0f;
      qk = mma.row.row.async scores, qa.view(64, 32), k_s.view(128, 32);
      wait qk;
    }

    // A later sibling reuses the alias name for an unswizzled buffer. It must
    // not inherit the earlier sibling's B128 provenance through a raw-name
    // fallback lookup.
    parallel p1 by 1 : group-4 {
      shared bf16[128, 128] r_s;
      qa = r_s;
      scores1 = mma.fill.f32 0.0f;
      qk1 = mma.row.row.async scores1, qa.view(64, 32), k_s.view(128, 32);
      wait qk1;
    }
  }
}

// CHECK-LABEL: __choreo_device_swizzle_alias_scope
// CHECK: Layout_K_SW128_Atom<bf16>
// CHECK: Layout_K_SW32_Atom<bf16>
// CHECK: bf16* qa = (bf16*)((bf16*)q_s
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::B128>(__choreo_wgmma_ptr_0_iter)
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::B128>(__choreo_wgmma_ptr_1_iter)
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::NS>(__choreo_wgmma_ptr_2_iter)
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::B128>(__choreo_wgmma_ptr_3_iter)

// A TMA copy in an inner scope can target a shared buffer declared in an
// enclosing scope.  Its swizzle entry must be filed under the reference-
// resolved buffer scope so the later mma.load in another inner scope finds
// the B128 mode and applies the XOR phase; otherwise the load reads the
// swizzled buffer with the natural address arithmetic.
__co__ auto swizzle_tma_load_scope(f16 [64, 16] lhs, f16 [16, 64] rhs) {
  f16 [64, 64] output{0.0f};
  parallel b by 1 : block {
    shared f16 [64, 16] a_s;
    shared f16 [16, 64] b_s;
    parallel p by 1 : group-4 {
      la = tma.copy.swiz<128> lhs.chunkat(_, _) => a_s;
      lb = tma.copy.swiz<128> rhs.chunkat(_, _) => b_s;
      // Declared after the copy, so the copy still targets the outer a_s.
      shared f16 [64, 16] a_s;
    }
    parallel q by 1 : group-4 {
      ma = mma.load a_s;
      mc = mma.fill.f32 0.0f;
      mma.row.col mc, ma, b_s;
      mma.store mc, output;
    }
  }
  return output;
}

// CHECK-LABEL: __choreo_device_swizzle_tma_load_scope
// CHECK: size_t __mma_load_byte = __mma_load_logical * 2;
// CHECK: ma[__mma_load_i] = __mma_load_src[(__mma_load_byte ^ ((__mma_load_byte & 896) >> 3)) / 2];

// A plain shared-buffer alias has no array or span_as expression to inherit
// swizzle from.  The alias must still pick up the source buffer's B128 mode,
// otherwise the WGMMA descriptor is emitted as unswizzled even though q_s is
// laid out with the B128 swizzle.
__co__ void swizzle_plain_alias(global bf16 [128, 128] q, global bf16 [128, 128] k) {
  parallel b by 1 : block {
    shared bf16 [128, 128] q_s;
    shared bf16 [128, 128] k_s;
    dma.copy.swiz<128> q => q_s;
    dma.copy.swiz<128> k => k_s;
    parallel p by 1 : group-4 {
      qa = q_s;
      scores = mma.fill.f32 0.0f;
      qk = mma.row.row.async scores, qa.view(64, 32), k_s.view(128, 32);
      wait qk;
    }
  }
}

// CHECK-LABEL: __choreo_device_swizzle_plain_alias
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::B128>(__choreo_wgmma_ptr_5_iter)
// CHECK: wgmma_make_smem_desc<WGMMA_MajorOrder::K_MAJOR, WGMMA_Swizzle::B128>(__choreo_wgmma_ptr_6_iter)

// The assignment form must propagate the same provenance.  qa is a real
// shared buffer and is re-pointed at the swizzled q_s, so the WGMMA descriptor
// on qa must use q_s's B128 mode rather than the natural layout.
__co__ void swizzle_plain_alias_assign(global bf16 [128, 128] q, global bf16 [128, 128] k) {
  parallel b by 1 : block {
    shared bf16 [128, 128] q_s;
    shared bf16 [128, 128] k_s;
    shared bf16 [128, 128] qa;
    dma.copy.swiz<128> q => q_s;
    dma.copy.swiz<128> k => k_s;
    parallel p by 1 : group-4 {
      qa = q_s;
      scores = mma.fill.f32 0.0f;
      qk = mma.row.row.async scores, qa.view(64, 32), k_s.view(128, 32);
      wait qk;
    }

    // Re-point the same shared alias at an unswizzled buffer in a later
    // sibling. The stale B128 provenance must be cleared, not inherited.
    parallel p1 by 1 : group-4 {
      shared bf16 [128, 128] r_s;
      qa = r_s;
      scores1 = mma.fill.f32 0.0f;
      qk1 = mma.row.row.async scores1, qa.view(64, 32), k_s.view(128, 32);
      wait qk1;
    }
  }
}

// CHECK-LABEL: __choreo_device_swizzle_plain_alias_assign
// CHECK: qa = q_s;
