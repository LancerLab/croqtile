// A shadowed sparse mma.load fragment can be left without a matching exec.
// Report the missing MMA information and stop cleanly instead of aborting.
//
// REQUIRES: TARGET-SM_90A
// RUN: not choreo -es -t cute -arch=sm_90a %s 2>&1 | FileCheck %s

__co__ auto missing_mma_info(f16 [64, 16] lhs_packed, u8 [64, 4] lhs_meta,
                             f16 [32, 8] rhs) {
  f32 [64, 8] output{0.0f};
  parallel by 1 : block {
    shared f16 [64, 16] a_s[2];
    shared u8 [64, 4] a_s_mdata[2];
    dma.copy lhs_packed => a_s[1];
    dma.copy lhs_meta => a_s_mdata[1];
    rhs_s = dma.copy rhs => shared;
    ma = mma.load a_s[1];
    parallel wg by 1 : group-4 {
      mc = mma.fill.f32 0.0f;
      mma.row.col.sp mc, ma, rhs_s;
      // Shadows the enclosing fragment, so the load above has no exec.
      shared f16 [64, 16] ma;
      mma.store mc, output;
    }
  }
  return output;
}

// CHECK: error: the MMA operation of `{{.*}}ma` cannot be executed.
// The error must be reported without the codegen abort/assertion.
// CHECK-NOT: Assertion failed
// CHECK-NOT: MMA information is incomplete
