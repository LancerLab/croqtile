// REQUIRES: TARGET-SM_90A
// RUN: choreo -es -t cute -arch=sm_90a %s -o - | FileCheck %s

__co__ void distinct_dynamic_stages(global f32 [256, 128] input) {
  parallel b by 1 : block {
    shared f32 [128, 128] input_s[2];
    shared event full[2];

    parallel g by 2 : group-4 {
      first_order = b * 2;
      next_order = first_order + 1;
      first_slot = first_order % 2;
      next_slot = next_order % 2;
      inthreads.async (g == 0) {
        first_load = tma.copy.async
          input.subspan(128, 128).at(0, 0) => input_s[first_slot];
        trigger full.at(first_order) after first_load;
        next_load = tma.copy.async
          input.subspan(128, 128).at(1, 0) => input_s[next_slot];
        trigger full.at(next_order) after next_load;
      }

      inthreads.async (g == 1) {
        wait full.at(first_order);
        wait full.at(next_order);
      }
    }
  }
}

// CHECK-COUNT-2: .arrive_and_expect_tx(
// CHECK-NOT: .expect_transaction(
