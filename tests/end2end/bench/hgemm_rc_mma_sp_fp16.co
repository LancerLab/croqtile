// REQUIRES: TARGET-SM_80
// RUN: choreo -gs -t cute -arch=sm_80 %s -o %s.cute.result && bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 16
#define N 8
#define K 16

// Sparse GEMM: A is 2:4 structured sparse (pre-packed), B is dense
// K-major operands for row.row MMA
// A_packed: [M, K/2], A_meta: [1, M/2] (u32 packed), B: [N, K]
__co__ auto matmul_sp(f16 [M, K/2] lhs_packed, u32 [1, M/2] lhs_meta, f16 [N, K] rhs) {
  f32 [M, N] output{0.0f};

  int TILE_M = 16, TILE_N = 8, TILE_K = 16;
  int WARP_M = 16, WARP_N = 8, WARP_K = 16;

  // Single warp sparse MMA
  parallel {block_m, block_n} by [1, 1] : block {
    parallel p by 1 : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K, TILE_K)] {
        // Load packed A and metadata (no swizzle)
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;

        ma = mma.load lhs_load_s;
        mb = mma.load rhs_load_s;
        me = mma.load lhs_load_s_mdata;
        mma.row.row.sp mc, ma, mb, me;
      }

      mma.store mc, output.chunkat(block_m, block_n);
    }
  }

  return output;
}

int main() {
  // Create dense A with 2:4 sparsity pattern
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, K);
  auto rhs = choreo::make_spandata<choreo::f16>(N, K);
  
  // Fill with 2:4 structured sparse pattern like sptc-demo
  std::mt19937 gen(42);
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::uniform_int_distribution<int> pick(0, 3);
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < K / 4; ++c_group) {
      int idx0 = pick(gen);
      int idx1 = pick(gen);
      while (idx1 == idx0) idx1 = pick(gen);
      if (idx0 > idx1) std::swap(idx0, idx1);

      float v0 = dist(gen);
      float v1 = dist(gen);
      if (v0 == 0.0f) v0 = 1.0f;
      if (v1 == 0.0f) v1 = -1.0f;

      size_t base = r * K + c_group * 4;
      lhs_dense.data()[base + idx0] = choreo::f16(v0);
      lhs_dense.data()[base + idx1] = choreo::f16(v1);
    }
  }
  std::vector<choreo::f16> rhs_sptc(K * N);
  for (size_t i = 0; i < rhs_sptc.size(); ++i) rhs_sptc[i] = choreo::f16(dist(gen));
  for (size_t n = 0; n < N; ++n)
    for (size_t k = 0; k < K; ++k)
      rhs[n][k] = rhs_sptc[k * N + n];

  std::cout << "A_dense:\n";
  for(size_t i=0; i<M; i++) {
    for(size_t j=0; j<K; j++) {
      std::cout << __half2float(lhs_dense.data()[i*K + j]) << " ";
    }
    std::cout << "\n";
  }

  // Encode sparse A to packed values + uint32 metadata (like sptc-demo).
  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, K/2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(1, M/2);
  for (size_t i = 0; i < lhs_meta.element_count(); ++i) lhs_meta.data()[i] = 0;

  std::vector<uint16_t> row_meta(M, 0);
  for (size_t r = 0; r < M; ++r) {
    uint16_t meta = 0;
    for (size_t c_group = 0; c_group < K / 4; ++c_group) {
      size_t base = r * K + c_group * 4;
      size_t in_base = r * (K / 2) + c_group * 2;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (!choreo::utils::is_zero(lhs_dense.data()[base + i])) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);

      lhs_packed.data()[in_base + 0] = lhs_dense.data()[base + idxs[0]];
      lhs_packed.data()[in_base + 1] = lhs_dense.data()[base + idxs[1]];

      int pair_idx = c_group * 2;
      meta |= static_cast<uint16_t>(idxs[0]) << (pair_idx * 2);
      meta |= static_cast<uint16_t>(idxs[1]) << ((pair_idx + 1) * 2);
    }
    row_meta[r] = meta;
  }

  // Pack metadata like sptc-demo
  for (size_t r = 0; r < M; r += 16) {
    for (size_t i = 0; i < 8; ++i) {
      uint32_t lo = row_meta[r + i];
      uint32_t hi = row_meta[r + i + 8];
      lhs_meta[0][i] = (hi << 16) | lo;
    }
  }

  std::cout << "A_packed:\n";
  for(size_t i=0; i<M; i++) {
    for(size_t j=0; j<K/2; j++) {
      std::cout << __half2float(lhs_packed.data()[i*(K/2) + j]) << " ";
    }
    std::cout << "\n";
  }

  std::cout << "row_meta:\n";
  for (size_t i = 0; i < M; ++i) {
    std::cout << row_meta[i] << " ";
  }
  std::cout << "\n";

  std::cout << "A_meta:\n";
  for (size_t i = 0; i < M / 2; i++) {
    std::cout << lhs_meta.data()[i] << " ";
  }
  std::cout << "\n";

  // Validate packed + row_meta decoding
  auto lhs_dec = choreo::make_spandata<choreo::f16>(M, K);
  lhs_dec.fill(choreo::f16(0.0f));
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < K / 4; ++c_group) {
      size_t base = r * K + c_group * 4;
      size_t in_base = r * (K / 2) + c_group * 2;
      int pair_idx = c_group * 2;
      uint16_t meta = row_meta[r];
      uint16_t pos0 = (meta >> (pair_idx * 2)) & 0x3;
      uint16_t pos1 = (meta >> ((pair_idx + 1) * 2)) & 0x3;
      lhs_dec.data()[base + pos0] = lhs_packed.data()[in_base + 0];
      lhs_dec.data()[base + pos1] = lhs_packed.data()[in_base + 1];
    }
  }
  int decode_err = 0;
  for (size_t i = 0; i < lhs_dec.element_count(); ++i) {
    if (lhs_dec.data()[i] != lhs_dense.data()[i]) decode_err++;
  }
  std::cout << "decode_err: " << decode_err << "\n";

  // Validate packed metadata vs row_meta
  int meta_pack_err = 0;
  for (size_t i = 0; i < M / 2; ++i) {
    uint32_t expect = (uint32_t(row_meta[i + 8]) << 16) | uint32_t(row_meta[i]);
    if (lhs_meta.data()[i] != expect) meta_pack_err++;
  }
  std::cout << "meta_pack_err: " << meta_pack_err << "\n";

  std::cout << "B_sptc[K,N]:\n";
  for (size_t k = 0; k < K; ++k) {
    for (size_t n = 0; n < N; ++n) {
      std::cout << __half2float(rhs_sptc[k * N + n]) << " ";
    }
    std::cout << "\n";
  }

  std::cout << "B_rhs[N,K]:\n";
  for (size_t n = 0; n < N; ++n) {
    for (size_t k = 0; k < K; ++k) {
      std::cout << __half2float(rhs[n][k]) << " ";
    }
    std::cout << "\n";
  }

  int rhs_mismatch = 0;
  for (size_t n = 0; n < N; ++n) {
    for (size_t k = 0; k < K; ++k) {
      if (rhs[n][k] != rhs_sptc[k * N + n]) rhs_mismatch++;
    }
  }
  std::cout << "rhs_mismatch: " << rhs_mismatch << "\n";

  auto res = matmul_sp(lhs_packed.view(), lhs_meta.view(), rhs.view());

  // Verification using dense A
  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K; ++k)
        ref += __half2float(lhs_dense[i][k]) * __half2float(rhs[j][k]);
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) {
        errors++;
        if (errors < 5)
          std::cout << "[" << i << ", " << j << "] got " << got << " ref " << ref << "\n";
      }
    }
  
  if (errors > 0) {
    std::cout << "FAILED: " << errors << " errors\n";
    return 1;
  }
  std::cout << "Test Passed\n" << std::endl;
}

// CHECK: Test Passed
