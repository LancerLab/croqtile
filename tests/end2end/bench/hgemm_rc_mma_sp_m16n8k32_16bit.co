// REQUIRES: TARGET-GPU
// RUN: choreo -gs -t cute -arch=sm_80 %s -o %s.cute.result && bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 256
#define N 256
#define K 256
#define META_K 32

// Sparse GEMM: A is 2:4 structured sparse (pre-packed), B is dense
// K-major operands for row.row MMA

__co__ auto matmul_sp_k32_f16(f16 [M, K/2] lhs_packed, u32 [M, K / META_K] lhs_meta, f16 [N, K] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 64, TILE_N = 64, TILE_K = 64;
  int WARP_M = 16, WARP_N = 8, WARP_K = 32;
  parallel {block_m, block_n} by [cdiv(M, TILE_M), cdiv(N, TILE_N)] : block {
    parallel {iv_warp_m, iv_warp_n} by [cdiv(TILE_M, WARP_M), cdiv(TILE_N, WARP_N)] : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        foreach iv_warp_k in [cdiv(TILE_K, WARP_K)] {
          ma = mma.load lhs_load_s.chunkat(iv_warp_m, iv_warp_k);
          mb = mma.load rhs_load_s.chunkat(iv_warp_n, iv_warp_k);
          me = mma.load lhs_load_s_mdata.chunkat(iv_warp_m, iv_warp_k);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
      mma.store mc, output.chunkat(block_m#iv_warp_m, block_n#iv_warp_n);
    }
  }
  return output;
}

__co__ auto matmul_sp_k32_bf16(bf16 [M, K/2] lhs_packed, u32 [M, K / META_K] lhs_meta, bf16 [N, K] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 64, TILE_N = 64, TILE_K = 64;
  int WARP_M = 16, WARP_N = 8, WARP_K = 32;
  parallel {block_m, block_n} by [cdiv(M, TILE_M), cdiv(N, TILE_N)] : block {
    parallel {iv_warp_m, iv_warp_n} by [cdiv(TILE_M, WARP_M), cdiv(TILE_N, WARP_N)] : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        foreach iv_warp_k in [cdiv(TILE_K, WARP_K)] {
          ma = mma.load lhs_load_s.chunkat(iv_warp_m, iv_warp_k);
          mb = mma.load rhs_load_s.chunkat(iv_warp_n, iv_warp_k);
          me = mma.load lhs_load_s_mdata.chunkat(iv_warp_m, iv_warp_k);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
      mma.store mc, output.chunkat(block_m#iv_warp_m, block_n#iv_warp_n);
    }
  }
  return output;
}

template <typename T>
T make_val(float v);

template <>
choreo::f16 make_val<choreo::f16>(float v) { return choreo::f16(v); }

template <>
choreo::bf16 make_val<choreo::bf16>(float v) { return choreo::bf16(v); }

inline float to_f(choreo::f16 v) { return __half2float(v); }
inline float to_f(choreo::bf16 v) { return __bfloat162float(v); }

template <typename T>
void init_structured_sparse_A(std::vector<float>& A_dense_f,
                              choreo::spanned_data<T, 2>& A_dense,
                              std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::uniform_int_distribution<int> pick(0, 3);
  A_dense_f.assign(M * K, 0.0f);
  A_dense.fill(make_val<T>(0.0f));
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < K / 4; ++c_group) {
      int idx0 = pick(gen);
      int idx1 = pick(gen);
      while (idx1 == idx0) idx1 = pick(gen);
      if (idx0 > idx1) std::swap(idx0, idx1);
      float v0 = dist(gen);
      float v1 = dist(gen);
      if (v0 == 0.0f) v0 = 1.0f;
      if (v1 == 0.0f) v1 = -1.0f;
      size_t base = r * K + c_group * 4;
      T t0 = make_val<T>(v0);
      T t1 = make_val<T>(v1);
      A_dense.data()[base + idx0] = t0;
      A_dense.data()[base + idx1] = t1;
      A_dense_f[base + idx0] = to_f(t0);
      A_dense_f[base + idx1] = to_f(t1);
    }
  }
}

template <typename T>
void init_rhs(std::vector<float>& rhs_f,
              choreo::spanned_data<T, 2>& rhs,
              std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::vector<T> rhs_t(K * N);
  rhs_f.resize(K * N);
  for (size_t i = 0; i < rhs_t.size(); ++i) {
    T tv = make_val<T>(dist(gen));
    rhs_t[i] = tv;
    rhs_f[i] = to_f(tv);
  }
  for (size_t n = 0; n < N; ++n)
    for (size_t k = 0; k < K; ++k)
      rhs[n][k] = rhs_t[k * N + n];
}

template <typename T>
void encode_k32(const std::vector<float>& A_dense_f,
                choreo::spanned_data<T, 2>& A_dense,
                choreo::spanned_data<T, 2>& A_packed,
                choreo::spanned_data<choreo::u32, 2>& A_meta) {
  for (size_t r = 0; r < M; ++r) {
    for (size_t strip = 0; strip < K / META_K; ++strip) {
      A_meta[r][strip] = 0;
    }
    for (size_t c_group = 0; c_group < K / 4; ++c_group) {
      size_t base = r * K + c_group * 4;
      size_t in_base = r * (K / 2) + c_group * 2;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (A_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 structure");
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);
      A_packed.data()[in_base + 0] = A_dense.data()[base + idxs[0]];
      A_packed.data()[in_base + 1] = A_dense.data()[base + idxs[1]];
      int pack_col = c_group / (META_K / 4);
      int pair_idx = (c_group % (META_K / 4)) * 2;
      uint32_t packed = A_meta[r][pack_col];
      packed |= (static_cast<uint32_t>(idxs[0]) << (pair_idx * 2));
      packed |= (static_cast<uint32_t>(idxs[1]) << ((pair_idx + 1) * 2));
      A_meta[r][pack_col] = packed;
    }
  }
}

void compress_k32_ref(const std::vector<float>& A_dense_f,
                      std::vector<float>& A_sparse_f,
                      std::vector<uint32_t>& E_meta) {
  int k_sparse = K / 2;
  int meta_cols_packed = K / META_K;
  A_sparse_f.assign(M * k_sparse, 0.0f);
  E_meta.assign(M * meta_cols_packed, 0);
  for (int r = 0; r < M; ++r) {
    for (int c_group = 0; c_group < K / 4; ++c_group) {
      int base = r * K + c_group * 4;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (A_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 structure");
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);

      int sparse_col_base = c_group * 2;
      A_sparse_f[r * k_sparse + sparse_col_base + 0] = A_dense_f[base + idxs[0]];
      A_sparse_f[r * k_sparse + sparse_col_base + 1] = A_dense_f[base + idxs[1]];

      int pack_col = c_group / (META_K / 4);
      int pair_idx = (c_group % (META_K / 4)) * 2;
      uint32_t packed = E_meta[r * meta_cols_packed + pack_col];
      packed |= (static_cast<uint32_t>(idxs[0]) << (pair_idx * 2));
      packed |= (static_cast<uint32_t>(idxs[1]) << ((pair_idx + 1) * 2));
      E_meta[r * meta_cols_packed + pack_col] = packed;
    }
  }
}

int run_case_k32_f16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, K);
  auto rhs = choreo::make_spandata<choreo::f16>(N, K);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, gen);
  init_rhs(rhs_f, rhs, gen);

  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, K / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(M, K / META_K);
  encode_k32(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta);

  std::vector<float> A_sparse_ref;
  std::vector<uint32_t> E_ref;
  compress_k32_ref(lhs_dense_f, A_sparse_ref, E_ref);
  int packed_err = 0;
  for (size_t i = 0; i < A_sparse_ref.size(); ++i) {
    if (A_sparse_ref[i] != to_f(lhs_packed.data()[i])) packed_err++;
  }
  int meta_err = 0;
  for (size_t i = 0; i < E_ref.size(); ++i) {
    if (E_ref[i] != lhs_meta.data()[i]) meta_err++;
  }
  int rhs_mismatch = 0;
  for (size_t n = 0; n < N; ++n)
    for (size_t k = 0; k < K; ++k)
      if (rhs[n][k] != make_val<choreo::f16>(rhs_f[k * N + n])) rhs_mismatch++;
  choreo::choreo_assert(packed_err == 0, "k32 packed mismatch");
  choreo::choreo_assert(meta_err == 0, "k32 meta mismatch");
  choreo::choreo_assert(rhs_mismatch == 0, "k32 rhs mismatch");

  auto res = matmul_sp_k32_f16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K; ++k)
        ref += lhs_dense_f[i * K + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int run_case_k32_bf16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::bf16>(M, K);
  auto rhs = choreo::make_spandata<choreo::bf16>(N, K);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, gen);
  init_rhs(rhs_f, rhs, gen);

  auto lhs_packed = choreo::make_spandata<choreo::bf16>(M, K / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(M, K / META_K);
  encode_k32(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta);

  auto res = matmul_sp_k32_bf16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K; ++k)
        ref += lhs_dense_f[i * K + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int main() {
  int errors = 0;
  errors += run_case_k32_f16("k32_f16");
  errors += run_case_k32_bf16("k32_bf16");
  if (errors == 0) {
    std::cout << "Test Passed\n";
    return 0;
  }
  std::cout << "FAILED: " << errors << " errors\n";
  return 1;
}

// CHECK: Test Passed