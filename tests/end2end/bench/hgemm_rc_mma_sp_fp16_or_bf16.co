  }
  int decode_err = 0;
  for (size_t i = 0; i < lhs_dec_f.size(); ++i)
    if (lhs_dec_f[i] != lhs_dense_f[i]) decode_err++;
  choreo::choreo_assert(decode_err == 0, "k32 decode mismatch");

  int meta_pack_err = 0;
  for (size_t r = 0; r < M; ++r) {
    uint32_t expect = 0;
    for (size_t c_group = 0; c_group < K32 / 4; ++c_group) {
      size_t base = r * K32 + c_group * 4;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (lhs_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);
      int pair_idx = (c_group % 8) * 2;
      expect |= (static_cast<uint32_t>(idxs[0]) << (pair_idx * 2));
      expect |= (static_cast<uint32_t>(idxs[1]) << ((pair_idx + 1) * 2));
    }
    if (lhs_meta[r][0] != expect) meta_pack_err++;
  }
  choreo::choreo_assert(meta_pack_err == 0, "k32 meta pack mismatch");

  auto res = matmul_sp_k32_bf16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K32; ++k)
        ref += lhs_dense_f[i * K32 + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int main() {
  int errors = 0;
  errors += run_case_k16_f16("k16_f16");
  errors += run_case_k16_bf16("k16_bf16");
  errors += run_case_k32_f16("k32_f16");
  errors += run_case_k32_bf16("k32_bf16");
  if (errors > 0) {
    std::cout << "FAILED: " << errors << " errors\n";
    return 1;
  }
  std::cout << "Test Passed\n";
  return 0;
}

