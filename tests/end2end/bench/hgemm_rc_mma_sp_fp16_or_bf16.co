// REQUIRES: TARGET-SM_80
// RUN: choreo -gs -t cute -arch=sm_80 %s -o %s.cute.result && bash %s.cute.result --execute | FileCheck --match-full-lines %s && rm -f %s.cute.result

#define M 16
#define N 8
#define K16 16
#define K32 32

// Sparse GEMM: A is 2:4 structured sparse (pre-packed), B is dense
// K-major operands for row.row MMA

__co__ auto matmul_sp_k16_f16(f16 [M, K16/2] lhs_packed, u32 [1, M/2] lhs_meta, f16 [N, K16] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 16, TILE_N = 8, TILE_K = 16;
  int WARP_M = 16, WARP_N = 8, WARP_K = 16;
  parallel {block_m, block_n} by [1, 1] : block {
    parallel p by 1 : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K16, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        ma = mma.load lhs_load_s;
        mb = mma.load rhs_load_s;
        me = mma.load lhs_load_s_mdata;
        mma.row.row.sp mc, ma, mb, me;
      }
      mma.store mc, output.chunkat(block_m, block_n);
    }
  }
  return output;
}

__co__ auto matmul_sp_k16_bf16(bf16 [M, K16/2] lhs_packed, u32 [1, M/2] lhs_meta, bf16 [N, K16] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 16, TILE_N = 8, TILE_K = 16;
  int WARP_M = 16, WARP_N = 8, WARP_K = 16;
  parallel {block_m, block_n} by [1, 1] : block {
    parallel p by 1 : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K16, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        ma = mma.load lhs_load_s;
        mb = mma.load rhs_load_s;
        me = mma.load lhs_load_s_mdata;
        mma.row.row.sp mc, ma, mb, me;
      }
      mma.store mc, output.chunkat(block_m, block_n);
    }
  }
  return output;
}

__co__ auto matmul_sp_k32_f16(f16 [M, K32/2] lhs_packed, u32 [M, K32/32] lhs_meta, f16 [N, K32] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 16, TILE_N = 8, TILE_K = 32;
  int WARP_M = 16, WARP_N = 8, WARP_K = 32;
  parallel {block_m, block_n} by [1, 1] : block {
    parallel p by 1 : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K32, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        ma = mma.load lhs_load_s;
        mb = mma.load rhs_load_s;
        me = mma.load lhs_load_s_mdata;
        mma.row.row.sp mc, ma, mb, me;
      }
      mma.store mc, output.chunkat(block_m, block_n);
    }
  }
  return output;
}

__co__ auto matmul_sp_k32_bf16(bf16 [M, K32/2] lhs_packed, u32 [M, K32/32] lhs_meta, bf16 [N, K32] rhs) {
  f32 [M, N] output{0.0f};
  int TILE_M = 16, TILE_N = 8, TILE_K = 32;
  int WARP_M = 16, WARP_N = 8, WARP_K = 32;
  parallel {block_m, block_n} by [1, 1] : block {
    parallel p by 1 : group {
      mc = mma.fill.f32 0.0f;
      foreach {iv_k} in [cdiv(K32, TILE_K)] {
        lhs_load_s = dma.copy lhs_packed.chunkat(block_m, iv_k) => shared;
        lhs_load_s_mdata = dma.copy lhs_meta.chunkat(block_m, iv_k) => local;
        rhs_load_s = dma.copy rhs.chunkat(block_n, iv_k) => shared;
        ma = mma.load lhs_load_s;
        mb = mma.load rhs_load_s;
        me = mma.load lhs_load_s_mdata;
        mma.row.row.sp mc, ma, mb, me;
      }
      mma.store mc, output.chunkat(block_m, block_n);
    }
  }
  return output;
}

template <typename T>
T make_val(float v);

template <>
choreo::f16 make_val<choreo::f16>(float v) { return choreo::f16(v); }

template <>
choreo::bf16 make_val<choreo::bf16>(float v) { return choreo::bf16(v); }

inline float to_f(choreo::f16 v) { return __half2float(v); }
inline float to_f(choreo::bf16 v) { return __bfloat162float(v); }

template <typename T>
void init_structured_sparse_A(std::vector<float>& A_dense_f,
                              choreo::spanned_data<T, 2>& A_dense,
                              int K,
                              std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::uniform_int_distribution<int> pick(0, 3);
  A_dense_f.assign(M * K, 0.0f);
  A_dense.fill(make_val<T>(0.0f));
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < size_t(K / 4); ++c_group) {
      int idx0 = pick(gen);
      int idx1 = pick(gen);
      while (idx1 == idx0) idx1 = pick(gen);
      if (idx0 > idx1) std::swap(idx0, idx1);
      float v0 = dist(gen);
      float v1 = dist(gen);
      if (v0 == 0.0f) v0 = 1.0f;
      if (v1 == 0.0f) v1 = -1.0f;
      size_t base = r * K + c_group * 4;
      T t0 = make_val<T>(v0);
      T t1 = make_val<T>(v1);
      A_dense.data()[base + idx0] = t0;
      A_dense.data()[base + idx1] = t1;
      A_dense_f[base + idx0] = to_f(t0);
      A_dense_f[base + idx1] = to_f(t1);
    }
  }
}

template <typename T>
void init_rhs(std::vector<float>& rhs_f,
              choreo::spanned_data<T, 2>& rhs,
              int K,
              std::mt19937& gen) {
  std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
  std::vector<T> rhs_t(K * N);
  rhs_f.resize(K * N);
  for (size_t i = 0; i < rhs_t.size(); ++i) {
    T tv = make_val<T>(dist(gen));
    rhs_t[i] = tv;
    rhs_f[i] = to_f(tv);
  }
  for (size_t n = 0; n < N; ++n)
    for (size_t k = 0; k < size_t(K); ++k)
      rhs[n][k] = rhs_t[k * N + n];
}

template <typename T>
void encode_k16(const std::vector<float>& A_dense_f,
                const choreo::spanned_data<T, 2>& A_dense,
                choreo::spanned_data<T, 2>& A_packed,
                choreo::spanned_data<choreo::u32, 2>& A_meta,
                std::vector<uint16_t>& row_meta) {
  row_meta.assign(M, 0);
  for (size_t r = 0; r < M; ++r) {
    uint16_t meta = 0;
    for (size_t c_group = 0; c_group < K16 / 4; ++c_group) {
      size_t base = r * K16 + c_group * 4;
      size_t in_base = r * (K16 / 2) + c_group * 2;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (A_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 structure");
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);
      A_packed.data()[in_base + 0] = A_dense.data()[base + idxs[0]];
      A_packed.data()[in_base + 1] = A_dense.data()[base + idxs[1]];
      int pair_idx = c_group * 2;
      meta |= static_cast<uint16_t>(idxs[0]) << (pair_idx * 2);
      meta |= static_cast<uint16_t>(idxs[1]) << ((pair_idx + 1) * 2);
    }
    row_meta[r] = meta;
  }

  for (size_t i = 0; i < M / 2; ++i) {
    uint32_t lo = row_meta[i];
    uint32_t hi = row_meta[i + 8];
    A_meta[0][i] = (hi << 16) | lo;
  }
}

template <typename T>
void encode_k32(const std::vector<float>& A_dense_f,
                const choreo::spanned_data<T, 2>& A_dense,
                choreo::spanned_data<T, 2>& A_packed,
                choreo::spanned_data<choreo::u32, 2>& A_meta) {
  for (size_t r = 0; r < M; ++r) {
    A_meta[r][0] = 0;
    for (size_t c_group = 0; c_group < K32 / 4; ++c_group) {
      size_t base = r * K32 + c_group * 4;
      size_t in_base = r * (K32 / 2) + c_group * 2;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (A_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 structure");
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);
      A_packed.data()[in_base + 0] = A_dense.data()[base + idxs[0]];
      A_packed.data()[in_base + 1] = A_dense.data()[base + idxs[1]];
      int pack_col = c_group / 8;
      int pair_idx = (c_group % 8) * 2;
      uint32_t packed = A_meta[r][pack_col];
      packed |= (static_cast<uint32_t>(idxs[0]) << (pair_idx * 2));
      packed |= (static_cast<uint32_t>(idxs[1]) << ((pair_idx + 1) * 2));
      A_meta[r][pack_col] = packed;
    }
  }
}

int run_case_k16_f16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, K16);
  auto rhs = choreo::make_spandata<choreo::f16>(N, K16);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, K16, gen);
  init_rhs(rhs_f, rhs, K16, gen);

  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, K16 / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(1, M / 2);
  std::vector<uint16_t> row_meta;
  encode_k16(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta, row_meta);

  // decode check
  std::vector<float> lhs_dec_f(M * K16, 0.0f);
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < K16 / 4; ++c_group) {
      size_t base = r * K16 + c_group * 4;
      size_t in_base = r * (K16 / 2) + c_group * 2;
      int pair_idx = c_group * 2;
      uint16_t meta = row_meta[r];
      uint16_t pos0 = (meta >> (pair_idx * 2)) & 0x3;
      uint16_t pos1 = (meta >> ((pair_idx + 1) * 2)) & 0x3;
      lhs_dec_f[base + pos0] = to_f(lhs_packed.data()[in_base + 0]);
      lhs_dec_f[base + pos1] = to_f(lhs_packed.data()[in_base + 1]);
    }
  }
  int decode_err = 0;
  for (size_t i = 0; i < lhs_dec_f.size(); ++i)
    if (lhs_dec_f[i] != lhs_dense_f[i]) decode_err++;
  choreo::choreo_assert(decode_err == 0, "k16 decode mismatch");

  int meta_pack_err = 0;
  for (size_t i = 0; i < M / 2; ++i) {
    uint32_t expect = (uint32_t(row_meta[i + 8]) << 16) | uint32_t(row_meta[i]);
    if (lhs_meta[0][i] != expect) meta_pack_err++;
  }
  choreo::choreo_assert(meta_pack_err == 0, "k16 meta pack mismatch");

  auto res = matmul_sp_k16_f16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K16; ++k)
        ref += lhs_dense_f[i * K16 + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int run_case_k16_bf16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::bf16>(M, K16);
  auto rhs = choreo::make_spandata<choreo::bf16>(N, K16);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, K16, gen);
  init_rhs(rhs_f, rhs, K16, gen);

  auto lhs_packed = choreo::make_spandata<choreo::bf16>(M, K16 / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(1, M / 2);
  std::vector<uint16_t> row_meta;
  encode_k16(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta, row_meta);

  std::vector<float> lhs_dec_f(M * K16, 0.0f);
  for (size_t r = 0; r < M; ++r) {
    for (size_t c_group = 0; c_group < K16 / 4; ++c_group) {
      size_t base = r * K16 + c_group * 4;
      size_t in_base = r * (K16 / 2) + c_group * 2;
      int pair_idx = c_group * 2;
      uint16_t meta = row_meta[r];
      uint16_t pos0 = (meta >> (pair_idx * 2)) & 0x3;
      uint16_t pos1 = (meta >> ((pair_idx + 1) * 2)) & 0x3;
      lhs_dec_f[base + pos0] = to_f(lhs_packed.data()[in_base + 0]);
      lhs_dec_f[base + pos1] = to_f(lhs_packed.data()[in_base + 1]);
    }
  }
  int decode_err = 0;
  for (size_t i = 0; i < lhs_dec_f.size(); ++i)
    if (lhs_dec_f[i] != lhs_dense_f[i]) decode_err++;
  choreo::choreo_assert(decode_err == 0, "k16 decode mismatch");

  int meta_pack_err = 0;
  for (size_t i = 0; i < M / 2; ++i) {
    uint32_t expect = (uint32_t(row_meta[i + 8]) << 16) | uint32_t(row_meta[i]);
    if (lhs_meta[0][i] != expect) meta_pack_err++;
  }
  choreo::choreo_assert(meta_pack_err == 0, "k16 meta pack mismatch");

  auto res = matmul_sp_k16_bf16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K16; ++k)
        ref += lhs_dense_f[i * K16 + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int run_case_k32_f16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::f16>(M, K32);
  auto rhs = choreo::make_spandata<choreo::f16>(N, K32);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, K32, gen);
  init_rhs(rhs_f, rhs, K32, gen);

  auto lhs_packed = choreo::make_spandata<choreo::f16>(M, K32 / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(M, K32 / 32);
  encode_k32(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta);

  // decode check
  std::vector<float> lhs_dec_f(M * K32, 0.0f);
  for (size_t r = 0; r < M; ++r) {
    uint32_t meta = lhs_meta[r][0];
    for (size_t c_group = 0; c_group < K32 / 4; ++c_group) {
      size_t base = r * K32 + c_group * 4;
      size_t in_base = r * (K32 / 2) + c_group * 2;
      int pair_idx = (c_group % 8) * 2;
      uint16_t pos0 = (meta >> (pair_idx * 2)) & 0x3;
      uint16_t pos1 = (meta >> ((pair_idx + 1) * 2)) & 0x3;
      lhs_dec_f[base + pos0] = to_f(lhs_packed.data()[in_base + 0]);
      lhs_dec_f[base + pos1] = to_f(lhs_packed.data()[in_base + 1]);
    }
  }
  int decode_err = 0;
  for (size_t i = 0; i < lhs_dec_f.size(); ++i)
    if (lhs_dec_f[i] != lhs_dense_f[i]) decode_err++;
  choreo::choreo_assert(decode_err == 0, "k32 decode mismatch");

  int meta_pack_err = 0;
  for (size_t r = 0; r < M; ++r) {
    uint32_t expect = 0;
    for (size_t c_group = 0; c_group < K32 / 4; ++c_group) {
      size_t base = r * K32 + c_group * 4;
      int idxs[2] = {-1, -1};
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (lhs_dense_f[base + i] != 0.0f) {
          if (nz < 2) idxs[nz] = i;
          nz++;
        }
      }
      if (idxs[0] > idxs[1]) std::swap(idxs[0], idxs[1]);
      int pair_idx = (c_group % 8) * 2;
      expect |= (static_cast<uint32_t>(idxs[0]) << (pair_idx * 2));
      expect |= (static_cast<uint32_t>(idxs[1]) << ((pair_idx + 1) * 2));
    }
    if (lhs_meta[r][0] != expect) meta_pack_err++;
  }
  choreo::choreo_assert(meta_pack_err == 0, "k32 meta pack mismatch");

  auto res = matmul_sp_k32_f16(lhs_packed.view(), lhs_meta.view(), rhs.view());

  float tolerance = 0.1f;
  int errors = 0;
  for (size_t i = 0; i < M; ++i)
    for (size_t j = 0; j < N; ++j) {
      float ref = 0.0f;
      for (size_t k = 0; k < K32; ++k)
        ref += lhs_dense_f[i * K32 + k] * rhs_f[k * N + j];
      float got = res[i][j];
      if (std::abs(got - ref) >= tolerance) errors++;
    }
  std::cout << tag << ": " << errors << " errors\n";
  return errors;
}

int run_case_k32_bf16(const char* tag) {
  std::mt19937 gen(42);
  auto lhs_dense = choreo::make_spandata<choreo::bf16>(M, K32);
  auto rhs = choreo::make_spandata<choreo::bf16>(N, K32);
  std::vector<float> lhs_dense_f;
  std::vector<float> rhs_f;
  init_structured_sparse_A(lhs_dense_f, lhs_dense, K32, gen);
  init_rhs(rhs_f, rhs, K32, gen);

  auto lhs_packed = choreo::make_spandata<choreo::bf16>(M, K32 / 2);
  auto lhs_meta = choreo::make_spandata<choreo::u32>(M, K32 / 32);
  encode_k32(lhs_dense_f, lhs_dense, lhs_packed, lhs_meta);

  std::vector<float> lhs_dec_f(M * K32, 0.0f);
  for (size_t r = 0; r < M; ++r) {
    uint32_t meta = lhs_meta[r][0];
    for (size_t c_group = 0; c_group < K32 / 4; ++c_group) {
      size_t base = r * K32 + c_group * 4;
      size_t in_base = r * (K32 / 2) + c_group * 2;
      int pair_idx = (c_group % 8) * 2;
      uint16_t pos0 = (meta >> (pair_idx * 2)) & 0x3;
      uint16_t pos1 = (meta >> ((pair_idx + 1) * 2)) & 0x3;
      lhs_dec_f[base + pos0] = to_f(lhs_packed.data()[in_base + 0]);
      lhs_dec_f[base + pos1] = to_f(lhs_packed.data()[in_base + 1]);
