# step 1: write the kernel source code into a temp file
kernel_src=/tmp/1724917410228903046_140522252818240/__choreo_sgemm_kernel_inlined.cuh
cat <<'EOF' > ${kernel_src}
 /// kernel program
__device__ void ukernel_sgemm_32x32x32(float* lhs, float* rhs, float* out) {
  int tid_x = threadIdx.x;
  int tid_y = threadIdx.y;
  for (int i = 0; i < 32; i++) {
      out[tid_y*32 + tid_x] += lhs[tid_y * 32 + i] * rhs[i * 32 + tid_x];
  }
  return;
}

__device__ int tile_addr_(int x_offset, int y_offset, int x_stride, int y_stride) {
  int idx = x_offset * x_stride + y_offset * y_stride;
  return idx;
}

__device__ int tile_addr_ex_(int x_tile, int y_tile, int x_offset, int y_offset, int x_tile_size, int y_tile_size, int x_stride, int y_stride) {
  int idx = x_tile * x_tile_size * x_stride + y_tile * y_tile_size * y_stride + x_offset * x_stride + y_offset * y_stride;
  return idx;
}

__device__ void fill_zero_elementwise(float* data) {
  int tid_x = threadIdx.x;
  int tid_y = threadIdx.y;
  data[tid_y*32 + tid_x] = 0.0;
}

EOF

# step 2: write the cuda source code into a temp file
cuda_src=/tmp/1724917410228903046_140522252818240/__choreo_cuda_kernel.cuh
cat <<'EOF' > ${cuda_src}

#pragma once

#include <cassert>
#include <cstdio>
#include <cstdlib>
#include <cublas_v2.h>
#include <cuda_runtime.h>
#include "choreo_cuda.h"
#include "/tmp/1724917410228903046_140522252818240/__choreo_sgemm_kernel_inlined.cuh"


#define CEIL_DIV(M, N) (((M) + (N)-1) / (N))
#define OFFSET(row, col, ld) ((row)*(ld)+(col))
#define FETCH_FLOAT4(pointer) (reinterpret_cast<float4*>(&(pointer))[0])

__global__ void  __choreo_sgemm_host_parallel(float* lhs, float* rhs, float* output);

void __choreo_sgemm_host(float* lhs, float* rhs, float* output) {
    dim3 blockDim(32, 32);
    dim3 gridDim(128, 128);
    __choreo_sgemm_host_parallel<<<gridDim, blockDim>>>(lhs, rhs, output);
} // end of choreo-cuda dataflow program

__global__ void  __choreo_sgemm_host_parallel(float* lhs, float* rhs, float* output) {
  auto q = blockIdx.x;
  auto p = blockIdx.y;
  auto bid_z = blockIdx.z;
  auto tid_x = threadIdx.x;
  auto tid_y = threadIdx.y;
  auto tid_z = threadIdx.z;

  __shared__ float lhs_load_buffer[32 * 32];
  __shared__ float rhs_load_buffer[32 * 32];
  __shared__ float l2_out[32 * 32];
  fill_zero_elementwise(l2_out);
  __syncthreads();

  for (auto k_tile = 0; k_tile < 128; k_tile++) {
    lhs_load_buffer[tid_y*32 + tid_x] = lhs[tid_y*32+tid_x+32*p*4096+32*k_tile*4096];
    rhs_load_buffer[tid_y*32 + tid_x] = rhs[tid_y*32+tid_x+32*k_tile*4096+32*q*4096];
    ukernel_sgemm_32x32x32(lhs_load_buffer,rhs_load_buffer,l2_out);
    __syncthreads();

    output[tid_y*32+tid_x+32*p*4096+32*q*4096] = l2_out[tid_y*32 + tid_x];
  } // end of choreo-foreach block.
} // end of choreo-cuda kernel function

EOF


