// REQUIRES: TARGET-GCUALL
// SHELL-ONLY
// RUN: choreo -t topscc %s -o %s.topscc.result && %s.topscc.result | FileCheck --match-full-lines %s && rm -f %s.topscc.result

#define K (1024)
#define M (1024*1024)
#define G (1024*1024*1024)

__co__ auto foo() {
  u8 [G] ans{11};
  parallel p by 1 {
    with idx in [1] {
      foreach idx {
        local u8 [1] a{32};
      }
    }
  }

  return ans;
}

int main()
{
  bool passed = true;

  auto res = foo();
  
  for (size_t i=0; i<G; i++)
    if (res[i] != 11) {
      std::cout << "error!\n";
      passed = false;
      break;
    }

  if (passed) std::cout << "passed!\n";

  return 0;
}

// CHECK: passed!
