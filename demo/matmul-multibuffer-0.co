    vr_dummy = __dtu_s_tvld_itar(input_addr_base, t_input_offset_m);
    smr = __dtu_v_swapsmr(smr);

    vacc0 = __dtu_m_vmm_mode3_f_vs0_ld_row(vacc0, vr_lhs0, smr, vr_rhs0, 1);
