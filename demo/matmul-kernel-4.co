#include "choreo.h"
#include <chrono>

// extern "C" void kernel(int * lhs, int * rhs, int * out, int m, int k, int n) {
__cok__ { /// kernel program
extern "C" void kernel(int * lhs, int * rhs, int * out) {
  int m = 8;
  int k = 1024;
  int n = 16;
  for (int i = 0; i < m; ++i) {
    for (int j = 0; j < n; ++j) {
      for (int z = 0; z < k; ++z) {
        out[i*n + j] += lhs[i*k+z]*rhs[z*n+j];
        // out[i*n + j] = lhs[i*k+z] + rhs[z*n+j];
      }
    }
  }
}
} /// end of kernel decl

/// Matmul-basic: This is the init version of mamtul, where, each kernel calculates a 1x16 vector of elements in the output matrix.
/// lhs and rhs loads the required data, and explicitly move from global memory to shared memory, then to local memory.
/// The inner-most kernel calculate a 1x1024, 1024x16 => 1x16 matmul

// Analysis:
//
// HW: in DORADO: 1 card = 2 clusters = 6 csb = 6 L2 = 24 SIP = 24 L1, each CSB = 8MB, each L1 = 1 MB
//
// GMEM: lhs=<512x1024>=2MB, rhs=<1024x1024>=4MB, output=<512x1024>=2MB
// SMEM: lhs_load=<8x1024>=32KB, rhs_load=<1024x16>=64KB, l2_out=<8x16>=... < 8MB
// LMEM: lhs_load=<8x1024>=32KB, rhs_load=<1024x16>=64KB, l2_out=<8x16>=... < 1MB
__co__ s32 [512, 1024] ele_add(s32 [512, 1024] lhs, s32 [1024, 1024] rhs) { /// device program
  s32[lhs.span(0), rhs.span(1)] output; // use same shape as lhs

  parallel p by 1 {  // p is sip_index
    with index = {m_tile, k_tile, n_tile} in [64, 1, 64] {  // decl your tiled spans
      foreach m_tile { // alternative: foreach index, index.x, index.y
        foreach n_tile {
          shared s32[8, 16] l2_out; // alternative: s32[lhs.span(0)/#p, lhs.span(1)/#x, rhs.span(2)/#y]
          foreach k_tile {
            // chunkat can support bounded_var algebra.
            lhs_load = dma.copy.async lhs.chunkat(m_tile, k_tile) => shared; // tiling_factor: {6, 17, 4}, new_size {lhs(0)/6, lhs(1)/17, lhs(2)/4}
            rhs_load = dma.copy.async rhs.chunkat(k_tile, n_tile) => shared; // no explicit decl the target buffer, but can refer by <FutureType>.data
            wait lhs_load, rhs_load;
            parallel q by 1 {
              with index = {m_tile_s, k_tile_s, n_tile_s} in [1, 1, 1] {
                foreach m_tile_s {
                  foreach n_tile_s {
                    // ALT: local s32[1, 16] l1_out; // alternative: s32[lhs.span(0)/#p, lhs.span(1)/#x, rhs.span(2)/#y]
                    foreach k_tile_s{
                      lhs_load_s = dma.copy.async lhs_load.data.chunkat(m_tile_s, k_tile_s) => local;
                      rhs_load_s = dma.copy.async rhs_load.data.chunkat(k_tile_s, n_tile_s) => local;
                      out_load_s = dma.copy.async l2_out.chunkat(m_tile_s, n_tile_s) => local;
                      wait lhs_load_s, rhs_load_s, out_load_s;
                      call kernel(lhs_load_s.data, rhs_load_s.data, out_load_s.data); // |span| calculate the total size of span.
                      // ALT: call kernel(lhs_load_s.data, rhs_load_s.data, l1_out); // |span| calculate the total size of span.
                      out_store_s = dma.copy.async out_load_s.data => l2_out.chunkat(m_tile_s, n_tile_s); // can use defined vars
                      // ALT: out_store_s = dma.copy.async l1_out => l2_out.chunkat(m_tile_s, n_tile_s); // can use defined vars
                      wait out_store_s;
                    }
                  }
                }
              }
            }

            out_store = dma.copy.async l2_out => output.chunkat(m_tile, n_tile); // can use defined vars
            wait out_store;
          }
        }
      }
    }
  } // can use python styling
  return output;
}

int main() { /// host program
  choreo::s32 a[512][1024] = {0}; // unified abstraction in choreo type system, no need for C++ vectors/uint8_t, no factor Data/Mem types, we handles the bridge choreo::s32 b[512][512] = {0};
  choreo::s32 b[1024][1024] = {0}; // unified abstraction in choreo type system, no need for C++ vectors/uint8_t, no factor Data/Mem types, we handles the bridge choreo::s32 b[512][512] = {0};
  std::fill_n(&a[0][0], sizeof(a) / sizeof(a[0][0]), 1);
  std::fill_n(&b[0][0], sizeof(b) / sizeof(b[0][0]), 1);
  auto lhs_data = choreo::make_spanview<2, choreo::s32>((int*)a, {512, 1024});
  auto rhs_data = choreo::make_spanview<2, choreo::s32>((int*)b, {1024, 1024});

  auto start = std::chrono::high_resolution_clock::now();

  auto res
    = ele_add(lhs_data, rhs_data);

  auto end = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);

  std::cout << res.shape()[0] << std::endl;
  std::cout << res.shape()[1] << std::endl;

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j) {
        std::cout << "i: " << i << ", j: " << j << "\n";
        std::cout << "res: " << res[i][j] << "\n";
        int ref = 0;
        for (size_t k = 0; k < lhs_data.shape()[1]; ++k) {
          ref += a[i][k]*b[k][j];

        }
        std::cout << "ref: " << ref << std::endl;
        assert(ref == res[i][j]);
      }
  std::cout << "Test Passed\n" << std::endl;
  std::cout << "Function execution time: " << duration.count() << " microseconds" << std::endl;
}
