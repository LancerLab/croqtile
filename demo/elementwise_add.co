#include "choreo.h"

__cok__ { /// kernel program
extern "C" void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}
} /// end of kernel decl

__co__ s32 [6, 17, 128] ele_add(s32 [6, 17, 128] lhs, s32 [6, 17, 128] rhs) { /// device program
  s32[lhs.span] output; // use same shape as lhs

  parallel p by 6 {  // p is sip_index
    with index = {x, y} in [17, 4] {  // decl your tiled spans
      foreach x { // alternative: foreach index, index.x, index.y
        foreach y { 
          lhs_load = dte.linear lhs.chunkat(p, x, y) => local; // tiling_factor: {6, 17, 4}, new_size {lhs(0)/6, lhs(1)/17, lhs(2)/4}
          rhs_load = dte.linear rhs.chunkat(p, x, y) => local; // no explicit decl the target buffer, but can refer by <FutureType>.data
          wait lhs_load, rhs_load;

          local s32[lhs_load.span] l1_out; // alternative: s32[lhs.span(0)/#p, lhs.span(1)/#x, rhs.span(2)/#y]
          
          call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|); // |span| calculate the total size of span.

          out_store = dte.linear l1_out => output.chunkat(p, x, y); // can use defined vars
          wait out_store;
        }
      }
    }
  } // can use python styling
  return output;
}

int main() { /// host program
  choreo::s32 a[6][17][128] = {0}; // unified abstraction in choreo type system, no need for C++ vectors/uint8_t, no factor Data/Mem types, we handles the bridge
  choreo::s32 b[6][17][128] = {0};
  std::fill_n(&a[0][0][0], sizeof(a) / sizeof(a[0][0][0]), 1);
  std::fill_n(&b[0][0][0], sizeof(b) / sizeof(b[0][0][0]), 2);

  auto res
    = ele_add(choreo::make_spanned<3, choreo::s32>((int*)a, {6, 17, 128}),
              choreo::make_spanned<3, choreo::s32>((int*)b, {6, 17, 128}));

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; i < res.shape()[1]; ++i)
      for (size_t k = 0; i < res.shape()[2]; ++i)
        assert(a[i][j][k] + b[i][j][k] == res[i][j][k]);

  std::cout << "Test Passed\n" << std::endl;
}

