#include "choreo.h"

__cok__ {
// kernel program
extern "C" void kernel(int * a, int * b, int * c, int n) {
  for (int i = 0; i < n; ++i)
    c[i] = a[i] + b[i];
}
}

// device program
__co__ s32 [6, 17, 128] ele_add(s32 [6, 17, 128] lhs, s32 [6, 17, 128] rhs) {

  s32[lhs.span] output;

  parallel p by 6 {  // p is sip_index
    // kernel function begin

    with index = {x, y} in [17, 8] {  // totally 100 chunks
      foreach x {
        foreach y { 
          // l2_lhs_load = dte.linear lhs.chunkat(p, l2_x, l2_y) => shared; // new_size {lhs(0)/6, lhs(1)/1, lhs(2)/1}
          // l2_rhs_load = dte.linear rhs.chunkat(p, l2_x, l2_y) => shared;
          // wait l2_lhs_load, l2_rhs_load;
          // shared i32[l2_lhs_load.span] l2_out; // use f1.span as the span of local buffer

          lhs_load = dte.linear lhs.chunkat(p, x, y) => local; // new_size {lhs(0)/6, lhs(1)/1, lhs(2)/1}
          rhs_load = dte.linear rhs.chunkat(p, x, y) => local;
          wait lhs_load, rhs_load;

          local s32[lhs_load.span] l1_out; // use f1.span as the span of local buffer

          
          call kernel(lhs_load.data, rhs_load.data, l1_out, |lhs_load.span|); // |span| calculate the total size of span.

          out_store = dte.linear l1_out => output.chunkat(p, x, y);
          wait out_store;
        }
      }
    }
    // l2_out_store = dte.linear l2_out => output.chunkat(p, l2_x, l2_y);
    // wait l2_out_store;
  }

  return output;
}

// host program
int main() {
  choreo::s32 a[6][17][128] = {0};
  choreo::s32 b[6][17][128] = {0};
  std::fill_n(&a[0][0][0], sizeof(a) / sizeof(a[0][0][0]), 1);
  std::fill_n(&b[0][0][0], sizeof(b) / sizeof(b[0][0][0]), 2);
  ele_add(choreo::make_spanned<3, choreo::s32>((int*)a, {6, 17, 128}),
                 choreo::make_spanned<3, choreo::s32>((int*)b, {6, 17, 128}));
}

