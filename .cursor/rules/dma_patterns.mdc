# Choreo DMA模式摘要

## 基本DMA操作

### 基本复制
从一个内存区域复制数据到另一个内存区域。

```choreo
// 基本DMA复制
__co__ void basic_dma(f32 [N] src, f32 [N] dst) {
  dma.copy src => dst;
}
```

### 分块复制
将大型数据分解为小块进行复制。

```choreo
// 分块DMA复制
__co__ void chunked_dma(f32 [M, N] src, f32 [M, N] dst) {
  with i in [M / BLOCK_SIZE] {
    dma.copy src.chunkat(i * BLOCK_SIZE, 0) => dst.chunkat(i * BLOCK_SIZE, 0);
  }
}
```

## 异步DMA模式

### 基本异步DMA
使用事件实现异步DMA操作。

```choreo
// 异步DMA操作
__co__ void async_dma(f32 [N] src, f32 [N] dst) {
  shared event e;
  
  // 启动异步DMA操作
  dma.copy src => dst : e;
  
  // 执行其他操作...
  
  // 等待DMA操作完成
  wait e;
}
```

### 多重异步DMA
并行启动多个DMA操作。

```choreo
// 多重异步DMA
__co__ void multi_async_dma(f32 [N] src1, f32 [N] dst1, f32 [N] src2, f32 [N] dst2) {
  shared event e1;
  shared event e2;
  
  // 启动多个异步DMA操作
  dma.copy src1 => dst1 : e1;
  dma.copy src2 => dst2 : e2;
  
  // 等待所有DMA操作完成
  wait e1;
  wait e2;
}
```

## 高级DMA模式

### 双缓冲DMA
使用双缓冲隐藏DMA延迟。

```choreo
// 双缓冲DMA模式
__co__ void double_buffer_dma(f32 [N] src, f32 [N] dst) {
  f32 [TILE_SIZE] buffer_a;
  f32 [TILE_SIZE] buffer_b;
  shared event e_a;
  shared event e_b;
  
  // 预加载第一个缓冲区
  dma.copy src.chunkat(0) => buffer_a : e_a;
  
  with i in [1, N / TILE_SIZE] {
    // 启动下一个缓冲区的加载
    dma.copy src.chunkat(i * TILE_SIZE) => buffer_b : e_b;
    
    // 等待当前缓冲区加载完成
    wait e_a;
    
    // 处理当前缓冲区
    // ...
    
    // 写回结果
    dma.copy buffer_a => dst.chunkat((i-1) * TILE_SIZE);
    
    // 交换缓冲区
    buffer_a, buffer_b = buffer_b, buffer_a;
    e_a, e_b = e_b, e_a;
  }
  
  // 处理最后一个缓冲区
  wait e_a;
  // ...
  dma.copy buffer_a => dst.chunkat((N / TILE_SIZE - 1) * TILE_SIZE);
}
```

### 三缓冲DMA
使用三个缓冲区进一步隐藏延迟。

```choreo
// 三缓冲DMA模式
__co__ void triple_buffer_dma(f32 [N] src, f32 [N] dst) {
  f32 [TILE_SIZE] buffer_a;
  f32 [TILE_SIZE] buffer_b;
  f32 [TILE_SIZE] buffer_c;
  shared event e_a;
  shared event e_b;
  shared event e_c;
  
  // 预加载前两个缓冲区
  dma.copy src.chunkat(0) => buffer_a : e_a;
  dma.copy src.chunkat(TILE_SIZE) => buffer_b : e_b;
  
  with i in [2, N / TILE_SIZE] {
    // 启动下一个缓冲区的加载
    dma.copy src.chunkat(i * TILE_SIZE) => buffer_c : e_c;
    
    // 等待并处理第一个缓冲区
    wait e_a;
    // 处理buffer_a
    dma.copy buffer_a => dst.chunkat((i-2) * TILE_SIZE);
    
    // 循环交换缓冲区
    buffer_a, buffer_b, buffer_c = buffer_b, buffer_c, buffer_a;
    e_a, e_b, e_c = e_b, e_c, e_a;
  }
  
  // 处理剩余的缓冲区
  wait e_a;
  dma.copy buffer_a => dst.chunkat((N / TILE_SIZE - 2) * TILE_SIZE);
  
  wait e_b;
  dma.copy buffer_b => dst.chunkat((N / TILE_SIZE - 1) * TILE_SIZE);
}
```

## 并行DMA模式

### 并行分块DMA
在多个并行线程中执行DMA操作。

```choreo
// 并行分块DMA
__co__ void parallel_chunked_dma(f32 [M, N] src, f32 [M, N] dst) {
  parallel p by THREADS {
    with i in [(M + THREADS - 1) / THREADS] {
      int row = p.id + i * THREADS;
      inthreads(row < M) {
        dma.copy src.chunkat(row, 0) => dst.chunkat(row, 0);
      }
    }
  }
}
```

### 交错DMA
在并行线程中交错执行DMA操作。

```choreo
// 交错DMA模式
__co__ void interleaved_dma(f32 [N] src, f32 [N] dst) {
  parallel p by 2 {
    f32 [TILE_SIZE] buffer;
    
    inthreads(p.id == 0) {
      // 线程0处理偶数块
      with i in [(N / TILE_SIZE + 1) / 2] {
        int idx = i * 2;
        inthreads(idx < N / TILE_SIZE) {
          dma.copy src.chunkat(idx * TILE_SIZE) => buffer;
          // 处理数据
          dma.copy buffer => dst.chunkat(idx * TILE_SIZE);
        }
      }
    }
    
    inthreads(p.id == 1) {
      // 线程1处理奇数块
      with i in [N / TILE_SIZE / 2] {
        int idx = i * 2 + 1;
        dma.copy src.chunkat(idx * TILE_SIZE) => buffer;
        // 处理数据
        dma.copy buffer => dst.chunkat(idx * TILE_SIZE);
      }
    }
  }
}
```

## DMA优化模式

### 合并DMA
合并多个小型DMA操作为一个大型操作。

```choreo
// 合并DMA操作
__co__ void coalesced_dma(f32 [N] src1, f32 [N] src2, f32 [N] dst1, f32 [N] dst2) {
  // 不推荐：多个小型DMA操作
  // dma.copy src1 => dst1;
  // dma.copy src2 => dst2;
  
  // 推荐：合并为一个大型DMA操作
  f32 [2*N] combined_src;
  f32 [2*N] combined_dst;
  
  // 构建合并源
  dma.copy src1 => combined_src.chunkat(0);
  dma.copy src2 => combined_src.chunkat(N);
  
  // 执行单次大型DMA
  dma.copy combined_src => combined_dst;
  
  // 分解目标
  dma.copy combined_dst.chunkat(0) => dst1;
  dma.copy combined_dst.chunkat(N) => dst2;
}
```

### 内存对齐DMA
确保DMA操作的内存对齐以提高性能。

```choreo
// 内存对齐DMA
__co__ void aligned_dma(f32 [N] src, f32 [N] dst) {
  // 确保TILE_SIZE是对齐的（例如，是16的倍数）
  with i in [N / TILE_SIZE] {
    dma.copy src.chunkat(i * TILE_SIZE) => dst.chunkat(i * TILE_SIZE);
  }
  
  // 处理剩余的不对齐部分
  int remaining = N % TILE_SIZE;
  inthreads(remaining > 0) {
    dma.copy src.chunkat(N - remaining) => dst.chunkat(N - remaining);
  }
}
```

