// RUN: cocc -emit-coir %s | FileCheck %s
// RUN: cocc -emit-coir --no-opt %s | FileCheck --check-prefix=RAW %s
//
// Test that -emit-coir runs the cleanup pass (canonicalize + CSE):
// the frontend's redundant literal index_casts are folded away, while the
// semantically required dynamic cast is kept.  With --no-opt the raw IR
// (redundant casts included) is preserved, like clang -emit-llvm at -O0.

__co__ s32 [64] probe(s32 [64] a, s32 idx) {
  s32[64] c;
  parallel p by 1 : thread {
    c.at(0) = a.at(idx);
  }
  return c;
}

// The literal index 0 folds into an index constant (no i32 literal survives),
// the store consumes it directly, and the dynamic index cast of %arg1 stays.
// CHECK-LABEL: coir.kernel @probe
// CHECK-NOT: constant {{[0-9]+}} : i32
// CHECK: arith.constant 0 : index
// CHECK: arith.index_cast %arg{{.*}} : i32 to index
// CHECK: coir.tensor.load_elem
// CHECK: coir.tensor.store_elem %{{.*}}, %{{.*}}[%c{{.*}}]
// CHECK-NOT: constant {{[0-9]+}} : i32
// CHECK: coir.return

// Under --no-opt the raw IR keeps the i32 literal and its index_cast.
// RAW-LABEL: coir.kernel @probe
// RAW: arith.constant 0 : i32
// RAW: arith.index_cast %{{.*}} : i32 to index
// RAW: coir.tensor.store_elem %{{.*}}, %{{.*}}[%{{.*}}]
