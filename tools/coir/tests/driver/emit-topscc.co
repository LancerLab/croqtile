// RUN: cocc -t topscc -es %s | FileCheck %s
//
// Test: cocc emits topscc source code (non-script mode)

__co__ s32 [64] ele_add(s32 [64] a, s32 [64] b) {
  s32[a.span] c;
  parallel p by 12 : thread {}
  return c;
}

// CHECK: #include <tops.h>
// CHECK: __global__ void __coir_global_ele_add
// CHECK: topsMalloc
// CHECK: topsMemcpy
// CHECK: topsDeviceSynchronize
