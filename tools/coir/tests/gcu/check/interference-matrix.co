// RUN: cocc %s -t gcu -emit-coir 2>/dev/null | FileCheck %s
//
// Verify that the const interference matrix attributes are emitted on the
// CoIR kernel when dynamic memreuse is active.  These attributes encode
// the precomputed N×N conflict matrix so the HeapSimulator can skip
// runtime conflict analysis.
//
// REQUIRES: TARGET-GCU

#include "choreo.h"

// The two local buffers (l_h2 and l_s2) have dynamic shapes (N-dependent)
// and non-overlapping lifetimes in some dimensions.  The memreuse pass
// should generate a 4-buffer interference matrix: 2 buffers from dma.copy
// => local plus 2 explicit local arrays = 4 total.
//
// CHECK-DAG: coir.mr_n_buffers = 4
// CHECK-DAG: coir.mr_interference
// CHECK-DAG: coir.mr_alignment = 512
// CHECK-DAG: coir.mr_size_exprs
// CHECK-DAG: coir.mr_buffer_ids

__co__ void interference_test(s32 [1024] src, s32 [N] input, s32 [1024] out) {
  parallel tid by 5 : thread {
    foreach k in 8 {
      l_h = dma.copy input => local;
      local s32[l_h.span] l_h2;
      foreach i in [l_h.span(0)] {
        l_h2.at(i) = l_h.data.at(i) * 3;
      }
      l_s = dma.copy src.chunkat(k) => local;
      local s32[l_s.span] l_s2;
      foreach i in [l_s.span(0)] {
        l_s2.at(i) = l_s.data.at(i) + l_h2.at(i % l_h.span(0));
      }
      dma.copy l_s2 => out.chunkat(k);
    }
  }
}
