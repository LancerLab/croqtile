// RUN: cocc -t topscc -es -arch=gcu400 %s -o - | FileCheck %s
//
// Verify GROUP-level parallel generates proper hardware IDs and launch dims.

__co__ s32 [8] test_group(s32 [8] input) {
  s32 [8] output;
  parallel p by 2 : block {
    parallel q by 4 : thread {
      output.at(p * 4 + q) = input.at(p * 4 + q) * 2;
    }
  }
  return output;
}

// CHECK: __thread_dims__(4, 1, 1)
// CHECK-NEXT: __device__ void test_group(
// CHECK: int pid_{{[0-9]+}} = __tops_bid_x();
// CHECK: int pid_{{[0-9]+}} = __tops_tid_x();
// CHECK: int pid_{{[0-9]+}} = __tops_stid_x();

// CHECK: __thread_dims__(4, 1, 1)
// CHECK-NEXT: __global__ void __coir_global_test_group(

// CHECK: <<<dim3(2, 1, 1), dim3(1, 1, 1)>>>
