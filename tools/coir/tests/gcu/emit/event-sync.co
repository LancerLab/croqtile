// RUN: cocc -t topscc -es %s -o - | FileCheck %s
//
// Verify event trigger/wait emits bool set/spin-wait pattern,
// and sync.shared emits __syncthreads().

__co__ s32 [4] test_event(s32 [4] input) {
  s32 [4] output;
  parallel p by 2 : block {
    shared event ep;
    local s32 [2] la;
    f = dma.copy.async input.chunkat(p) => la;
    wait f;
    parallel t by 2 : thread {
      inthreads (t < 1) {
        la.at(0) = la.at(0) + 1;
        trigger ep;
      }
      inthreads (t >= 1) {
        wait ep;
        la.at(1) = la.at(0) + la.at(1);
      }
    }
    sync.shared;
    g = dma.copy.async la => output.chunkat(p);
    wait g;
  }
  return output;
}

// CHECK: = true
// CHECK: while ({{.*}} == false) continue
// CHECK: = false
// CHECK: __syncthreads()
