// RUN: cocc -t topscc -es %s -o - | FileCheck %s
//
// Verify inthreads emits if-guard with predicate and __syncthreads.

__co__ s32 [4] test_inthreads(s32 [4] input) {
  s32 [4] output;
  parallel p by 2 : block {
    local s32 [2] la;
    f = dma.copy.async input.chunkat(p) => la;
    wait f;
    local s32 [2] lb;
    parallel t by 2 : thread {
      inthreads (t < 1) {
        lb.at(0) = la.at(0) * 3;
      }
    }
    g = dma.copy.async lb => output.chunkat(p);
    wait g;
  }
  return output;
}

// CHECK: if (
// CHECK: __syncthreads()
