// RUN: cocc -t topscc -es %s -o - | FileCheck %s
//
// Verify coir.call emits function call with correct pointer casts.

__co__ s32 [4] test_call(s32 [4] input) {
  s32 [4] output;
  parallel p by 2 : block {
    local s32 [2] la;
    local s32 [2] lb;
    f = dma.copy.async input.chunkat(p) => la;
    wait f;
    call my_kernel(la, lb);
    g = dma.copy.async lb => output.chunkat(p);
    wait g;
  }
  return output;
}

// CHECK: my_kernel((int*){{.*}}, (int*){{.*}})
