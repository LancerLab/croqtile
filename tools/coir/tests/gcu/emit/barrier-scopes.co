// RUN: cocc -t topscc -es %s -o - | FileCheck %s
//
// Verify sync.local emits __syncsubthreads() and sync.shared emits __syncthreads().

__co__ s32 [4] test_barrier_scopes(s32 [4] input) {
  s32 [4] output;
  parallel p by 2 : block {
    local s32 [2] la;
    f = dma.copy.async input.chunkat(p) => la;
    wait f;
    parallel t by 2 : thread {
      la.at(t) = la.at(t) + 1;
    }
    sync.local;
    sync.shared;
    g = dma.copy.async la => output.chunkat(p);
    wait g;
  }
  return output;
}

// CHECK: __syncsubthreads()
// CHECK: __syncthreads()
