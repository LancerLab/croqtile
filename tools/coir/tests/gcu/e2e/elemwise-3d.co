// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// 3D elementwise add with 3-component parallel.

__co__ s32 [4, 8, 16] ele_add_3d(s32 [4, 8, 16] a, s32 [4, 8, 16] b) {
  s32[a.span] c;
  parallel p={px,py,pz} by [1, 1, 1] {
    l1_a = dma.copy a.chunkat(p) => local;
    l1_b = dma.copy b.chunkat(p) => local;
    local s32[l1_a.span] l1_c;
    foreach i in [l1_a.span(0)]
      foreach j in [l1_a.span(1)]
        foreach k in [l1_a.span(2)]
          l1_c.at(i, j, k) = l1_a.data.at(i, j, k) + l1_b.data.at(i, j, k);
    dma.copy l1_c => c.chunkat(p);
  }
  return c;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(4, 8, 16);
  auto b = choreo::make_spandata<choreo::s32>(4, 8, 16);
  a.fill_random(-10, 10);
  b.fill_random(-10, 10);

  auto res = ele_add_3d(a.view(), b.view());

  bool ok = true;
  for (size_t i = 0; i < 4 * 8 * 16; ++i)
    if (a.data()[i] + b.data()[i] != res.data()[i]) ok = false;

  if (ok)   std::cout << "PASS: 3d elemwise add" << std::endl;
  else      std::cout << "FAIL: 3d elemwise add" << std::endl;
}

// CHECK: PASS: 3d elemwise add
