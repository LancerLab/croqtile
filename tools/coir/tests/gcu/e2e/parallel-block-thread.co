// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s > %s.result && bash %s.result --execute | FileCheck --match-full-lines %s && rm -f %s.result
//
// Block+thread parallel: 2 blocks x 4 threads processing global input.
// Uses global storage to access input directly from threads.

__co__ s32 [8] test_bt(global s32 [8] input) {
  s32 [8] output;
  parallel p by 2 {
    f = dma.copy.async input.chunkat(p) => local;
    wait f;
    local s32 [4] tmp;
    foreach i in [4] {
      tmp.at(i) = f.data.at(i) * 2;
    }
    dma.copy tmp => output.chunkat(p);
  }
  return output;
}

int main() {
  auto in = choreo::make_spandata<choreo::s32>(8);
  auto in_p = in.data();
  for (int i = 0; i < 8; ++i) in_p[i] = i + 1;

  auto res = test_bt(in.view());
  auto res_p = res.data();

  bool pass = true;
  for (int i = 0; i < 8; ++i) {
    if (res_p[i] != (i + 1) * 2) pass = false;
  }
  if (pass)
    std::cout << "PASS: parallel-block-thread" << std::endl;
  else
    std::cout << "FAIL: parallel-block-thread" << std::endl;
}

// CHECK: PASS: parallel-block-thread
