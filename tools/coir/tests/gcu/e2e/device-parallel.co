// REQUIRES: TARGET-GCUx2
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// Multi-device parallel with per-device data partitioning.
// 2D input [2, 4]: device 0 processes row 0, device 1 processes row 1.
// Each device has 2 blocks, each block handles a [1, 2] tile via
// chunkat(d, p), proving true data partitioning across devices.
// Partial D2H gathers each device's portion into the host result.

__co__ s32 [2, 4] test_multi_dev(s32 [2, 4] input) {
  s32 [2, 4] output;
  parallel d by 2 : device {
    parallel p by 2 : block {
      f = dma.copy.async input.chunkat(d, p) => local;
      wait f;
      local s32 [1, 2] tmp;
      foreach i in [2] {
        tmp.at(0, i) = f.data.at(0, i) * 3;
      }
      dma.copy tmp => output.chunkat(d, p);
    }
  }
  return output;
}

int main() {
  int* h_in = new int[8];
  for (int i = 0; i < 8; ++i) h_in[i] = i + 1;

  auto in_view = choreo::make_spanview<2, choreo::s32>(h_in, {2, 4});
  auto res = test_multi_dev(in_view);
  auto res_p = res.data();

  bool pass = true;
  for (int i = 0; i < 8; ++i) {
    if (res_p[i] != (i + 1) * 3) {
      pass = false;
    }
  }
  if (pass)
    std::cout << "PASS: device-parallel" << std::endl;
  else
    std::cout << "FAIL: device-parallel" << std::endl;

  delete[] h_in;
}

// CHECK: PASS: device-parallel
