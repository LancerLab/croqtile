// REQUIRES: TARGET-GCU300
// RUN: cocc -t topscc -gs %s > %s.result && bash %s.result --execute | FileCheck --match-full-lines %s && rm -f %s.result
//
// MMA matrix multiply via micro-kernel on GCU (f16 input, f32 accum).
// Data must reside in local (L1) memory for MMA operations.

__co__ auto mma_matmul(f16 [128, 32] A, f16 [32, 128] B) {
  f32 [128, 128] output;

  parallel p by 1 {
    local f16[128, 32] lhs;
    local f16[32, 128] rhs;
    local f32[128, 128] out;
    dma.copy A => lhs;
    dma.copy B => rhs;
    mc = mma.fill.f32 0;
    ma = mma.load lhs;
    mb = mma.load rhs;
    mma.row.col mc, ma, mb;
    mma.store mc, out;
    dma.copy out => output;
  }
  return output;
}

int main() {
  auto lhs = choreo::make_spandata<choreo::f16>(128, 32);
  auto rhs = choreo::make_spandata<choreo::f16>(32, 128);
  lhs.fill(choreo::f16(1.0f));
  rhs.fill(choreo::f16(1.0f));

  auto res = mma_matmul(lhs.view(), rhs.view());

  bool pass = true;
  for (int i = 0; i < 128; ++i)
    for (int j = 0; j < 128; ++j)
      if (std::abs(res[i][j] - 32.0f) > 1.0f)
        pass = false;

  if (pass) std::cout << "PASS: coir mma" << std::endl;
  else std::cout << "FAIL: coir mma" << std::endl;
}

// CHECK: PASS: coir mma
