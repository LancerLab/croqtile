// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s > %s.result && bash %s.result --execute | FileCheck --match-full-lines %s && rm -f %s.result
//
// f16 elementwise add.

__co__ f16 [128] ele_add_f16(f16 [128] a, f16 [128] b) {
  f16[a.span] c;
  parallel p by 1 {
    l1_a = dma.copy a.chunkat(p) => local;
    l1_b = dma.copy b.chunkat(p) => local;
    local f16[l1_a.span] l1_c;
    foreach i in [l1_a.span(0)] {
      l1_c.at(i) = l1_a.data.at(i) + l1_b.data.at(i);
    }
    dma.copy l1_c => c.chunkat(p);
  }
  return c;
}

int main() {
  auto a = choreo::make_spandata<choreo::f16>(128);
  auto b = choreo::make_spandata<choreo::f16>(128);
  a.fill(choreo::f16(1.0f));
  b.fill(choreo::f16(2.0f));

  auto res = ele_add_f16(a.view(), b.view());

  bool pass = true;
  for (size_t i = 0; i < 128; ++i) {
    float val = (float)res[i];
    if (std::abs(val - 3.0f) > 0.01f) {
      pass = false;
      break;
    }
  }

  if (pass)
    std::cout << "PASS: f16 elemwise add" << std::endl;
  else
    std::cout << "FAIL: f16 elemwise add" << std::endl;
}

// CHECK: PASS: f16 elemwise add
