// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s | bash -s -- --execute 2>&1 | FileCheck %s
//
// Test: runtime detection of unwaited async DMA via choreo::future destructor.
// swap bypasses the compiler's static check, but at runtime the rotated
// future goes out of scope in ST_TRIGGERED state, triggering the diagnosis.

__co__ auto dma_unwaited(s32 [64] input) {
  s32 [input.span] output;

  parallel p by 1 {
    f0 = dma.copy.async input.chunkat(p) => local;
    f1 = dma.copy.async input.chunkat(p) => local;
    swap(f0, f1);
    wait f1;

    dma.copy f1.data => output.chunkat(p);
  }

  return output;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(64);
  auto res = dma_unwaited(a.view());
}

// CHECK: [choreo-rt] Error is detected: future{{.*}}has never been waited.
