// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// End-to-end test: cocc generates topscc script, compiles, and executes

__co__ s32 [64] ele_add(s32 [64] a, s32 [64] b) {
  s32[a.span] c;
  parallel p by 1 {
    l1_a = dma.copy a.chunkat(p) => local;
    l1_b = dma.copy b.chunkat(p) => local;
    local s32[l1_a.span] l1_c;
    foreach i in [l1_a.span(0)] {
      l1_c.at(i) = l1_a.data.at(i) + l1_b.data.at(i);
    }
    dma.copy l1_c => c.chunkat(p);
  }
  return c;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(64);
  auto b = choreo::make_spandata<choreo::s32>(64);
  a.fill_random(-10, 10);
  b.fill_random(-10, 10);

  auto res = ele_add(a.view(), b.view());

  for (size_t i = 0; i < 64; ++i)
    choreo::choreo_assert(a[i] + b[i] == res[i], "mismatch");

  std::cout << "PASS: cocc topscc e2e" << std::endl;
}

// CHECK: PASS: cocc topscc e2e
