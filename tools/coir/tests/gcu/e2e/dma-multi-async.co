// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -gs %s > %s.result && bash %s.result --execute | FileCheck --match-full-lines %s && rm -f %s.result
//
// Test: multiple async DMA copies with independent waits.
// Exercises choreo::future lifecycle for concurrent async operations.

__co__ auto dma_multi(s32 [64] a, s32 [64] b) {
  s32 [a.span] output;

  parallel p by 1 {
    fa = dma.copy.async a.chunkat(p) => local;
    fb = dma.copy.async b.chunkat(p) => local;
    wait fa, fb;

    local s32 [64] tmp;
    foreach i in [tmp.span]
      tmp.at(i) = fa.data.at(i) + fb.data.at(i);

    dma.copy tmp => output.chunkat(p);
  }

  return output;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(64);
  auto b = choreo::make_spandata<choreo::s32>(64);
  for (size_t i = 0; i < 64; ++i) {
    a[i] = static_cast<int>(i);
    b[i] = static_cast<int>(i * 10);
  }

  auto res = dma_multi(a.view(), b.view());

  for (size_t i = 0; i < 64; ++i)
    choreo::choreo_assert(res[i] == static_cast<int>(i + i * 10), "mismatch");

  std::cout << "PASS: dma multi async" << std::endl;
}

// CHECK: PASS: dma multi async
