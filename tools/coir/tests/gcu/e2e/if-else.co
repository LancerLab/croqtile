// REQUIRES: TARGET-GCUALL
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// Test: if/else control flow in device code.

__co__ auto test_if_else(s32 [8] input) {
  s32 [input.span] output;

  parallel p by 1 {
    f = dma.copy.async input.chunkat(p) => local;
    wait f;

    local s32 [8] tmp;
    foreach i in [8] {
      if (f.data.at(i) > 0)
        tmp.at(i) = f.data.at(i) * 2;
      else
        tmp.at(i) = 0 - f.data.at(i);
    }

    dma.copy tmp => output.chunkat(p);
  }

  return output;
}

int main() {
  auto a = choreo::make_spandata<choreo::s32>(8);
  for (int i = 0; i < 8; i++)
    a.data()[i] = i - 4;  // [-4, -3, -2, -1, 0, 1, 2, 3]
  auto res = test_if_else(a.view());
  int expected[] = {4, 3, 2, 1, 0, 2, 4, 6};
  for (int i = 0; i < 8; i++)
    choreo::choreo_assert(res[i] == expected[i], "mismatch");
  std::cout << "PASS: if_else" << std::endl;
}

// CHECK: PASS: if_else
