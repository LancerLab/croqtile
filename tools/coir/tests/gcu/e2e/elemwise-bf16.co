// REQUIRES: TARGET-GCU300
// RUN: cocc -t topscc -gs %s | bash -s -- --execute | FileCheck --match-full-lines %s
//
// bf16 elementwise add.

__co__ bf16 [128] ele_add_bf16(bf16 [128] a, bf16 [128] b) {
  bf16[a.span] c;
  parallel p by 1 {
    l1_a = dma.copy a.chunkat(p) => local;
    l1_b = dma.copy b.chunkat(p) => local;
    local bf16[l1_a.span] l1_c;
    foreach i in [l1_a.span(0)] {
      l1_c.at(i) = l1_a.data.at(i) + l1_b.data.at(i);
    }
    dma.copy l1_c => c.chunkat(p);
  }
  return c;
}

int main() {
  auto a = choreo::make_spandata<choreo::bf16>(128);
  auto b = choreo::make_spandata<choreo::bf16>(128);
  a.fill(choreo::bf16(1.0f));
  b.fill(choreo::bf16(2.0f));

  auto res = ele_add_bf16(a.view(), b.view());

  bool pass = true;
  for (size_t i = 0; i < 128; ++i) {
    float val = (float)res[i];
    if (std::abs(val - 3.0f) > 0.1f) {
      pass = false;
      break;
    }
  }

  if (pass)
    std::cout << "PASS: bf16 elemwise add" << std::endl;
  else
    std::cout << "FAIL: bf16 elemwise add" << std::endl;
}

// CHECK: PASS: bf16 elemwise add
