// REQUIRES: TARGET-GCU
// RUN: cocc -t topscc -es %s | FileCheck --check-prefix=IR %s
//
// Static memory reuse verification:
// The generated topscc device code must contain a single __spm_N pool whose
// 1024-byte size shows the four buffers reuse two 512-byte slots.  Without
// memreuse each buffer would get its own independent array (or the pool would
// double to 2048).  The cleanup pass CSEs the identical SPM pointer
// computations of each reused buffer pair, so each slot's offset is declared
// once and shared by both buffers of the pair.
//
// Runtime execution requires GCU hardware; pass --execute to test.

__co__ void memreuse_static(s32 [256] a, s32 [256] b, s32 [256] out) {
  parallel tid by 4 : thread {
    foreach k in 4 {
      l1_a = dma.copy a.chunkat(k) => local;
      local s32[l1_a.span] l1_c;
      foreach i in [l1_a.span(0)] {
        l1_c.at(i) = l1_a.data.at(i) * 2;
      }
      l1_b = dma.copy b.chunkat(k) => local;
      local s32[l1_b.span] l1_d;
      foreach i in [l1_b.span(0)] {
        l1_d.at(i) = l1_b.data.at(i) + 1;
      }
      dma.copy l1_d => out.chunkat(k);
    }
  }
}

// One pool array (not four independent arrays).  Its 1024-byte size is the
// reuse proof: four 512-byte buffers collapsed into two slots.  Without
// memreuse this would be a 2048-byte pool (or four separate arrays).
// IR: {{__spm_[0-9]+\[1024\]}}
// The two reused slots sit at offsets 0 and 512.  Each is declared once and
// shared by the buffer pair that reuses it (CSE merged the duplicate pointer
// computations, so the historical 0,512,0,512 alias list is now 0,512).
// IR: + 0);
// IR: + 512);
