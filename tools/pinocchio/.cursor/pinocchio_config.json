    },
    "debugger": {
      "rule_file": "debugger_agent.rule",
      "description": "调试和修复Choreo代码问题"
    }
  },
  
  "knowledge_files": {
    "choreo_syntax_rules": "choreo_syntax_rules.json",
    "choreo_common_errors": "choreo_common_errors.json",
    "topscc_to_choreo_translation": "topscc_to_choreo_translation.json",
    "topscc_syntax": "topscc_syntax.json",
    "cuda_syntax": "cuda_syntax.json",
    "choreo_templates": "choreo_templates.json",
    "advanced_patterns": "advanced_patterns.json",
    "hpc_hardware_performance_rules": "hpc_hardware_performance_rules.json"
  },
  
  "activation_phrase": "Pinocchio",
