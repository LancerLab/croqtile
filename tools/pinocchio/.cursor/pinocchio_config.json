{
  "version": "1.0",
  "name": "Pinocchio",
  "description": "Pinocchio - Choreo AI助手系统",
  "author": "Albert",
  "created_date": "2023-06-12",
  
  "paths": {
    "knowledge_base": "./.cursor/pinocchio/knowledge",
    "rules": "./.cursor/pinocchio/rules",
    "tests": "./tests/pinocchio"
  },
  
  "components": {
    "coordinator": {
      "rule_file": "coordinator.rule",
      "description": "协调和管理各个专门代理"
    },
    "analyzer": {
      "rule_file": "analyzer_agent.rule",
      "description": "分析Choreo代码和识别语法问题"
    },
    "generator": {
      "rule_file": "generator_agent.rule",
      "description": "生成符合Choreo语法的代码"
