{
  "version": "1.0",
  "language": "CUDA",
  "description": "Knowledge base for CUDA syntax and mapping to Choreo",
  
  "basic_mapping": {
    "description": "Core mapping concepts between CUDA and Choreo",
    "thread_mapping": "CUDA threads map to tensor indices in Choreo",
    "kernel_mapping": "CUDA kernels map to compute blocks in Choreo",
    "memory_mapping": {
      "global_memory": "Maps to standard tensors in Choreo",
      "shared_memory": "Maps to tensors with specific memory layout options",
      "constant_memory": "Maps to tensors with read-only attributes",
      "registers": "Maps to local variables in Choreo compute blocks"
    }
  },
  
  "cuda_constructs": {
    "kernel_definition": {
      "syntax": "__global__ void kernel_name(parameters) { /* code */ }",
      "choreo_equivalent": "compute { /* code */ }"
    },
    "thread_indexing": {
      "syntax": {
        "threadIdx": "threadIdx.x, threadIdx.y, threadIdx.z",
        "blockIdx": "blockIdx.x, blockIdx.y, blockIdx.z",
        "blockDim": "blockDim.x, blockDim.y, blockDim.z",
        "gridDim": "gridDim.x, gridDim.y, gridDim.z"
      },
      "choreo_equivalent": "Tensor indices in compute blocks"
    },
    "global_index_calculation": {
      "syntax": "int idx = blockIdx.x * blockDim.x + threadIdx.x;",
      "choreo_equivalent": "Direct tensor indexing with compute parallel directive"
    },
    "memory_types": {
      "__global__": "Standard tensors in Choreo",
      "__shared__": "Tensors with specific memory layout",
      "__constant__": "Tensors with specific attributes",
      "__device__": "Tensors with device-specific attributes"
    },
    "synchronization": {
      "__syncthreads()": "Implicit in Choreo or explicit synchronization directives"
    },
    "kernel_launch": {
      "syntax": "kernel_name<<<grid_dim, block_dim, shared_mem, stream>>>(args);",
      "choreo_equivalent": "Automatic scheduling based on compute specifications"
    }
  },
  
  "translation_patterns": {
    "matrix_multiplication": {
      "cuda_pattern": [
        "__global__ void matMul(float *A, float *B, float *C, int M, int N, int K) {",
        "    int row = blockIdx.y * blockDim.y + threadIdx.y;",
        "    int col = blockIdx.x * blockDim.x + threadIdx.x;",
        "    float sum = 0.0f;",
        "    if (row < M && col < N) {",
        "        for (int i = 0; i < K; i++) {",
        "            sum += A[row * K + i] * B[i * N + col];",
        "        }",
        "        C[row * N + col] = sum;",
        "    }",
        "}"
      ],
      "choreo_equivalent": [
        "tensor A[M][K] : float32 = input;",
        "tensor B[K][N] : float32 = input;",
        "tensor C[M][N] : float32 = output;",
        "",
        "compute parallel(M, N) {",
        "    int row = M_idx;",
        "    int col = N_idx;",
        "    float sum = 0.0f;",
        "    for (int i = 0; i < K; i++) {",
        "        sum += A[row][i] * B[i][col];",
        "    }",
        "    C[row][col] = sum;",
        "}"
      ]
    },
    "convolution_2d": {
      "cuda_pattern": [
        "__global__ void conv2d(float *input, float *kernel, float *output, int H, int W, int KH, int KW) {",
        "    int h = blockIdx.y * blockDim.y + threadIdx.y;",
        "    int w = blockIdx.x * blockDim.x + threadIdx.x;",
        "    if (h < H && w < W) {",
        "        float sum = 0.0f;",
        "        for (int kh = 0; kh < KH; kh++) {",
        "            for (int kw = 0; kw < KW; kw++) {",
        "                int h_in = h + kh - KH/2;",
        "                int w_in = w + kw - KW/2;",
        "                if (h_in >= 0 && h_in < H && w_in >= 0 && w_in < W) {",
        "                    sum += input[h_in * W + w_in] * kernel[kh * KW + kw];",
        "                }",
        "            }",
        "        }",
        "        output[h * W + w] = sum;",
        "    }",
        "}"
      ],
      "choreo_equivalent": [
        "tensor input[H][W] : float32 = input;",
        "tensor kernel[KH][KW] : float32 = input;",
        "tensor output[H][W] : float32 = output;",
        "",
        "compute parallel(H, W) {",
        "    int h = H_idx;",
        "    int w = W_idx;",
        "    float sum = 0.0f;",
        "    for (int kh = 0; kh < KH; kh++) {",
        "        for (int kw = 0; kw < KW; kw++) {",
        "            int h_in = h + kh - KH/2;",
        "            int w_in = w + kw - KW/2;",
        "            if (h_in >= 0 && h_in < H && w_in >= 0 && w_in < W) {",
        "                sum += input[h_in][w_in] * kernel[kh][kw];",
        "            }",
        "        }",
        "    }",
        "    output[h][w] = sum;",
        "}"
      ]
    },
    "reduction": {
      "cuda_pattern": [
        "__global__ void reduce_sum(float *input, float *output, int N) {",
        "    __shared__ float sdata[BLOCK_SIZE];",
        "    int tid = threadIdx.x;",
        "    int i = blockIdx.x * blockDim.x + threadIdx.x;",
        "    sdata[tid] = (i < N) ? input[i] : 0;",
        "    __syncthreads();",
        "    for (int s = blockDim.x/2; s > 0; s >>= 1) {",
        "        if (tid < s) {",
        "            sdata[tid] += sdata[tid + s];",
        "        }",
        "        __syncthreads();",
        "    }",
        "    if (tid == 0) output[blockIdx.x] = sdata[0];",
        "}"
      ],
      "choreo_equivalent": [
        "tensor input[N] : float32 = input;",
        "tensor output[1] : float32 = output;",
        "",
        "compute reduction(sum, 0) {",
        "    output[0] = input[N_idx];",
        "}"
      ]
    },
    "shared_memory_example": {
      "cuda_pattern": [
        "__global__ void sharedExample(float *A, float *B, int N) {",
        "    __shared__ float shared_data[BLOCK_SIZE];",
        "    int tid = threadIdx.x;",
        "    int i = blockIdx.x * blockDim.x + threadIdx.x;",
        "    if (i < N) {",
        "        shared_data[tid] = A[i];",
        "    }",
        "    __syncthreads();",
        "    if (i < N && tid > 0 && tid < BLOCK_SIZE-1) {",
        "        B[i] = shared_data[tid-1] + shared_data[tid] + shared_data[tid+1];",
        "    }",
        "}"
      ],
      "choreo_equivalent": [
        "tensor A[N] : float32 = input;",
        "tensor B[N] : float32 = output;",
        "tensor shared_data[BLOCK_SIZE] : float32;",
        "",
        "option memory_layout(shared_data, shared);",
        "",
        "compute parallel(GRID_SIZE, BLOCK_SIZE) {",
        "    int tid = BLOCK_SIZE_idx;",
        "    int i = GRID_SIZE_idx * BLOCK_SIZE + BLOCK_SIZE_idx;",
        "    if (i < N) {",
        "        shared_data[tid] = A[i];",
        "    }",
        "    // Synchronization is implicit in Choreo",
        "    if (i < N && tid > 0 && tid < BLOCK_SIZE-1) {",
        "        B[i] = shared_data[tid-1] + shared_data[tid] + shared_data[tid+1];",
        "    }",
        "}"
      ]
    }
  },
  
  "optimization_mapping": {
    "tiling": {
      "cuda_approach": "Manual tiling with shared memory",
      "choreo_equivalent": "option tile(tensor, tile_sizes);"
    },
    "coalescing": {
      "cuda_approach": "Manual reorganization of memory access patterns",
      "choreo_equivalent": "option memory_layout(tensor, layout_type);"
    },
    "loop_unrolling": {
      "cuda_approach": "#pragma unroll or manual unrolling",
      "choreo_equivalent": "option unroll(loop, factor);"
    },
    "shared_memory_usage": {
      "cuda_approach": "__shared__ type array[SIZE];",
      "choreo_equivalent": "option memory_layout(tensor, shared);"
    }
  },
  
  "translation_challenges": {
    "thread_cooperation": "CUDA explicit thread cooperation needs to be converted to Choreo's implicit model",
    "warp_level_operations": "Warp-level primitives need higher-level representations in Choreo",
    "complex_indexing": "Complex CUDA indexing schemes need to be mapped to Choreo's tensor indexing",
    "atomics": "CUDA atomic operations need equivalent Choreo constructs",
    "dynamic_parallelism": "CUDA dynamic parallelism requires special handling in Choreo"
  },
  
  "common_optimizations": {
    "shared_memory_usage": "Identify shared memory usage in CUDA and map to appropriate Choreo memory layouts",
    "coalesced_access": "Identify coalesced memory access patterns and preserve them in Choreo",
    "thread_divergence": "Identify and eliminate thread divergence when converting to Choreo",
    "register_pressure": "Balance register usage when converting complex CUDA kernels to Choreo"
  }
} 