{
  "version": "1.0",
  "description": "Advanced patterns and templates for Choreo programming",
  
  "multibuffer_patterns": {
    "double_buffer": {
      "description": "Double buffering pattern to overlap computation and data transfer",
      "template": [
        "// Double buffering pattern to overlap computation and data transfer",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    tensor buffer_a[TILE_SIZE][M] : float32;",
        "    tensor buffer_b[TILE_SIZE][M] : float32;",
        "    ",
        "    // Prefetch first tile",
        "    dma.copy input.chunk(0, TILE_SIZE) => buffer_a;",
        "    ",
        "    for (int i = 0; i < N; i += TILE_SIZE) {",
        "        // Prefetch next tile if available",
        "        if (i + TILE_SIZE < N) {",
        "            dma.copy input.chunk(i + TILE_SIZE, TILE_SIZE) => buffer_b;",
        "        }",
        "        ",
        "        // Process current tile",
        "        for (int ti = 0; ti < TILE_SIZE; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                if (i + ti < N) {",
        "                    output[i + ti][j] = process(buffer_a[ti][j]);",
        "                }",
        "            }",
        "        }",
        "        ",
        "        // Swap buffers",
        "        swap(buffer_a, buffer_b);",
        "    }",
        "}"
      ]
    },
    "multi_buffer": {
      "description": "Multi-buffering pattern for deep pipeline",
      "template": [
        "// Multi-buffering pattern for deep pipeline",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    const int NUM_BUFFERS = 3; // Triple buffering",
        "    tensor buffers[NUM_BUFFERS][TILE_SIZE][M] : float32;",
        "    int current_buffer = 0;",
        "    ",
        "    // Prefetch initial tiles",
        "    for (int b = 0; b < NUM_BUFFERS - 1 && b * TILE_SIZE < N; b++) {",
        "        dma.copy input.chunk(b * TILE_SIZE, TILE_SIZE) => buffers[b];",
        "    }",
        "    ",
        "    for (int i = 0; i < N; i += TILE_SIZE) {",
        "        // Determine buffer indices",
        "        int process_buffer = current_buffer;",
        "        int prefetch_buffer = (current_buffer + NUM_BUFFERS - 1) % NUM_BUFFERS;",
        "        ",
        "        // Prefetch next tile if available",
        "        if (i + (NUM_BUFFERS - 1) * TILE_SIZE < N) {",
        "            dma.copy input.chunk(i + (NUM_BUFFERS - 1) * TILE_SIZE, TILE_SIZE) => buffers[prefetch_buffer];",
        "        }",
        "        ",
        "        // Process current tile",
        "        for (int ti = 0; ti < TILE_SIZE; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                if (i + ti < N) {",
        "                    output[i + ti][j] = process(buffers[process_buffer][ti][j]);",
        "                }",
        "            }",
        "        }",
        "        ",
        "        // Update current buffer",
        "        current_buffer = (current_buffer + 1) % NUM_BUFFERS;",
        "    }",
        "}"
      ]
    },
    "event_based_buffering": {
      "description": "Event-based double buffering with synchronization",
      "template": [
        "// Event-based double buffering with synchronization",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "parallel p by 1, q by 3 {",
        "    with n_tile in [16] {",
        "        shared tensor buffer[2][n_tile.span] : float32;",
        "        local tensor local_output[n_tile.span / q] : float32;",
        "        ",
        "        shared event prefetch_event[2][2], process_event[2][2];",
        "        ",
        "        // Prefetch first tile",
        "        dma.copy input.chunkat(_, n_tile) => buffer[0];",
        "        trigger prefetch_event[1]; // Allow fetching next buffer",
        "        trigger process_event[0];  // Allow processing current buffer",
        "        ",
        "        foreach n_tile {",
        "            int current_idx = n_tile % 2;",
        "            int next_idx = (current_idx + 1) % 2;",
        "            ",
        "            // Prefetch next tile asynchronously",
        "            inthreads.async (q == #q - 1) {",
        "                wait prefetch_event[next_idx];",
        "                if (n_tile + 1 < #n_tile) {",
        "                    dma.copy input.chunkat(_, n_tile + 1) => buffer[next_idx];",
        "                }",
        "                trigger process_event[next_idx];",
        "            }",
        "            ",
        "            // Process current tile asynchronously",
        "            inthreads.async (q < #q - 1) {",
        "                wait process_event[current_idx][q];",
        "                auto slice = dma.copy buffer[current_idx].chunk(#q - 1, 1).at(q, _) => local;",
        "                // Process data",
        "                for (int i = 0; i < slice.span(0); i++) {",
        "                    for (int j = 0; j < slice.span(1); j++) {",
        "                        local_output[i][j] = process(slice[i][j]);",
        "                    }",
        "                }",
        "                dma.copy local_output => output.chunk(#q - 1, #n_tile).at(q, n_tile);",
        "                trigger prefetch_event[current_idx][q];",
        "            }",
        "        }",
        "    }",
        "    sync.shared;",
        "}"
      ]
    }
  },
  
  "pipeline_patterns": {
    "basic_pipeline": {
      "description": "Basic pipeline pattern with stages",
      "template": [
        "// Basic pipeline pattern with stages",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor intermediate[N][M] : float32;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    // Stage 1: Process input to intermediate",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            intermediate[i][j] = stage1_process(input[i][j]);",
        "        }",
        "    }",
        "    ",
        "    // Stage 2: Process intermediate to output",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            output[i][j] = stage2_process(intermediate[i][j]);",
        "        }",
        "    }",
        "}"
      ]
    },
    "pipelined_tiling": {
      "description": "Pipelined execution with tiling",
      "template": [
        "// Pipelined execution with tiling",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor stage1_buffer[TILE_SIZE][M] : float32;",
        "tensor stage2_buffer[TILE_SIZE][M] : float32;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    // Process first tile for stage 1",
        "    for (int ti = 0; ti < TILE_SIZE && ti < N; ti++) {",
        "        for (int j = 0; j < M; j++) {",
        "            stage1_buffer[ti][j] = stage1_process(input[ti][j]);",
        "        }",
        "    }",
        "    ",
        "    for (int i = TILE_SIZE; i < N + TILE_SIZE; i += TILE_SIZE) {",
        "        // Stage 1: Process next tile if available",
        "        for (int ti = 0; ti < TILE_SIZE && i + ti < N; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                stage2_buffer[ti][j] = stage1_process(input[i + ti][j]);",
        "            }",
        "        }",
        "        ",
        "        // Stage 2: Process previous tile",
        "        for (int ti = 0; ti < TILE_SIZE && i - TILE_SIZE + ti < N; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i - TILE_SIZE + ti][j] = stage2_process(stage1_buffer[ti][j]);",
        "            }",
        "        }",
        "        ",
        "        // Swap buffers",
        "        swap(stage1_buffer, stage2_buffer);",
        "    }",
        "}"
      ]
    },
    "producer_consumer": {
      "description": "Producer-consumer pattern with inthreads",
      "template": [
        "// Producer-consumer pattern with inthreads",
        "// lhs, rhs: Input tensors, out: Output tensor",
        "tensor lhs[M][N] : float32 = input;",
        "tensor rhs[M][N] : float32 = input;",
        "tensor out[M][N] : float32 = output;",
        "",
        "parallel p by 5 {",
        "    tfs = {1, 4}; // tiling factors",
        "    sshape = lhs.span / tfs;",
        "    shared tensor lhs_sbuffer[sshape] : float32;",
        "    shared tensor rhs_sbuffer[sshape] : float32;",
        "    shared tensor out_sbuffer[sshape] : float32;",
        "    ",
        "    // Event for producer and consumer",
        "    shared event pe[4], ce[4];",
        "    trigger ce;",
        "    ",
        "    with q in [tfs(1)] foreach q {",
        "        inthreads.async (p == #p - 1) {  // producer",
        "            wait ce;",
        "            lf = dma.copy.async lhs.chunkat(_, q) => lhs_sbuffer;",
        "            rf = dma.copy.async rhs.chunkat(_, q) => rhs_sbuffer;",
        "            wait lf, rf;",
        "            trigger pe;",
        "        }",
        "        ",
        "        inthreads.async (p < #p - 1) {  // consumer",
        "            wait pe[p];",
        "            lf = dma.copy.async lhs_sbuffer.chunk(#p - 1, 1).at(p, _) => local;",
        "            rf = dma.copy.async rhs_sbuffer.chunk(#p - 1, 1).at(p, _) => local;",
        "            wait lf, rf;",
        "            local tensor out_lbuffer[lf.span] : float32;",
        "            // Process data",
        "            for (int i = 0; i < lf.span(0); i++) {",
        "                for (int j = 0; j < lf.span(1); j++) {",
        "                    out_lbuffer[i][j] = lf[i][j] + rf[i][j];",
        "                }",
        "            }",
        "            dma.copy out_lbuffer => out.chunk(#p - 1, #q).at(p, q);",
        "            trigger ce[p];",
        "        }",
        "    }",
        "    sync.shared;",
        "}"
      ]
    }
  },
  
  "async_patterns": {
    "async_data_transfer": {
      "description": "Asynchronous data transfer pattern",
      "template": [
        "// Asynchronous data transfer pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor buffer[TILE_SIZE][M] : float32;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    for (int i = 0; i < N; i += TILE_SIZE) {",
        "        // Start asynchronous data transfer",
        "        auto transfer = dma.copy.async input.chunk(i, TILE_SIZE) => buffer;",
        "        ",
        "        // Could do other work here while data is transferring",
        "        ",
        "        // Wait for transfer to complete",
        "        wait transfer;",
        "        ",
        "        // Process data",
        "        for (int ti = 0; ti < TILE_SIZE && i + ti < N; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i + ti][j] = process(buffer[ti][j]);",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    },
    "inthreads_async": {
      "description": "Asynchronous execution with inthreads",
      "template": [
        "// Asynchronous execution with inthreads",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "parallel p by 4 {",
        "    shared event e[4];",
        "    ",
        "    inthreads.async (p == 0) {",
        "        // Task for thread 0",
        "        // Process subset of data",
        "        for (int i = 0; i < N/4; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i][j] = process(input[i][j]);",
        "            }",
        "        }",
        "        trigger e[0];",
        "    }",
        "    ",
        "    inthreads.async (p == 1) {",
        "        // Task for thread 1",
        "        // Process subset of data",
        "        for (int i = N/4; i < N/2; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i][j] = process(input[i][j]);",
        "            }",
        "        }",
        "        trigger e[1];",
        "    }",
        "    ",
        "    inthreads.async (p == 2) {",
        "        // Task for thread 2",
        "        // Process subset of data",
        "        for (int i = N/2; i < 3*N/4; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i][j] = process(input[i][j]);",
        "            }",
        "        }",
        "        trigger e[2];",
        "    }",
        "    ",
        "    inthreads.async (p == 3) {",
        "        // Task for thread 3",
        "        // Process subset of data",
        "        for (int i = 3*N/4; i < N; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i][j] = process(input[i][j]);",
        "            }",
        "        }",
        "        trigger e[3];",
        "    }",
        "    ",
        "    // Wait for all threads to complete",
        "    wait e;",
        "}"
      ]
    }
  },
  
  "loop_tail_handling": {
    "remainder_handling": {
      "description": "Loop tail/remainder handling pattern",
      "template": [
        "// Loop tail/remainder handling pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    const int TILE_SIZE = 32;",
        "    int main_iterations = N / TILE_SIZE;",
        "    int remainder = N % TILE_SIZE;",
        "    ",
        "    // Process main iterations",
        "    for (int i = 0; i < main_iterations; i++) {",
        "        for (int ti = 0; ti < TILE_SIZE; ti++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i * TILE_SIZE + ti][j] = process(input[i * TILE_SIZE + ti][j]);",
        "            }",
        "        }",
        "    }",
        "    ",
        "    // Process remainder",
        "    for (int i = 0; i < remainder; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            output[main_iterations * TILE_SIZE + i][j] = process(input[main_iterations * TILE_SIZE + i][j]);",
        "        }",
        "    }",
        "}"
      ]
    },
    "predicated_execution": {
      "description": "Predicated execution for handling remainders",
      "template": [
        "// Predicated execution for handling remainders",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    const int TILE_SIZE = 32;",
        "    for (int i = 0; i < (N + TILE_SIZE - 1) / TILE_SIZE; i++) {",
        "        for (int ti = 0; ti < TILE_SIZE; ti++) {",
        "            if (i * TILE_SIZE + ti < N) {  // Predicate check",
        "                for (int j = 0; j < M; j++) {",
        "                    output[i * TILE_SIZE + ti][j] = process(input[i * TILE_SIZE + ti][j]);",
        "                }",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    }
  },
  
  "branching_patterns": {
    "conditional_execution": {
      "description": "Conditional execution pattern",
      "template": [
        "// Conditional execution pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            if (condition(input[i][j])) {",
        "                output[i][j] = process_a(input[i][j]);",
        "            } else {",
        "                output[i][j] = process_b(input[i][j]);",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    },
    "data_dependent_execution": {
      "description": "Data-dependent execution pattern",
      "template": [
        "// Data-dependent execution pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    // First pass: compute a property",
        "    float property = 0.0f;",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            property += input[i][j];",
        "        }",
        "    }",
        "    property /= (N * M);  // Average value",
        "    ",
        "    // Second pass: use the property",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            if (input[i][j] > property) {",
        "                output[i][j] = input[i][j] - property;",
        "            } else {",
        "                output[i][j] = 0.0f;",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    },
    "algorithm_selection": {
      "description": "Algorithm selection based on input properties",
      "template": [
        "// Algorithm selection based on input properties",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "compute {",
        "    // Determine input properties",
        "    bool is_sparse = check_sparsity(input, N, M);",
        "    ",
        "    if (is_sparse) {",
        "        // Use sparse algorithm",
        "        for (int i = 0; i < N; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                if (input[i][j] != 0.0f) {",
        "                    output[i][j] = sparse_process(input[i][j]);",
        "                } else {",
        "                    output[i][j] = 0.0f;",
        "                }",
        "            }",
        "        }",
        "    } else {",
        "        // Use dense algorithm",
        "        for (int i = 0; i < N; i++) {",
        "            for (int j = 0; j < M; j++) {",
        "                output[i][j] = dense_process(input[i][j]);",
        "            }",
        "        }",
        "    }",
        "}"
      ]
    }
  },
  
  "optimization_patterns": {
    "fusion_pattern": {
      "description": "Operation fusion pattern",
      "template": [
        "// Operation fusion pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "// Instead of doing two separate loops:",
        "// for (...) { intermediate[i][j] = op1(input[i][j]); }",
        "// for (...) { output[i][j] = op2(intermediate[i][j]); }",
        "",
        "// Fuse the operations:",
        "compute {",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            output[i][j] = op2(op1(input[i][j]));",
        "        }",
        "    }",
        "}"
      ]
    },
    "memory_coalescing": {
      "description": "Memory access coalescing pattern",
      "template": [
        "// Memory access coalescing pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "// For architectures where consecutive accesses within a thread block",
        "// should access consecutive memory locations:",
        "",
        "compute parallel(N, M) {",
        "    int i = N_idx;",
        "    int j = M_idx;",
        "    ",
        "    // Ensure threads within a warp access consecutive memory",
        "    // This might require transposing the data or reorganizing the computation",
        "    ",
        "    output[i][j] = process(input[i][j]);",
        "}"
      ]
    },
    "memory_layout_optimization": {
      "description": "Memory layout optimization pattern",
      "template": [
        "// Memory layout optimization pattern",
        "// input: Input tensor, output: Output tensor",
        "tensor input[N][M] : float32 = input;",
        "tensor output[N][M] : float32 = output;",
        "",
        "// Specify memory layout for tensors",
        "option memory_layout(input, row_major);  // or column_major",
        "option memory_layout(output, row_major);",
        "",
        "compute {",
        "    for (int i = 0; i < N; i++) {",
        "        for (int j = 0; j < M; j++) {",
        "            output[i][j] = process(input[i][j]);",
        "        }",
        "    }",
        "}"
      ]
    }
  }
} 