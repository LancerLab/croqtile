// __co_device__：单线程选择排序实现 topk
__co_device__ void topk_device(float* in, int* out_idx, float* out_val, int n, int k) {
    for (int i = 0; i < k; ++i) {
        int max_idx = i;
        float max_val = in[i];
        for (int j = i + 1; j < n; ++j) {
            if (in[j] > max_val) {
                max_val = in[j];
                max_idx = j;
            }
        }
        // 交换 in[i] 和 in[max_idx]
        float tmp = in[i];
        in[i] = in[max_idx];
        in[max_idx] = tmp;
        // 记录 topk
        out_val[i] = in[i];
        out_idx[i] = max_idx;
    }
}

// __co__：数据块搬运与并行调度
__co__ void topk(float* in, int* out_idx, float* out_val, int n, int k) {
    // 假设单块处理，直接搬运到 device
    float in_buf[1024];
    int out_idx_buf[1024];
    float out_val_buf[1024];
    dma(in, in_buf, n * sizeof(float));
    topk_device(in_buf, out_idx_buf, out_val_buf, n, k);
    dma(out_idx_buf, out_idx, k * sizeof(int));
    dma(out_val_buf, out_val, k * sizeof(float));
}

// main：分配输入/输出，调用 topk，验证和计时
int main() {
    int n = 16;
    int k = 5;
    float in[16] = {3.2, 1.5, 7.8, 2.1, 9.0, 4.4, 6.6, 8.8, 0.9, 5.5, 2.2, 3.3, 7.7, 6.1, 4.9, 8.0};
    int out_idx[5];
    float out_val[5];
    timer_start();
    topk(in, out_idx, out_val, n, k);
    timer_stop();
    // 验证输出
    printf("Top-%d values:\n", k);
    for (int i = 0; i < k; ++i) {
        printf("%d: val=%.2f, idx=%d\n", i, out_val[i], out_idx[i]);
    }
    return 0;
}
