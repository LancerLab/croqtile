// Synthetic Tawa-style MLIR IR for SALA analysis.
// Models Tawa's concurrent warp-specialized GEMM with aref pipeline.
//
// WG0 (producer): TMA loads A,B into aref cyclic buffers (D=3)
// WG1 (consumer): WGMMA on aref data, then epilogue store
//
// Tawa currently stores output from registers to GMEM (no epilogue SMEM).
// This IR adds a hypothetical SMEM output buffer to show SALA's value
// if Tawa adopted stmatrix-based output staging.
//
// aref pipeline: put -> get -> consumed (HB chain)
// Pipeline A: 3-stage cyclic buffer for A tiles
// Pipeline B: 3-stage cyclic buffer for B tiles
// Output: epilogue SMEM buffer for C tiles

module attributes {"num-warps" = 8 : i32} {
  tt.func public @tawa_gemm_aref(%arg0: !tt.ptr<f16>, %arg1: !tt.ptr<f16>, %arg2: !tt.ptr<f16>) {
    // WG0: Producer partition
    // create_aref allocates pipeline buffers + mbarriers
    %pipe_a = ttg.local_alloc : () -> !ttg.memdesc<3x128x64xf16>
    %pipe_b = ttg.local_alloc : () -> !ttg.memdesc<3x64x128xf16>

    // Hypothetical epilogue output buffer (stmatrix target)
    %out_c = ttg.local_alloc : () -> !ttg.memdesc<128x128xf16>

    // WG0: Producer loop - aref.put()
    // Each put expands to: wait empty barrier -> TMA load -> arrive full barrier
    scf.for %k = %c0 to %K step %c1 {
      // aref.put(%pipe_a[%k mod 3], TMA_load(A))
      %slot_a = ttg.memdesc_index %pipe_a[%k_mod_3]
      ttg.async_copy_global_to_local %arg0, %slot_a
      ttg.async_commit_group

      // aref.put(%pipe_b[%k mod 3], TMA_load(B))
      %slot_b = ttg.memdesc_index %pipe_b[%k_mod_3]
      ttg.async_copy_global_to_local %arg1, %slot_b
      ttg.async_commit_group

      // WG1: Consumer - aref.get() (blocking wait on full barrier)
      ttg.async_wait {num = 0 : i32}

      // WG1: WGMMA on aref data
      %slot_a_r = ttg.memdesc_index %pipe_a[%k_mod_3_r]
      %slot_b_r = ttg.memdesc_index %pipe_b[%k_mod_3_r]
      ttng.warp_group_dot %slot_a_r, %slot_b_r

      // WG1: aref.consumed() - arrive on empty barrier
      // (modeled as implicit in the phase transition)

      scf.yield
    }

    // Mainloop tail: drain pipeline
    ttg.async_wait {num = 0 : i32}

    // WG1: Epilogue - write accumulated result to SMEM output buffer
    // This is the hypothetical stmatrix path:
    ttg.local_store %acc, %out_c

    // WG1: TMA store from SMEM to GMEM
    ttg.async_copy_local_to_global %out_c

    // Cleanup
    ttg.local_dealloc %pipe_a
    ttg.local_dealloc %pipe_b
    ttg.local_dealloc %out_c

    tt.return
  }
}
