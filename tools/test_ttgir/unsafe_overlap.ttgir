#blocked = #ttg.blocked<{sizePerThread = [1, 8], threadsPerWarp = [8, 4], warpsPerCTA = [4, 1], order = [1, 0]}>
#shared = #ttg.nvmma_shared<{swizzlingByteWidth = 128, transposed = false, elementBitWidth = 16}>
#smem = #ttg.shared_memory
#mma = #ttg.nvidia_mma<{versionMajor = 3, versionMinor = 0, warpsPerCTA = [4, 1], instrShape = [16, 128, 16]}>
module attributes {"ttg.num-ctas" = 1 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "cuda:90", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @unsafe_kernel(%a_ptr: !tt.ptr<f16>, %c_ptr: !tt.ptr<f16>, %K: i32) {
    %c0_i32 = arith.constant 0 : i32
    %c1_i32 = arith.constant 1 : i32
    %c64_i32 = arith.constant 64 : i32
    %cst = arith.constant dense<0.000000e+00> : tensor<64x64xf32, #mma>
    %pipe_a = ttg.local_alloc : () -> !ttg.memdesc<2x64x64xf16, #shared, #smem, mutable>
    %out_buf = ttg.local_alloc : () -> !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
    %a_0 = ttg.memdesc_index %pipe_a[%c0_i32] : !ttg.memdesc<2x64x64xf16, #shared, #smem, mutable> -> !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
    %a_copy = ttg.async_copy_global_to_local %a_ptr, %a_0 : !tt.ptr<f16> -> <64x64xf16, #shared, #smem, mutable>
    %a_tok = ttg.async_commit_group tokens %a_copy
    %result:2 = scf.for %iv = %c0_i32 to %K step %c64_i32 iter_args(%acc = %cst, %stage = %c0_i32) -> (tensor<64x64xf32, #mma>, i32) : i32 {
      %wait = ttg.async_wait %a_tok {num = 1 : i32}
      %a_s = ttg.memdesc_index %pipe_a[%stage] : !ttg.memdesc<2x64x64xf16, #shared, #smem, mutable> -> !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
      %dot = ttng.warp_group_dot %a_s, %a_s, %acc {inputPrecision = 0 : i32, isAsync = true} : !ttg.memdesc<64x64xf16, #shared, #smem, mutable> * !ttg.memdesc<64x64xf16, #shared, #smem, mutable> -> tensor<64x64xf32, #mma>
      %dot_w:3 = ttng.warp_group_dot_wait %dot, %a_s, %a_s {pendings = 1 : i32} : tensor<64x64xf32, #mma>, !ttg.memdesc<64x64xf16, #shared, #smem, mutable>, !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
      %c_f16_loop = arith.truncf %dot_w#0 : tensor<64x64xf32, #mma> to tensor<64x64xf16, #mma>
      %c_blocked_loop = ttg.convert_layout %c_f16_loop : tensor<64x64xf16, #mma> -> tensor<64x64xf16, #blocked>
      ttg.local_store %c_blocked_loop, %out_buf : tensor<64x64xf16, #blocked> -> !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
      %next_stage = arith.addi %stage, %c1_i32 : i32
      scf.yield %dot_w#0, %next_stage : tensor<64x64xf32, #mma>, i32
    }
    ttg.local_dealloc %out_buf : !ttg.memdesc<64x64xf16, #shared, #smem, mutable>
    ttg.local_dealloc %pipe_a : !ttg.memdesc<2x64x64xf16, #shared, #smem, mutable>
    tt.return
  }
}
