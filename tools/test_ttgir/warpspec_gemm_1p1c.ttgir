    ttg.local_dealloc %out_buf : !ttg.memdesc<192x128xf16, #shared_out, #smem, mutable>
    ttg.local_dealloc %pipe_b : !ttg.memdesc<2x64x128xf16, #shared1, #smem, mutable>
    ttg.local_dealloc %pipe_a : !ttg.memdesc<2x192x64xf16, #shared, #smem, mutable>
