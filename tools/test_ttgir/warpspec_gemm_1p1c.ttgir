    %out_buf = ttg.local_alloc : () -> !ttg.memdesc<192x128xf16, #shared_out, #smem, mutable>
    %a_0 = ttg.memdesc_index %pipe_a[%c0_i32] : !ttg.memdesc<2x192x64xf16, #shared, #smem, mutable> -> !ttg.memdesc<192x64xf16, #shared, #smem, mutable>
    %a_copy = ttg.async_copy_global_to_local %a_ptr, %a_0 : !tt.ptr<f16> -> <192x64xf16, #shared, #smem, mutable>
    %a_tok = ttg.async_commit_group tokens %a_copy
    %b_0 = ttg.memdesc_index %pipe_b[%c0_i32] : !ttg.memdesc<2x64x128xf16, #shared1, #smem, mutable> -> !ttg.memdesc<64x128xf16, #shared1, #smem, mutable>
    %b_copy = ttg.async_copy_global_to_local %b_ptr, %b_0 : !tt.ptr<f16> -> <64x128xf16, #shared1, #smem, mutable>
    %b_tok = ttg.async_commit_group tokens %b_copy
    %result:2 = scf.for %iv = %c0_i32 to %K step %c64_i32 iter_args(%acc = %cst, %stage = %c0_i32) -> (tensor<192x128xf32, #mma>, i32) : i32 {
      %wait = ttg.async_wait %a_tok, %b_tok {num = 1 : i32}
      %a_s = ttg.memdesc_index %pipe_a[%stage] : !ttg.memdesc<2x192x64xf16, #shared, #smem, mutable> -> !ttg.memdesc<192x64xf16, #shared, #smem, mutable>
      %b_s = ttg.memdesc_index %pipe_b[%stage] : !ttg.memdesc<2x64x128xf16, #shared1, #smem, mutable> -> !ttg.memdesc<64x128xf16, #shared1, #smem, mutable>
      %dot = ttng.warp_group_dot %a_s, %b_s, %acc {inputPrecision = 0 : i32, isAsync = true} : !ttg.memdesc<192x64xf16, #shared, #smem, mutable> * !ttg.memdesc<64x128xf16, #shared1, #smem, mutable> -> tensor<192x128xf32, #mma>
      %dot_w:3 = ttng.warp_group_dot_wait %dot, %a_s, %b_s {pendings = 1 : i32} : tensor<192x128xf32, #mma>, !ttg.memdesc<192x64xf16, #shared, #smem, mutable>, !ttg.memdesc<64x128xf16, #shared1, #smem, mutable>
      %next_stage = arith.addi %stage, %c1_i32 : i32
      scf.yield %dot_w#0, %next_stage : tensor<192x128xf32, #mma>, i32
    }
    %final_wait = ttng.warp_group_dot_wait %result#0 {pendings = 0 : i32} : tensor<192x128xf32, #mma>
    %all_done = ttg.async_wait {num = 0 : i32}
    %c_f16 = arith.truncf %final_wait : tensor<192x128xf32, #mma> to tensor<192x128xf16, #mma>
    %c_blocked = ttg.convert_layout %c_f16 : tensor<192x128xf16, #mma> -> tensor<192x128xf16, #blocked>
    ttg.local_store %c_blocked, %out_buf : tensor<192x128xf16, #blocked> -> !ttg.memdesc<192x128xf16, #shared_out, #smem, mutable>
