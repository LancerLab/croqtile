#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define scale_h 19
#define scale_w 19
#endif

__co__ auto GELU(f32 [16, 512, scale_h, scale_w] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {x, y} in [4, 512] {
      l = dma.copy i.chunkat(p#x, y, _, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, y, _, _);
    }
  }
  return o;
}

int main() {
  test4("GELU", GELU, {16, 512, 19, 19});
}
