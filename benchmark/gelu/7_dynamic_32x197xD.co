#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define embed_dim 1023
#endif

__co__ auto GELU(f32 [32, 197, embed_dim] i) {
  f32 [i.span] o;
  parallel p by 8 : local {
    foreach x in [4] {
      if (embed_dim < 512) {
        l = dma.copy i.chunkat(p#x, _, _) => local;
        foreach idx in [l.span]
          l.data.at(idx) = __gelu(l.data.at(idx));
        dma.copy l.data => o.chunkat(p#x, _, _);
      } else {
        foreach y in [197] {
          l = dma.copy i.chunkat(p#x, y, _) => local;
          foreach idx in [l.span]
            l.data.at(idx) = __gelu(l.data.at(idx));
          dma.copy l.data => o.chunkat(p#x, y, _);
        }
      }
    }
  }
  return o;
}

int main() {
  test3("GELU", GELU, {32, 197, 1023});
}
