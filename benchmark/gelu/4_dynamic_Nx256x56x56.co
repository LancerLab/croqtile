#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define batch_size 117
#endif

__co__ auto GELU(f32 [batch_size, 256, 56, 56] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {b, x} in [batch_size, 16] {
      l = dma.copy i.chunkat(b, p#x, _, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(b, p#x, _, _);
    }
  }
  return o;
}

int main() {
  test4("GELU", GELU, {117, 256, 56, 56});
}
