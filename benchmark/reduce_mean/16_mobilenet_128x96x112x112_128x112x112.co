#include "choreo.h"
#include <chrono>
#include <iostream>
#include <cmath>

#define N 128
#define C 96
#define H 112
#define W 112

#ifndef NUM_BLOCK
  #define NUM_BLOCK 2
#endif
#ifndef NUM_THREAD
  #define NUM_THREAD 8
#endif

__cok__ {
  // Generic 2D reduce-mean: in [m, n] -> out [m], reduce along n
  __co_device__ void reduce_mean_kernel(float* in, float* out, int m, int n) {
    for (int i = 0; i < m; ++i) {
      float acc = 0.f;
      int base = i * n;
      for (int j = 0; j < n; ++j) acc += in[base + j];
      out[i] = acc / n;
    }
  }
}

// Reduce over C: [N, C, H, W] -> [N, H, W]
__co__ f32 [N, H, W] ele_reduce_mean(f32 [N, C, H, W] inp) {
  f32 [N, H, W] out;

  // Split N by blocks, then by threads. Do not tile H/W explicitly:
  // we view (N/#p/#q)*H*W as m, and C as n.
  parallel p by NUM_BLOCK {
   with index = {n_tile} in [112] { foreach n_tile {
    // Transpose to [N/#p, H, W, C] so the reduced dim C is last (contiguous).
    ts = dma.transp<0, 2, 3, 1> inp.chunkat(p,_ , n_tile, _) => shared; // [N/#p, H, W, C]

    // Shared output for this block: [N/#p, H, W]
    os = dma.copy.async out.chunkat(p, n_tile, _)            => shared; // [N/#p, H, W]
    wait os;

    parallel q by NUM_THREAD {
      // Local pieces for this thread
      il = dma.copy.async ts.chunkat(q, _, _, _) => local; // [N/#p/#q, H, W, C]
      ol = dma.copy.async os.chunkat(q, _, _)    => local; // [N/#p/#q, H, W]
      wait il, ol;

      // View local input as [m, n] with m=(N/#p/#q)*H*W, n=C
      call reduce_mean_kernel(
        il.data,                                  // in
        ol.data,                                  // out
        il.span(0) * il.span(1) * il.span(2),     // m
        il.span(3)                                 // n = C
      );

      dma.copy ol => os.chunkat(q,_, _);
    }
    
    dma.copy os => out.chunkat(p, n_tile, _);
  }}}

  return out;
}

// --------------------------- Host / main ---------------------------
int main() {
  auto a = choreo::make_spandata<choreo::f32>(N, C, H, W);
  a.fill_random(-1.0, 1.0);

  auto t0 = std::chrono::high_resolution_clock::now();
  auto r  = ele_reduce_mean(a.view());
  auto t1 = std::chrono::high_resolution_clock::now();
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  // Verification: for each (n, h, w), average over C
  for (size_t n = 0; n < N; ++n) {
    for (size_t h = 0; h < H; ++h) {
      for (size_t w = 0; w < W; ++w) {
        double acc = 0.0;
        for (size_t c = 0; c < C; ++c) acc += a[n][c][h][w];
        float ref = static_cast<float>(acc / C);
        if (std::fabs(ref - r[n][h][w]) > 1e-5f) {
          std::cout << "Mismatch at (n=" << n << ", h=" << h << ", w=" << w
                    << ") ref=" << ref << " got=" << r[n][h][w] << "\n";
          choreo::choreo_assert(false, "reduce_mean mismatch (case16)");
        }
      }
    }
  }

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " us\n";
  return 0;
}

