#include "choreo.h"
#include <chrono>
#include <iostream>
#include <cmath>

#define C 256
#define H 56
#define W 56
size_t n =32;
#ifndef NUM_BLOCK
  #define NUM_BLOCK 2
#endif
#ifndef NUM_THREAD
  #define NUM_THREAD 8
#endif
#ifdef __STATIC_SHAPE__
#define N 32
#else
#define N n
#endif
__cok__ {
  // Generic 2D reduce-mean kernel:
  // in  : [m, n]
  // out : [m]
  // Reduces over the second dimension (n).
  __co_device__ void reduce_mean_kernel(float* in, float* out, int m, int n) {
    for (int i = 0; i < m; ++i) {
      float acc = 0.f;
      int base = i * n;
      for (int j = 0; j < n; ++j) acc += in[base + j];
      out[i] = acc / n;
    }
  }
}

// Reduce over the last two dims (H, W):
// [N, C, H, W] -> [N, C]
__co__ f32 [N, C] ele_reduce_mean(f32 [N, C, H, W] inp) {
  f32 [N, C] out;

  // Split the first dim (N) twice: by NUM_BLOCK then by NUM_THREAD.
  // Split the second dim (C) via foreach tiles.
  parallel p by NUM_BLOCK {
    with index = {c_tile} in [C] {
      foreach c_tile {
        // Bring a (N/#p, 1, H, W) tile into shared memory for this (p, c_tile).
        is = dma.copy.async inp.chunkat(p, c_tile, _, _) => shared;
        wait is;

        // Now split the N/#p chunk further across NUM_THREAD.
        parallel q by NUM_THREAD {
          // Local input slice: (N/#p/#q, 1, H, W)
          il = dma.copy.async is.chunkat(q, _, _, _) => local;
          // Local output slice: (N/#p/#q, 1) mapped to out along (p, q, c_tile).
          ol = dma.copy.async out.chunkat(p, _).chunkat(q, c_tile) => local;
          wait il, ol;

          // View local input as [m, n] with m = (N/#p/#q)*1 and n = H*W.
          call reduce_mean_kernel(
            il.data,                         // in
            ol.data,                         // out
            il.span(0) * il.span(1),        // m = N/#p/#q
            il.span(2) * il.span(3)         // n = H*W
          );

          // Store the local output slice back to global.
          dma.copy ol => out.chunkat(p, _).chunkat(q, c_tile);
        }
      }
    }
  }

  return out;
}

// --------------------------- Host / main ---------------------------
int main() {
  auto a = choreo::make_spandata<choreo::f32>(N, C, H, W);
  a.fill_random(-1.0, 1.0);

  auto t0 = std::chrono::high_resolution_clock::now();
  auto r  = ele_reduce_mean(a.view());
  auto t1 = std::chrono::high_resolution_clock::now();
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  // Verify: for each (n, c) average over H and W
  for (size_t n = 0; n < N; ++n) {
    for (size_t c = 0; c < C; ++c) {
      double acc = 0.0;
      for (size_t h = 0; h < H; ++h)
        for (size_t w = 0; w < W; ++w)
          acc += a[n][c][h][w];
      float ref = static_cast<float>(acc / (H * W));
      if (std::fabs(ref - r[n][c]) > 1e-5f) {
        std::cout << "Mismatch at (n=" << n << ", c=" << c
                  << ") ref=" << ref << " got=" << r[n][c] << "\n";
        choreo::choreo_assert(false, "reduce_mean mismatch (case3)");
      }
    }
  }

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " us\n";
  return 0;
}

