          l1_a = dma.copy lhs.chunkat(p#q, m_tile, k_tile) => local;
          l1_b = dma.copy rhs.chunkat(k_tile, n_tile) => local;
          foreach {i, j, k, l} in [l1_a.span(0), l1_a.span(1), l1_b.span(1), l1_a.span(2)] {
            l1_out.at(i, j, k) += l1_a.data.at(i, j, l) * l1_b.data.at(l, k);
          }
          dma.copy l1_out => output.chunkat(p#q, m_tile, n_tile);
        }
      }
    }
  }
  return output;
}

// case3: [256, 512] + [512, 10] --> [256, 10] (CNN)
__co__ auto matmul3(f32 [256, 512] lhs, f32 [512, 10] rhs) {
  f32 [lhs.span(0), rhs.span(1)] output;
  parallel p by 4, q by 10 {
    foreach {m_tile, n_tile} in [8, 1] {
      local f32[lhs.span(0)/#m_tile/#p, rhs.span(1)/#n_tile/#q] l1_out {0.0f};
      foreach {k_tile} in [16] {
        l1_a = dma.copy lhs.chunkat(p#m_tile, k_tile) => local;
        l1_b = dma.copy rhs.chunkat(k_tile, q#n_tile) => local;
        foreach {i, j, k} in [l1_a.span(0), l1_b.span(1), l1_a.span(1)] {
          l1_out.at(i, j) += l1_a.data.at(i, k) * l1_b.data.at(k, j);
        }
      }
      dma.copy l1_out => output.chunkat(p#m_tile, q#n_tile);
    }
  }
  return output;
}

// case4: [32, num_heads, 512, 64] + [32, num_heads, 64, 512] --> [32, num_heads, 512, 512] (Dynamic)
__co__ auto matmul4(f32 [32, num_heads, 512, 64] lhs, f32 [32, num_heads, 64, 512] rhs) {
  f32 [lhs.span(0), lhs.span(1), lhs.span(2), rhs.span(3)] output;
  parallel p by 4, q by 8 {
    with index = {m_tile, n_tile, k_tile} in [16, 16, 1] {
      foreach m_tile, n_tile {
        local f32[output.span(0)/#p/#q, output.span(1), output.span(2)/#m_tile, output.span(3)/#n_tile] l1_out {0.0f};
        foreach k_tile {
          l1_a = dma.copy lhs.chunkat(p#q, _, m_tile, k_tile) => local;
          l1_b = dma.copy rhs.chunkat(p#q, _, k_tile, n_tile) => local;
          foreach {i, j, m, n, k} in [l1_a.span(0), l1_a.span(1), l1_a.span(2), l1_b.span(3), l1_a.span(3)] {
            l1_out.at(i, j, m, n) += l1_a.data.at(i, j, m, k) * l1_b.data.at(i, j, k, n);
          }
          dma.copy l1_out => output.chunkat(p#q, _, m_tile, n_tile);
        }
      }
    }
  }
  return output;
}

