        }
      }
      dma.copy l1_out => output.chunkat(n_tile#p, c_tile#q, _, _);
    }
  }
  return output;
}

// - case18: [16, 512, 64, 64] --> [16, 512, 32, 32] (U-Net)
__co__ auto max_pool2d18(f32 [16, 512, 64, 64] input) {
  f32 [input.span(0), input.span(1), input.span(2)/2, input.span(3)/2] output;
  parallel p by 2, q by 8 {
    foreach {n_tile, c_tile} in [1, 8] {
      l1_input = dma.copy input.chunkat(n_tile#p, c_tile#q, _, _) => local;
      local f32[l1_input.span(0), l1_input.span(1), l1_input.span(2)/2, l1_input.span(3)/2] l1_out;
      foreach {i, j} in [l1_out.span(0), l1_out.span(1)] {
        foreach {h, w} in [l1_out.span(2), l1_out.span(3)] {
          f32 max_val = l1_input.data.at(i, j, h * 2, w * 2);
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2, w * 2 + 1));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2 + 1));
          l1_out.at(i, j, h, w) = max_val;
        }
      }
      dma.copy l1_out => output.chunkat(n_tile#p, c_tile#q, _, _);
    }
  }
  return output;
}

// - case19: [32, 512, 14, 14] --> [32, 512, 7, 7] (VGG)
__co__ auto max_pool2d19(f32 [32, 512, 14, 14] input) {
  f32 [input.span(0), input.span(1), input.span(2)/2, input.span(3)/2] output;
  parallel p by 4, q by 8 {
    foreach {n_tile, c_tile} in [1, 8] {
      l1_input = dma.copy input.chunkat(n_tile#p, c_tile#q, _, _) => local;
      local f32[l1_input.span(0), l1_input.span(1), l1_input.span(2)/2, l1_input.span(3)/2] l1_out;
      foreach {i, j} in [l1_out.span(0), l1_out.span(1)] {
        foreach {h, w} in [l1_out.span(2), l1_out.span(3)] {
          f32 max_val = l1_input.data.at(i, j, h * 2, w * 2);
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2, w * 2 + 1));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2 + 1));
          l1_out.at(i, j, h, w) = max_val;
        }
      }
      dma.copy l1_out => output.chunkat(n_tile#p, c_tile#q, _, _);
    }
  }
  return output;
}

// - case20: [32, 3, 224, 224] --> [32, 3, 112, 112] (ViT)
__co__ auto max_pool2d20(f32 [32, 3, 224, 224] input) {
  f32 [input.span(0), input.span(1), input.span(2)/2, input.span(3)/2] output;
  parallel p by 4, q by 3 {
    foreach {n_tile, c_tile} in [8, 1] {
      l1_input = dma.copy input.chunkat(n_tile#p, c_tile#q, _, _) => local;
      local f32[l1_input.span(0), l1_input.span(1), l1_input.span(2)/2, l1_input.span(3)/2] l1_out;
      foreach {i, j} in [l1_out.span(0), l1_out.span(1)] {
        foreach {h, w} in [l1_out.span(2), l1_out.span(3)] {
          f32 max_val = l1_input.data.at(i, j, h * 2, w * 2);
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2, w * 2 + 1));
          max_val = max_(max_val, l1_input.data.at(i, j, h * 2 + 1, w * 2 + 1));
          l1_out.at(i, j, h, w) = max_val;
        }
      }
      dma.copy l1_out => output.chunkat(n_tile#p, c_tile#q, _, _);
    }
  }
  return output;
}

extern "C" void cpu_max_pool2d1(choreo::f32* input, choreo::f32* output, int N, int C, int H, int W) {
  const int out_H = H / 2;
  const int out_W = W / 2;

  for (int n = 0; n < N; ++n) {
    for (int c = 0; c < C; ++c) {
      for (int oh = 0; oh < out_H; ++oh) {
        for (int ow = 0; ow < out_W; ++ow) {
            int ih = oh * 2;
            int iw = ow * 2;

            int input_base = n * C * H * W + c * H * W;
            int output_idx = n * C * out_H * out_W + c * out_H * out_W + oh * out_W + ow;

            float max_val = input[input_base + ih * W + iw];
            max_val = std::max(max_val, input[input_base + (ih + 1) * W + iw]);
            max_val = std::max(max_val, input[input_base + ih * W + (iw + 1)]);
            max_val = std::max(max_val, input[input_base + (ih + 1) * W + (iw + 1)]);
            output[output_idx] = max_val;
        }
      }
    }
  }
}

#define TEST1(func, N, C, H, W) \
  auto input_##func = choreo::make_spandata<choreo::f32>(N, C, H, W); \
  input_##func.fill_random(-10.0f, 10.0f); \
  auto output_##func = func(input_##func.view()); \
  float *cpu_res_##func = (float *)malloc(N * C * (H / 2) * (W / 2) * sizeof(float)); \
  cpu_max_pool2d1(input_##func.data(), cpu_res_##func, N, C, H, W); \
  for (int i = 0; i < N * C * (H / 2) * (W / 2); ++i) { \
    assert(fabs(output_##func.data[i] - cpu_res_##func[i]) < 1e-3); \
  } \
  printf("Test %s passed!\n", #func);

int main() {
  TEST1(max_pool2d1, 64, 256, 27, 27);
  // other test cases can be added similarly
  printf("All tests passed!\n");
  return 0;
}