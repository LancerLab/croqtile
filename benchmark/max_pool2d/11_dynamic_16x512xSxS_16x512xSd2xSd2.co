#include "common.hpp"
#ifdef __STATIC_SHAPE__
#define scale_h 14
#define scale_w 14
#endif

__co__ auto max_pool2d11(f32 [16, 512, scale_h, scale_w] input) {
  f32 [16, 512, scale_h/2, scale_w/2] output;
  parallel p by 4 {
    foreach n in [16/#p] {
      l1_input = dma.copy input.chunkat(n#p, _, _, _) => local;
      local f32[1, 512, scale_h/2, scale_w/2] l1_out;
      foreach {c} in [512] {
        foreach {oh, ow} in [scale_h/2, scale_w/2] {
          f32 m = l1_input.data.at(0, c, 2*oh, 2*ow);
          if (l1_input.data.at(0, c, 2*oh, 2*ow+1) > m) m = l1_input.data.at(0, c, 2*oh, 2*ow+1);
          if (l1_input.data.at(0, c, 2*oh+1, 2*ow) > m) m = l1_input.data.at(0, c, 2*oh+1, 2*ow);
          if (l1_input.data.at(0, c, 2*oh+1, 2*ow+1) > m) m = l1_input.data.at(0, c, 2*oh+1, 2*ow+1);
          l1_out.at(0, c, oh, ow) = m;
        }
      }
      dma.copy l1_out => output.chunkat(n#p, _, _, _);
    }
  }
  return output;
}

int main() {
  TESTP(max_pool2d11, 16, 512, 14, 14);
  return 0;
}
