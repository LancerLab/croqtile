  return output.data;
}


// 3->4
#define TEST1(func, in_dim0, in_dim1, in_dim2, out_dim0, out_dim1, out_dim2, out_dim3) \
  auto input_##func = choreo::make_spandata<choreo::f32>(in_dim0, in_dim1, in_dim2); \
  input_##func.fill(1.0f); \
  auto res_##func = func(input_##func.view()); \
  assert(res_##func.span(0) == out_dim0); \
  assert(res_##func.span(1) == out_dim1); \
  assert(res_##func.span(2) == out_dim2); \
  assert(res_##func.span(3) == out_dim3); \
  printf("Case %s passed!\n", #func);
  
// 4->2
#define TEST2(func, in_dim0, in_dim1, in_dim2, in_dim3, out_dim0, out_dim1) \
  auto input_##func = choreo::make_spandata<choreo::f32>(in_dim0, in_dim1, in_dim2, in_dim3); \
  input_##func.fill(1.0f); \
  auto res_##func = func(input_##func.view()); \
  assert(res_##func.span(0) == out_dim0); \
  assert(res_##func.span(1) == out_dim1); \
  printf("Case %s passed!\n", #func);
  
// 4->3
#define TEST3(func, in_dim0, in_dim1, in_dim2, in_dim3, out_dim0, out_dim1, out_dim2) \
  auto input_##func = choreo::make_spandata<choreo::f32>(in_dim0, in_dim1, in_dim2, in_dim3); \
  input_##func.fill(1.0f); \
  auto res_##func = func(input_##func.view()); \
  assert(res_##func.span(0) == out_dim0); \
  assert(res_##func.span(1) == out_dim1); \
  assert(res_##func.span(2) == out_dim2); \
  printf("Case %s passed!\n", #func);
  
// 4->4
#define TEST4(func, in_dim0, in_dim1, in_dim2, in_dim3, out_dim0, out_dim1, out_dim2, out_dim3) \
  auto input_##func = choreo::make_spandata<choreo::f32>(in_dim0, in_dim1, in_dim2, in_dim3); \
  input_##func.fill(1.0f); \
  auto res_##func = func(input_##func.view()); \
  assert(res_##func.span(0) == out_dim0); \
  assert(res_##func.span(1) == out_dim1); \
  assert(res_##func.span(2) == out_dim2); \
  assert(res_##func.span(3) == out_dim3); \
  printf("Case %s passed!\n", #func);

// 3->2
#define TEST5(func, in_dim0, in_dim1, in_dim2, out_dim0, out_dim1) \
  auto input_##func = choreo::make_spandata<choreo::f32>(in_dim0, in_dim1, in_dim2); \
  input_##func.fill(1.0f); \
  auto res_##func = func(input_##func.view()); \
  assert(res_##func.span(0) == out_dim0); \
  assert(res_##func.span(1) == out_dim1); \
  printf("Case %s passed!\n", #func);

#define batch_size 32
#define seq_len 512
#define num_heads 12
#define height 28
#define width 28
#define channels 197
#define embed_dim 768
#define d_model 1024
#define time_steps 64
#define vocab_size 2048

int main() {
  #if 1
  TEST1(reshape1, 32, 512, 768, 32, 512, 12, 64);
  TEST2(reshape2, 128, 128, 28, 28, 128, 100352);
  TEST1(reshape3, batch_size, seq_len, 768, batch_size, seq_len, 12, 64);
  TEST3(reshape4, 32, num_heads, 512, 64, 32, 512, num_heads * 64);
  TEST2(reshape5, batch_size, 1280, height, width, batch_size, 1280 * height * width);
  TEST4(reshape6, 128, channels, 112, 112, 128, 112, 112, channels);
  TEST1(reshape7, 32, 197, embed_dim, 32, 197, embed_dim / 64, 64);
  TEST1(reshape8, 16, 1024, d_model, 16, 1024, d_model / 64, 64);
  TEST2(reshape9, batch_size, 256, height, width, batch_size, 256 * height * width);
  TEST2(reshape10, 64, 128, height, width, 64, 128 * height * width);
  TEST2(reshape11, 16, 512, height, width, 16, 512 * height * width);
  TEST5(reshape12, 64, time_steps, 256, 64 * time_steps, 256);
  TEST5(reshape13, 32, 512, vocab_size, 32, 512 * vocab_size);
  TEST2(reshape14, 64, 1280, 7, 7, 64, 1280 * 7 * 7);
  TEST1(reshape15, 16, 1024, 1024, 16, 16, 1024, 64);
  TEST5(reshape16, 64, 100, 256, 6400, 256);
  TEST2(reshape17, 128, 96, 7, 7, 128, 4704);
  TEST2(reshape18, 64, 512, 7, 7, 64, 25088);
  TEST5(reshape19, 32, 512, 2048, 32, 1048576);
  TEST4(reshape20, 16, 512, 32, 32, 16, 32, 32, 512);
  TEST3(reshape21, 32, 3, 224, 224, 32, 196, 768);

  std::cout << "All reshape cases passed!" << std::endl;
  #endif
  return 0;
}