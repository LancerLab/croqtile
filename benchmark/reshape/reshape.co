  return output.data;
}
// - case7: [32, 197, embed_dim] --> [32, 197, embed_dim / 64, 64] (Dynamic)
__co__ auto reshape7(f32 [32, 197, embed_dim] input) {
  output = dma.copy input.span_as([32, 197, embed_dim / 64, 64]) => global;
  return output.data;
}
// - case8: [16, 1024, d_model] --> [16, 1024, d_model / 64, 64] (Dynamic)
__co__ auto reshape8(f32 [16, 1024, d_model] input) {
  output = dma.copy input.span_as([16, 1024, d_model / 64, 64]) => global;
  return output.data;
}
