// - case1: [32, 512, 768] --> [32, 512, 12, 64] (BERT)
__co__ auto reshape1(f32 [32, 512, 768] input) {
  output = dma.copy input.span_as([32, 512, 12, 64]) => global;
  return output.data;
}
// - case2: [128, 128, 28, 28] --> [128, 100352] (CNN)
__co__ auto reshape2(f32 [128, 128, 28, 28] input) {
  output = dma.copy input.span_as([128, 100352]) => global;
  return output.data;
}
// - case3: [batch_size, seq_len, 768] --> [batch_size, seq_len, 12, 64] (Attention)
__co__ auto reshape3(f32 [batch_size, seq_len, 768] input) {
  output = dma.copy input.span_as([batch_size, seq_len, 12, 64]) => global;
  return output.data;
}
// - case4: [32, num_heads, 512, 64] --> [32, 512, num_heads * 64] (Attention)
__co__ auto reshape4(f32 [32, num_heads, 512, 64] input) {
  output = dma.copy input.span_as([32, 512, num_heads * 64]) => global;
  return output.data;
}
