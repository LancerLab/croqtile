#define I 128
#define J 256
#define K 28
#define L 28

#define NUM_BLOCK 2
// TODO: make it 12
#define NUM_THREAD 8 

__co__ auto ele_add(f32 [I, J, K, L] lhs, f32 [J] rhs) {
  f32 [lhs.span] out;
  parallel p by NUM_BLOCK {
    lfs = dma.copy lhs.chunkat(p,_,_,_) => shared;
    parallel q by NUM_THREAD {
      rfl = dma.copy rhs.chunkat(q) => local;
      foreach r in [14] {
        lfl = dma.copy lfs.chunkat(_,q,r,_) => local;
        local f32 [lfl.span] lout;
        foreach index = {i,j,k,l} in lfl.span
          lout.at(index) = lfl.data.at(index) + rfl.data.at(j);
        dma.copy lout => out.chunkat(p,_,_,_).chunkat(_,q,r,_);
      }
    }
  }
  return out;
}


int main() {
  auto a = choreo::make_spandata<choreo::f32>(I, J, K, L);
  auto b = choreo::make_spandata<choreo::f32>(J);
  a.fill_random(-1.0, 1.0);
  b.fill_random(-1.0, 1.0);

  auto res = ele_add(a.view(), b.view());

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j)
      for (size_t k = 0; k < res.shape()[2]; ++k) {
        for (size_t l = 0; l < res.shape()[3]; ++l) {
          if (a[i][j][k][l] + b[j] != res[i][j][k][l]) {
            std::cout << a[i][j][k][l] << " + " << b[j] << " != " << res[i][j][k][l] << "\n";
            choreo::choreo_assert(a[i][j][k][l] + b[j] == res[i][j][k][l], "values are not equal.");
          }
        }
      }

  std::cout << "Passed.\n";
}
