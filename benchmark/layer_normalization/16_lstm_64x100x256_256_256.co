#define I 64
#define J 100
#define K 256

#define NUM_BLOCK 2
// TODO: make it 12
#define NUM_THREAD 8 

// #define __STATIC_SHAPE__
#ifdef __STATIC_SHAPE__
#endif

__co__ auto layer_norm(f32 [I, J, K] lhs, f32 [K] scale, f32 [K] bias) {
  f32 [lhs.span] out;
  parallel p by NUM_BLOCK, q by NUM_THREAD {
    tilings : [10, 8];
    n = p # q;
    bnum = I / (#p * #q);
    assert(bnum > 0, "unexpected batch count.");

    local f32 [bnum] mean{0.0f}, variance{0.0f}, std_div;

    foreach r in tilings {
      lfl = dma.copy lhs.chunkat(n,r) => local;
      assert(bnum == lfl.span(0), "unexpected batch count.");
      foreach idx = {b, c, s} in lfl.span {
        mean.at(b) += lfl.data.at(idx);
      }
    }
    foreach b in [bnum] mean.at(b) /= (lhs.span(1) * lhs.span(2));
    
    foreach r in tilings {
      lfl = dma.copy lhs.chunkat(n,r) => local;
      foreach idx = {b, c, s} in lfl.span {
        f32 diff = lfl.data.at(idx) - mean.at(b);
        variance.at(b) += diff * diff;
      }
    }
    foreach b in [bnum]  {
      variance.at(b) /= (lhs.span(1) * lhs.span(2));
      std_div.at(b) = __sqrt(variance.at(b));
    }

    foreach r = {rc, rs} in tilings {
      lfl = dma.copy lhs.chunkat(n,r) => local;
      sl = dma.copy.async scale.chunkat(rs) => local;
      bl = dma.copy.async bias.chunkat(rs) => local;
      wait sl, bl;
      local f32 [lfl.span] lout;
      foreach index = {b, c, s} in lfl.span {
        // TODO: make stack veriable work `f32 normalized = ....`
        // TODO: allows local scalar initialization: `local f32 normalized = ...`
        local f32 normalized;
        normalized = (lfl.data.at(index) - mean.at(b)) / std_div.at(b);
        lout.at(index) = sl.data.at(s) * normalized + bl.data.at(s);
      }
      dma.copy lout => out.chunkat(n,r);
    }
  }
  return out;
}


int main() {
  auto input = choreo::make_spandata<choreo::f32>(I, J, K);
  auto scale = choreo::make_spandata<choreo::f32>(K);
  auto bias = choreo::make_spandata<choreo::f32>(K);
  input.fill_random(-1.0, 1.0);
  scale.fill_random(-1.0, 1.0);
  bias.fill_random(-1.0, 1.0);

  auto res = layer_norm(input.view(), scale.view(), bias.view());

  // verfication
  auto out = choreo::make_spandata<choreo::f32>(I, J, K);
  for (int i = 0; i < I; ++i) {
    // Calculate mean across ALL elements of this sample
    float mean = 0.0f;

    for (int c = 0; c < J; ++c)
      for (int s = 0; s < K; ++s)
        mean += input[i][c][s];

    mean /= (J * K);

    // Calculate variance
    float variance = 0.0f;
    for (int c = 0; c < J; ++c) {
      for (int s = 0; s < K; ++s) {
        float diff = input[i][c][s] - mean;
        variance += diff * diff;
      }
    }
    variance /= (J * K);
    float std_div = std::sqrt(variance);

    // Normalize and apply scale/shift
    for (int c = 0; c < J; ++c) {
      for (int s = 0; s < K; ++s) {
        float normalized = (input[i][c][s] - mean) / std_div;
        out[i][c][s] = scale[s] * normalized + bias[s];
      }
    }
  }

  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j)
      for (size_t k = 0; k < res.shape()[2]; ++k) {
        auto sm = out[i][j][k];
        if (fabs(sm - res[i][j][k]) > 1e-3) {
          std::cout << "i: " << i << ", j: " << j << ", k: " << k << "\n";
          std::cout << sm << " != " << res[i][j][k] << "\n";
          choreo::choreo_assert(sm == res[i][j][k], "values are not equal.");
        }
      }

  std::cout << "Passed.\n";
}
