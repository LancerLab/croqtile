#include "choreo.h"
#include <chrono>
#include <iostream>
size_t num_heads =1;
#ifdef __STATIC_SHAPE__
#define J 1
#else
#define J num_heads
#endif
#define I 32
#define K 512
#define L 64

#ifndef NUM_BLOCK
  #define NUM_BLOCK 2
#endif
#ifndef NUM_THREAD
  #define NUM_THREAD 2
#endif

__cok__ {
  __co_device__ void concat_kernel(float* in1, float* in2, float* out, int m, int n) {
    // m = I*J/tiles, n = K/NUM_THREAD * L
    for (int i = 0; i < m; ++i) {
      int base_out = i * (2*n);
      int base_in  = i * n;
      for (int j = 0; j < n; ++j) {
        out[base_out + j]     = in1[base_in + j];  
        out[base_out + n + j] = in2[base_in + j];  
      }
    }
  }
}

// ---------------- choreo operator ----------------
__co__ f32 [I, J, K, L*2] ele_concat_K(f32 [I, J, K, L] a, f32 [I, J, K, L] b) {
  f32 [I, J, K, L*2] out;

  parallel p by NUM_BLOCK {
    with index = {n_tile} in [K] {
      foreach n_tile {
        as = dma.copy.async a.chunkat(p, _, n_tile, _) => shared;
        bs = dma.copy.async b.chunkat(p, _, n_tile, _) => shared;
        wait as, bs;

        parallel q by 1 {
          al = dma.copy.async as.chunkat(_, q, _, _) => local;
          bl = dma.copy.async bs.chunkat(_, q, _, _) => local;
          ol = dma.copy.async out.chunkat(p, q, n_tile,  _) => local;
          wait al, bl, ol;

          call concat_kernel(al.data, bl.data, ol.data,
                             al.span(0)*al.span(1)*al.span(2),   // M = I/NUM_BLOCK * 1
                             al.span(3));  // N = (K/NUM_THREAD)*L

          dma.copy ol => out.chunkat(p, q, n_tile,  _);
        }
      }
    }
  }
  return out;
}

// ---------------- host test ----------------
int main() {
  auto a = choreo::make_spandata<choreo::f32>(I, J, K, L);
  auto b = choreo::make_spandata<choreo::f32>(I, J, K, L);
  a.fill_random(-1.0, 1.0);
  b.fill_random(-1.0, 1.0);

  auto t0 = std::chrono::high_resolution_clock::now();
  auto r  = ele_concat_K(a.view(), b.view());
  auto t1 = std::chrono::high_resolution_clock::now();
  auto dur = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0);

  for (size_t i=0;i<I;++i)
    for (size_t j=0;j<J;++j)
      for (size_t kk=0; kk<K; ++kk) {
      for (size_t l=0; l<2*L; ++l) {
        size_t which = l / L;
        size_t ll     = l % L;
        float got = r[i][j][kk][l];
        float ref = (which==0)? a[i][j][kk][ll] : b[i][j][kk][ll];
        if (ref!=got) {
          std::cout << "Mismatch at ("<<i<<","<<j<<","<<kk<<")\n";
          choreo::choreo_assert(false,"concat mismatch");
        }
      }
     }
  std::cout << "Passed.\n";
  std::cout << "Execution time: " << dur.count() << " us\n";
  return 0;
}

