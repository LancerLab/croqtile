#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define time_steps 1024
#endif

__co__ auto TRANSPOSE(f32 [64, time_steps, 256] i) {
  f32 [i.span(1), i.span(0), i.span(2)] o;
  parallel p by 2 : block {
    parallel q by 4 : thread {
      foreach {x, y} in [i.span(0)/#p/#q, 128] {
        l = dma.transp<1, 0, 2> i.chunkat(p#q#x, y, _) => local;
        dma.copy l.data => o.chunkat(y, p#q#x, _);
      }
    }
  }
  return o;
}

int main() {
  test3("TRANSPOSE", TRANSPOSE, {64, 1024, 256}, {1, 0, 2});
}