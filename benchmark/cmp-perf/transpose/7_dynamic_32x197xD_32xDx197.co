#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define embed_dim 1000
#endif

__co__ auto TRANSPOSE(f32 [32, 197, embed_dim] i) {
  f32 [i.span(0), i.span(2), i.span(1)] o;
  parallel p by 4 : thread {
    foreach {x, y} in [i.span(0)/#p, 197] {
      l = dma.transp<0, 2, 1> i.chunkat(p#x, y, _) => local;
      dma.copy l.data => o.chunkat(p#x, _, y);
    }
  }
  return o;
}

int main() {
  test3("TRANSPOSE", TRANSPOSE, {32, 197, 1000}, {0, 2, 1});
}