#include "choreo.h"
#include "common.h"

#define _padding 0
__co__ auto CONV2D(f32 [32, 768, 14, 14] i, f32 [1000, 768, 7, 7] w, int stride, int padding, int dilation) {
  N = i.span(0);
  Cin = i.span(1);
  H = i.span(2);
  W = i.span(3);
  Cout = w.span(0);
  Kh = w.span(2);
  Kw = w.span(3);
  Ho = (H + 2 * padding - dilation * (Kh - 1) - 1) / stride + 1;
  Wo = (W + 2 * padding - dilation * (Kw - 1) - 1) / stride + 1;
  Hpad = H + 2 * padding;
  Wpad = W + 2 * padding;

  f32 [N, Cout, Ho, Wo] o;

  M = Ho * Wo;
  K = Cin * Kh * Kw;

  parallel p by 2 : block {
    shared f32 [M, K] A;
    shared f32 [Ho*Wo, Cout] Y;

    foreach n in [N / #p] {
      // 1. im2col
      i_s_padded = dma.pad<{0, 0, padding, padding}, {0, 0, padding, padding}, {0, 0, 0, 0}, 0.0f> i.chunkat(p#n, _, _, _) => shared;
      with {i, j} in [Hpad, Wpad] {
        foreach i(:-6:), j(:-6:) {
          dma.copy i_s_padded.chunkat(_, _, i, j).subspan(_, _, Kh, Kw) => A.subspan(1, _).at(i*Wo + j, 0).span_as(1, Cin, Kh, Kw);
        }
      }
      // 2. GEMM: C = A x B, result shape: M x Cout
      parallel q by 8 : thread {
        foreach {qq} in [100] {
          local f32 [A.span(0)/#q, Cout/#qq] l1_Y{0.0f};
          l1_B = dma.copy w.span_as(Cout, K).chunkat(qq, _) => local;
          call k_matmul(A.chunkat(q, _), l1_B.data, l1_Y, M/#q, Cout/#qq, K);
          dma.copy l1_Y => Y.chunkat(q, qq);
        }
      }
      
      dma.transp<0, 3, 1, 2> Y.span_as(1, Ho, Wo, Cout) => o.chunkat(p#n, _, _, _);
    }
  }
  return o;
}

int main() {
  test_dynamic("CONV2D", CONV2D, {32, 768, 14, 14}, {1000, 768, 7, 7}, 1, 0, 1);
}