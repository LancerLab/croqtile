#include "common.hpp"

// case3: [256, 512] + [512, 10] --> [256, 10] (CNN) -- k_matmul vectorized
__co__ auto matmul3(f32 [256, 512] lhs, f32 [512, 10] rhs) {
  f32 [lhs.span(0), rhs.span(1)] output;
  parallel p by 2 {
    with tilings = {m_tile, n_tile, k_tile} in [256/16, 10/1, 512/32] {
      foreach m_tile, n_tile {
        local f32[16, 1] l1_out {0.0f};
        foreach k_tile {
          l1_a = dma.copy lhs.chunkat(m_tile, k_tile) => local;
          l1_b = dma.transp<1,0> rhs.chunkat(k_tile, n_tile) => local;
          call k_matmul(l1_a.data, l1_b.data, l1_out, 16, 1, 32);
        }
        dma.copy l1_out => output.chunkat(m_tile, n_tile);
      }
    }
  }
  return output;
}

int main() {
  TEST1(matmul3, 256, 10, 512);
  return 0;
}
