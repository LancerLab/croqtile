#include "choreo.h"
#include "common.h"

__co__ auto GELU(f32 [128, 128, 28, 28] i) {
  f32 [i.span] o;
  parallel p by 4 : thread {
    foreach {x, y} in [32, 32] {
      l = dma.copy i.chunkat(p#x, y, _, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, y, _, _);
    }
  }
  return o;
}

int main() {
  test4("GELU", GELU, {128, 128, 28, 28});
}
