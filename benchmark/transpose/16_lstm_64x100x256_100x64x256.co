#include "choreo.h"
#include "common.h"

__co__ auto TRANSPOSE(f32 [64, 100, 256] i) {
  f32 [i.span(1), i.span(0), i.span(2)] o;
  parallel p by 2 : shared {
    parallel q by 4 : local {
      foreach {x, y} in [i.span(0)/#p/#q, 1] {
        l = dma.transp<1, 0, 2> i.chunkat(p#q#x, y, _) => local;
        dma.copy l.data => o.chunkat(y, p#q#x, _);
      }
    }
  }
  return o;
}

int main() {
  test3("TRANSPOSE", TRANSPOSE, {64, 100, 256}, {1, 0, 2});
}