#define I 32
#define J 512
#define K 768

#define NUM_BLOCK 2
// TODO: make it 12
#define NUM_THREAD 8 

__co__ auto ele_add(f32 [I, J, K] lhs, f32 rhs) {
  f32 [lhs.span] out;
  parallel p by NUM_BLOCK {
    lfs = dma.copy lhs.chunkat(p,_,_) => shared;
    parallel q by NUM_THREAD {
      foreach r in [8] {
        lfl = dma.copy lfs.chunkat(_,q,r) => local;
        local f32 [lfl.span] lout;
        foreach index in lfl.span
          lout.at(index) = lfl.data.at(index) + rhs;
        dma.copy lout => out.chunkat(p,_,_).chunkat(_,q,r);
      }
    }
  }
  return out;
}


int main() {
  auto a = choreo::make_spandata<choreo::f32>(I, J, K);
  float b = 1.1f;
  a.fill_random(-1.0, 1.0);

  auto start = std::chrono::high_resolution_clock::now();
  auto res = ele_add(a.view(), b);
  auto end = std::chrono::high_resolution_clock::now();
  auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end - start);

  // verfication
  for (size_t i = 0; i < res.shape()[0]; ++i)
    for (size_t j = 0; j < res.shape()[1]; ++j)
      for (size_t k = 0; k < res.shape()[2]; ++k) {
        if (a[i][j][k] + b != res[i][j][k]) {
          std::cout << a[i][j][k] << " + " << b << " != " << res[i][j][k] << "\n";
          choreo::choreo_assert(a[i][j][k] + b == res[i][j][k], "values are not equal.");
        }
      }

  std::cout << "Passed.\n";
  std::cout << "Execution time: " << duration.count() << " microseconds" << std::endl;
}
