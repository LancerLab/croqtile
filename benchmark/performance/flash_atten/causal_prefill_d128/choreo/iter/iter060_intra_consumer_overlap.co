// Warp-specialized 1p2c with 2-stage pipeline, split K/V events
// + Prototype FA3-like intra-consumer overlap schedule:
//   issue QK[n+1] first, then PV[n], then mma.wait<1>.
// D=128, bf16, causal prefill

#define BLOCK_M 128
#define BLOCK_N 128
#define WG_M 64
#define WG_K 16
#define SWIZ 128
#define STAGES 2

#define DIM 128

__co__ void flash_atten(
  global bf16[B, Q_SEQ, H, DIM] Q,
  global bf16[B, KV_SEQ, H, DIM] K,
  global bf16[B, KV_SEQ, H, DIM] V,
  global bf16[B, Q_SEQ, H, DIM] O
) {
  float scale = 0.12751743f;
  int past_len = KV_SEQ - Q_SEQ;

  parallel {bm, head, batch} by [cdiv(Q_SEQ, BLOCK_M), H, B] : block {
    launch_bounds(1);
    Q_head = Q.subspan(1, Q_SEQ, 1, DIM).at(batch, 0, head, 0).sqz();
    K_head = K.subspan(1, KV_SEQ, 1, DIM).at(batch, 0, head, 0).sqz();
    V_head = V.subspan(1, KV_SEQ, 1, DIM).at(batch, 0, head, 0).sqz();
    O_head = O.subspan(1, Q_SEQ, 1, DIM).at(batch, 0, head, 0).sqz();

    shared bf16[BLOCK_M, DIM] q_shared;
    shared bf16[BLOCK_N, DIM] k_buf[STAGES];
    shared bf16[BLOCK_N, DIM] v_buf[STAGES];
    shared bf16[BLOCK_M, DIM] acc_o_shared;
    shared event qf, kf[STAGES], ke[STAGES], vf[STAGES], ve[STAGES];

    kv_bound = __min(cdiv((bm + 1) * BLOCK_M + past_len, BLOCK_N), cdiv(KV_SEQ, BLOCK_N));

    parallel p by [BLOCK_M/WG_M + 1] : group-4, t by 128 : thread {
      inthreads.async (p == 0 && t == 0) {
        tma.copy.async<qf>.swiz<SWIZ>
          Q_head.subspan(BLOCK_M, DIM).at(bm, 0) => q_shared;
        trigger qf;

        foreach {bn} in [kv_bound] {
          stage = bn % STAGES;
          wait ke[stage];
          tma.copy.async<kf[stage]>.swiz<SWIZ>
            K_head.subspan(BLOCK_N, DIM).at(bn, 0) => k_buf[stage];
          trigger kf[stage];
          wait ve[stage];
          tma.copy.async<vf[stage]>.swiz<SWIZ>
            V_head.subspan(BLOCK_N, DIM).at(bn, 0) => v_buf[stage];
          trigger vf[stage];
        }
      }

      inthreads.async (p > 0) {
        cid = p - 1;
        foreach {s} in [STAGES] {
          trigger ke[s];
          trigger ve[s];
        }

        wait qf;

        frag f32[WG_M] scores_max {-inf};
        frag f32[WG_M] scores_max_prev;
        frag f32[WG_M] scores_scale;
        frag f32[WG_M] scores_sum;
        frag f32[WG_M] logsum {0.0f};
        frag bf16[WG_M, BLOCK_N] acc_s_cast;
        acc_o = mma.fill.f32 0.0f;

        // Prologue: issue QK[0]
        wait kf[0];
        acc_s = mma.fill.f32 0.0f;
        mma.row.row acc_s, q_shared.subspan(WG_M, DIM).at(cid, 0), k_buf[0];
        mma.commit;
        mma.wait<0>;

        foreach {bn} in [kv_bound] {
          stage = bn % STAGES;
          trigger ke[stage];

          // Softmax on acc_s (QK[bn] result is ready)
          int causal_row_base = bm * BLOCK_M + cid * WG_M + past_len;
          if ((bn + 1) * BLOCK_N > causal_row_base + 1) {
            apply {i, j} in acc_s.span {
              if ((bn * BLOCK_N + j) > (bm * BLOCK_M + cid * WG_M + i + past_len))
                acc_s.at(i, j) = -inf;
            }
          }

          copy(scores_max_prev, scores_max);
          reduce_max(scores_max, acc_s, 1);
          apply {i} in scores_max.span {
            scores_max.at(i) = __max(scores_max.at(i), scores_max_prev.at(i));
            scores_scale.at(i) = __exp2f(scores_max_prev.at(i) * scale - scores_max.at(i) * scale);
          }
          apply {i, j} in acc_s.span
            acc_s.at(i, j) = __exp2f(acc_s.at(i, j) * scale - scores_max.at(i) * scale);
          reduce_sum(scores_sum, acc_s, 1);
          apply {i} in logsum.span
            logsum.at(i) = logsum.at(i) * scores_scale.at(i) + scores_sum.at(i);
          apply {i, j} in acc_o.span
            acc_o.at(i, j) = acc_o.at(i, j) * scores_scale.at(i);
          apply {i, j} in acc_s_cast.span
            acc_s_cast.at(i, j) = __to<bf16>(acc_s.at(i, j));

          // Prototype overlap schedule:
          //   1) issue QK[bn+1]
          //   2) issue PV[bn]
          //   3) wait<1> so QK[bn+1] is ready while PV[bn] may still be in flight
          if (bn + 1 < kv_bound) {
            wait kf[(bn + 1) % STAGES];
            mma.fill acc_s, 0.0f;
            mma.row.row acc_s, q_shared.subspan(WG_M, DIM).at(cid, 0), k_buf[(bn + 1) % STAGES];
            mma.commit;
          }

          wait vf[stage];
          mma.row.col acc_o, acc_s_cast, v_buf[stage];
          mma.commit;

          if (bn + 1 < kv_bound) {
            mma.wait<1>;
          } else {
            mma.wait<0>;
          }

          if (bn > 0)
            trigger ve[(bn - 1) % STAGES];
        }
        if (kv_bound > 0)
          trigger ve[(kv_bound - 1) % STAGES];

        apply {i, j} in acc_o.span
          acc_o.at(i, j) = acc_o.at(i, j) / logsum.at(i);
        mma.store acc_o, acc_o_shared.subspan(WG_M, DIM).at(cid, 0);
        dma.copy acc_o_shared.subspan(WG_M, DIM).at(cid, 0) => O_head.subspan(WG_M, DIM).at(bm * 2 + cid, 0);
      }
    }
  }
}

#define MHA_DIM DIM
#define MHA_DTYPE choreo::bf16
#include "../../../fa_helper.hpp"

int main() {
  #include "../build/bench_configs.inc"
  return mha_helper::RunBenchmarks(
      "Choreo Flash Attention iter060 intra-consumer overlap prototype (D=128 bf16 causal)",
      kBenchConfigs, kBenchConfigCount,
      [&](const mha_helper::BenchConfig& cfg,
          const mha_helper::TensorViews& views) {
        (void)cfg;
        flash_atten(views.Q, views.K, views.V, views.O);
      });
}
