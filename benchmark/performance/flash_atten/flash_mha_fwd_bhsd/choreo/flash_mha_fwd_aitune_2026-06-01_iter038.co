// Winner: flash_mha_fwd ai-tune 2026-06-01, iter038 (258.5 TFLOPS, +39%)
// Compile: EXTRA_NVCC_FLAGS="--use_fast_math" bash bench.sh --kernel flash_mha_fwd_aitune_2026-06-01_iter038.co --gpu 1
//
// 1p1c architecture with BLOCK_M=64 for doubled occupancy.
// 256 threads (vs 384), register budget allows 2 blocks/SM (~25% occ).
// SMEM drops from 82KB to ~72KB; bench.sh auto-patches launch_bounds(256,2).

#define BLOCK_M 64
#define BLOCK_N 128
#define WG_M 64
#define WG_K 16
#define SWIZ 128
#define STAGES 2

#define DIM 64

#define min(a, b) ((a) < (b) ? (a) : (b))

__co__ void flash_atten(
  global f16[B, H, Q_SEQ, DIM] Q,
  global f16[B, H, KV_SEQ, DIM] K,
  global f16[B, H, KV_SEQ, DIM] V,
  global f16[B, H, Q_SEQ, DIM] O
) {
  float scale = 0.18033688f;
  int past_len = KV_SEQ - Q_SEQ;

  parallel {bm, head, batch} by [cdiv(Q_SEQ, BLOCK_M), H, B] : block {
    bm_rev = cdiv(Q_SEQ, BLOCK_M) - 1 - bm;
    Q_head = Q.subspan(1, 1, Q_SEQ, DIM).at(batch, head, 0, 0).sqz();
    K_head = K.subspan(1, 1, KV_SEQ, DIM).at(batch, head, 0, 0).sqz();
    V_head = V.subspan(1, 1, KV_SEQ, DIM).at(batch, head, 0, 0).sqz();
    O_head = O.subspan(1, 1, Q_SEQ, DIM).at(batch, head, 0, 0).sqz();

    shared f16[BLOCK_M, DIM] q_shared;
    shared f16[BLOCK_N, DIM] k_buf[STAGES];
    shared f16[BLOCK_N, DIM] v_buf[STAGES];
    shared event qf, kvf[STAGES], kve[STAGES];

    kv_bound = __min(cdiv((bm_rev + 1) * BLOCK_M + past_len, BLOCK_N), cdiv(KV_SEQ, BLOCK_N));

    parallel p by [2] : group-4, t by 128 : thread {
      inthreads.async (p == 0) {
        tma.copy.async<qf>.swiz<SWIZ>
          Q_head.subspan(BLOCK_M, DIM).at(bm_rev, 0) => q_shared;
        trigger qf;

        foreach {bn} in [kv_bound] {
          stage = bn % STAGES;
          wait kve[stage];
          tma.copy.async<kvf[stage]>.swiz<SWIZ>
            K_head.subspan(BLOCK_N, DIM).at(bn, 0) => k_buf[stage];
          tma.copy.async<kvf[stage]>.swiz<SWIZ>
            V_head.subspan(BLOCK_N, DIM).at(bn, 0) => v_buf[stage];
          trigger kvf[stage];
        }
      }

      inthreads.async (p > 0) {
        foreach {s} in [STAGES] {
          trigger kve[s];
        }

        wait qf;

        fragment f32[WG_M] scores_max {-inf};
        fragment f32[WG_M] scores_max_prev;
        fragment f32[WG_M] scores_scale;
        fragment f32[WG_M] scores_sum;
        fragment f32[WG_M] logsum {0.0f};
        acc_o = mma.fill.f32 0.0f;

        causal_limit = bm_rev * BLOCK_M + past_len;

        foreach {bn} in [kv_bound] {
          stage = bn % STAGES;
          acc_s = mma.fill.f32 0.0f;

          wait kvf[stage];
          mma.row.row acc_s, q_shared, k_buf[stage];

          if ((bn + 1) * BLOCK_N > causal_limit) {
            frag.apply acc_s, [](i, j) {
              return ((bn * BLOCK_N + j) > (causal_limit + i))
                ? -inf : acc_s.at(i, j);
            };
          }

          frag.copy scores_max_prev, scores_max;
          frag.reduce_max acc_s, scores_max, 1;
          frag.apply scores_max, [](i) { return __max(scores_max.at(i), scores_max_prev.at(i)); };
          frag.apply scores_scale, [](i) { return __exp2f(scores_max_prev.at(i) * scale - scores_max.at(i) * scale);};
          frag.apply acc_s, [](i, j) { return __exp2f(acc_s.at(i, j) * scale - scores_max.at(i) * scale);};
          frag.reduce_sum acc_s, scores_sum, 1;
          frag.apply logsum, [](i) { return logsum.at(i) * scores_scale.at(i) + scores_sum.at(i);};
          frag.apply acc_o, [](i, j) { return acc_o.at(i, j) * scores_scale.at(i);};

          fragment f16[WG_M, BLOCK_N] acc_s_cast;
          frag.apply acc_s_cast, [](i, j) { return __to<f16>(acc_s.at(i, j));};

          mma.row.col acc_o, acc_s_cast, v_buf[stage];
          trigger kve[stage];
        }

        frag.apply acc_o, [](i, j) { return acc_o.at(i, j) / logsum.at(i); };
        mma.store acc_o, O_head.subspan(WG_M, DIM).at(bm_rev, 0);
      }
    }
  }
}

#include "mha_helper.hpp"

int main() {
  mha_helper::BenchConfig configs[] = {
    {2, 32, 512, 512, true, "B=2 H=32 SEQ=512 decoder"},
    {2, 32, 1024, 1024, true, "B=2 H=32 SEQ=1024 decoder"},
    {2, 32, 2048, 2048, true, "B=2 H=32 SEQ=2048 decoder"},
    {2, 32, 4096, 4096, true, "B=2 H=32 SEQ=4096 decoder"},
    {1, 32, 8192, 8192, true, "B=1 H=32 SEQ=8192 decoder"},
  };
  return mha_helper::RunBenchmarks(
      "Choreo Flash Attention flash_mha_fwd aitune iter038 1p1c BM64", configs,
      sizeof(configs) / sizeof(configs[0]),
      [&](const mha_helper::BenchConfig& cfg,
          const mha_helper::TensorViews& views) {
        (void)cfg;
        flash_atten(views.Q, views.K, views.V, views.O);
      });
}
