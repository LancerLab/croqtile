// Usage: choreo -gs -t cute -arch=sm_90a v2_1p1c_tma.co -o bench.sh
//        bash bench.sh --execute

// sequential load + compute + store with SIMT-level memory copy(dma.copy)

// tunable
#define BLOCK_M 128
#define BLOCK_N 128
#define WG_M 64
#define WG_K 16

// constants
#define DIM 64

// #define SPLIT_K 1  // enable this to explicitly split k dim in mma

__co__ void flash_atten(
  global f16[B, H, Q_SEQ, DIM] Q, global f16[B, H, KV_SEQ, DIM] K,
  global f16[B, H, KV_SEQ, DIM] V, bool is_causal,
  global f16[B, H, Q_SEQ, DIM] O
) {
  // constants
  float scale = 0.18033688f;
  int past_len = KV_SEQ - Q_SEQ;
  assert(BLOCK_M % WG_M == 0, "BLOCK_M must be a multiple of WG_M");
  assert(BLOCK_N % WG_K == 0, "BLOCK_N must be a multiple of WG_K");

  parallel {bm, head, batch} by [cdiv(Q_SEQ, BLOCK_M), H, B] : block {
    Q_head = Q.subspan(1, 1, Q_SEQ, DIM).at(batch, head, 0, 0).sqz();
    K_head = K.subspan(1, 1, KV_SEQ, DIM).at(batch, head, 0, 0).sqz();
    V_head = V.subspan(1, 1, KV_SEQ, DIM).at(batch, head, 0, 0).sqz();
    O_head = O.subspan(1, 1, Q_SEQ, DIM).at(batch, head, 0, 0).sqz();

    q_s = dma.copy.swiz<128> Q_head.subspan(BLOCK_M, DIM).at(bm, 0) => shared;
    parallel wgm by [BLOCK_M / WG_M]: group-4 {
      fragment f16[WG_M, BLOCK_N] acc_s_cast;
      fragment f32[WG_M] scores_max {-inf};
      fragment f32[WG_M] scores_max_prev;
      fragment f32[WG_M] scores_scale;
      fragment f32[WG_M] scores_sum;
      fragment f32[WG_M] logsum {0.0f};
      acc_o = mma.fill.f32 0.0f;

      kv_bound = __min(cdiv((bm + 1) * BLOCK_M + past_len, BLOCK_N), cdiv(KV_SEQ, BLOCK_N));

      foreach {bn} in [kv_bound] {
        acc_s = mma.fill.f32 0.0f;
        k_s = dma.copy.swiz<128> K_head.subspan(BLOCK_N, DIM).at(bn, 0) => shared;
        #ifndef SPLIT_K
        mma.row.row acc_s, q_s.chunkat(wgm, _), k_s;
        #else
        foreach {k} in [cdiv(DIM, WG_K)] {
          ma = mma.load.swiz<128> q_s.chunkat(wgm, k);
          mb = mma.load.swiz<128> k_s.chunkat(_, k);
          mma.row.row acc_s, ma, mb;
        }
        #endif
        frag.apply acc_s, [](i, j) {
          return ((bn * BLOCK_N + j) > (bm * BLOCK_M + wgm * WG_M + i + past_len))
            ? -inf : acc_s.at(i, j);
        };

        frag.copy scores_max_prev, scores_max;
        frag.reduce_max acc_s, scores_max, 1;
        frag.apply scores_max, [](i) {
          return __max(scores_max.at(i), scores_max_prev.at(i));
        };
        frag.apply scores_scale, [](i) {
          return __exp2f(scores_max_prev.at(i) * scale - scores_max.at(i) * scale);
        };
        frag.apply acc_s, [](i, j) {
          return __exp2f(acc_s.at(i, j) * scale - scores_max.at(i) * scale);
        };
        frag.reduce_sum acc_s, scores_sum, 1;
        frag.apply logsum, [](i) {
          return logsum.at(i) * scores_scale.at(i) + scores_sum.at(i);
        };
        frag.apply acc_o, [](i, j) {
          return acc_o.at(i, j) * scores_scale.at(i);
        };
        frag.apply acc_s_cast, [](i, j) {
          return __to<f16>(acc_s.at(i, j));
        };

        v_s = dma.copy.swiz<128> V_head.subspan(BLOCK_N, DIM).at(bn, 0) => shared;
        #ifndef SPLIT_K
        mma.row.col acc_o, acc_s_cast, v_s;
        #else
        foreach {k} in [cdiv(BLOCK_N, WG_K)] {
          ma = acc_s_cast.chunkat(_, k);
          mb = mma.loadS v_s.chunkat(k, _);
          mma.row.col acc_o, ma, mb;
        }
        #endif
      }

      frag.apply acc_o, [](i, j) {
        return acc_o.at(i, j) / logsum.at(i);
      };
      mma.store acc_o, O_head.subspan(WG_M, DIM).at(bm # wgm, 0);
    }
  }
}

#include "mha_helper.hpp"

int main() {
  mha_helper::BenchConfig configs[] = {
    {2, 32, 512, 512, true, "B=2 H=32 SEQ=512 decoder"},
    {2, 32, 1024, 1024, true, "B=2 H=32 SEQ=1024 decoder"},
    {2, 32, 2048, 2048, true, "B=2 H=32 SEQ=2048 decoder"},
    {2, 32, 4096, 4096, true, "B=2 H=32 SEQ=4096 decoder"},
    {1, 32, 8192, 8192, true, "B=1 H=32 SEQ=8192 decoder"},
  };
  return mha_helper::RunBenchmarks(
      "Choreo Flash Attention v1 Manual Baseline", configs,
      sizeof(configs) / sizeof(configs[0]),
      [&](const mha_helper::BenchConfig& cfg,
          const mha_helper::TensorViews& views) {
        flash_atten(views.Q, views.K, views.V, cfg.is_causal, views.O);
      });
}
