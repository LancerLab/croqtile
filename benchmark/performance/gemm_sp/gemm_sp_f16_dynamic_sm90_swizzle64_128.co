#include <cstring>
#include <cstdlib>

// H800 PCIe (Hopper PCIe class) FP16 Tensor Core peak throughput.
#define H800_PCIE_PEAK_F16_TFLOPS 1513

#ifndef SPMM_DEFAULT_M
#define SPMM_DEFAULT_M 4096
#endif

#ifndef SPMM_DEFAULT_N
#define SPMM_DEFAULT_N 8192
#endif

#ifndef SPMM_DEFAULT_K
#define SPMM_DEFAULT_K 8192
#endif

#define SPMM_WARP_M 64
#define SPMM_WARP_N 256
#define SPMM_TILE_K 64
#define SPMM_WARP_K 32

#define SPMM_PACKED_TILE_K 32
#define SPMM_META_TILE_COLS 8

template <typename T>
using SparsePolicy = choreo::utils::SparsePolicy<T>;

// TODO incorrect!! Need load metadata inside the kernel
__co__ void spmm( global f16 [M, PACKED_K] lhs_packed, 
                  global u8 [M, META_COLS] lhs_meta,
                  global f16 [N, K] rhs, 
                  global f32 [M, N] output
                ) {
  parallel {block_m, block_n}
      by [cdiv(M, SPMM_WARP_M), cdiv(N, SPMM_WARP_N)] : block {
    shared f16 [SPMM_WARP_M, SPMM_PACKED_TILE_K] lhs_load_s;
    shared f16 [SPMM_WARP_N, SPMM_TILE_K] rhs_load_s;
    shared u8 [SPMM_WARP_M, SPMM_META_TILE_COLS] lhs_load_s_mdata;
    mc = mma.fill.f32 0.0f;
    foreach {iv_k} in [cdiv(K, SPMM_TILE_K)] {
      tma.copy.swiz<64> lhs_packed.subspan(SPMM_WARP_M, SPMM_PACKED_TILE_K).at(block_m, iv_k) => lhs_load_s;
      tma.copy.swiz<128> rhs.subspan(SPMM_WARP_N, SPMM_TILE_K).at(block_n, iv_k) => rhs_load_s;
      
      // dma.copy lhs_meta.subspan(SPMM_WARP_M, SPMM_META_TILE_COLS).at(block_m, iv_k) => lhs_load_s_mdata;
      foreach {iv_warp} in [cdiv(SPMM_TILE_K, SPMM_WARP_K)] {
        parallel p by 1 : group-4 {
          ma = mma.load.swiz<64> lhs_load_s.chunkat(_, iv_warp);
          mb = mma.load.swiz<128> rhs_load_s.chunkat(_, iv_warp);
          me = mma.load lhs_load_s_mdata.chunkat(_, iv_warp);
          mma.row.row.sp mc, ma, mb, me;
        }
      }
    }
    shared f32 [SPMM_WARP_M, SPMM_WARP_N] output_s;
    mma.store mc, output_s;
    tma.copy output_s => output.subspan(SPMM_WARP_M, SPMM_WARP_N).at(block_m, block_n);
  }
}

void init_pattern_sparse_a(choreo::spanned_data<choreo::f16, 2>& lhs_dense) {
  for (size_t row = 0; row < SPMM_DEFAULT_M; ++row) {
    for (size_t group = 0; group < SPMM_DEFAULT_K / 4; ++group) {
      size_t base = group * 4;
      lhs_dense[row][base + 0] = choreo::utils::from_f32<choreo::f16>(
          1.0f + 0.125f * static_cast<float>(row) +
          0.03125f * static_cast<float>(group));
      lhs_dense[row][base + 1] = choreo::utils::from_f32<choreo::f16>(0.0f);
      lhs_dense[row][base + 2] = choreo::utils::from_f32<choreo::f16>(
          -0.51f - 0.0625f * static_cast<float>(row) +
          0.015625f * static_cast<float>(group));
      lhs_dense[row][base + 3] = choreo::utils::from_f32<choreo::f16>(0.0f);
    }
  }
}

void encode_wgmma_sp_k32(choreo::spanned_data<choreo::f16, 2>& lhs_dense,
                         choreo::spanned_data<choreo::f16, 2>& lhs_packed,
                         choreo::spanned_data<choreo::u8, 2>& lhs_meta) {
  lhs_meta.fill(0);
  for (size_t row = 0; row < lhs_dense.shape()[0]; ++row) {
    for (size_t group = 0; group < lhs_dense.shape()[1] / 4; ++group) {
      size_t base = group * 4;
      int idx0 = -1;
      int idx1 = -1;
      int nz = 0;
      for (int i = 0; i < 4; ++i) {
        if (choreo::to_f32(lhs_dense[row][base + i]) != 0.0f) {
          if (nz == 0)
            idx0 = i;
          else if (nz == 1)
            idx1 = i;
          ++nz;
        }
      }
      choreo::choreo_assert(nz == 2, "Invalid 2:4 sparse pattern");
      if (idx0 > idx1) std::swap(idx0, idx1);

      size_t sparse_col = group * 2;
      lhs_packed[row][sparse_col + 0] = lhs_dense[row][base + idx0];
      lhs_packed[row][sparse_col + 1] = lhs_dense[row][base + idx1];

      choreo::u8 nibble = static_cast<choreo::u8>(idx0 | (idx1 << 2));
      size_t byte_col = group / 2;
      if ((group & 1) == 0)
        lhs_meta[row][byte_col] = nibble;
      else
        lhs_meta[row][byte_col] |= static_cast<choreo::u8>(nibble << 4);
    }
  }
}

int main(int argc, char** argv) {
  bool enable_timing = true;
  bool skip_verify = false;
  double user_flops = -1.0;
  auto is_disable_timing_arg = [](const char* s) {
    const char* t = "--disable-timing";
    int i = 0;
    while (t[i] != '\0' && s[i] == t[i]) ++i;
    return t[i] == '\0' && s[i] == '\0';
  };
  auto is_skip_verify_arg = [](const char* s) {
    const char* t = "--skip-verify";
    int i = 0;
    while (t[i] != '\0' && s[i] == t[i]) ++i;
    return t[i] == '\0' && s[i] == '\0';
  };
  for (int i = 1; i < argc; ++i) {
    if (is_disable_timing_arg(argv[i])) {
      enable_timing = false;
      continue;
    }
    if (is_skip_verify_arg(argv[i])) {
      skip_verify = true;
      continue;
    }
    if (std::strncmp(argv[i], "--flops=", 8) == 0) {
      user_flops = std::atof(argv[i] + 8);
      continue;
    }
  }

  const char* timing_env = std::getenv("CHOREO_DISABLE_TIMING");
  if (timing_env && timing_env[0] == '1' && timing_env[1] == '\0') {
    enable_timing = false;
  }

  const char* skip_verify_env = std::getenv("CHOREO_SKIP_VERIFY");
  if (skip_verify_env && skip_verify_env[0] == '1' && skip_verify_env[1] == '\0') {
    skip_verify = true;
  }

  size_t m = SPMM_DEFAULT_M;
  size_t n = SPMM_DEFAULT_N;
  size_t k = SPMM_DEFAULT_K;

  choreo::runtime_check((k % 64) == 0,
                        "SPMM_DEFAULT_K must be divisible by 64");

  std::mt19937 gen(42);
  auto lhs_dense_h = choreo::make_spandata<choreo::f16>(m, k);
  auto lhs_packed_h = choreo::make_spandata<choreo::f16>(m, k / 2);
  auto lhs_meta_h = choreo::make_spandata<choreo::u8>(m, k / 8);
  auto rhs_h = choreo::make_spandata<choreo::f16>(n, k);

  // SparsePolicy<choreo::f16>::init_structured_sparse_A(lhs_dense_h, gen);
  init_pattern_sparse_a(lhs_dense_h);
  rhs_h.fill_random(-1.0f, 1.0f);
  encode_wgmma_sp_k32(lhs_dense_h, lhs_packed_h, lhs_meta_h);

  auto res_h = choreo::make_spandata<float>(m, n);
  res_h.fill(0.0f);

  half *lhs_packed_d = nullptr, *rhs_d = nullptr;
  u8 *lhs_meta_d = nullptr;
  float *res_d = nullptr;
  choreo::abend_true(cudaMalloc(&lhs_packed_d, m * (k / 2) * sizeof(half)));
  choreo::abend_true(cudaMalloc(&lhs_meta_d, m * (k / 8) * sizeof(u8)));
  choreo::abend_true(cudaMalloc(&rhs_d, n * k * sizeof(half)));
  choreo::abend_true(cudaMalloc(&res_d, m * n * sizeof(float)));

  choreo::abend_true(cudaMemcpy(lhs_packed_d, lhs_packed_h.data(), m * (k / 2) * sizeof(half), cudaMemcpyHostToDevice));
  choreo::abend_true(cudaMemcpy(lhs_meta_d, lhs_meta_h.data(), m * (k / 8) * sizeof(u8), cudaMemcpyHostToDevice));
  choreo::abend_true(cudaMemcpy(rhs_d, rhs_h.data(), n * k * sizeof(half), cudaMemcpyHostToDevice));
  choreo::abend_true(cudaMemcpy(res_d, res_h.data(), m * n * sizeof(float), cudaMemcpyHostToDevice));
  choreo::abend_true(cudaDeviceSynchronize());

  auto lhs_packed_d_view = choreo::make_spanview<choreo::f16, 2>(lhs_packed_d, {m, k / 2});
  auto lhs_meta_d_view = choreo::make_spanview<choreo::u8, 2>(lhs_meta_d, {m, k / 8});
  auto rhs_d_view = choreo::make_spanview<choreo::f16, 2>(rhs_d, {n, k});
  auto res_d_view = choreo::make_spanview<float, 2>(res_d, {m, n});

  if (enable_timing) {
    int warmup = 10;
    int repeat = 500;
    const char* warmup_env = std::getenv("CHOREO_TIMING_WARMUP");
    const char* repeat_env = std::getenv("CHOREO_TIMING_REPEAT");
    if (warmup_env) {
      int value = std::atoi(warmup_env);
      if (value >= 0) warmup = value;
    }
    if (repeat_env) {
      int value = std::atoi(repeat_env);
      if (value > 0) repeat = value;
    }
    choreo::TimerOption topt;
    topt.warmup = warmup;
    topt.repeat = repeat;
    auto avg_ms = choreo::timing(
        [&]() { spmm(lhs_packed_d_view, lhs_meta_d_view, rhs_d_view, res_d_view); },
        topt);
    std::cout << "Timing avg ms: " << avg_ms << "\n";

    double flops = (user_flops > 0.0)
                       ? user_flops
                       : (2.0 * double(m) * double(n) * double(k));
    double tflops = (flops / (avg_ms / 1000.0)) / 1e12;
    std::cout << "TFLOPS: " << tflops << "\n";

    double eff = (tflops / H800_PCIE_PEAK_F16_TFLOPS) * 100.0;
    std::cout << "HW efficiency: " << eff << "%\n";
  } else {
    spmm(lhs_packed_d_view, lhs_meta_d_view, rhs_d_view, res_d_view);
  }

  if (skip_verify) {
    std::cout << "Test Passed (verify skipped)\n" << std::endl;
    return 0;
  }

  spmm(lhs_packed_d_view, lhs_meta_d_view, rhs_d_view, res_d_view);
  choreo::abend_true(cudaDeviceSynchronize());
  choreo::abend_true(cudaMemcpy(res_h.data(), res_d, m * n * sizeof(float), cudaMemcpyDeviceToHost));
  choreo::abend_true(cudaDeviceSynchronize());

  auto lhs_dense_v = lhs_dense_h.view();
  auto rhs_v = rhs_h.view();
  auto res_v = res_h.view();

  float tolerance = 1.0e-2f;
  for (size_t i = 0; i < m; ++i) {
    for (size_t j = 0; j < n; ++j) {
      float ref = 0.0f;
      for (size_t kk = 0; kk < lhs_dense_v.shape()[1]; ++kk)
        ref += choreo::to_f32(lhs_dense_v[i][kk]) * choreo::to_f32(rhs_v[j][kk]);
      float got = res_v[i][j];
      float diff = std::abs(got - ref);
      if (diff >= tolerance) {
        std::cout << "[" << i << ", " << j << "] " << ref << " <-> " << got
                  << ", abs delta: " << diff << std::endl;
      }
      choreo::choreo_assert((diff < tolerance), "values are not equal.");
    }
  }
  std::cout << "Test Passed\n" << std::endl;
}
