#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define time_steps 512
#endif

__co__ auto GELU(f32 [64, time_steps, 256] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {x, ts} in [16, time_steps] {
      l = dma.copy i.chunkat(p#x, ts, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, ts, _);
    }
  }
  return o;
}

int main() {
  test3("GELU", GELU, {64, 512, 256});
}
