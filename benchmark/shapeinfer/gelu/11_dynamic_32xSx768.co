#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define seq_len 768
#endif

__co__ auto GELU(f32 [32, seq_len, 768] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {x, sl} in [8, seq_len] {
      l = dma.copy i.chunkat(p#x, sl, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, sl, _);
    }
  }
  return o;
}

int main() {
  test3("GELU", GELU, {32, 768, 768});
}
