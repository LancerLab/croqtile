#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define num_heads 100
#endif

__co__ auto GELU(f32 [32, num_heads, 512, 64] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {x, y} in [8, num_heads] {
      l = dma.copy i.chunkat(p#x, y, _, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, y, _, _);
    }
  }
  return o;
}

int main() {
  test4("GELU", GELU, {32, 100, 512, 64});
}
