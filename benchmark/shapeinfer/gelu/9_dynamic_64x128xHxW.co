#include "choreo.h"
#include "common.h"

#ifdef __STATIC_SHAPE__
#define height 32
#define width 32
#endif

__co__ auto GELU(f32 [64, 128, height, width] i) {
  f32 [i.span] o;
  parallel p by 4 : local {
    foreach {x, y} in [16, 128] {
      l = dma.copy i.chunkat(p#x, y, _, _) => local;
      foreach idx in [l.span]
        l.data.at(idx) = __gelu(l.data.at(idx));
      dma.copy l.data => o.chunkat(p#x, y, _, _);
    }
  }
  return o;
}

int main() {
  test4("GELU", GELU, {64, 128, 32, 32});
}
