        foreach {k} in [l1_input.span(2)] {
          l1_out.at(0, j, k) = __exp(l1_input.data.at(0, j, k) - max_val);
          sum_exp += l1_out.at(0, j, k);
        }

        // Normalize
        foreach {k} in [l1_input.span(2)]
          l1_out.at(0, j, k) = l1_out.at(0, j, k) / sum_exp;
      }
      dma.copy l1_out => output.chunkat(i#p, _, _);
    }
  }
  return output;
}

// case17: [128, 96, 112, 112] --> [128, 96, 112, 112] (MobileNet)
__co__ auto softmax17(f32 [128, 96, 112, 112] input) {
  f32 [input.span] output;
  parallel p by 4 {
    foreach batch_idx in [input.span(0)/#p] {
      foreach {h_tile, w_tile} in [4, 4] {
        l1_input = dma.copy input.chunkat(batch_idx#p, _, h_tile, w_tile) => local;
        local f32[l1_input.span] l1_out;
        foreach {i, j} in [l1_input.span(2), l1_input.span(3)] {
          // Find max for numerical stability
          f32 max_val = l1_input.data.at(0, 0, i, j);
          foreach {k} in [l1_input.span(1)]
            if (l1_input.data.at(0, k, i, j) > max_val)
              max_val = l1_input.data.at(0, k, i, j);
          // Compute exp and sum
          f32 sum_exp = 0.0f;
          foreach {k} in [l1_input.span(1)] {
            l1_out.at(0, k, i, j) = __exp(l1_input.data.at(0, k, i, j) - max_val);
            sum_exp += l1_out.at(0, k, i, j);
          }
          // Normalize
          foreach {k} in [l1_input.span(1)]
            l1_out.at(0, k, i, j) = l1_out.at(0, k, i, j) / sum_exp;
        }

        dma.copy l1_out => output.chunkat(batch_idx#p, _, h_tile, w_tile);
      }
    }
  }
  return output;
}

// case18: [64, 256, 56, 56] --> [64, 256, 56, 56] (ResNet)
__co__ auto softmax18(f32 [64, 256, 56, 56] input) {
  f32 [input.span] output;
  parallel p by 4 {
    foreach batch_idx in [input.span(0)/#p] {
      foreach {h_tile, w_tile} in [7, 7] {
        l1_input = dma.copy input.chunkat(batch_idx#p, _, h_tile, w_tile) => local;
        local f32[l1_input.span] l1_out;
        foreach {i, j} in [l1_input.span(2), l1_input.span(3)] {
          // Find max for numerical stability
          f32 max_val = l1_input.data.at(0, 0, i, j);
          foreach {k} in [l1_input.span(1)]
            if (l1_input.data.at(0, k, i, j) > max_val)
              max_val = l1_input.data.at(0, k, i, j);
          // Compute exp and sum
          f32 sum_exp = 0.0f;
          foreach {k} in [l1_input.span(1)] {
            l1_out.at(0, k, i, j) = __exp(l1_input.data.at(0, k, i, j) - max_val);
            sum_exp += l1_out.at(0, k, i, j);
          }
          // Normalize
          foreach {k} in [l1_input.span(1)]
            l1_out.at(0, k, i, j) = l1_out.at(0, k, i, j) / sum_exp;
        }

        dma.copy l1_out => output.chunkat(batch_idx#p, _, h_tile, w_tile);
      }
    }
  }
  return output;
}

// case19: [32, 512, 2048] --> [32, 512, 2048] (Transformer)
__co__ auto softmax19(f32 [32, 512, 2048] input)  {
  f32 [input.span(0), input.span(1), input.span(2)] output;
  parallel p by 4, q by 8 {
    foreach {i} in [input.span(0)] {
      l1_input = dma.copy input.chunkat(i, p#q, _) => local;
      local f32[1, l1_input.span(1), l1_input.span(2)] l1_out;
      foreach {j} in [l1_input.span(1)] {
        // Find max for numerical stability
        f32 max_val = l1_input.data.at(0, j, 0);
        foreach {k} in [l1_input.span(2)]
          if (l1_input.data.at(0, j, k) > max_val)
            max_val = l1_input.data.at(0, j, k);

        // Compute exp and sum
        f32 sum_exp = 0.0f;
        foreach {k} in [l1_input.span(2)] {
          l1_out.at(0, j, k) = __exp(l1_input.data.at(0, j, k) - max_val);
          sum_exp += l1_out.at(0, j, k);
        }

        // Normalize
        foreach {k} in [l1_input.span(2)]
          l1_out.at(0, j, k) = l1_out.at(0, j, k) / sum_exp;
      }
      dma.copy l1_out => output.chunkat(i, p#q, _);
    }
  }
  return output;
}

// case20: [32, 197, 3072] --> [32, 197, 3072] (ViT)
__co__ auto softmax20(f32 [32, 197, 3072] input) {
  f32 [input.span(0), input.span(1), input.span(2)] output;
  parallel p by 4 {
    foreach {i} in [input.span(1)] {
      l1_input = dma.copy input.chunkat(p, i, _) => local;
      local f32[l1_input.span(0), l1_input.span(1), l1_input.span(2)] l1_out;
      foreach {j} in [l1_input.span(1)] {
        // Find max for numerical stability
        f32 max_val = l1_input.data.at(i, j, 0);
        foreach {k} in [l1_input.span(2)]
          if (l1_input.data.at(i, j, k) > max_val)
            max_val = l1_input.data.at(i, j, k);

        // Compute exp and sum
        f32 sum_exp = 0.0f;
        foreach {k} in [l1_input.span(2)] {
          l1_out.at(i, j, k) = __exp(l1_input.data.at(i, j, k) - max_val);
          sum_exp += l1_out.at(0, j, k);
        }

        // Normalize
        foreach {k} in [l1_input.span(2)]
          l1_out.at(i, j, k) = l1_out.at(i, j, k) / sum_exp;
      }
      dma.copy l1_out => output.chunkat(p, i, _);
    }
  }
  return output;
}

extern "C" void cpu_softmax1(choreo::f32* input, choreo::f32 *output, int H, int W, int C) {
  for (int i = 0; i < H; ++i) {
    for (int j = 0; j < W; ++j) {
      float max_val = input[i * W * C + j * C];
      for (int k = 1; k < C; ++k) {
        if (input[i * W * C + j * C + k] > max_val)
          max_val = input[i * W * C + j * C + k];
      }
      float sum_exp = 0.0f;
      for (int k = 0; k < C; ++k) {
        output[i * W * C + j * C + k] = expf(input[i * W * C + j * C + k] - max_val);
        sum_exp += output[i * W * C + j * C + k];
      }
      for (int k = 0; k < C; ++k) {
        output[i * W * C + j * C + k] /= sum_exp;
      }
    }
  }
}

extern "C" void cpu_softmax2(choreo::f32* input, choreo::f32 *output, int N, int C, int H, int W) {
  const int total_elements = N * C * H * W;
  float max_val, sum_exp;
  for (int n = 0; n < N; ++n) {
    for (int h = 0; h < H; ++h) {
      for (int w = 0; w < W; ++w) {
        int base_idx = n * C * H * W + h * W + w;
        int stride = H * W;
        max_val = input[base_idx];
        for (int c = 1; c < C; ++c) {
          float val = input[base_idx + c * stride];
          if (val > max_val) max_val = val;
        }
        sum_exp = 0.0f;
        for (int c = 0; c < C; ++c) {
          float val = input[base_idx + c * stride];
          float exp_val = expf(val - max_val);
          output[base_idx + c * stride] = exp_val;
          sum_exp += exp_val;
        }
        for (int c = 0; c < C; ++c) {
          output[base_idx + c * stride] /= sum_exp;
        }
      }
    }
  }
}

#define TEST1(func, H, W, C) \
  auto input_##func = choreo::make_spandata<choreo::f32>(H, W, C); \
  input_##func.fill_random(-10.0f, 10.0f); \
  auto output_##func = func(input_##func.view()); \
  float *cpu_res_##func = (float *)malloc(H * W * C * sizeof(float)); \
  cpu_softmax1(input_##func.data(), cpu_res_##func, H, W, C); \
  for (int i = 0; i < H * W * C; ++i) { \
    assert(fabs(output_##func.data[i] - cpu_res_##func[i]) < 1e-3); \
  } \
  printf("Test %s passed!\n", #func);

#define TEST2(func, N, C, H, W) \
  auto input_##func = choreo::make_spandata<choreo::f32>(N, C, H, W); \
  input_##func.fill_random(-1.0f, 1.0f); \
  auto output_##func = func(input_##func.view()); \
  float *cpu_res_##func = (float *)malloc(N * C * H * W * sizeof(float)); \
  cpu_softmax2(input_##func.data(), cpu_res_##func, N, C, H, W); \
  for (int i = 0; i < N * C * H * W; ++i) { \
    assert(fabs(output_##func.data[i] - cpu_res_##func[i]) < 1e-3); \
  } \
  printf("Test %s passed!\n", #func);

int main() {
  TEST1(softmax1, 32, 512, 768);
  TEST2(softmax2, 128, 128, 28, 28);
  // other tests can be added similarly
  printf("All tests passed!\n");
}