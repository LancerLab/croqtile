        // Compute exp and sum
        f32 sum_exp = 0.0f;
        foreach {k} in [l1_input2.span(0)] {
          l1_out.at(0, j, k) = __exp(l1_input1.data.at(0, j, k) - max_val);
          sum_exp += l1_out.at(0, j, k);
        }

        // Normalize
        foreach {k} in [l1_input2.span(0)]
          l1_out.at(0, j, k) = l1_out.at(0, j, k) / sum_exp;
      }
      dma.copy l1_out => output.chunkat(i#p, _, _);
    }
  }
  return output;
}
